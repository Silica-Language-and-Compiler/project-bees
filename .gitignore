# Trial leaves: executables have no extension, so ignore everything in a leaf first, then
# re-include sources and goldens, then ignore generated files again (later rules win).
trials/*/*
!trials/*/*.*
!trials/*/Makefile
!trials/*/lib/
# M3: the roles and the node leaves (their generated files are ignored again below)
!trials/m3_dist/roles/
!trials/m3_dist/nodes/
trials/m3_dist/nodes/*/*
!trials/m3_dist/nodes/*/Makefile
!trials/m3_dist/nodes/*/node.wire
!trials/m3_dist/nodes/*/node.atoms
!trials/m3_dist/nodes/*/lib/
!trials/m3_dist/nodes/*/dangerous_exposure_source
trials/m3_dist/*.sout

# M4: the roles and the node leaves; the files generated by trials/m4_demo/roles/gen_types.py and the build are ignored again
!trials/m4_demo/roles/
!trials/m4_demo/nodes/
trials/m4_demo/nodes/*/*
!trials/m4_demo/nodes/*/Makefile
!trials/m4_demo/nodes/*/node.atoms
!trials/m4_demo/nodes/*/lib/
!trials/m4_demo/nodes/*/dangerous_exposure_source
trials/m4_demo/roles/client.role
trials/m4_demo/roles/service.role
trials/m4_demo/roles/extras_ticker.role
trials/m4_demo/roles/extras_hostile.role
trials/m4_demo/roles/__pycache__/
trials/m4_demo/nodes/*/lib/bees_atoms.silica
trials/m4_demo/nodes/*/lib/bees_atoms.index
trials/m4_demo/nodes/*/lib/bees_wire_*.silica
trials/m4_demo/nodes/*/lib/bees_peers.silica
trials/m4_demo/nodes/*/lib/bees_msgs.silica
trials/m4_demo/nodes/*/lib/m4_payload.silica
!trials/m4_demo/nodes/*/lib/bees_wire.silica
trials/m4_demo/*.sout
trials/m4_demo/rate.*.out*
trials/m4_demo/measure.txt

# Generated by the trial harness (tools/trial.mk)
*.sams
*.iface
*.o
*.sout
*.cur_fail
silica.config
silica.compile.order
silica.needs_runtime
silica.link
.integrate_counts
.fail/
lib/bees_atoms.silica
lib/bees_atoms.index
trials/*/lib/bees_modules.silica
trials/*/lib/bees_ids.silica
trials/*/lib/bees_wire_tables.silica
trials/*/lib/bees_wire_ints.silica
trials/*/lib/bees_wire_msgs.silica
trials/*/lib/bees_peers.silica
trials/*/lib/bees_msgs.silica
trials/m3_dist/nodes/*/lib/bees_msgs.silica
trials/m3_dist/nodes/*/lib/bees_peers.silica
trials/m3_dist/nodes/*/lib/bees_atoms.silica
trials/m3_dist/nodes/*/lib/bees_atoms.index
trials/m3_dist/nodes/*/lib/bees_wire_*.silica
trials/m3_dist/nodes/*/lib/bees_peers.silica
!trials/m3_dist/nodes/*/lib/bees_wire.silica

native/build/
native/dangerous_exposure_source/lib/
silica.atoms
silica.shapes
__pycache__/
# M2: root units generated by tools/bees_edge_gen.py
trials/m2_carrier_tcp/dangerous_m2_listener.silica
trials/m2_carrier_tcp/dangerous_m2_connector.silica
trials/m2_carrier_tcp/dangerous_m2_refuse.silica

# Other compilation artifacts: runtime objects, native archives and libraries, compiler crash records, OS files
__silica_runtime.*
*.a
*.so
*.dylib
*.dSYM/
silica.compile.*
# the compiler's derived transport code (encode/decode), written beside each unit that uses it
*.silica.derived
.DS_Store
# N3 (TRUST): node leaves; their generated units and root units, run outputs and the measure files are ignored again
!trials/n3_trust/roles/
!trials/n3_trust/nodes/
!trials/n3_trust/certs/
trials/n3_trust/nodes/*/*
!trials/n3_trust/nodes/*/Makefile
!trials/n3_trust/nodes/*/*.config
!trials/n3_trust/nodes/*/*.atoms
!trials/n3_trust/nodes/*/*.trust
!trials/n3_trust/nodes/*/lib/
!trials/n3_trust/nodes/*/dangerous_exposure_source
trials/n3_trust/nodes/g2/unreadable_whitelist.config
trials/n3_trust/nodes/*/lib/bees_trust_conf.*
trials/n3_trust/nodes/*/lib/bees_trust_mfa.silica
trials/n3_trust/rate.*.out*
trials/n3_trust/measure.txt
trials/n3_trust/nodes/*/silica.config
trials/n3_trust/nodes/*/silica.atoms
trials/n3_trust/nodes/*/lib/bees_atoms.*
trials/n3_trust_frames/lib/bees_atoms.*
# N4.1 (TRUST over mutual TLS 1.3): as N3; the TEST-ONLY certificates and keys in certs/ are fixtures the goldens depend on
# (tools/bees_test_certs.sh made them once; keys that belong to nobody)
!trials/n4_trust_tls/roles/
!trials/n4_trust_tls/nodes/
!trials/n4_trust_tls/certs/
trials/n4_trust_tls/nodes/*/*
!trials/n4_trust_tls/nodes/*/Makefile
!trials/n4_trust_tls/nodes/*/*.config
!trials/n4_trust_tls/nodes/*/*.atoms
!trials/n4_trust_tls/nodes/*/*.trust
!trials/n4_trust_tls/nodes/*/lib/
!trials/n4_trust_tls/nodes/*/dangerous_exposure_source
trials/n4_trust_tls/nodes/*/lib/bees_trust_conf.*
trials/n4_trust_tls/nodes/*/lib/bees_trust_mfa.silica
trials/n4_trust_tls/rate.*.out*
trials/n4_trust_tls/measure.txt
trials/n4_trust_tls/nodes/*/silica.config
trials/n4_trust_tls/nodes/*/silica.atoms
trials/n4_trust_tls/nodes/*/lib/bees_atoms.*
# N2 (BEAM mode): the roles and node leaves of n2_dist and n2_live; generated root units, beam_conf/beam_peers, cookie files,
# the live trial's raw logs and its compiled stock driver
!trials/n2_dist/roles/
!trials/n2_dist/nodes/
!trials/n2_live/roles/
!trials/n2_live/nodes/
trials/n2_dist/nodes/*/*
trials/n2_live/nodes/*/*
!trials/n2_dist/nodes/*/Makefile
!trials/n2_live/nodes/*/Makefile
!trials/n2_dist/nodes/*/node.wire
!trials/n2_live/nodes/*/node.wire
!trials/n2_dist/nodes/*/node.atoms
!trials/n2_live/nodes/*/node.atoms
!trials/n2_live/nodes/*/node.beam
!trials/n2_dist/nodes/*/bees.config
!trials/n2_live/nodes/*/bees.config
!trials/n2_dist/nodes/*/lib/
!trials/n2_live/nodes/*/lib/
!trials/n2_dist/nodes/*/dangerous_exposure_source
!trials/n2_live/nodes/*/dangerous_exposure_source
trials/*/nodes/*/lib/beam_conf.silica
trials/*/nodes/*/lib/beam_peers.silica
trials/*/nodes/*/lib/bees_peers.silica
trials/*/nodes/*/lib/bees_msgs.silica
trials/*/nodes/*/lib/bees_atoms.silica
trials/*/nodes/*/lib/bees_atoms.index
trials/n2_auth/cookie.txt
trials/n2_live/*.raw
trials/n2_live/erl_crash.dump
# N0.2: the M3 and M4 node leaves' bees.config
!trials/m3_dist/nodes/*/bees.config
!trials/m4_demo/nodes/*/bees.config
# N1: trials/n1_addr and trials/n1_frames (roles, node leaves); n1_addr's bees.config is written from bees.config.in
!trials/n1_addr/roles/
!trials/n1_addr/nodes/
!trials/n1_frames/roles/
!trials/n1_frames/nodes/
trials/n1_addr/nodes/*/*
trials/n1_frames/nodes/*/*
!trials/n1_addr/nodes/*/Makefile
!trials/n1_frames/nodes/*/Makefile
!trials/n1_addr/nodes/*/node.wire
!trials/n1_frames/nodes/*/node.wire
!trials/n1_addr/nodes/*/node.atoms
!trials/n1_addr/nodes/*/bees.config.in
!trials/n1_frames/nodes/*/bees.config
!trials/n1_addr/nodes/*/lib/
!trials/n1_frames/nodes/*/lib/
!trials/n1_addr/nodes/*/dangerous_exposure_source
!trials/n1_frames/nodes/*/dangerous_exposure_source
trials/n1_addr/any_ip.*.out
trials/n1_frames/big.times
trials/n1_frames/measure_*
