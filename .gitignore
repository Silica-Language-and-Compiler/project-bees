# Trial leaves: executables have no extension, so ignore everything in a leaf first, then
# re-include sources and goldens, then ignore generated files again (later rules win).
trials/*/*
!trials/*/*.*
!trials/*/Makefile
!trials/*/lib/

# Generated by the trial harness (tools/trial.mk)
*.sams
*.iface
*.o
*.sout
*.cur_fail
silica.config
silica.compile.order
silica.needs_runtime
silica.link
.integrate_counts
.fail/
lib/bees_atoms.silica
lib/bees_atoms.index
trials/*/lib/bees_modules.silica
trials/*/lib/bees_ids.silica
trials/*/lib/bees_wire_tables.silica
trials/*/lib/bees_wire_ints.silica
trials/*/lib/bees_wire_msgs.silica
native/build/
native/dangerous_exposure_source/lib/
silica.atoms
silica.shapes
__pycache__/
# M2: root units generated by tools/bees_edge_gen.py
trials/m2_carrier_tcp/dangerous_m2_listener.silica
trials/m2_carrier_tcp/dangerous_m2_connector.silica
trials/m2_carrier_tcp/dangerous_m2_refuse.silica

# Other compilation artifacts: runtime objects, native archives and libraries, compiler crash records, OS files
__silica_runtime.*
*.a
*.so
*.dylib
*.dSYM/
silica.compile.*
.DS_Store
