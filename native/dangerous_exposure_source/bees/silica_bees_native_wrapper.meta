link_library: "silica_bees_native"

wrapper bees_clock_monotonic_ns {
    symbol: "bees_clock_monotonic_ns"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_clock_system_ns {
    symbol: "bees_clock_system_ns"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_poll_wait_ms {
    symbol: "bees_poll_wait_ms"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_fixture_word {
    symbol: "bees_fixture_word"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_dns_resolve {
    symbol: "bees_dns_resolve"
    result: "tagged_result"
    error_domain: "dangerous_bees_dns"
    arguments: [
        { name: "host_ptr", lifetime: "borrowed", retain: false },
        { name: "host_len", role: "length", length_of: "host_ptr" }
    ]
}

wrapper bees_dns_take {
    symbol: "bees_dns_take"
    result: "struct"
    error_domain: "dangerous_bees_dns"
}
