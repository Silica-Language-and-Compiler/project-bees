link_library: "silica_bees_native"

wrapper bees_clock_monotonic_ns {
    symbol: "bees_clock_monotonic_ns"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_clock_system_ns {
    symbol: "bees_clock_system_ns"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_poll_wait_ms {
    symbol: "bees_poll_wait_ms"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_fixture_word {
    symbol: "bees_fixture_word"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_tcp_read_word {
    symbol: "bees_tcp_read_word"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_tcp_last_word {
    symbol: "bees_tcp_last_word"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_tcp_write_word {
    symbol: "bees_tcp_write_word"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_tcp_close {
    symbol: "bees_tcp_close"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_tcp_open_prepare {
    symbol: "bees_tcp_open_prepare"
    result: "scalar"
    error_domain: "dangerous_bees_native"
}

wrapper bees_tcp_open_text {
    symbol: "bees_tcp_open_text"
    result: "scalar"
    error_domain: "dangerous_bees_native"
    arguments: [
        { name: "addr_ptr", lifetime: "borrowed", retain: false },
        { name: "addr_len", role: "length", length_of: "addr_ptr" }
    ]
}
