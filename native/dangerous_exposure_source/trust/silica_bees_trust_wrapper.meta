link_library: "silica_bees_trust"

wrapper bees_trust_random_etf {
    symbol: "bees_trust_random_etf"
    result: "struct"
    error_domain: "dangerous_bees_trust_native"
}

wrapper bees_trust_ct_set {
    symbol: "bees_trust_ct_set"
    result: "tagged_result"
    error_domain: "dangerous_bees_trust_native"
    arguments: [
        { name: "a_ptr", lifetime: "borrowed", retain: false },
        { name: "a_len", role: "length", length_of: "a_ptr" }
    ]
}

wrapper bees_trust_ct_equal {
    symbol: "bees_trust_ct_equal"
    result: "tagged_result"
    error_domain: "dangerous_bees_trust_native"
    arguments: [
        { name: "b_ptr", lifetime: "borrowed", retain: false },
        { name: "b_len", role: "length", length_of: "b_ptr" }
    ]
}
