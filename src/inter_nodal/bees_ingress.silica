// BEES ingress: the audit trail and the numbering of the language's rejection reasons.
//
// The receive step is no longer here. Bytes that came from the network become typed values only through the language's
// derived `decode((:etf), frame, { limits })`, called in the `sequence` of a `sequence ... produces pure` block in the
// deliverer that dangerous_bees_net starts for a frame (generated bees_peers, dlv_<name>; the validation copy of the same call is
// bees_msgs@validate_named). The stub `recreate` of M3 to M5, which copied parts into a buffer without clearing taint, is
// gone (mvp.md section 4, N0.0). The 4-byte framing is the language's wireframe; the handshake's 2-byte framing and the
// REG_SEND control message are read by bees_dist over strings, every read bounds-checked.
module bees_ingress;
use bees_atoms;

export audit/3;
export banner/0;
export reason_text/1;
export reason_atom/1;
export reason_code/1;

// The language's rejection atoms (transport design 4.3) numbered 1 to 16, in the design's order; 0 is accepted (:ok).
// The numbers appear in audit lines and goldens; they are BEES's, not the language's.
fn reason_atom(code: int64) -> atom {
    case code of {
        0 -> :ok;
        1 -> bees_atoms@a_bad_version();
        2 -> bees_atoms@a_truncated();
        3 -> bees_atoms@a_trailing_bytes();
        4 -> bees_atoms@a_bad_tag();
        5 -> bees_atoms@a_too_large();
        6 -> bees_atoms@a_too_deep();
        7 -> bees_atoms@a_too_long();
        8 -> bees_atoms@a_out_of_range();
        9 -> bees_atoms@a_bad_utf8();
        10 -> bees_atoms@a_unknown_atom();
        11 -> bees_atoms@a_bad_variant();
        12 -> bees_atoms@a_missing_field();
        13 -> bees_atoms@a_duplicate_field();
        14 -> bees_atoms@a_unknown_field();
        15 -> bees_atoms@a_foreign_actor();
        16 -> bees_atoms@a_unsupported();
        _: int64 -> bees_atoms@a_unsupported()
    }
}
fn reason_code(a: atom) -> int64 {
    case a == :ok of { true -> 0; false ->
    case a == bees_atoms@a_bad_version() of { true -> 1; false ->
    case a == bees_atoms@a_truncated() of { true -> 2; false ->
    case a == bees_atoms@a_trailing_bytes() of { true -> 3; false ->
    case a == bees_atoms@a_bad_tag() of { true -> 4; false ->
    case a == bees_atoms@a_too_large() of { true -> 5; false ->
    case a == bees_atoms@a_too_deep() of { true -> 6; false ->
    case a == bees_atoms@a_too_long() of { true -> 7; false ->
    case a == bees_atoms@a_out_of_range() of { true -> 8; false ->
    case a == bees_atoms@a_bad_utf8() of { true -> 9; false ->
    case a == bees_atoms@a_unknown_atom() of { true -> 10; false ->
    case a == bees_atoms@a_bad_variant() of { true -> 11; false ->
    case a == bees_atoms@a_missing_field() of { true -> 12; false ->
    case a == bees_atoms@a_duplicate_field() of { true -> 13; false ->
    case a == bees_atoms@a_unknown_field() of { true -> 14; false ->
    case a == bees_atoms@a_foreign_actor() of { true -> 15; false -> 16 } } } } } } } } } } } } } } } }
}
fn reason_text(code: int64) -> string { bees_atoms@spelling(reason_atom(code)) }

// One audit line per refused or dropped thing, to the program's standard output (the program's own sink for it is the
// compiler's job; BEES only counts and names). kind says what, who names the peer or the reason, n is a count or a code.
// The line is written by one println, so that another thread's output (the runtime's own lines included) cannot land inside
// it, as it did when each part was printed on its own (m4_demo kill, 2026-11-10).
fn digits(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> digits(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}
fn int_text(n: int64) -> string {
    case n < 0 of {
        true -> concat("-", digits(0 - n, ""));
        false -> digits(n, "")
    }
}
fn audit(kind: string, who: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- println(concat(concat(concat("[bees audit] ", kind), concat(" ", who)), concat(" ", int_text(n))))
    produces pure :ok end
}

// Printed once by every node at start (mvp.md 3.5): the MVP link has no authentication and no encryption.
fn banner() -> atom {
    sequence proc[device_io]
        _: atom <- println("[bees] TEST ONLY: no authentication, no encryption on this transport (127.0.0.1); TRUST's TLS is not built yet")
    produces pure :ok end
}
