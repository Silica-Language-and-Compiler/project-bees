// BEES node: one link between two nodes over the language's (:tcp) carrier (transport design 6.2, 6.3; the hosted
// dangerous_tcp_carrier of the Silica stdlib), spoken as the design writes it: tagged tuples, string segments, credits.
//
//   conn  the RECEIVE ACTOR and the connection carrier's owner: it receives the carrier's events (:link_up, :rx, :tx_credit,
//         :tx_failed, :link_down), runs the distribution handshake (bees_dist) and then the data phase, and delivers REG_SEND
//         payloads by registered name through short-lived deliverers (bees_peers), where the language's decode runs.
//         Its state holds no heap value (SD-35): each frame's bytes are reassembled by a short-lived assembler `asm`, one per
//         frame, which keeps the wireframe state { mode, expected, pending } and ends when its frame is complete. The
//         carrier is granted ONE receive credit at a time, and only when the assembler has said it needs more bytes
//         ((:bees, 4, ...)): so at most one segment is ever on its way to an assembler, and no segment can reach an assembler
//         that has already ended with its frame (it did, with four credits outstanding, and the stream stalled under load:
//         the m4_demo rate run, 2026-11-10). The
//         assembler of the handshake messages uses BEES's 2-byte framing (bees_dist@unframe2); after the handshake the
//         language's wireframe@unframe (4-byte framing) does the work.
//   tx    the SEND ACTOR, the one writer of the link: it takes framed segments (strings) and casts each to the carrier as
//         (:tx, segment, self()), so frames of several proxies never interleave. It also sends the net tick when the link has
//         been idle for a tick interval, and, when the link is lost, ends every proxy through the reaper (the message (:bees, 1, 0, tx, tx)).
//   lsn   the LISTEN ACTOR of a listening node: the listening carrier's owner as far as this unit goes. The carrier is opened
//         with "listen:PORT" by the carrier edge (src/shim/bees_tcp_edge.part, carrier_listen), whose small actor stands between:
//         the standard library's listener hands over the accepted DESCRIPTOR since 2026-11-20, and that actor starts the
//         connection's carrier from it. lsn is told (:link_up, "port:N") once bound and, for every connection accepted,
//         (:accepted, connection_carrier, info), and lsn starts a link on that connection (tx, conn) and adopts it for conn with (:open, conn, ""): the connection then
//         answers its own :link_up and the handshake starts. N2c: every accepted connection is served; the node has several links (one per
//         peer line) and a peer that connects again replaces its old link (slot, below). tx and conn are spawned only once their
//         carrier is known, so neither ever changes its carrier (SD-39: a replaced dangerous_actor_ref in state makes the compiler
//         fall back to a whole-state copy per dispatch, which grew both actors by hundreds of MB in the m4_demo rate run). A dialing
//         node needs no lsn: the root unit starts each link on its own carrier at once (bees_node_edge.part).
//   slot  one per peer line (a chain): who owns the peer's registered names, and the order in which a replacing link takes them over
//         (spikes/N2b-multi-link.md, "N2c").
// The language's carrier has no idle timeout, so conn keeps its own (io_ms): a peer silent for io_ms ends the link
// with reason timeout, as the native edge did.
//
// A link is "up" once the handshake is complete: data frames of proxies are written only then (a frame earlier is dropped), and
// a frame received before the handshake completes is dropped with an audit entry and the link is closed.
// Failure maps onto Silica's own rules (mvp.md 3.3): the proxies are ended with kill_abnormal, which is what a sender sees.
//
// BEES-internal messages are tagged tuples with the tag :bees (conn: (:bees, kind, body, rest, why); tx: (:bees, kind, seg)),
// and :who (tx learns the reaper); these tags are Silica-level actor-protocol atoms
// that never reach the wire, allowed by tools/bees_config.py check beside the carrier contract's own.
//
// Why the dangerous_ prefix, and why this unit exports only the two behaviours (checked on silica-999926, 2026-11-10): a unit
// that holds a dangerous_actor_ref (the carrier) must be named dangerous_* (E4026), and a call to any function of a
// dangerous_* unit is allowed only inside an FFI worker's external_danger sequence (E4042), even when the function does no
// foreign work. So nothing here is called from outside: the node is started by the program's dangerous_ root unit, which
// spawns `tx` and `conn` (a dialer) or `lsn` (a listener) by reference and casts to them (net_launch, net_start, net_raw_writer, net_send_raw in
// src/shim/bees_node_edge.part, pasted into every node program by tools/bees_edge_gen.py).
module dangerous_bees_net;
use bees_atoms;
use bees_dist;
use bees_ingress;
use bees_msgs;
use bees_peers;
use wireframe;
use carrier;

export tx/2;
export conn/2;
export lsn/2;
export slot/2;

// ======================================================================== tx
// tx message kinds (:bees, kind, seg): 0 a data segment (written only while the link is up), 1 a raw segment (always),
// 2 the link is up, 3 the link is lost, 4 the idle timer. (:who, r) names the reaper, (:car, c) its connection actor (the link's janitor, N2c); kind 9 ends the writer (conn's last act). The carrier c is fixed for the actor's
// life: the new state's c is always st.c, because the compiler proves a state release only when each pointer-carrying slot is
// passed through, and it counts a dangerous_actor_ref as pointer-carrying (SD-39); an unproven tx grew by hundreds of MB.
fn ctl(tx: actor_ref, kind: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(tx, (:bees, kind, "") impl ActorMessage {})
    produces pure ok end
}
// a framed segment, written whether or not the link is up (the handshake, and test programs that break the protocol)
fn send_raw(tx: actor_ref, seg: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(tx, (:bees, 1, seg) impl ActorMessage {})
    produces pure ok end
}
fn arm(me: actor_ref, ms: uint64) -> boolean {
    sequence proc[concurrency]
        t: timer_ref <- send_after(ms, me, (:bees, 4, "") impl ActorMessage {})
    produces pure true end
}
fn msg_kind(msg: (:bees, int64, string) | (:who, actor_ref) | (:car, actor_ref)) -> int64 {
    case msg of {
        (:bees, k: int64, _s: string) -> k;
        (:who, _w: actor_ref) -> 5;
        (:car, _c: actor_ref) -> 7
    }
}
fn msg_seg(msg: (:bees, int64, string) | (:who, actor_ref) | (:car, actor_ref)) -> string {
    case msg of {
        (:bees, _k: int64, s: string) -> s;
        (:who, _w: actor_ref) -> "";
        (:car, _c: actor_ref) -> ""
    }
}
fn msg_who(msg: (:bees, int64, string) | (:who, actor_ref) | (:car, actor_ref), old: actor_ref) -> actor_ref {
    case msg of {
        (:bees, _k: int64, _s: string) -> old;
        (:who, w: actor_ref) -> w;
        (:car, _c: actor_ref) -> old
    }
}
fn msg_cn(msg: (:bees, int64, string) | (:who, actor_ref) | (:car, actor_ref), old: actor_ref) -> actor_ref {
    case msg of { (:bees, _k: int64, _s: string) -> old; (:who, _w: actor_ref) -> old; (:car, c: actor_ref) -> c }
}
fn is_write(kind: int64, up: boolean) -> boolean { kind == 1 or (kind == 0 and up) }
fn up_after(kind: int64, up: boolean) -> boolean {
    case kind == 2 of { true -> true; false -> case kind == 3 of { true -> false; false -> up } }
}
fn sent_after(kind: int64, up: boolean, sent: int64) -> int64 {
    case kind == 4 of {
        true -> 0;
        false -> case is_write(kind, up) of { true -> sent + 1; false -> sent }
    }
}
fn b2i(b: boolean) -> int64 { case b of { true -> 1; false -> 0 } }

fn tx(
    msg: (:bees, int64, string) | (:who, actor_ref) | (:car, actor_ref),
    st: { c: dangerous_actor_ref, up: boolean, sent: int64, reaper: actor_ref, cn: actor_ref, tick_ms: uint64 }
) -> (:no_reply, { c: dangerous_actor_ref, up: boolean, sent: int64, reaper: actor_ref, cn: actor_ref, tick_ms: uint64 }) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        kind: int64 <- msg_kind(msg);
        seg: string <- msg_seg(msg);
        _: boolean <- case is_write(kind, st.up) of { true -> cast(st.c, (:tx, seg, me) impl ActorMessage {}); false -> true };
        idle: boolean <- kind == 4 and st.up and st.sent == 0 and st.tick_ms > 0;
        tk: string <- bees_dist@tick();
        _: boolean <- case idle of { true -> cast(st.c, (:tx, tk, me) impl ActorMessage {}); false -> true };
        arm_first: boolean <- kind == 2 and st.tick_ms > 0;
        arm_again: boolean <- kind == 4 and st.up and st.tick_ms > 0;
        _: boolean <- case arm_first or arm_again of { true -> arm(me, st.tick_ms); false -> true };
        _: boolean <- case kind == 3 of { true -> cast(st.reaper, (:bees, 1, 0, me, st.cn) impl ActorMessage {}); false -> true };
        _: atom <- case kind == 9 of { true -> stop_self(:normal); false -> :ok }
    produces pure (:no_reply, { c: st.c, up: up_after(kind, st.up), sent: sent_after(kind, st.up, st.sent), reaper: msg_who(msg, st.reaper), cn: msg_cn(msg, st.cn), tick_ms: st.tick_ms }) end
}

// ======================================================================== asm
// The assembler of one frame: it holds the reassembly state and nothing else lives long with a heap value in its state
// (SD-35). hs chooses the framing: BEES's 2-byte handshake framing, or the language's 4-byte wireframe. When a frame is
// complete it hands the body and the bytes that followed it (the start of the next frame) to conn as (:bees, 1, body, rest, :ok)
// and ends; a framing rejection is (:bees, 2, "", "", reason); when it has used every byte and needs more it says so,
// (:bees, 4, "", "", :ok), and conn grants the carrier one receive credit.
fn asm(
    seg: string,
    a: { core: actor_ref, hs: boolean, rx: { mode: atom, expected: int64, pending: string } }
) -> (:no_reply, { core: actor_ref, hs: boolean, rx: { mode: atom, expected: int64, pending: string } }) {
    sequence
        un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- case a.hs of {
            true -> bees_dist@unframe2(a.rx, seg, bees_dist@max_handshake());
            false -> wireframe@unframe(a.rx, seg, bees_peers@frame_max())
        };
        rx2: { mode: atom, expected: int64, pending: string } <- case un of {
            (:more, r1: { mode: atom, expected: int64, pending: string }) -> {
                sequence proc[concurrency]
                    _: boolean <- cast(a.core, (:bees, 4, "", "", :ok) impl ActorMessage {})
                produces pure r1 end
            };
            (:frame, body: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                sequence proc[concurrency]
                    _: boolean <- cast(a.core, (:bees, 1, body, r2.pending, :ok) impl ActorMessage {});
                    _: atom <- stop_self(:normal)
                produces pure r2 end
            };
            (:rejected, why: atom) -> {
                sequence proc[concurrency]
                    _: boolean <- cast(a.core, (:bees, 2, "", "", why) impl ActorMessage {});
                    _: atom <- stop_self(:normal)
                produces pure a.rx end
            }
        }
    produces pure (:no_reply, { core: a.core, hs: a.hs, rx: rx2 }) end
}
// a new assembler for the next frame, started with the bytes already received (it drains them at once: an empty segment)
fn spawn_asm(core: actor_ref, hs: boolean, pending: string) -> actor_ref {
    sequence proc[concurrency]
        a: actor_ref <- spawn({ core: core, hs: hs, rx: { mode: :stream, expected: 0, pending: pending } }, asm, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(a, "" impl ActorMessage {})
    produces pure a end
}

// ======================================================================== conn
// mode: 0 waiting for the link, 1 the handshake (2-byte framing), 3 data (4-byte framing), 9 closing (a violation: waiting for
// the link_down our close causes), 10 over. step: the dialer's handshake step (0 expecting s, 1 expecting N). seen: frames
// (ticks included) since the last idle check.
fn step(a: actor_ref, mode: int64, stp: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    { asm: a, mode: mode, step: stp, peer: peer, ok: ok, dropped: dropped, ticks: ticks, seen: seen }
}
// N2c: `step` carries three things in one number (a function may take at most 8 register arguments, E1070, so a ninth field has no
// constructor): the handshake step (hs, 0 to 3), the state of the frame assembler (aw: 0 none or ended, 1 busy with a segment, 2 idle and
// waiting for the next one) and, once the link is over (mode 10), the teardown flags (fl: 1 the carrier said link_down, 2 the manager
// released this link, 4 the cookie worker has nothing left to answer; always set here, set by a grace timer in BEAM mode).
fn hs_of(s: int64) -> int64 { s % 4 }
fn aw_of(s: int64) -> int64 { (s / 4) % 4 }
fn fl_of(s: int64) -> int64 { s / 16 }
fn pk(hs: int64, aw: int64, fl: int64) -> int64 { hs + aw * 4 + fl * 16 }
fn with_aw(s: int64, aw: int64) -> int64 { pk(hs_of(s), aw, fl_of(s)) }
fn with_hs(s: int64, hs: int64) -> int64 { pk(hs, aw_of(s), fl_of(s)) }
fn with_fl(s: int64, bit: int64) -> int64 { case (fl_of(s) / bit) % 2 == 1 of { true -> s; false -> s + bit * 16 } }
fn ks(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, stp: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    step(st.asm, st.mode, stp, st.peer, st.ok, st.dropped, st.ticks, st.seen)
}
fn keep(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    step(st.asm, st.mode, st.step, st.peer, st.ok, st.dropped, st.ticks, st.seen)
}
fn in_link(mode: int64) -> boolean { mode == 1 or mode == 3 }

fn credit(c: dangerous_actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(c, (:credit, n) impl ActorMessage {})
    produces pure ok end
}
fn close_link(c: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(c, :close impl ActorMessage {})
    produces pure ok end
}
fn arm_idle(me: actor_ref, ms: uint64) -> boolean {
    case ms > 0 of {
        false -> true;
        true -> {
            sequence proc[concurrency]
                t: timer_ref <- send_after(ms, me, (:bees, 3, "", "", :ok) impl ActorMessage {})
            produces pure true end
        }
    }
}

// the handshake messages, as raw (always written) segments
fn send_name(tx: actor_ref) -> boolean { send_raw(tx, bees_dist@put_n_init(bees_peers@node_name(), bees_peers@node_creation())) }
fn send_accept(tx: actor_ref) -> boolean {
    sequence
        _: boolean <- send_raw(tx, bees_dist@put_s_ok());
        ok: boolean <- send_raw(tx, bees_dist@put_n_acc(bees_peers@node_name(), bees_peers@node_creation()))
    produces pure ok end
}

// the connection is up (a dialer's carrier connected, or an accepted connection was opened): start the handshake
fn on_up(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, me: actor_ref, info: string) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case starts_with(info, "port:") or st.mode != 0 of {
        true -> keep(st);
        false -> link_up(st, me)
    }
}
fn link_up(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, me: actor_ref) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        _: boolean <- case st.dial of { true -> send_name(st.tx); false -> true };
        _: boolean <- arm_idle(me, st.io_ms);
        a: actor_ref <- spawn_asm(me, true, "");
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(a, 1, pk(0, 1, 0), st.peer, st.ok, st.dropped, st.ticks, 0)
    produces pure s end
}
// a received segment goes to the frame's assembler; the next receive credit waits for the assembler's (:bees, 4, ...)
fn on_rx(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, seg: string) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence proc[concurrency]
        _: boolean <- case in_link(st.mode) of { true -> cast(st.asm, seg impl ActorMessage {}); false -> true };
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- ks(st, case in_link(st.mode) of { true -> with_aw(st.step, 1); false -> st.step })
    produces pure s end
}

// a violation of the protocol: audit it, close the link, wait for the link_down
fn violation(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, kind: string, who: string, n: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        _: atom <- bees_ingress@audit(kind, who, n);
        _: boolean <- close_link(st.c);
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(st.asm, 9, st.step, st.peer, st.ok, st.dropped + 1, st.ticks, st.seen)
    produces pure s end
}
fn kind_for(mode: int64) -> string { case mode == 1 of { true -> "frame before handshake dropped, link closed"; false -> "bad frame length, link closed" } }

fn claim(slot: actor_ref, peer: int64, tx: actor_ref, conn: actor_ref) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(slot, (:bees, 4, peer, tx, conn) impl ActorMessage {})
    produces pure ok end
}
// the link is established: the proxies may write. N2c: a listening node's proxies are started by the peer's SLOT on its go (this
// conn claims the slot here when the table has more than one peer; with one peer lsn claimed at accept), never directly, so that a
// peer that connects again replaces its old link in a sound order (spikes/N2b-multi-link.md, "Reconnect").
fn established(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, peer: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence proc[concurrency]
        me: actor_ref <- self();
        _: boolean <- ctl(st.tx, 2);
        _: boolean <- case st.dial or bees_peers@peer_count() == 1 of { true -> true; false -> claim(st.lt, peer, st.tx, me) };
        _: atom <- bees_ingress@audit("handshake complete with", bees_peers@peer_name(peer), peer);
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(st.asm, 3, with_hs(st.step, 2), peer, st.ok, st.dropped, st.ticks, st.seen + 1)
    produces pure s end
}

// a complete handshake message (its body, without the 2-byte prefix)
fn hs_done(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, body: string) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case st.dial of {
        false -> hs_listener(st, bees_dist@n_init_name(body));
        true -> case hs_of(st.step) == 0 of {
            true -> hs_dial_status(st, body);
            false -> hs_dial_name(st, bees_dist@n_acc_name(body))
        }
    }
}
fn hs_listener(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, r: { code: int64, v: string }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case r.code == 0 of {
        false -> violation(st, "bad name message, link closed", "code", r.code);
        true -> hs_listed(st, r.v, bees_peers@peer_index(r.v))
    }
}
fn hs_listed(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, name: string, idx: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case idx < 0 of {
        true -> violation(st, "unlisted node, link closed", name, 0 - 1);
        false -> case bees_peers@link_dials_of(idx) of {
            true -> violation(st, "a peer this node dials, dialed in; link closed", name, idx);
            false -> hs_accept(st, idx)
        }
    }
}
fn hs_accept(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, idx: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        _: boolean <- send_accept(st.tx);
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- established(st, idx)
    produces pure s end
}
fn hs_dial_status(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, body: string) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case bees_dist@is_s_ok(body) of {
        false -> violation(st, "status is not ok, link closed", "status", length_bytes(body));
        true -> step(st.asm, 1, with_hs(st.step, 1), st.peer, st.ok, st.dropped, st.ticks, st.seen + 1)
    }
}
fn hs_dial_name(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, r: { code: int64, v: string }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case r.code == 0 of {
        false -> violation(st, "bad name message, link closed", "code", r.code);
        true -> hs_expected(st, r.v, bees_peers@peer_index(r.v))
    }
}
fn hs_expected(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, name: string, idx: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case idx == st.peer of {
        false -> violation(st, "not the node dialed, link closed", name, idx);
        true -> established(st, idx)
    }
}

// a complete frame body in the data phase: empty is a net tick; else 112, REG_SEND, payload. Anything wrong with the content
// drops the frame (counted, audited) and keeps the link: the framing was intact. Anything but REG_SEND is dropped and counted.
fn frame_done(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, body: string) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case length_bytes(body) == 0 of {
        true -> step(st.asm, 3, st.step, st.peer, st.ok, st.dropped, st.ticks + 1, st.seen + 1);
        false -> frame_target(st, body, bees_dist@reg_send_target(body, bees_peers@peer_name(st.peer)))
    }
}
fn dropped_frame(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, kind: string, who: string, n: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        _: atom <- bees_ingress@audit(kind, who, n);
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(st.asm, 3, st.step, st.peer, st.ok, st.dropped + 1, st.ticks, st.seen + 1)
    produces pure s end
}
fn frame_target(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, body: string, t: { code: int64, name: atom, pstart: int64 }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case t.code == 0 of {
        false -> dropped_frame(st, "frame dropped", bees_ingress@reason_text(t.code), t.code);
        true -> frame_name(st, bees_dist@payload_of(body, t.pstart), t.name, bees_peers@local_index(t.name))
    }
}
fn frame_name(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, payload: string, name: atom, li: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case li < 0 of {
        true -> dropped_frame(st, "frame dropped, not a name this node serves", bees_atoms@spelling(name), 0 - 1);
        false -> frame_valid(st, payload, li, bees_msgs@validate_named(payload, name))
    }
}
// the payload is validated against the name's declared type (the language's decode, in bees_msgs) before it is delivered
fn frame_valid(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, payload: string, li: int64, why: atom) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case why == :ok of {
        false -> dropped_frame(st, "payload refused", bees_atoms@spelling(why), bees_ingress@reason_code(why));
        true -> deliver(st, payload, li)
    }
}
fn deliver(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, payload: string, li: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence proc[concurrency]
        d: actor_ref <- bees_peers@start_deliverer(li);
        _: boolean <- cast(d, payload impl ActorMessage {});
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(st.asm, 3, st.step, st.peer, st.ok + 1, st.dropped, st.ticks, st.seen + 1)
    produces pure s end
}

fn on_down(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, reason: atom, kt: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        _: atom <- bees_ingress@audit("link down, proxies ended; reason", bees_atoms@spelling(reason), st.ok);
        _: atom <- bees_ingress@audit("frames delivered", "-", st.ok);
        _: atom <- bees_ingress@audit("frames dropped", "-", st.dropped);
        _: atom <- bees_ingress@audit("net ticks seen (1 yes, 0 no)", "-", b2i(st.ticks > 0));
        _: boolean <- ctl(st.tx, 3);
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(st.asm, 10, pk(hs_of(st.step), aw_of(st.step), kt + 4), st.peer, st.ok, st.dropped, st.ticks, st.seen)
    produces pure s end
}
// a failed write ends the link in the carrier but is reported only as tx_failed, so it ends the link here too
fn on_down_if(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, reason: atom, kt: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case st.mode == 10 of {
        true -> case kt == 1 of { true -> ks(st, with_fl(st.step, 1)); false -> keep(st) };
        false -> on_down(st, reason, kt)
    }
}
// the idle check: a peer silent for io_ms (no frame, no tick) is lost; the link is closed with reason timeout
fn on_idle(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, me: actor_ref) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case in_link(st.mode) of {
        false -> keep(st);
        true -> case st.seen > 0 of {
            true -> {
                sequence
                    _: boolean <- arm_idle(me, st.io_ms);
                    s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(st.asm, st.mode, st.step, st.peer, st.ok, st.dropped, st.ticks, 0)
                produces pure s end
            };
            false -> {
                sequence
                    _: boolean <- close_link(st.c);
                    s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- on_down(st, bees_atoms@a_timeout(), 0)
                produces pure s end
            }
        }
    }
}

// a frame from the assembler: handled by phase, then the next assembler is started with the bytes that followed it
fn on_frame(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, me: actor_ref, body: string, rest: string) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- case st.mode of {
            1 -> hs_done(st, body);
            3 -> frame_done(st, body);
            _: int64 -> keep(st)
        };
        a: actor_ref <- case in_link(s.mode) of {
            true -> spawn_asm(me, s.mode == 1, rest);
            false -> st.tx
        };
        out: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- step(a, s.mode, with_aw(s.step, case in_link(s.mode) of { true -> 1; false -> 0 }), s.peer, s.ok, s.dropped, s.ticks, s.seen)
    produces pure out end
}
// the assembler has used every byte it was given: one more receive credit
fn on_more(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    sequence
        _: boolean <- case in_link(st.mode) of { true -> credit(st.c, 1); false -> true };
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- ks(st, with_aw(st.step, 2))
    produces pure s end
}
// the assembler ended itself after the frame it sent (kind 1 or 2): none is left
fn asm_gone(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    step(st.tx, s.mode, with_aw(s.step, 0), s.peer, s.ok, s.dropped, s.ticks, s.seen)
}
fn on_bees(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, me: actor_ref, k: int64, body: string, rest: string, why: atom) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case k of {
        1 -> on_frame(st, me, body, rest);
        2 -> asm_gone(st, case in_link(st.mode) of { true -> violation(st, kind_for(st.mode), bees_atoms@spelling(why), bees_ingress@reason_code(why)); false -> keep(st) });
        3 -> on_idle(st, me);
        4 -> on_more(st);
        7 -> on_replaced(st);
        9 -> ks(st, with_fl(st.step, 2));
        _: int64 -> case k >= 100 of { true -> on_go(st, k - 100); false -> keep(st) }
    }
}
// N2c: the slot says the peer connected again: this link ends now (the carrier is closed and the proxies are ended through tx's
// kind 3, as for a lost link; reason `replaced`). A link already closing or over ends by itself.
fn on_replaced(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case st.mode == 9 or st.mode == 10 of {
        true -> keep(st);
        false -> {
            sequence
                _: boolean <- close_link(st.c);
                s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- on_down(st, bees_atoms@a_replaced(), 0)
            produces pure s end
        }
    }
}
// N2c: the slot says this link now owns the peer's registered names (the old link's proxies are gone): start them. A link that is
// already over starts none (its tx told the slot, as the reaper of a proxy-less link, that it ended).
fn on_go(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, k: int64) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case st.mode == 10 of {
        true -> keep(st);
        false -> {
            sequence
                _: boolean <- start_peer(st.tx, k, st.lt);
                s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- keep(st)
            produces pure s end
        }
    }
}
fn start_peer(tx: actor_ref, peer: int64, mgr: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: actor_ref <- bees_peers@start_proxies(peer, tx, mgr);
        ok: boolean <- cast(tx, (:who, r) impl ActorMessage {})
    produces pure ok end
}

fn handle(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, me: actor_ref, msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:bees, int64, string, string, atom)) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case msg of {
        (:link_up, info: string) -> on_up(st, me, info);
        (:rx, seg: string) -> on_rx(st, seg);
        (:tx_credit, _n: int64) -> keep(st);
        (:tx_failed, _why: atom) -> on_down_if(st, bees_atoms@a_link_down(), 0);
        (:link_down, why2: atom) -> on_down_if(st, why2, 1);
        (:bees, k: int64, body: string, rest: string, why3: atom) -> on_bees(st, me, k, body, rest, why3)
    }
}
// N2c teardown: a link that is over (mode 10) is ended by its connection actor once nothing can cast to it or to its writer again:
// the carrier has said its last word (link_down: it ends itself), the manager (slot or redial actor) has released the link (it holds
// no reference any more, and has seen the proxies ended: the registered names are free), the cookie worker has nothing left to
// answer (fl bit 4), and the frame assembler is not busy with a segment (it would cast the result here). Then the idle assembler is
// removed (remove_actor never fails its caller), the writer is told to end (kind 9: the proxies, this actor and the carrier are its only
// possible senders and all are done) and this actor ends. Timers that fire later are dropped silently by the runtime.
// done: the actions of fin were taken, so conn ends (stop_self is allowed only in a behaviour)
fn done(s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 }) -> boolean { s.mode == 10 and fl_of(s.step) == 7 and aw_of(s.step) != 1 }
fn fin(st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }, s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 }) -> { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } {
    case s.mode == 10 and fl_of(s.step) == 7 and aw_of(s.step) != 1 of {
        false -> s;
        true -> {
            sequence proc[concurrency]
                _: boolean <- case aw_of(s.step) == 2 of { true -> remove_asm(s.asm); false -> true };
                _: boolean <- cast(st.tx, (:bees, 9, "") impl ActorMessage {})
            produces pure s end
        }
    }
}
fn remove_asm(a: actor_ref) -> boolean {
    sequence proc[concurrency]
        r: (int64, affinity_error) <- remove_actor(a)
    produces pure true end
}
fn conn(
    msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:bees, int64, string, string, atom),
    st: { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }
) -> (:no_reply, { asm: actor_ref, c: dangerous_actor_ref, tx: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64, io_ms: uint64, dial: boolean, lt: actor_ref }) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        s0: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- handle(st, me, msg);
        s: { asm: actor_ref, mode: int64, step: int64, peer: int64, ok: int64, dropped: int64, ticks: int64, seen: int64 } <- fin(st, s0);
        _: atom <- case done(s) of { true -> stop_self(:normal); false -> :ok }
    produces pure (:no_reply, { asm: s.asm, c: st.c, tx: st.tx, mode: s.mode, step: s.step, peer: s.peer, ok: s.ok, dropped: s.dropped, ticks: s.ticks, seen: s.seen, io_ms: st.io_ms, dial: st.dial, lt: st.lt }) end
}

// ======================================================================== lsn
// The listening carrier's owner, through the carrier edge's carrier_listen. On every (:accepted, car, info) it starts a link on car exactly as the root unit's net_launch does on
// a dialer's carrier (the same state literals), and opens car with conn as its owner (N2c: every accepted connection is served; a
// peer that connects again replaces its old link through the slots below). Everything else the listener says ((:link_up, "port:N"), its
// :link_down) changes nothing. The tx's first reaper is the slot chain: a link that ends before any proxies exist tells the slot itself
// (message kind 1). With ONE peer line the peer is known at accept, so the claim is made here (the proxies still start at accept, as
// before); with more it is made at `established`.
fn link_on(car: dangerous_actor_ref, st: { reaper: actor_ref, io_ms: uint64, tick_ms: uint64, accepted: int64, slot: actor_ref }) -> int64 {
    sequence proc[concurrency]
        t: actor_ref <- spawn({ c: car, up: false, sent: 0, reaper: st.slot, cn: st.slot, tick_ms: st.tick_ms }, tx, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- spawn({ asm: t, c: car, tx: t, mode: 0, step: 0, peer: 0 - 1, ok: 0, dropped: 0, ticks: 0, seen: 0, io_ms: st.io_ms, dial: false, lt: st.slot }, conn, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(t, (:car, n) impl ActorMessage {});
        _: boolean <- case bees_peers@peer_count() == 1 of { true -> claim(st.slot, 0, t, n); false -> true };
        _: boolean <- cast(car, (:open, n, "") impl ActorMessage {})
    produces pure 1 end
}
// -> the number of connections this event accepts (0 or 1)
fn lsn_event(msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), st: { reaper: actor_ref, io_ms: uint64, tick_ms: uint64, accepted: int64, slot: actor_ref }) -> int64 {
    case msg of {
        (:accepted, car: dangerous_actor_ref, _info: string) -> link_on(car, st);
        (:link_up, _i: string) -> 0;
        (:rx, _s: string) -> 0;
        (:tx_credit, _n: int64) -> 0;
        (:tx_failed, _w: atom) -> 0;
        (:link_down, _w2: atom) -> 0
    }
}
fn lsn(
    msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
    st: { reaper: actor_ref, io_ms: uint64, tick_ms: uint64, accepted: int64, slot: actor_ref }
) -> (:no_reply, { reaper: actor_ref, io_ms: uint64, tick_ms: uint64, accepted: int64, slot: actor_ref }) {
    sequence
        now: int64 <- lsn_event(msg, st)
    produces pure (:no_reply, { reaper: st.reaper, io_ms: st.io_ms, tick_ms: st.tick_ms, accepted: st.accepted + now, slot: st.slot }) end
}

// ======================================================================== slot
// N2c: one SLOT per peer line (a chain: the head is `slot` of the lsn and of every conn, a message for peer k is passed along until
// the slot with that k takes it). A slot keeps who owns the peer's registered names: `cur` (its tx and conn) and, while a newer
// connection of the same peer waits, `pend`. Messages (:bees, op, k, tx, conn):
//   4 claim(k, tx, conn)   from a conn that has just learned its peer (or from lsn when the table has one peer): nobody owns the names ->
//                          the claimant gets go (conn kind 100 + k) at once; else the claimant waits as pend (a pend already waiting is
//                          told to end), and the owner is told to end (conn kind 7, replaced)
//   2 gone(k)             from the reaper of the owner's proxies, AFTER it has ended them (kill_abnormal): the names are free, so pend
//                          (if any) becomes the owner and gets go; else nobody owns them
//   1 ended(tx, conn)     from a tx whose link ended while its reaper was still the slot, i.e. before it ever started proxies (see
//                          tx kind 3): if it is cur that is a gone; if it is pend it is just dropped; at the end of the chain, a link
//                          nobody owns. Every link that ends is RELEASED once (conn kind 9) when the slot has dropped it (N2c teardown)
// The order that keeps the registered names from clashing: a new link's proxies start ONLY on its go, and go is sent ONLY when the
// old owner's reaper has reported (gone), or when nobody owned the names.
fn cmd(c: actor_ref, kind: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(c, (:bees, kind, "", "", :ok) impl ActorMessage {})
    produces pure ok end
}
fn slot_fwd(st: { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }, op: int64, k: int64, t: actor_ref, c: actor_ref) -> { ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean } {
    sequence proc[concurrency]
        _: boolean <- case st.last of { true -> true; false -> cast(st.next, (:bees, op, k, t, c) impl ActorMessage {}) }
    produces pure { ct: st.ct, cc: st.cc, pt: st.pt, pc: st.pc, live: st.live, pend: st.pend } end
}
fn slot_claim(st: { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }, t: actor_ref, c: actor_ref) -> { ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean } {
    case st.live of {
        false -> {
            sequence
                _: boolean <- cmd(c, 100 + st.k)
            produces pure { ct: t, cc: c, pt: st.pt, pc: st.pc, live: true, pend: false } end
        };
        true -> {
            sequence
                _: boolean <- case st.pend of { true -> cmd(st.pc, 7); false -> true };
                _: boolean <- cmd(st.cc, 7)
            produces pure { ct: st.ct, cc: st.cc, pt: t, pc: c, live: st.live, pend: true } end
        }
    }
}
// the owner's names are free (its proxies are ended, or it never had any): release its connection actor (kind 9: nothing here refers to
// it any more, so it may end itself once the carrier has said its last word), then the waiting link, if any, takes the names
fn slot_gone(st: { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }) -> { ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean } {
    case st.pend of {
        true -> {
            sequence
                _: boolean <- cmd(st.cc, 9);
                _: boolean <- cmd(st.pc, 100 + st.k)
            produces pure { ct: st.pt, cc: st.pc, pt: st.pt, pc: st.pc, live: true, pend: false } end
        };
        false -> {
            sequence
                _: boolean <- cmd(st.cc, 9)
            produces pure { ct: st.ct, cc: st.cc, pt: st.pt, pc: st.pc, live: false, pend: false } end
        }
    }
}
fn slot_ended(st: { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }, t: actor_ref, c: actor_ref) -> { ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean } {
    case st.live and st.ct == t of {
        true -> slot_gone(st);
        false -> case st.pend and st.pt == t of {
            true -> {
                sequence
                    _: boolean <- cmd(st.pc, 9)
                produces pure { ct: st.ct, cc: st.cc, pt: st.pt, pc: st.pc, live: st.live, pend: false } end
            };
            false -> case st.last of {
                true -> {
                    sequence
                        _: boolean <- cmd(c, 9)
                    produces pure { ct: st.ct, cc: st.cc, pt: st.pt, pc: st.pc, live: st.live, pend: st.pend } end
                };
                false -> slot_fwd(st, 1, 0, t, c)
            }
        }
    }
}
fn slot_do(st: { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }, op: int64, k: int64, t: actor_ref, c: actor_ref) -> { ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean } {
    case op of {
        4 -> case k == st.k of { true -> slot_claim(st, t, c); false -> slot_fwd(st, op, k, t, c) };
        2 -> case k == st.k of { true -> slot_gone(st); false -> slot_fwd(st, op, k, t, c) };
        1 -> slot_ended(st, t, c);
        _: int64 -> { ct: st.ct, cc: st.cc, pt: st.pt, pc: st.pc, live: st.live, pend: st.pend }
    }
}
fn slot(
    msg: (:bees, int64, int64, actor_ref, actor_ref),
    st: { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }
) -> (:no_reply, { k: int64, next: actor_ref, last: boolean, ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean }) {
    sequence
        s: { ct: actor_ref, cc: actor_ref, pt: actor_ref, pc: actor_ref, live: boolean, pend: boolean } <- case msg of {
            (:bees, op: int64, k: int64, t: actor_ref, c: actor_ref) -> slot_do(st, op, k, t, c)
        }
    produces pure (:no_reply, { k: st.k, next: st.next, last: st.last, ct: s.ct, cc: s.cc, pt: s.pt, pc: s.pc, live: s.live, pend: s.pend }) end
}

