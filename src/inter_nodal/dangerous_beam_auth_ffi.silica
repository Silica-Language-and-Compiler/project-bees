// BEAM mode (N2): the foreign bindings of the cookie edge (native/src/silica_bees_beam.c, sidecar
// native/dangerous_exposure_source/beam/) and their adapters, in the shape of the language's dangerous_sockets: each adapter
// binds the foreign result before returning it (a foreign call in tail position faults, SD-15). Called only from the worker
// dangerous_beam_auth@auth, inside its external_danger sequence. Every result is tainted; the worker re-creates the scalars
// with the language's recreate before anything leaves it.
module dangerous_beam_auth_ffi;

wrapper_meta "dangerous_exposure_source/beam/silica_bees_beam_wrapper.meta";

export load_cookie/1;
export challenge/0;
export digest/1;
export digest_word/1;

foreign c_wrapper "bees_beam_load_cookie"
fn load_cookie_raw(path_ptr: uint8, path_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "bees_beam_challenge"
fn challenge_raw(unused: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "bees_beam_digest"
fn digest_raw(challenge: int64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "bees_beam_digest_word"
fn digest_word_raw(i: int64) -> { tag: int64, value: int64, error_code: int64 };

fn load_cookie(path: string) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- load_cookie_raw(path);
    r
}

fn challenge() -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- challenge_raw(0);
    r
}

fn digest(c: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- digest_raw(c);
    r
}

fn digest_word(i: int64) -> { tag: int64, value: int64, error_code: int64 } {
    r: { tag: int64, value: int64, error_code: int64 } <- digest_word_raw(i);
    r
}
