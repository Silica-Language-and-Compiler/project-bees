module bees_etf_term;
// GENERATED by tools/gen_bees_etf.py; edit the template there.
//
// bees_term <-> ETF (BEES MVP milestone M1b; the validator and the pid codec are in bees_etf). A frame is 131 and one
// term; `decode` allocates nothing unless the whole frame passes `bees_etf@validate`, so a hostile frame costs no heap
// (a rejected frame returns :none and the reason is `bees_etf@validate`). Cells: bees_term's tags 0 nil, 1 int, 2 float,
// 3 atom, 5 cons, 6 tuple, 7 binary. Atoms come from bees_atoms only (D30). Not representable, so rejected :unsupported
// by the decoder and by the encoder: maps, funs, references, ports, a local actor_ref (tag 4), bit binaries.
//
// A REMOTE PID is BEES's own value, the tuple { bees_remote_pid, Node, Id, Serial, Creation } (the marker atom is
// declared in bees_etf.atoms): NEW_PID_EXT and PID_EXT decode to it and a tuple of exactly that shape (an atom node, three
// integers 0..2^32-1) encodes as NEW_PID_EXT. A tuple with that marker and any other shape is :bad_variant on encode.
//
// Two walks per decode (validate, then build) and one `end_of` per child while building: the work is O(depth x size),
// at most 16 x 4096 bytes. The terms are built by recursion, so the heap holds exactly the term.
use bees_atoms;
use bees_term;
use bees_wire;
use bees_wire_ints;
use bees_etf;

export decode/4;
export dec_term/5;
export enc/3;
export enc_term/5;

fn bi(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64) -> int64 { bees_wire@bi(rg, b, i) }
fn u32(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64) -> int64 { bees_wire@rd_u32(rg, b, i) }

// ================================================================ decode
fn decode(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case bees_etf@validate(rg, b, len) == 0 of {
        true -> dec_term(h, rg, b, len, 1);
        false -> :none
    }
}
// the term at pos, which `bees_etf@check` has accepted
fn dec_term(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) { mk_term(h, rg, b, len, pos, bi(rg, b, pos)) }
fn mk_term(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64, tag: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case tag of {
        97 -> mk_int_at(h, rg, b, len, pos);
        98 -> mk_int_at(h, rg, b, len, pos);
        110 -> mk_int_at(h, rg, b, len, pos);
        70 -> mk_float_at(h, rg, b, len, pos);
        100 -> mk_atom_at(h, rg, b, len, pos);
        115 -> mk_atom_at(h, rg, b, len, pos);
        118 -> mk_atom_at(h, rg, b, len, pos);
        119 -> mk_atom_at(h, rg, b, len, pos);
        106 -> bees_term@mk_nil(h);
        107 -> mk_str_at(h, rg, b, pos);
        108 -> mk_list_items(h, rg, b, len, pos + 5, u32(rg, b, pos + 1));
        109 -> bees_term@mk_binary(h, u32(rg, b, pos + 1), mk_bytes(h, rg, b, pos + 5, u32(rg, b, pos + 1)));
        104 -> mk_tuple_at(h, rg, b, len, pos + 2, bi(rg, b, pos + 1));
        105 -> mk_tuple_at(h, rg, b, len, pos + 5, u32(rg, b, pos + 1));
        88 -> mk_pid_term(h, rg, b, len, pos);
        103 -> mk_pid_term(h, rg, b, len, pos);
        _: int64 -> bees_term@mk_nil(h)
    }
}
fn mk_int_at(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        r: { v: int64, pos: int64 } <- bees_wire_ints@dec_int64(rg, b, len, pos);
        n: int64 <- r.v
    produces pure bees_term@mk_int(h, n) end
}
// the float is returned by a function of its own and bound from the call: binding it from a field of the decode result in
// the same sequence stores 0.0 in the cell (the SD-26 family; see the M1b note)
fn float_at(rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64) -> float64 {
    sequence
        r: { v: float64, pos: int64 } <- bees_wire@dec_f64(rg, b, len, pos);
        x: float64 <- r.v
    produces pure x end
}
fn mk_float_at(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        x: float64 <- float_at(rg, b, len, pos)
    produces pure bees_term@mk_float(h, x) end
}
fn mk_atom_at(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    sequence
        r: { v: atom, pos: int64 } <- bees_wire@dec_atom(rg, b, len, pos);
        a: atom <- r.v
    produces pure bees_term@mk_atom(h, a) end
}
// n byte cells (a binary's bytes, or a STRING_EXT's elements) starting at p
fn mk_bytes(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), p: int64, n: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case n <= 0 of {
        true -> bees_term@mk_nil(h);
        false -> bees_term@mk_cons(h, bees_term@mk_int(h, bi(rg, b, p)), mk_bytes(h, rg, b, p + 1, n - 1))
    }
}
fn mk_str_at(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) { mk_bytes(h, rg, b, pos + 3, bi(rg, b, pos + 1) * 256 + bi(rg, b, pos + 2)) }
// n elements from p, then the tail term (NIL_EXT for a proper list)
fn mk_list_items(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, p: int64, n: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case n <= 0 of {
        true -> dec_term(h, rg, b, len, p);
        false -> bees_term@mk_cons(h, dec_term(h, rg, b, len, p), mk_list_items(h, rg, b, len, bees_etf@end_of(rg, b, len, p), n - 1))
    }
}
fn mk_elems(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, p: int64, n: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    case n <= 0 of {
        true -> bees_term@mk_nil(h);
        false -> bees_term@mk_cons(h, dec_term(h, rg, b, len, p), mk_elems(h, rg, b, len, bees_etf@end_of(rg, b, len, p), n - 1))
    }
}
// the arity n and the position of the first element
fn mk_tuple_at(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, first: int64, n: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) { bees_term@mk_tuple(h, n, mk_elems(h, rg, b, len, first, n)) }
fn mk_pid_term(h: { r: region(L, normal) }, rg: region(L, normal), b: buf(L, normal, uint8, 4096), len: int64, pos: int64) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) {
    bees_term@mk_tuple(h, 5, bees_term@mk_cons(h, bees_term@mk_atom(h, bees_atoms@a_bees_remote_pid()),
        bees_term@mk_cons(h, bees_term@mk_atom(h, bees_etf@dec_pid_node(rg, b, len, pos)),
        bees_term@mk_cons(h, bees_term@mk_int(h, bees_etf@dec_pid_id(rg, b, len, pos)),
        bees_term@mk_cons(h, bees_term@mk_int(h, bees_etf@dec_pid_serial(rg, b, len, pos)),
        bees_term@mk_cons(h, bees_term@mk_int(h, bees_etf@dec_pid_creation(rg, b, len, pos)), bees_term@mk_nil(h)))))))
}

// ================================================================ encode
// the frame length in bytes, or the negated reason
fn enc(rg: region(L, normal), b: buf(L, normal, uint8, 4096), t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 { bees_wire@finish(rg, b, enc_term(rg, b, bees_wire@put_hdr(rg, b), t, 0)) }
fn enc_term(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))), depth: int64) -> int64 {
    case pos < 0 of {
        true -> pos;
        false -> enc_tag(rg, b, pos, t, depth, bees_term@tag(t))
    }
}
fn enc_tag(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))), depth: int64, tag: int64) -> int64 {
    case tag of {
        0 -> bees_wire@put_nil(rg, b, pos);
        1 -> bees_wire_ints@enc_int64(rg, b, pos, bees_term@int_of(t));
        2 -> enc_float(rg, b, pos, t);
        3 -> bees_wire@enc_atom(rg, b, pos, bees_term@atom_of(t));
        5 -> enc_list(rg, b, pos, t, depth);
        6 -> enc_tuple(rg, b, pos, t, depth);
        7 -> enc_bin(rg, b, pos, t);
        _: int64 -> 0 - 16
    }
}
fn enc_float(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    sequence
        x: float64 <- bees_term@float_of(t)
    produces pure bees_wire@enc_f64(rg, b, pos, x) end
}
fn enc_elems(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, l: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))), depth: int64) -> int64 {
    case pos < 0 or bees_term@tag(l) != 5 of {
        true -> pos;
        false -> enc_elems(rg, b, enc_term(rg, b, pos, bees_term@hd_of(l), depth), bees_term@tl_of(l), depth)
    }
}
fn is_marker(x: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> boolean { bees_term@tag(x) == 3 and bees_term@atom_of(x) == bees_atoms@a_bees_remote_pid() }
fn is_pid_tuple(t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> boolean { bees_term@arity(t) == 5 and is_marker(bees_term@nth(bees_term@hd_of(t), 0)) }
fn enc_tuple(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))), depth: int64) -> int64 {
    case is_pid_tuple(t) of {
        true -> enc_pid_tuple(rg, b, pos, bees_term@hd_of(t));
        false -> case bees_term@arity(t) > 256 of {
            true -> bees_wire@fail(pos, 7);
            false -> enc_elems(rg, b, bees_wire@put_tuple_hdr(rg, b, bees_wire@enter(pos, depth), bees_term@arity(t)), bees_term@hd_of(t), depth + 1)
        }
    }
}
// el: the five elements (marker, node, id, serial, creation)
fn pid_shape(el: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> boolean {
    bees_term@tag(bees_term@nth(el, 1)) == 3 and bees_term@tag(bees_term@nth(el, 2)) == 1 and bees_term@tag(bees_term@nth(el, 3)) == 1 and bees_term@tag(bees_term@nth(el, 4)) == 1
}
fn enc_pid_tuple(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, el: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    case pid_shape(el) of {
        false -> bees_wire@fail(pos, 11);
        true -> bees_etf@enc_pid(rg, b, pos, bees_term@atom_of(bees_term@nth(el, 1)), bees_term@int_of(bees_term@nth(el, 2)), bees_term@int_of(bees_term@nth(el, 3)), bees_term@int_of(bees_term@nth(el, 4)))
    }
}
// the tail after the cons cells
fn list_tail(t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) { case bees_term@tag(t) == 5 of { true -> list_tail(bees_term@tl_of(t)); false -> t } }
fn small_int(x: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> boolean { bees_term@tag(x) == 1 and bees_term@int_of(x) >= 0 and bees_term@int_of(x) <= 255 }
fn all_small(l: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> boolean {
    case bees_term@tag(l) == 5 of { false -> true; true -> case small_int(bees_term@hd_of(l)) of { true -> all_small(bees_term@tl_of(l)); false -> false } }
}
fn put_small(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, l: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    case pos < 0 or bees_term@tag(l) != 5 of {
        true -> pos;
        false -> put_small(rg, b, bees_wire@put_i(rg, b, pos, bees_term@int_of(bees_term@hd_of(l))), bees_term@tl_of(l))
    }
}
// a proper list of small ints is STRING_EXT, as erl writes it; any other list is LIST_EXT, elements, then the tail
fn enc_list(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))), depth: int64) -> int64 {
    case bees_term@list_len(t) > 256 of {
        true -> bees_wire@fail(pos, 7);
        false -> case bees_term@tag(list_tail(t)) == 0 and all_small(t) of {
            true -> put_small(rg, b, bees_wire@put_string_hdr(rg, b, bees_wire@enter(pos, depth), bees_term@list_len(t)), t);
            false -> enc_term(rg, b, enc_elems(rg, b, bees_wire@put_list_hdr(rg, b, bees_wire@enter(pos, depth), bees_term@list_len(t)), t, depth + 1), list_tail(t), depth + 1)
        }
    }
}
fn enc_bin(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, t: ref?(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> int64 {
    case bees_term@int_of(t) > 1024 of {
        true -> bees_wire@fail(pos, 7);
        false -> case bees_term@list_len(bees_term@hd_of(t)) == bees_term@int_of(t) and all_small(bees_term@hd_of(t)) of {
            false -> bees_wire@fail(pos, 11);
            true -> put_small(rg, b, bees_wire@put_u32(rg, b, bees_wire@put_i(rg, b, pos, 109), bees_term@int_of(t)), bees_term@hd_of(t))
        }
    }
}
