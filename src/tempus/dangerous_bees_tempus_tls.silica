// BEES TEMPUS (T5): the TLS link of a tempus/1 connection, between the language's (:tcp) carrier and TEMPUS's framing
// (development-plan/tempus-design.md sections 4, 5 and 17.6). It is the counterpart of TRUST's link
// (src/trust/dangerous_bees_tls.silica, whose structure, credit rules and teardown order it keeps: read that unit's head for
// why there are two FFI workers per connection and a separate listener), over the same engine
// (dangerous_bees_tls_native, native/tls/silica_bees_tls.c) opened with the TEMPUS profile: open_conn_profile(role, 1, spec),
// ALPN tempus/1, its own contexts, so a node that is both TRUST and TEMPUS holds two credentials.
//
// What differs from TRUST's link:
//   - It uses no generated configuration unit. Its values are in its state, given by whoever spawns it (the application
//     passes values): spec (certfile, NUL, keyfile, NUL, NUL: no CA, a TEMPUS certificate is self-signed over the node's
//     identity key, ruling OQ-2), dial (the carrier's connect budget in milliseconds, as text), hs_ms. In a link (tlnk)
//     hs_ms is the connection's DEADLINE, the monotonic clock's value in ms at which its one bound has passed (ruling
//     NQ-14: shuffle_timeout_ms is one bound from the dial, or the accept, to the close): the handshake is given what
//     is left of it. In the listener (tlnkl) hs_ms is that bound in ms; each accepted link gets its deadline at the accept.
//   - No pin and no whitelist here. A finished handshake is accepted when it shows ALPN tempus/1, a peer certificate,
//     X25519MLKEM768, and a peer certificate whose key is Ed25519 (the engine's peer_key answers; any other key type is
//     refused, tempus_cert_key). TEMPUS connections use the hybrid key exchange only: there is no classical
//     (X25519-only) opt-in, D44's is for whitelisted TRUST peers (ruling NQ-8). Certificate validity dates are not
//     checked: the producer token carries the validity window (ruling NQ-10).
//   - What it hands its owner first, in BOTH roles, before any plaintext of the peer: the peer certificate's raw Ed25519
//     public key (32 bytes), then the SHA-512 of the peer certificate's DER (64 bytes). The connection actor
//     (dangerous_bees_tempus_conn) compares the key with the `pub` of the peer's advert (the channel binding: without it a
//     node in the middle with its own certificate could relay an advert and its proof) and looks the fingerprint up in the
//     `tempus` whitelist (bridges and sentinels, rulings OQ-3 and NQ-4).
// Actors: tlnk the link (role 0 a client started by (:open, owner, "host:port"); role 2 an accepted connection), tlnkw its
// writer, tlnkl the listener. Upward the carrier contract, message for message, as TRUST's link. Audit lines are written
// by the owner: (:bees, 11, event, what, 0) before the :link_up or :link_down the line explains.
module dangerous_bees_tempus_tls;
use dangerous_bees_tls_native;
use dangerous_tcp_carrier;

export tlnk/2;
export tlnkw/2;
export tlnkl/2;

fn starts(s: string, p: string) -> boolean {
    length_bytes(s) >= length_bytes(p) and substring(s, 0, length_bytes(p)) == p
}

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn none_res() -> { tag: int64, value: int64, error_code: int64 } {
    { tag: 2, value: 0 - 1, error_code: 0 }
}

fn m_kind(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout) -> atom {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> :open;
        (:tx, _s: string, _f: actor_ref) -> :tx;
        (:credit, _n: int64) -> :credit;
        :close -> :close;
        (:link_up, _i: string) -> :link_up;
        (:accepted, _c: dangerous_actor_ref, _i2: string) -> :accepted;
        (:rx, _r: string) -> :rx;
        (:tx_credit, _k: int64) -> :tx_credit;
        (:tx_failed, _w: atom) -> :tx_failed;
        (:link_down, _w2: atom) -> :link_down;
        :poll -> :poll;
        :timeout -> :timeout
    }
}

fn m_text(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout) -> string {
    case msg of {
        (:open, _o: actor_ref, a: string) -> a;
        (:tx, s: string, _f: actor_ref) -> s;
        (:credit, _n: int64) -> "";
        :close -> "";
        (:link_up, i: string) -> i;
        (:accepted, _c: dangerous_actor_ref, i2: string) -> i2;
        (:rx, r: string) -> r;
        (:tx_credit, _k: int64) -> "";
        (:tx_failed, _w: atom) -> "";
        (:link_down, _w2: atom) -> "";
        :poll -> "";
        :timeout -> ""
    }
}

fn m_count(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout) -> int64 {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> 0;
        (:tx, _s: string, _f: actor_ref) -> 0;
        (:credit, n: int64) -> n;
        :close -> 0;
        (:link_up, _i: string) -> 0;
        (:accepted, _c: dangerous_actor_ref, _i2: string) -> 0;
        (:rx, _r: string) -> 0;
        (:tx_credit, _k: int64) -> 0;
        (:tx_failed, _w: atom) -> 0;
        (:link_down, _w2: atom) -> 0;
        :poll -> 0;
        :timeout -> 0
    }
}

fn m_txc(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout) -> int64 {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> 0;
        (:tx, _s: string, _f: actor_ref) -> 0;
        (:credit, _n: int64) -> 0;
        :close -> 0;
        (:link_up, _i: string) -> 0;
        (:accepted, _c: dangerous_actor_ref, _i2: string) -> 0;
        (:rx, _r: string) -> 0;
        (:tx_credit, k: int64) -> k;
        (:tx_failed, _w: atom) -> 0;
        (:link_down, _w2: atom) -> 0;
        :poll -> 0;
        :timeout -> 0
    }
}

fn m_owner(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout, fallback: actor_ref) -> actor_ref {
    case msg of {
        (:open, o: actor_ref, _a: string) -> o;
        (:tx, _s: string, _f: actor_ref) -> fallback;
        (:credit, _n: int64) -> fallback;
        :close -> fallback;
        (:link_up, _i: string) -> fallback;
        (:accepted, _c: dangerous_actor_ref, _i2: string) -> fallback;
        (:rx, _r: string) -> fallback;
        (:tx_credit, _k: int64) -> fallback;
        (:tx_failed, _w: atom) -> fallback;
        (:link_down, _w2: atom) -> fallback;
        :poll -> fallback;
        :timeout -> fallback
    }
}

fn m_why(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout) -> atom {
    case msg of {
        (:open, _o: actor_ref, _a: string) -> :closed;
        (:tx, _s: string, _f: actor_ref) -> :closed;
        (:credit, _n: int64) -> :closed;
        :close -> :closed;
        (:link_up, _i: string) -> :closed;
        (:accepted, _c: dangerous_actor_ref, _i2: string) -> :closed;
        (:rx, _r: string) -> :closed;
        (:tx_credit, _k: int64) -> :closed;
        (:tx_failed, _w: atom) -> :closed;
        (:link_down, w2: atom) -> w2;
        :poll -> :closed;
        :timeout -> :closed
    }
}

// the audit event of an engine refusal (inter-nodal-modes 3.11 names alpn_mismatch and tls_verify_failed)
fn refusal_event(code: int64) -> string {
    case code of {
        2 -> "tls_verify_failed";
        3 -> "tls_verify_failed";
        4 -> "alpn_mismatch";
        6 -> "tls_identity_error";
        8 -> "tls_group_refused";
        10 -> "tempus_cert_key";
        9 -> "tls_engine_refused";
        _: int64 -> "tls_handshake_failed"
    }
}
fn refusal_text(code: int64) -> string {
    case code of {
        1 -> "the TLS 1.3 handshake failed (alert, version, group, suite or signature outside the tempus/1 profile)";
        2 -> "the peer certificate did not pass the engine's check";
        3 -> "the peer presented no certificate";
        4 -> "the peer did not agree on ALPN tempus/1";
        6 -> "this node's TEMPUS certificate or key could not be loaded";
        8 -> "the connection did not negotiate X25519MLKEM768, the only key exchange of the tempus/1 profile";
        10 -> "the peer certificate's key is not Ed25519";
        7 -> "the connection table is full";
        9 -> "the OpenSSL found at run time is older than 4.1.0, the minimum";
        _: int64 -> "engine error"
    }
}
// the names of what the engine reports (bees_tls_facts): the negotiated group as OpenSSL answers it (an OpenSSL NID, or
// 0x1000000 plus the IANA id for a group OpenSSL has no NID for: X25519MLKEM768 is 0x10011EC = 16781804, x25519 is NID 1034),
// and the suite's IANA id (0x1302 = 4866 TLS_AES_256_GCM_SHA384, 0x1303 = 4867 TLS_CHACHA20_POLY1305_SHA256)
fn group_text(g: int64) -> string { case g of { 16781804 -> "X25519MLKEM768"; 1034 -> "X25519"; _: int64 -> "other-group" } }
fn suite_text(s: int64) -> string { case s of { 4866 -> "TLS_AES_256_GCM_SHA384"; 4867 -> "TLS_CHACHA20_POLY1305_SHA256"; _: int64 -> "other-suite" } }
fn role_text(r: int64) -> string { case r == 2 of { true -> "server"; false -> "client" } }
// what a finished handshake must show, judged here on the engine's facts: 0 accepted, or the refusal code (4 not ALPN
// tempus/1, 3 no peer certificate, 2 the engine's verify result is not 0, 8 a group that is not X25519MLKEM768, 10 a peer
// certificate whose key is not Ed25519)
fn post_handshake_code(facts: int64, key_ok: boolean) -> int64 {
    case facts % 2 == 0 of {
        true -> 4;
        false -> case (facts / 2) % 2 == 0 of {
            true -> 3;
            false -> case (facts / 4) % 256 != 0 of {
                true -> 2;
                false -> case facts / 67108864 != 16781804 of {
                    true -> 8;
                    false -> case key_ok of { true -> 0; false -> 10 }
                }
            }
        }
    }
}
fn established_text(role: int64, facts: int64) -> string {
    concat(concat(concat("TLSv1.3 ", group_text(facts / 67108864)), concat(" ", suite_text((facts / 1024) % 65536))),
        concat(" alpn tempus/1, mutual, as ", role_text(role)))
}
// The worker may not print (E2103: external_danger-touched data and device_io never share a sequence), so its audit lines are
// written by its owner: (:bees, 11, event, what, 0), pure text built from re-created codes, before the :link_up or :link_down
// the line explains (dangerous_bees_trust@tconn c_bees 11, tcli k_bees 11), so the order with TRUST's own lines is fixed.
fn tell_audit(owner: actor_ref, event: string, what: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(owner, (:bees, 11, event, what, 0) impl ActorMessage {})
    produces pure ok end
}

// ======================================================================== tlnk, the link
// The state: the owner, the carrier, the writer (the carrier stands in until it is spawned; never cast to before), the
// engine's handle, the role, the phase (0 fresh, 1 waiting for the carrier, 2 handshake, 3 up, 4 closing), the owner's
// receive credit, whether the carrier holds a credit of the link's, what was handed up of the peer certificate (0 nothing,
// 1 its key, 2 its fingerprint too), whether the owner was told the link is down, and the three values of the head.
fn tlnk(msg: (:open, actor_ref, string) | (:tx, string, actor_ref) | (:credit, int64) | :close | (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | :poll | :timeout, st: { owner: actor_ref, car: dangerous_actor_ref, w: dangerous_actor_ref, h: int64, role: int64, phase: int64, credit: int64, car_out: boolean, sent: int64, told: boolean, spec: string, dial: string, hs_ms: uint64 }) -> (:no_reply, { owner: actor_ref, car: dangerous_actor_ref, w: dangerous_actor_ref, h: int64, role: int64, phase: int64, credit: int64, car_out: boolean, sent: int64, told: boolean, spec: string, dial: string, hs_ms: uint64 }) {
    sequence proc[external_danger, concurrency, transport]
        me: actor_ref <- self();
        kind: atom <- m_kind(msg);
        text: string <- m_text(msg);
        owner: actor_ref <- m_owner(msg, st.owner);
        // ---- :open from the owner: the writer is started and the carrier opened (or adopted) for this link
        fresh: boolean <- kind == :open and st.phase == 0;
        do_dial: boolean <- fresh and st.role == 0;
        do_adopt: boolean <- fresh and st.role == 2;
        w: dangerous_actor_ref <- case do_dial or do_adopt of {
            true -> {
                sequence proc[concurrency]
                    nw: dangerous_actor_ref <- spawn_dangerous({ car: st.car, h: 0 - 1, inflight: false, closing: false, aborting: false, closed: false }, tlnkw, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
                produces pure nw end
            };
            false -> st.w
        };
        has_w: boolean <- st.phase != 0 or do_dial or do_adopt;
        ctext: string <- case do_adopt of { true -> ""; false -> concat(concat(text, ":"), st.dial) };
        _: boolean <- case fresh of {
            true -> cast(st.car, (:open, me, ctext) impl ActorMessage {});
            false -> true
        };
        // ---- the carrier is up: the handshake starts (a client's ClientHello is ready for the writer at once)
        car_up: boolean <- kind == :link_up and st.phase == 1;
        // the OpenSSL minimum-version rule (contract/what-is-required-to-use.md: 4.1.0, 0x40100000 = 1074790400, no exception):
        // the engine reports the version of the library loaded at run time, this link refuses anything older
        res_ver: { tag: int64, value: int64, error_code: int64 } <- case car_up of {
            true -> dangerous_bees_tls_native@openssl_version();
            false -> none_res()
        };
        ver_raw: int64 <- res_ver.value;
        ver: int64 <- pure_int(recreate(ver_raw));
        engine_ok: boolean <- ver >= 1074790400;
        res_open: { tag: int64, value: int64, error_code: int64 } <- case car_up and engine_ok of {
            true -> dangerous_bees_tls_native@open_conn_profile(case st.role == 2 of { true -> 2; false -> 1 }, 1, st.spec);
            false -> none_res()
        };
        open_tag_raw: int64 <- res_open.tag;
        open_h_raw: int64 <- res_open.value;
        open_code_raw: int64 <- res_open.error_code;
        open_tag: int64 <- pure_int(recreate(open_tag_raw));
        open_h: int64 <- pure_int(recreate(open_h_raw));
        open_code: int64 <- pure_int(recreate(open_code_raw));
        opened: boolean <- car_up and engine_ok and open_tag == 0;
        open_failed: boolean <- car_up and opened == false;
        h: int64 <- case opened of { true -> open_h; false -> st.h };
        // ---- ciphertext from the carrier
        got_rx: boolean <- kind == :rx;
        do_feed: boolean <- got_rx and (st.phase == 2 or st.phase == 3);
        res_feed: { tag: int64, value: int64, error_code: int64 } <- case do_feed of {
            true -> dangerous_bees_tls_native@feed(h, text);
            false -> none_res()
        };
        feed_tag_raw: int64 <- res_feed.tag;
        feed_bits_raw: int64 <- res_feed.value;
        feed_code_raw: int64 <- res_feed.error_code;
        feed_tag: int64 <- pure_int(recreate(feed_tag_raw));
        bits: int64 <- pure_int(recreate(feed_bits_raw));
        feed_code: int64 <- pure_int(recreate(feed_code_raw));
        hs_failed: boolean <- do_feed and st.phase == 2 and feed_tag != 0;
        hs_finished: boolean <- do_feed and st.phase == 2 and feed_tag == 0 and bits % 4 == 1;
        hs_more: boolean <- do_feed and st.phase == 2 and feed_tag == 0 and bits % 4 == 0;
        cipher_ready: boolean <- do_feed and feed_tag == 0 and (bits / 4) % 2 == 1;
        // ---- the handshake finished: this link judges what it shows (the engine only reports it)
        res_facts: { tag: int64, value: int64, error_code: int64 } <- case hs_finished of {
            true -> dangerous_bees_tls_native@facts(h);
            false -> none_res()
        };
        facts_raw: int64 <- res_facts.value;
        facts: int64 <- pure_int(recreate(facts_raw));
        // the peer certificate's key must be Ed25519 (asked of the engine now; its bytes go up later, on the owner's credit)
        res_hkey: { tag: int64, value: int64, error_code: int64 } <- case hs_finished of {
            true -> dangerous_bees_tls_native@peer_key(h);
            false -> none_res()
        };
        hkey_tag_raw: int64 <- res_hkey.tag;
        key_ok: boolean <- pure_int(recreate(hkey_tag_raw)) == 0;
        // ---- bytes for the owner: on its credit, on :poll, and after ciphertext arrived (phase 3). First the peer
        // certificate's key (32 bytes), then its SHA-512 fingerprint (64 bytes), then the peer's plaintext
        credit1: int64 <- st.credit + m_count(msg);
        do_read: boolean <- st.phase == 3 and credit1 > 0 and (kind == :credit or kind == :poll or do_feed);
        read_key: boolean <- do_read and st.sent == 0;
        read_fp: boolean <- do_read and st.sent == 1;
        res_id: { tag: int64, value: int64, error_code: int64 } <- case read_key of {
            true -> dangerous_bees_tls_native@peer_key(h);
            false -> case read_fp of {
                true -> dangerous_bees_tls_native@peer_fp(h);
                false -> none_res()
            }
        };
        id_tag_raw: int64 <- res_id.tag;
        id_tag: int64 <- pure_int(recreate(id_tag_raw));
        do_plain: boolean <- do_read and st.sent == 2;
        res_read: { tag: int64, value: int64, error_code: int64 } <- case do_plain of {
            true -> dangerous_bees_tls_native@read_plain(h, 0);
            false -> none_res()
        };
        read_tag_raw: int64 <- res_read.tag;
        read_tag: int64 <- pure_int(recreate(read_tag_raw));
        got_id: boolean <- (read_key or read_fp) and id_tag == 0;
        got_plain: boolean <- got_id or (do_plain and read_tag == 0);
        need_cipher: boolean <- do_plain and read_tag == 2;
        // the certificate's bytes cannot fail after the handshake showed them; if they do the link is given up
        peer_ended: boolean <- (do_plain and (read_tag == 1 or read_tag == 3)) or ((read_key or read_fp) and id_tag != 0);
        // ---- the one take of this worker: the bytes for the owner
        bytes_in: string <- case got_plain of {
            true -> dangerous_bees_tls_native@take(h);
            false -> ""
        };
        post_code: int64 <- case hs_finished of { true -> post_handshake_code(facts, key_ok); false -> 0 };
        post_refused: boolean <- hs_finished and post_code != 0;
        hs_done_now: boolean <- hs_finished and post_code == 0;
        // a client that refuses its server does not send its Finished: the server never completes the handshake
        _: { tag: int64, value: int64, error_code: int64 } <- case post_refused of {
            true -> dangerous_bees_tls_native@discard(h);
            false -> none_res()
        };
        // the one tainted cast of this worker: plaintext to the owner
        _: boolean <- case got_plain of {
            true -> cast(owner, (:rx, bytes_in) impl ActorMessage {});
            false -> true
        };
        // ---- the writer: the handle and a flush when the engine has ciphertext; the owner's plaintext and close; the
        // carrier's write acknowledgements
        expired: boolean <- kind == :timeout and st.phase == 2;
        refused: boolean <- open_failed or hs_failed or post_refused;
        give_up: boolean <- refused or expired or peer_ended;
        car_gone: boolean <- kind == :link_down;
        _: boolean <- case opened or (cipher_ready and give_up == false) of {
            true -> cast(w, (:credit, h) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case kind == :tx and st.phase == 3 of {
            true -> cast(w, (:tx, text, me) impl ActorMessage {});
            false -> true
        };
        // the carrier's (:tx_credit, 1) acknowledges one write; its (:tx_credit, 8) at :link_up is a grant, not an acknowledgement
        _: boolean <- case kind == :tx_credit and m_txc(msg) == 1 and has_w of {
            true -> cast(w, (:tx_credit, 1) impl ActorMessage {});
            false -> true
        };
        owner_close: boolean <- kind == :close and (st.phase == 1 or st.phase == 2 or st.phase == 3);
        _: boolean <- case owner_close of {
            true -> cast(w, :close impl ActorMessage {});
            false -> true
        };
        _: boolean <- case give_up of {
            true -> cast(w, :reset impl ActorMessage {});
            false -> true
        };
        // ---- audit lines, written by the owner (E2103)
        code: int64 <- case open_failed of { true -> case engine_ok of { true -> open_code; false -> 9 }; false -> case hs_failed of { true -> feed_code; false -> post_code } };
        _: boolean <- case refused of {
            true -> tell_audit(owner, refusal_event(code), concat(concat(refusal_text(code), ", as "), role_text(st.role)));
            false -> case expired of {
                true -> tell_audit(owner, "timeout", concat("stage tls_handshake, as ", role_text(st.role)));
                false -> case hs_done_now of {
                    true -> tell_audit(owner, "tls_established", established_text(st.role, facts));
                    false -> case car_gone and st.phase == 2 and st.told == false of {
                        true -> tell_audit(owner, "closed_by_peer", concat("stage tls_handshake, as ", role_text(st.role)));
                        false -> true
                    }
                }
            }
        };
        down_why: atom <- case peer_ended and do_plain and read_tag == 3 of { true -> :closed; false -> :fault };
        _: boolean <- case give_up and st.told == false of {
            true -> cast(owner, (:link_down, down_why) impl ActorMessage {});
            false -> true
        };
        // ---- the handshake passed: the owner sees the link come up, as from a carrier
        _: boolean <- case hs_done_now of {
            true -> {
                sequence proc[concurrency]
                    a: boolean <- cast(owner, (:link_up, case st.role == 2 of { true -> "peer:accepted"; false -> "tls:tempus/1" }) impl ActorMessage {});
                    b: boolean <- cast(owner, (:tx_credit, 8) impl ActorMessage {})
                produces pure a and b end
            };
            false -> true
        };
        // ---- receive credit at the carrier: at most one, and only when ciphertext is needed
        car_holds: boolean <- st.car_out and got_rx == false;
        want_cipher: boolean <- opened or hs_more or need_cipher;
        grant: boolean <- want_cipher and car_holds == false and give_up == false and owner_close == false;
        _: boolean <- case grant of {
            true -> cast(st.car, (:credit, 1) impl ActorMessage {});
            false -> true
        };
        // ---- the handshake is bounded by what is left of the connection's one bound (ruling NQ-14: hs_ms is the deadline,
        // the monotonic clock's value in ms); more plaintext may be waiting after a delivery
        _: boolean <- case opened of {
            true -> {
                sequence proc[concurrency]
                    mono: int64 <- monotonic_time();
                    now_ms: uint64 <- to_uint64(mono / 1000000);
                    left: uint64 <- case st.hs_ms > now_ms of { true -> st.hs_ms - now_ms; false -> 0 };
                    _: timer_ref <- send_after(left, me, :timeout impl ActorMessage {})
                produces pure true end
            };
            false -> true
        };
        credit2: int64 <- case got_plain of { true -> credit1 - 1; false -> credit1 };
        _: boolean <- case got_plain and credit2 > 0 of {
            true -> cast(me, :poll impl ActorMessage {});
            false -> true
        };
        // ---- the carrier said :link_down and has ended with it: the owner is told unless it was, the writer frees the engine's
        // state and ends, and so does the link
        _: boolean <- case car_gone and st.told == false and st.phase != 0 of {
            true -> cast(owner, (:link_down, m_why(msg)) impl ActorMessage {});
            false -> true
        };
        _: boolean <- case car_gone and has_w of {
            true -> cast(w, (:link_down, m_why(msg)) impl ActorMessage {});
            false -> true
        };
        _: atom <- case car_gone of { true -> stop_self(:normal); false -> :ok };
        phase_next: int64 <- case do_dial or do_adopt of {
            true -> 1;
            false -> case opened of {
                true -> 2;
                false -> case give_up or owner_close or open_failed of {
                    true -> 4;
                    false -> case hs_done_now of { true -> 3; false -> st.phase }
                }
            }
        };
        // every field is bound before the record, so the compiler can prove the state's release (W2300 otherwise: a whole-state
        // copy per dispatch, and a long-lived listener's memory then grew by about 1 MiB per accepted connection, SD-35)
        credit_next: int64 <- case phase_next == 3 of { true -> credit2; false -> 0 };
        car_out_next: boolean <- grant or car_holds;
        told_next: boolean <- st.told or give_up;
        car_next: dangerous_actor_ref <- st.car;
        role_next: int64 <- st.role;
        sent_next: int64 <- case got_id of { true -> st.sent + 1; false -> st.sent };
        spec_next: string <- st.spec;
        dial_next: string <- st.dial;
        hs_next: uint64 <- st.hs_ms
    produces
        pure (:no_reply, { owner: owner, car: car_next, w: w, h: h, role: role_next, phase: phase_next,
            credit: credit_next, car_out: car_out_next, sent: sent_next, told: told_next, spec: spec_next, dial: dial_next, hs_ms: hs_next })
    end
}

// ======================================================================== tlnkw, the writer
fn w_kind(msg: (:tx, string, actor_ref) | (:credit, int64) | :close | (:tx_credit, int64) | (:link_down, atom) | :reset) -> atom {
    case msg of {
        (:tx, _s: string, _f: actor_ref) -> :tx;
        (:credit, _h: int64) -> :credit;
        :close -> :close;
        (:tx_credit, _n: int64) -> :tx_credit;
        (:link_down, _w: atom) -> :link_down;
        :reset -> :reset
    }
}
fn w_text(msg: (:tx, string, actor_ref) | (:credit, int64) | :close | (:tx_credit, int64) | (:link_down, atom) | :reset) -> string {
    case msg of {
        (:tx, s: string, _f: actor_ref) -> s;
        (:credit, _h: int64) -> "";
        :close -> "";
        (:tx_credit, _n: int64) -> "";
        (:link_down, _w: atom) -> "";
        :reset -> ""
    }
}
fn w_handle(msg: (:tx, string, actor_ref) | (:credit, int64) | :close | (:tx_credit, int64) | (:link_down, atom) | :reset, fallback: int64) -> int64 {
    case msg of {
        (:tx, _s: string, _f: actor_ref) -> fallback;
        (:credit, h: int64) -> h;
        :close -> fallback;
        (:tx_credit, _n: int64) -> fallback;
        (:link_down, _w: atom) -> fallback;
        :reset -> fallback
    }
}
// Messages, all from its link: (:credit, h) the engine's handle, and a flush; (:tx, plaintext, _) to write; (:tx_credit, _) the
// carrier wrote the last (:tx, ...); :close, close_notify and then the carrier's :close; :reset, the handshake was given up: what
// the engine holds (an alert) and then the carrier's :close; (:link_down, _) the carrier has gone: free the engine's state, end.
// The state: the carrier, the handle, a (:tx, ...) in flight, a close or a reset asked for, the carrier closed.
fn tlnkw(msg: (:tx, string, actor_ref) | (:credit, int64) | :close | (:tx_credit, int64) | (:link_down, atom) | :reset, st: { car: dangerous_actor_ref, h: int64, inflight: boolean, closing: boolean, aborting: boolean, closed: boolean }) -> (:no_reply, { car: dangerous_actor_ref, h: int64, inflight: boolean, closing: boolean, aborting: boolean, closed: boolean }) {
    sequence proc[external_danger, concurrency, transport]
        me: actor_ref <- self();
        kind: atom <- w_kind(msg);
        h: int64 <- w_handle(msg, st.h);
        gone: boolean <- kind == :link_down;
        inflight: boolean <- st.inflight and kind != :tx_credit;
        closing: boolean <- st.closing or kind == :close;
        aborting: boolean <- st.aborting or kind == :reset;
        live: boolean <- h >= 0 and st.closed == false and gone == false;
        res_write: { tag: int64, value: int64, error_code: int64 } <- case kind == :tx and live and closing == false and aborting == false of {
            true -> dangerous_bees_tls_native@write_plain(h, w_text(msg));
            false -> none_res()
        };
        can_send: boolean <- inflight == false and st.closed == false and gone == false;
        notify: boolean <- can_send and closing and aborting == false and h >= 0;
        res_out: { tag: int64, value: int64, error_code: int64 } <- case notify of {
            true -> dangerous_bees_tls_native@close_conn(h);
            false -> case can_send and h >= 0 of {
                true -> dangerous_bees_tls_native@pull(h);
                false -> none_res()
            }
        };
        n_raw: int64 <- res_out.value;
        n: int64 <- pure_int(recreate(n_raw));
        go_out: boolean <- (notify or (can_send and h >= 0)) and n > 0;
        cipher: string <- case go_out of {
            true -> dangerous_bees_tls_native@take(h);
            false -> ""
        };
        // the one tainted cast of this worker: ciphertext to the carrier, one write in flight at a time
        _: boolean <- case go_out of {
            true -> cast(st.car, (:tx, cipher, me) impl ActorMessage {});
            false -> true
        };
        // nothing more to send: a close or a reset closes the carrier now
        close_now: boolean <- (closing or aborting) and can_send and go_out == false;
        _: boolean <- case close_now of {
            true -> cast(st.car, :close impl ActorMessage {});
            false -> true
        };
        _: { tag: int64, value: int64, error_code: int64 } <- case gone and st.h >= 0 of {
            true -> dangerous_bees_tls_native@free_conn(st.h);
            false -> none_res()
        };
        _: atom <- case gone of { true -> stop_self(:normal); false -> :ok }
    produces
        pure (:no_reply, { car: st.car, h: case notify or gone of { true -> 0 - 1; false -> h }, inflight: inflight or go_out,
            closing: closing, aborting: aborting, closed: st.closed or close_now })
    end
}

// ======================================================================== tlnkl, the listener
fn l_act(msg: (:open, actor_ref, string) | :close | (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), st: { owner: actor_ref, car: dangerous_actor_ref, spec: string, dial: string, hs_ms: uint64 }, me: actor_ref) -> actor_ref {
    case msg of {
        (:open, o: actor_ref, a: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(st.car, (:open, me, a) impl ActorMessage {})
            produces pure o end
        };
        :close -> { sequence proc[concurrency] _: boolean <- cast(st.car, :close impl ActorMessage {}) produces pure st.owner end };
        (:link_up, i: string) -> { sequence proc[concurrency] _: boolean <- cast(st.owner, (:link_up, i) impl ActorMessage {}) produces pure st.owner end };
        (:accepted, fd: int64, _i2: string) -> {
            sequence proc[concurrency]
                // the listener hands over the accepted descriptor and starts no actor (the standard library's contract
                // since 2026-11-20): the connection's carrier is started here, unsupervised, as the listener used to
                c: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: fd, rx_credit: 0, up: false, listening: false, link_spec: "" }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                // the accepted connection's one bound begins here (ruling NQ-14): its link gets the deadline
                mono: int64 <- monotonic_time();
                dl: uint64 <- to_uint64(mono / 1000000) + st.hs_ms;
                l: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), car: c, w: c, h: 0 - 1, role: 2, phase: 0, credit: 0, car_out: false, sent: 0, told: false, spec: st.spec, dial: st.dial, hs_ms: dl }, tlnk, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
                _: boolean <- cast(st.owner, (:accepted, l, "peer:accepted") impl ActorMessage {})
            produces pure st.owner end
        };
        (:rx, _r: string) -> st.owner;
        (:tx_credit, _k: int64) -> st.owner;
        (:tx_failed, _w: atom) -> st.owner;
        (:link_down, w2: atom) -> { sequence proc[concurrency] _: boolean <- cast(st.owner, (:link_down, w2) impl ActorMessage {}) produces pure st.owner end }
    }
}
// The listening link: (:open, owner, "listen:...") from the node opens its carrier; the carrier's (:link_up, "port:N") and
// (:link_down, _) go to the owner; every accepted connection gets its own carrier, started here from the descriptor the
// listening carrier hands over, and its own link (role 2). The state is the owner and the carrier.
fn tlnkl(msg: (:open, actor_ref, string) | :close | (:link_up, string) | (:accepted, int64, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), st: { owner: actor_ref, car: dangerous_actor_ref, spec: string, dial: string, hs_ms: uint64 }) -> (:no_reply, { owner: actor_ref, car: dangerous_actor_ref, spec: string, dial: string, hs_ms: uint64 }) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        owner: actor_ref <- l_act(msg, st, me);
        car: dangerous_actor_ref <- st.car;
        spec: string <- st.spec;
        dial: string <- st.dial;
        hs: uint64 <- st.hs_ms
    produces pure (:no_reply, { owner: owner, car: car, spec: spec, dial: dial, hs_ms: hs }) end
}

