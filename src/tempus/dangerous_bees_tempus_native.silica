// BEES TEMPUS (T4): the Silica face of the TEMPUS native edge (native/tempus/silica_bees_tempus.c; sidecar
// dangerous_exposure_source/tempus/): the system clock (ruling NQ-11), and Ed25519 verify, sign and public key, and SHA-512, over the programmer-installed OpenSSL
// (hosted platforms only: development-plan/tempus-design.md NQ-6). The raw bindings are called only through the bound-first
// adapters below, and the adapters only from the edge worker's external_danger sequence (dangerous_bees_tempus_edge@ted), so
// every result is FFI-derived: bytes come back as one ETF binary that the receiving actor converts with the language's
// decode((:etf), ...), and a verdict as a number the receiving actor only compares.
// Each function takes ONE byte string (SD-30): several inputs travel concatenated, each of a fixed length except the last.
module dangerous_bees_tempus_native;

wrapper_meta "dangerous_exposure_source/tempus/silica_bees_tempus_wrapper.meta";

export verify/1;
export sign_etf/1;
export public_etf/1;
export sha512_etf/1;
export wall_etf/1;

foreign c_wrapper "bees_tempus_ed25519_verify"
fn verify_raw(in_ptr: uint8, in_len: uint64) -> { tag: int64, value: int64, error_code: int64 };

foreign c_wrapper "bees_tempus_ed25519_sign"
fn sign_raw(in_ptr: uint8, in_len: uint64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "bees_tempus_ed25519_public"
fn public_raw(in_ptr: uint8, in_len: uint64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "bees_tempus_sha512"
fn sha512_raw(in_ptr: uint8, in_len: uint64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

foreign c_wrapper "bees_tempus_wall_clock"
fn wall_raw(in_ptr: uint8, in_len: uint64) -> { tag: int64, text_ptr: uint8, text_len: uint64, error_code: int64 };

// input: public key (32) || signature (64) || message. 1: the signature is that key's over the message; 0: it is not;
// 2: the input is not of that form
fn verify(input: string) -> int64 {
    r: { tag: int64, value: int64, error_code: int64 } <- verify_raw(input);
    v: int64 <- case r.tag == 0 of { true -> r.value; false -> 2 };
    v
}
// input: private key seed (32) || message. The signature as one ETF binary; empty on a bad input
fn sign_etf(input: string) -> string {
    out: string <- sign_raw(input);
    out
}
// input: private key seed (32). The public key as one ETF binary
fn public_etf(input: string) -> string {
    out: string <- public_raw(input);
    out
}
// the SHA-512 of the input as one ETF binary
fn sha512_etf(input: string) -> string {
    out: string <- sha512_raw(input);
    out
}
// the system clock (ruling NQ-11): the seconds since 1970 as 8 bytes, most significant first, as one ETF binary; empty
// when the operating system gave no time. The input is not read.
fn wall_etf(input: string) -> string {
    out: string <- wall_raw(input);
    out
}
