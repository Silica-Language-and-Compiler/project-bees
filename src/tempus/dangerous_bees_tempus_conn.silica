// BEES TEMPUS (T5, T3): one tempus/1 connection (development-plan/tempus-design.md sections 4, 5, 8 and 10), the `tout`
// and `tin` of section 9 in one behaviour. Its link is the TEMPUS TLS link (dangerous_bees_tempus_tls@tlnk), which speaks
// the carrier contract and hands up, before any byte of the peer, the peer certificate's Ed25519 key (32 bytes) and the
// SHA-512 of its DER (64 bytes).
//
// A connection, the same in both roles until the request (role 0 dialed, role 2 accepted; role 3 is an accepted connection
// beyond the node's inflight_max, role 4 one accepted while the node's system clock cannot be read (ruling NQ-22): when
// its link is up it is closed at once, one audit line, and the node is told nothing):
//   the link comes up; this node's advert goes out at once
//   the 96 identity bytes of the link
//   the peer's advert: its bounds; THE CHANNEL BINDING: the advert's pub must be the key of the peer's TLS certificate
//     (without it a node in the middle with its own certificate could relay an advert and its proof); the token rules that
//     need no key (bees_tempus_admit@pre; a token under another kid is answered with the one key_rotated frame, ruling
//     OQ-10); THE TEMPUS WHITELIST (rulings OQ-3, NQ-4): a peer whose token says tempus_bridge or tempus_sentinel must
//     present a certificate of the whitelist, and a whitelisted certificate must come with such a token; then, by the
//     edge, id == SHA-512(pub) and the producer's signature
//   this node's challenge (32 bytes from the platform's secure source, TRUST's random edge reused); the peer's challenge,
//     answered with this node's signature over nonce || its own token (made by the node's signer actor, the only holder
//     of the private seed); the peer's response, verified by the edge over the nonce sent || the peer's token
//   ADMITTED. Role 0 sends its one request and reads the one reply; role 2 reads the one request, hands it to the node
//     actor and sends the node's reply. Then close.
// Every entry of a received shuffle, shuffle_reply or sample_reply is verified without contact before the node sees the
// frame (ruling OQ-4): the token rules with the store's type, the identity hash, the producer's signature. One entry that
// does not verify refuses the whole frame (section 10).
// Any violation closes with no reply (the one exception is key_rotated) and writes one audit line.
//
// What the node actor (cfg.node) is told, as (:bees, op, s1, s2, cid, m, me):
//   60 the reply of a dialed request (s1: the frame body, entries verified; s2 and m: the admitted peer's descriptor
//      and 4 * (whitelist index + 1) + its type, as in 63)                      61 the dialed connection failed (s1: the event)
//   62 the peer answered key_rotated (s1: the current kid it named)             65 admitted and closed (a dial with no request)
//   63 an admitted peer's request (s1: the frame body; s2: the peer's descriptor as ETF bytes; m: 4 * (whitelist index + 1)
//      + the peer's type). The node answers this actor (:bees, 20, reply_body, "", 0), or (:bees, 21, "", "", 0) to close
//      with no reply. It always answers.
//   64 an accepted connection has closed (the listener's count)
//   67 an accepted peer was refused by this actor (ruling NQ-19; s1: the audit event; m 1: s2 is the peer's descriptor,
//      its id and its token verified; m 0: s2 is the peer's id alone, the SHA-512 of its certificate's key, its token
//      not verified). See report() for which refusals are told. A bridge raises the peer's score; any other node drops it.
// Teardown follows TRUST's connection (dangerous_bees_trust@tconn): the send actor closes the link after what it holds,
// the assembler is stopped, and this actor ends 500 ms later and only when no answer it asked for is still on its way
// (a cast to an ended actor fails its sender on the pinned compiler, SD-43; nothing here depends on that failing).
//
// The values a connection needs are in its state, given by whoever spawns it (cfg; the application passes values):
// node, sig (the signer), edge (dangerous_bees_tempus_edge@ted), rnd (dangerous_bees_trust_edge@trnd), mine (this node's
// advert frame body), mtok (its token), kid and ppub (the current producer key), wl (the tempus whitelist: the SHA-512
// fingerprints as lower-case hex, 128 characters each, concatenated), now (seconds; the node's clock for token checks),
// skew (seconds), count (the store's shuffle length: the most entries a frame may hold), ms (the connection's DEADLINE:
// the value of the monotonic clock, in ms, at which shuffle_timeout_ms has passed since the dial or the accept. Ruling
// NQ-14: one bound from dial to close. The carrier's connect budget, the link's handshake timer and this actor's timer
// are each armed with what is left of it, one after another, so the three stages share the one bound;
// tempus_conn in src/tempus/bees_tempus_link.part turns the caller's shuffle_timeout_ms into this value). While the
// node itself works on an admitted request (phase 16) the bound is the node's: it always answers.
module dangerous_bees_tempus_conn;
use bees_atoms;
use bees_trust_frame;
use bees_tempus_view;
use bees_tempus_frame;
use bees_tempus_admit;
use wireframe;
use carrier;

export tcon/2;
export ttx/2;
export tasm/2;
export tsig/2;
export wl_index/2;

fn b2i(b: boolean) -> int64 { case b of { true -> 1; false -> 0 } }
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn credit(c: dangerous_actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(c, (:credit, n) impl ActorMessage {})
    produces pure ok end
}
fn arm(me: actor_ref, ms: uint64, tag: int64) -> boolean {
    sequence proc[concurrency]
        t: timer_ref <- send_after(ms, me, (:bees, 5, "", "", tag) impl ActorMessage {})
    produces pure true end
}
// the milliseconds from now to a deadline given as the monotonic clock's value in ms (0 when it has passed)
fn left_ms(deadline: uint64) -> uint64 {
    sequence proc[concurrency]
        m: int64 <- monotonic_time();
        now: uint64 <- to_uint64(m / 1000000)
    produces pure case deadline > now of { true -> deadline - now; false -> 0 } end
}
fn str_of(r: (:ok, string) | (:rejected, atom)) -> string {
    case r of { (:ok, s: string) -> s; (:rejected, _w: atom) -> "" }
}
// the bytes an edge answered with (one ETF binary, FFI-derived: read with the language's decode, at most 64 bytes)
fn edge_bytes(etf: string) -> string {
    r: (:ok, string) | (:rejected, atom) <- bees_trust_frame@dec_token_term(etf);
    str_of(r)
}
// the index of a fingerprint (128 hex characters) in the whitelist, or -1
fn wl_from(wl: string, h: string, i: int64) -> int64 {
    case (i + 1) * 128 > length_bytes(wl) of {
        true -> 0 - 1;
        false -> case bees_trust_frame@cut(wl, i * 128, i * 128 + 128) == h of { true -> i; false -> wl_from(wl, h, i + 1) }
    }
}
fn wl_index(wl: string, h: string) -> int64 { wl_from(wl, h, 0) }

// ======================================================================== tsig, the signer
// One per node, the only actor that holds the node's private seed. (2, message, tag, reply_to): the edge signs
// seed || message and answers reply_to (:bees, 32, etf_binary, "", tag). (9, seed, 0, _) replaces the seed (not used yet).
fn tsig(msg: (int64, string, int64, actor_ref), st: { edge: dangerous_actor_ref, seed: string }) -> (:no_reply, { edge: dangerous_actor_ref, seed: string }) {
    sequence proc[concurrency]
        (op: int64, text: string, tag: int64, reply_to: actor_ref) <- msg;
        input: string <- bees_trust_frame@cat2(st.seed, text);
        _: boolean <- case op == 2 of {
            true -> cast(st.edge, (2, input, tag, reply_to) impl ActorMessage {});
            false -> true
        };
        seed: string <- case op == 9 of { true -> text; false -> st.seed }
    produces pure (:no_reply, { edge: st.edge, seed: seed }) end
}

// ======================================================================== tasm, the per-frame assembler (as TRUST's)
fn asm_kind(msg: (:bees, int64, string)) -> int64 { case msg of { (:bees, k: int64, _s: string) -> k } }
fn asm_seg(msg: (:bees, int64, string)) -> string { case msg of { (:bees, _k: int64, s: string) -> s } }
fn unframe_fixed(rx: { mode: atom, expected: int64, pending: string }, seg: string, k: int64) -> (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) {
    b: string <- bees_trust_frame@cat2(rx.pending, seg);
    case length_bytes(b) >= k of {
        true -> (:frame, bees_trust_frame@cut(b, 0, k), { mode: rx.mode, expected: 0, pending: bees_trust_frame@cut(b, k, length_bytes(b)) });
        false -> (:more, { mode: rx.mode, expected: 0, pending: b })
    }
}
fn frame_code(why: atom) -> int64 {
    case why == bees_atoms@a_too_large() of { true -> 5; false -> case why == bees_atoms@a_truncated() of { true -> 2; false -> 4 } }
}
// kind 0 a segment, 1 go (drain what is held), 2 stop. To its core: (:bees, 4, ...) more bytes wanted, (:bees, 1, body, rest, 0)
// a frame and the bytes after it, (:bees, 2, "", "", code) refused before decoding (5 too large: the length is refused as
// soon as it is read, before a byte of the body is stored)
fn tasm(msg: (:bees, int64, string), a: { core: actor_ref, fixed: int64, max: int64, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { core: actor_ref, fixed: int64, max: int64, rx: { mode: atom, expected: int64, pending: string } }) {
    sequence
        k: int64 <- asm_kind(msg);
        un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- case k == 2 of {
            true -> (:rejected, :closed);
            false -> case a.fixed > 0 of {
                true -> unframe_fixed(a.rx, asm_seg(msg), a.fixed);
                false -> wireframe@unframe(a.rx, asm_seg(msg), a.max)
            }
        };
        rx2: { mode: atom, expected: int64, pending: string } <- case un of {
            (:more, r1: { mode: atom, expected: int64, pending: string }) -> {
                sequence proc[concurrency]
                    _: boolean <- cast(a.core, (:bees, 4, "", "", 0) impl ActorMessage {})
                produces pure r1 end
            };
            (:frame, body: string, r2: { mode: atom, expected: int64, pending: string }) -> {
                sequence proc[concurrency]
                    _: boolean <- cast(a.core, (:bees, 1, body, r2.pending, 0) impl ActorMessage {});
                    _: atom <- stop_self(:normal)
                produces pure r2 end
            };
            (:rejected, why: atom) -> {
                sequence proc[concurrency]
                    _: boolean <- case why == :closed of { true -> true; false -> cast(a.core, (:bees, 2, "", "", frame_code(why)) impl ActorMessage {}) };
                    _: atom <- stop_self(:normal)
                produces pure a.rx end
            }
        }
    produces pure (:no_reply, { core: a.core, fixed: a.fixed, max: a.max, rx: rx2 }) end
}
// the frame ceiling of section 8 (D47: a literal)
fn frame_max() -> int64 { 131072 }
fn asm_new(core: actor_ref, fixed: int64, pending: string, go: boolean) -> actor_ref {
    sequence proc[concurrency]
        a: actor_ref <- spawn({ core: core, fixed: fixed, max: frame_max(), rx: { mode: :stream, expected: 0, pending: pending } }, tasm, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- case go of { true -> cast(a, (:bees, 1, "") impl ActorMessage {}); false -> true }
    produces pure a end
}
fn asm_go(a: actor_ref) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(a, (:bees, 1, "") impl ActorMessage {})
    produces pure ok end
}
fn asm_stop(a: actor_ref, live: boolean) -> boolean {
    case live of {
        false -> true;
        true -> {
            sequence proc[concurrency]
                ok: boolean <- cast(a, (:bees, 2, "") impl ActorMessage {})
            produces pure ok end
        }
    }
}

// ======================================================================== ttx, the send actor
// (:bees, kind, bytes): 9 a frame body, sent with its 4-byte length; 4 bytes as they are (test programs); 3 close the link
// after everything before it, and end; 10 end without touching the link (it has already ended)
fn tx_k(msg: (:bees, int64, string)) -> int64 { case msg of { (:bees, k: int64, _s: string) -> k } }
fn tx_s(msg: (:bees, int64, string)) -> string { case msg of { (:bees, _k: int64, s: string) -> s } }
fn ttx(msg: (:bees, int64, string), st: { c: dangerous_actor_ref, n: int64 }) -> (:no_reply, { c: dangerous_actor_ref, n: int64 }) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        k: int64 <- tx_k(msg);
        seg: string <- case k of { 9 -> bees_trust_frame@frame4(tx_s(msg)); 4 -> tx_s(msg); _: int64 -> "" };
        _: boolean <- case k == 3 of {
            true -> cast(st.c, :close impl ActorMessage {});
            false -> case length_bytes(seg) > 0 of { true -> cast(st.c, (:tx, seg, me) impl ActorMessage {}); false -> true }
        };
        _: atom <- case k == 3 or k == 10 of { true -> stop_self(:normal); false -> :ok }
    produces pure (:no_reply, { c: st.c, n: st.n + 1 }) end
}
fn tx_send(tx: actor_ref, kind: int64, s: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(tx, (:bees, kind, s) impl ActorMessage {})
    produces pure ok end
}
fn tx_frame(tx: actor_ref, body: string) -> boolean { tx_send(tx, 9, body) }
fn tx_end(tx: actor_ref, down: boolean) -> boolean { tx_send(tx, case down of { true -> 10; false -> 3 }, "") }

// ======================================================================== tcon
// Phases: 0 waiting for the link   1 the link's 96 identity bytes   2 the peer's advert   3 its identity hash (edge)
//   4 the producer's signature (edge)   5 the nonce (random edge)   6 the peer's challenge   7 this node's signature (signer)
//   8 the peer's response   9 its verification (edge)   10 role 0: the reply   11, 12 a reply entry's hash and signature
//   13 role 2: the request   14, 15 a request entry's hash and signature   16 the node's answer   19 closed, reaped after
//   500 ms   20 ended   17 key_rotated was sent: what the peer still sends is read and dropped until it closes or the
//   connection's bound passes (closing with its bytes unread would reset the connection and could destroy the frame)
// The changing part of the state (v): the assembler and whether it lives, the phase, whether the link has gone down, the
// number of answers on their way, the peer certificate's key and fingerprint, the peer's descriptor (ETF bytes), the nonce
// sent, and, while a frame's entries are verified, the frame and the entry's index.
fn vp(v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }, phase: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } { { asm: v.asm, phase: phase, live: v.live, down: v.down, pend: v.pend, ckey: v.ckey, cfp: v.cfp, pd: v.pd, nonce: v.nonce, k: v.k, body: v.body } }
// one more answer asked for, and the phase that waits for it
fn vask(v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }, phase: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } { { asm: v.asm, phase: phase, live: v.live, down: v.down, pend: v.pend + 1, ckey: v.ckey, cfp: v.cfp, pd: v.pd, nonce: v.nonce, k: v.k, body: v.body } }
fn vgot(v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } { { asm: v.asm, phase: v.phase, live: v.live, down: v.down, pend: v.pend - 1, ckey: v.ckey, cfp: v.cfp, pd: v.pd, nonce: v.nonce, k: v.k, body: v.body } }
fn vdown(v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } { { asm: v.asm, phase: v.phase, live: v.live, down: true, pend: v.pend, ckey: v.ckey, cfp: v.cfp, pd: v.pd, nonce: v.nonce, k: v.k, body: v.body } }
fn with_v(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }) -> { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } { { c: st.c, tx: st.tx, role: st.role, cid: st.cid, req: st.req, cfg: st.cfg, v: v } }

fn peer_of(v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }) -> { addr: string, id: string, pub: string, token: string } {
    r: { ok: boolean, d: { addr: string, id: string, pub: string, token: string } } <- bees_tempus_frame@desc_of(v.pd);
    r.d
}
fn peer_short(v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }) -> string {
    case length_bytes(v.pd) == 0 of {
        true -> "-";
        false -> { d: { addr: string, id: string, pub: string, token: string } <- peer_of(v); bees_trust_frame@cut(bees_trust_frame@hex(d.id), 0, 16) }
    }
}
fn cid_text(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) -> string { concat(case st.role == 0 of { true -> "d"; false -> "a" }, bees_trust_frame@int_text(st.cid)) }
// one TEMPUS audit line: the event, the peer (the first 16 hex digits of its id, once its advert was read), what, and the
// connection (a: accepted, d: dialed, and its number)
fn audit(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, event: string, what: string) -> atom {
    say(concat(concat(concat("[tempus audit] ", event), concat(" peer=", peer_short(st.v))), concat(concat(" ", what), concat(" ", cid_text(st)))))
}
fn tell(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, op: int64, s1: string, s2: string, m: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(st.cfg.node, (:bees, op, s1, s2, st.cid, m, me) impl ActorMessage {})
    produces pure ok end
}
// what the node is told of an admitted peer beside its descriptor: 4 * (whitelist index + 1) + the token's type
fn peer_m(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) -> int64 {
    d: { addr: string, id: string, pub: string, token: string } <- peer_of(st.v);
    t: { ok: boolean, why: string, kid: string, sub: string, typ: int64, nbf: int64, exp: int64, payload: string, sig: string } <- bees_tempus_frame@tok(d.token);
    4 * (wl_index(st.cfg.wl, bees_trust_frame@hex(st.v.cfp)) + 1) + t.typ
}
// close: the node is told (op; 0: nothing to tell; an accepted connection always tells 64), the send actor closes the link
// after what it holds, the assembler ends, the actor is reaped later
fn finish(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, op: int64, s1: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    sequence
        _: boolean <- case op of { 0 -> true; 60 -> tell(st, me, 60, s1, st.v.pd, peer_m(st)); _: int64 -> tell(st, me, op, s1, "", 0) };
        _: boolean <- case st.role == 2 of { true -> tell(st, me, 64, "", "", 0); false -> true };
        _: boolean <- tx_end(st.tx, st.v.down);
        _: boolean <- asm_stop(st.v.asm, st.v.live);
        _: boolean <- arm(me, 500, 9)
    produces pure { asm: st.v.asm, phase: 19, live: false, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: st.v.k, body: "" } end
}
fn refuse(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, event: string, what: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    sequence
        _: atom <- audit(st, event, what);
        v1: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } <- finish(st, me, case st.role == 0 of { true -> 61; false -> 0 }, event)
    produces pure report(st, me, event, v1) end
}
// a refusal that is not the peer's doing (this node's random source or signer): nothing is reported
fn refuse_own(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, event: string, what: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    sequence
        _: atom <- audit(st, event, what)
    produces pure finish(st, me, case st.role == 0 of { true -> 61; false -> 0 }, event) end
}
// Ruling NQ-19: the node is told of every refusal of an ACCEPTED peer whose identity is known, so that a bridge can raise
// that peer's score (67; 66 is taken by the client part). The identity is never the advert's word alone: it is the SHA-512 of the key of the peer's TLS
// certificate, which the handshake proved the peer holds. From the proof stage on (phase 5) the advert's id was checked
// against that hash and the producer's signature on the token was verified: the descriptor goes with the report (m 1).
// Before that the token is not to be believed: only the id goes (m 0), in phase 2 after the edge has hashed the
// certificate's key (the answer comes when the connection is already closing: k -1 marks it, body keeps the event). A
// timeout counts only while the connection waits for the peer.
fn report(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, event: string, v1: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string }) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    ph: int64 <- st.v.phase;
    case st.role != 2 or length_bytes(st.v.ckey) != 32 or (event == "timeout" and reading(ph) == false) of {
        true -> v1;
        false -> case ph == 2 of {
            true -> {
                sequence
                    _: boolean <- ask_edge(st, me, 4, st.v.ckey)
                produces pure { asm: v1.asm, phase: v1.phase, live: v1.live, down: v1.down, pend: v1.pend + 1, ckey: v1.ckey, cfp: v1.cfp, pd: v1.pd, nonce: v1.nonce, k: 0 - 1, body: event } end
            };
            false -> case ph >= 4 of {
                false -> v1;
                true -> {
                    d: { addr: string, id: string, pub: string, token: string } <- peer_of(st.v);
                    sequence
                        _: boolean <- case ph >= 5 of { true -> tell(st, me, 67, event, st.v.pd, 1); false -> tell(st, me, 67, event, d.id, 0) }
                    produces pure v1 end
                }
            }
        }
    }
}
fn stage(phase: int64) -> string {
    case phase of {
        1 -> "stage identity"; 2 -> "stage advert"; 6 -> "stage challenge"; 8 -> "stage response"; 10 -> "stage reply";
        13 -> "stage request"; _: int64 -> "stage admission"
    }
}

fn c_up(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase == 0 of {
        false -> st.v;
        true -> case st.role >= 3 of {
            true -> {
                sequence
                    _: atom <- case st.role == 3 of { true -> audit(st, "inflight_refused", "more accepted connections than inflight_max: closed at once"); false -> audit(st, "clock_refused", "the system clock cannot be read: closed at once") }
                produces pure finish(st, me, 0, "") end
            };
            false -> {
                sequence
                    a: actor_ref <- asm_new(me, 96, "", true);
                    _: boolean <- tx_frame(st.tx, st.cfg.mine);
                    // ruling NQ-14: what is left of the connection's one bound, which began at the dial or the accept
                    _: boolean <- arm(me, left_ms(st.cfg.ms), 1)
                produces pure { asm: a, phase: 1, live: true, down: false, pend: 0, ckey: "", cfp: "", pd: "", nonce: "", k: 0, body: "" } end
            }
        }
    }
}
fn c_rx(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, seg: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.live and st.v.phase < 19 of {
        false -> st.v;
        true -> {
            sequence proc[concurrency]
                _: boolean <- cast(st.v.asm, (:bees, 0, seg) impl ActorMessage {})
            produces pure st.v end
        }
    }
}
fn c_more(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.live and st.v.phase < 19 and st.v.down == false of {
        false -> st.v;
        true -> { sequence _: boolean <- credit(st.c, 1) produces pure st.v end }
    }
}
fn reading(phase: int64) -> boolean { phase == 1 or phase == 2 or phase == 6 or phase == 8 or phase == 10 or phase == 13 }
// the link said :link_down and has ended with it: nothing casts to it again
fn c_down(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase == 17 of {
        true -> { g: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, vdown(st.v)); finish(g, me, case st.role == 0 of { true -> 61; false -> 0 }, "key_rotated_sent") };
        false -> c_down_in(st, me)
    }
}
fn c_down_in(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase == 0 of {
        true -> {
            sequence
                _: boolean <- tx_end(st.tx, true);
                _: boolean <- case st.role >= 3 of { true -> true; false -> tell(st, me, case st.role == 0 of { true -> 61; false -> 64 }, "connect_failed", "", 0) }
            produces pure vp(st.v, 20) end
        };
        false -> case reading(st.v.phase) of {
            false -> vdown(st.v);
            true -> {
                sequence
                    _: atom <- audit(st, "closed_by_peer", stage(st.v.phase));
                    g: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, vdown(st.v))
                produces pure finish(g, me, case st.role == 0 of { true -> 61; false -> 0 }, "closed_by_peer") end
            }
        }
    }
}
fn c_timer(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, tag: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case tag of {
        9 -> case st.v.phase == 19 of {
            false -> st.v;
            true -> case st.v.pend <= 0 of {
                true -> vp(st.v, 20);
                false -> { sequence _: boolean <- arm(me, 100, 9) produces pure st.v end }
            }
        };
        1 -> case st.v.phase >= 1 and st.v.phase < 16 of {
            false -> case st.v.phase == 17 of {
                true -> finish(st, me, case st.role == 0 of { true -> 61; false -> 0 }, "key_rotated_sent");
                false -> st.v
            };
            true -> refuse(st, me, "timeout", stage(st.v.phase))
        };
        _: int64 -> st.v
    }
}
// a framing refusal (an oversize length): no frame was stored or decoded; the assembler has ended
fn c_reject(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, code: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase < 19 of {
        false -> st.v;
        true -> {
            sequence
                dead: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, { asm: st.v.asm, phase: st.v.phase, live: false, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: st.v.k, body: st.v.body })
            produces pure refuse(dead, me, "protocol_error", concat("frame refused before decoding: ", bees_atoms@spelling(bees_trust_frame@reason(code)))) end
        }
    }
}

// ---- asking the edges; each answer comes back as (:bees, kind, ...) and is counted (pend)
fn ask_edge(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, op: int64, input: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(st.cfg.edge, (op, input, 0, me) impl ActorMessage {})
    produces pure ok end
}
fn ask_rnd(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(st.cfg.rnd, (1, "", "", 32, me) impl ActorMessage {})
    produces pure ok end
}
fn ask_sig(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, text: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(st.cfg.sig, (2, text, 0, me) impl ActorMessage {})
    produces pure ok end
}

// ---- phase 1: the link's identity bytes
fn c_ident(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    sequence
        _: boolean <- asm_go(st.v.asm)
    produces pure { asm: st.v.asm, phase: 2, live: st.v.live, down: st.v.down, pend: st.v.pend, ckey: bees_trust_frame@cut(body, 0, 32), cfp: bees_trust_frame@cut(body, 32, 96), pd: "", nonce: "", k: 0, body: "" } end
}
// ---- phase 2: the peer's advert
fn typ_of(d: { addr: string, id: string, pub: string, token: string }) -> int64 {
    t: { ok: boolean, why: string, kid: string, sub: string, typ: int64, nbf: int64, exp: int64, payload: string, sig: string } <- bees_tempus_frame@tok(d.token);
    t.typ
}
fn wl_why(typ: int64, wli: int64) -> string {
    case typ == 1 of {
        true -> case wli >= 0 of { true -> "a certificate of the tempus whitelist with a token whose typ is not tempus_bridge or tempus_sentinel"; false -> "" };
        false -> case wli < 0 of { true -> "a tempus_bridge or tempus_sentinel token under a certificate that is not in the tempus whitelist"; false -> "" }
    }
}
fn c_advert(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case bees_tempus_frame@kind(body) != 1 of {
        true -> refuse(st, me, "protocol_error", "the first frame is not an advert");
        false -> {
            a: { ok: boolean, why: string, d: { addr: string, id: string, pub: string, token: string } } <- bees_tempus_frame@dec_advert(body);
            case a.ok of {
                false -> refuse(st, me, "protocol_error", a.why);
                true -> c_advert_ok(st, me, a.d)
            }
        }
    }
}
fn c_advert_ok(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, d: { addr: string, id: string, pub: string, token: string }) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    pd: string <- bees_tempus_frame@desc_bytes(d);
    v1: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } <- { asm: st.v.asm, phase: st.v.phase, live: st.v.live, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: pd, nonce: "", k: 0, body: "" };
    s1: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, v1);
    case d.pub != st.v.ckey of {
        true -> refuse(s1, me, "binding_refused", "the advert's pub is not the key of the peer's TLS certificate");
        false -> {
            p: { why: string, payload: string, sig: string } <- bees_tempus_admit@pre(d, st.cfg.kid, st.cfg.now, st.cfg.skew, 0);
            case p.why == bees_tempus_admit@rotated() of {
                true -> {
                    sequence
                        _: boolean <- tx_frame(st.tx, bees_tempus_frame@enc_rotated(st.cfg.kid));
                        _: atom <- audit(s1, "key_rotated", "the peer's token is under another kid; it was told the current one");
                        _: boolean <- asm_go(st.v.asm)
                    produces pure vp(v1, 17) end
                };
                false -> case length_bytes(p.why) > 0 of {
                    true -> refuse(s1, me, "admission_refused", p.why);
                    false -> {
                        w: string <- wl_why(typ_of(d), wl_index(st.cfg.wl, bees_trust_frame@hex(st.v.cfp)));
                        case length_bytes(w) > 0 of {
                            true -> refuse(s1, me, "whitelist_reject", w);
                            false -> { sequence _: boolean <- ask_edge(st, me, 4, d.pub) produces pure vask(v1, 3) end }
                        }
                    }
                }
            }
        }
    }
}
// ---- phase 3: the SHA-512 of the peer's pub; phase 4: the producer's signature over the token's payload
fn c_hash(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, etf: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    d: { addr: string, id: string, pub: string, token: string } <- peer_of(st.v);
    case edge_bytes(etf) == d.id of {
        false -> {
            // the identity is the hash just made of the certificate's key (d.pub is that key: the channel binding)
            sequence
                v1: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } <- refuse(st, me, "admission_refused", "id is not the SHA-512 of pub");
                _: boolean <- case st.role == 2 and length_bytes(edge_bytes(etf)) == 64 of { true -> tell(st, me, 67, "admission_refused", edge_bytes(etf), 0); false -> true }
            produces pure v1 end
        };
        true -> {
            p: { why: string, payload: string, sig: string } <- bees_tempus_admit@pre(d, st.cfg.kid, st.cfg.now, st.cfg.skew, 0);
            sequence
                _: boolean <- ask_edge(st, me, 1, bees_tempus_admit@producer_input(st.cfg.ppub, p.sig, p.payload))
            produces pure vask(st.v, 4) end
        }
    }
}
fn c_prod(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, verdict: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case verdict == 1 of {
        false -> refuse(st, me, "admission_refused", "the signature does not verify");
        true -> { sequence _: boolean <- ask_rnd(st, me) produces pure vask(st.v, 5) end }
    }
}
// ---- phase 5: the nonce; this node's challenge goes out and the peer's is read
fn c_nonce(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, etf: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    nonce: string <- edge_bytes(etf);
    case length_bytes(nonce) == 32 of {
        false -> refuse_own(st, me, "internal_error", "random bytes refused");
        true -> {
            sequence
                _: boolean <- tx_frame(st.tx, bees_tempus_frame@enc_challenge(nonce));
                _: boolean <- asm_go(st.v.asm)
            produces pure { asm: st.v.asm, phase: 6, live: st.v.live, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: nonce, k: 0, body: "" } end
        }
    }
}
// ---- phase 6: the peer's challenge, or its key_rotated
fn c_challenge(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    k: int64 <- bees_tempus_frame@kind(body);
    case k == 4 of {
        true -> {
            f: { ok: boolean, why: string, v: string } <- bees_tempus_frame@dec_field(body, 4);
            case f.ok of {
                false -> refuse(st, me, "protocol_error", f.why);
                true -> {
                    sequence
                        _: atom <- audit(st, "key_rotated", "the peer says this node's token is under another kid than its current one")
                    produces pure finish(st, me, case st.role == 0 of { true -> 62; false -> 0 }, f.v) end
                }
            }
        };
        false -> case k == 2 of {
            false -> refuse(st, me, "protocol_error", "a challenge was expected");
            true -> {
                f: { ok: boolean, why: string, v: string } <- bees_tempus_frame@dec_field(body, 2);
                case f.ok of {
                    false -> refuse(st, me, "protocol_error", f.why);
                    true -> { sequence _: boolean <- ask_sig(st, me, bees_tempus_admit@pop_message(f.v, st.cfg.mtok)) produces pure vask(st.v, 7) end }
                }
            }
        }
    }
}
// ---- phase 7: this node's signature; its response goes out and the peer's is read
fn c_signed(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, etf: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    sig: string <- edge_bytes(etf);
    case length_bytes(sig) == 64 of {
        false -> refuse_own(st, me, "internal_error", "the signature could not be made");
        true -> {
            sequence
                _: boolean <- tx_frame(st.tx, bees_tempus_frame@enc_response(sig));
                _: boolean <- asm_go(st.v.asm)
            produces pure vp(st.v, 8) end
        }
    }
}
// ---- phase 8: the peer's response; phase 9: its verification
fn c_response(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case bees_tempus_frame@kind(body) != 3 of {
        true -> refuse(st, me, "pop_failed", "a response was expected");
        false -> {
            f: { ok: boolean, why: string, v: string } <- bees_tempus_frame@dec_field(body, 3);
            case f.ok of {
                false -> refuse(st, me, "pop_failed", f.why);
                true -> {
                    d: { addr: string, id: string, pub: string, token: string } <- peer_of(st.v);
                    sequence
                        _: boolean <- ask_edge(st, me, 1, bees_tempus_admit@pop_input(d.pub, f.v, st.v.nonce, d.token))
                    produces pure vask(st.v, 9) end
                }
            }
        }
    }
}
fn typ_text(typ: int64) -> string { case typ of { 1 -> "tempus_edge"; 2 -> "tempus_bridge"; 3 -> "tempus_sentinel"; _: int64 -> "?" } }
fn c_pop(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, verdict: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case verdict == 1 of {
        false -> refuse(st, me, "pop_failed", "the proof of possession does not verify");
        true -> {
            d: { addr: string, id: string, pub: string, token: string } <- peer_of(st.v);
            wli: int64 <- wl_index(st.cfg.wl, bees_trust_frame@hex(st.v.cfp));
            sequence
                _: atom <- audit(st, "admitted", concat(typ_text(typ_of(d)), case wli >= 0 of { true -> concat(", tempus whitelist entry ", bees_trust_frame@int_text(wli)); false -> ", token and proof of possession" }))
            produces pure c_admitted(st, me) end
        }
    }
}
fn c_admitted(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.role == 2 of {
        true -> { sequence _: boolean <- asm_go(st.v.asm) produces pure vp(st.v, 13) end };
        false -> case length_bytes(st.req) == 0 of {
            true -> finish(st, me, 65, "");
            false -> {
                sequence
                    _: boolean <- tx_frame(st.tx, st.req);
                    _: boolean <- asm_go(st.v.asm)
                produces pure vp(st.v, 10) end
            }
        }
    }
}
// ---- the entries of a received frame, one after another (base 11: a reply, role 0; base 14: a request, role 2)
fn nth(v: List[{ id: string, d: string, age: int64 }, mem(normal)], k: int64) -> { id: string, d: string, age: int64 } {
    case v of {
        []: List[{ id: string, d: string, age: int64 }, mem(normal)] -> bees_tempus_view@entry("", "", 0);
        [h: { id: string, d: string, age: int64 }, t: List[{ id: string, d: string, age: int64 }, mem(normal)]] -> case k <= 0 of { true -> h; false -> nth(t, k - 1) }
    }
}
fn ent_d(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) -> { addr: string, id: string, pub: string, token: string } {
    e: { ok: boolean, why: string, store: int64, entries: List[{ id: string, d: string, age: int64 }, mem(normal)] } <- bees_tempus_frame@dec_entries(st.v.body, st.cfg.count);
    en: { id: string, d: string, age: int64 } <- nth(e.entries, st.v.k);
    r: { ok: boolean, d: { addr: string, id: string, pub: string, token: string } } <- bees_tempus_frame@desc_of(en.d);
    r.d
}
fn ent_pre(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, d: { addr: string, id: string, pub: string, token: string }) -> { why: string, payload: string, sig: string } {
    e: { ok: boolean, why: string, store: int64, entries: List[{ id: string, d: string, age: int64 }, mem(normal)] } <- bees_tempus_frame@dec_entries(st.v.body, st.cfg.count);
    bees_tempus_admit@pre(d, st.cfg.kid, st.cfg.now, st.cfg.skew, e.store)
}
fn ent_count(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) -> int64 {
    e: { ok: boolean, why: string, store: int64, entries: List[{ id: string, d: string, age: int64 }, mem(normal)] } <- bees_tempus_frame@dec_entries(st.v.body, st.cfg.count);
    bees_tempus_view@size(e.entries)
}
fn ent_step(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, base: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.k >= ent_count(st) of {
        true -> ent_done(st, me, base);
        false -> {
            d: { addr: string, id: string, pub: string, token: string } <- ent_d(st);
            p: { why: string, payload: string, sig: string } <- ent_pre(st, d);
            case length_bytes(p.why) > 0 of {
                true -> refuse(st, me, "entry_refused", concat(concat("entry ", bees_trust_frame@int_text(st.v.k)), concat(": ", p.why)));
                false -> { sequence _: boolean <- ask_edge(st, me, 4, d.pub) produces pure vask(st.v, base) end }
            }
        }
    }
}
fn ent_hash(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, etf: string, base: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    d: { addr: string, id: string, pub: string, token: string } <- ent_d(st);
    case edge_bytes(etf) == d.id of {
        false -> refuse(st, me, "entry_refused", concat(concat("entry ", bees_trust_frame@int_text(st.v.k)), ": id is not the SHA-512 of pub"));
        true -> {
            p: { why: string, payload: string, sig: string } <- ent_pre(st, d);
            sequence
                _: boolean <- ask_edge(st, me, 1, bees_tempus_admit@producer_input(st.cfg.ppub, p.sig, p.payload))
            produces pure vask(st.v, base + 1) end
        }
    }
}
fn ent_sig(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, verdict: int64, base: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case verdict == 1 of {
        false -> refuse(st, me, "entry_refused", concat(concat("entry ", bees_trust_frame@int_text(st.v.k)), ": the signature does not verify"));
        true -> {
            nx: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, { asm: st.v.asm, phase: st.v.phase, live: st.v.live, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: st.v.k + 1, body: st.v.body });
            ent_step(nx, me, base)
        }
    }
}
fn ent_done(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, base: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case base == 11 of {
        true -> finish(st, me, 60, st.v.body);
        false -> to_node(st, me, st.v.body)
    }
}
fn ent_begin(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string, base: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    e: { ok: boolean, why: string, store: int64, entries: List[{ id: string, d: string, age: int64 }, mem(normal)] } <- bees_tempus_frame@dec_entries(body, st.cfg.count);
    case e.ok of {
        false -> refuse(st, me, "protocol_error", e.why);
        true -> {
            s0: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, { asm: st.v.asm, phase: st.v.phase, live: st.v.live, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: 0, body: body });
            ent_step(s0, me, base)
        }
    }
}
// ---- phase 10 (role 0): the reply
fn c_reply(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    k: int64 <- bees_tempus_frame@kind(body);
    case k == 6 or k == 8 of {
        true -> ent_begin(st, me, body, 11);
        false -> case k == 11 or k == 14 of {
            true -> finish(st, me, 60, body);
            false -> refuse(st, me, "protocol_error", "the reply is not a reply frame")
        }
    }
}
// ---- phase 13 (role 2): the request; phase 16: the node's answer
fn to_node(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    m: int64 <- peer_m(st);
    sequence
        _: boolean <- tell(st, me, 63, body, st.v.pd, m)
    produces pure { asm: st.v.asm, phase: 16, live: st.v.live, down: st.v.down, pend: st.v.pend + 1, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: 0, body: "" } end
}
fn c_request(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    k: int64 <- bees_tempus_frame@kind(body);
    case k == 5 of {
        true -> ent_begin(st, me, body, 14);
        false -> case k == 7 or k == 9 or k == 10 or k == 12 or k == 13 of {
            true -> to_node(st, me, body);
            false -> refuse(st, me, "protocol_error", concat("not a request: ", bees_tempus_frame@why_refused(body)))
        }
    }
}
fn c_answer(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, k: int64, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    g: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, vgot(st.v));
    case g.v.phase != 16 of {
        true -> g.v;
        false -> case k == 20 and g.v.down == false of {
            true -> { sequence _: boolean <- tx_frame(st.tx, body) produces pure finish(g, me, 0, "") end };
            false -> finish(g, me, 0, "")
        }
    }
}
// a frame from the assembler: the next assembler is started with the bytes after it HELD, and let go when this actor is
// ready for the next frame
fn c_frame(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string, rest: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase == 17 of {
        true -> {
            sequence
                a: actor_ref <- asm_new(me, 0, rest, true)
            produces pure { asm: a, phase: 17, live: true, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: st.v.k, body: st.v.body } end
        };
        false -> c_frame_rd(st, me, body, rest)
    }
}
fn c_frame_rd(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string, rest: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case reading(st.v.phase) of {
        false -> { asm: st.v.asm, phase: st.v.phase, live: false, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: st.v.k, body: st.v.body };
        true -> {
            sequence
                a: actor_ref <- asm_new(me, 0, rest, false);
                s2: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, { asm: a, phase: st.v.phase, live: true, down: st.v.down, pend: st.v.pend, ckey: st.v.ckey, cfp: st.v.cfp, pd: st.v.pd, nonce: st.v.nonce, k: st.v.k, body: st.v.body })
            produces pure c_frame_in(s2, me, body) end
        }
    }
}
fn c_frame_in(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, body: string) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase of {
        1 -> c_ident(st, body);
        2 -> c_advert(st, me, body);
        6 -> c_challenge(st, me, body);
        8 -> c_response(st, me, body);
        10 -> c_reply(st, me, body);
        _: int64 -> c_request(st, me, body)
    }
}
// an answer of an edge, the random edge or the signer: counted; dropped when the connection has closed meanwhile; a link
// that went down while it was on its way ends the connection here
fn c_edge(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, k: int64, s1: string, n: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    g: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } } <- with_v(st, vgot(st.v));
    case g.v.phase >= 19 of {
        // closed meanwhile: dropped, but for the hash a refusal in phase 2 asked for (report): the node is told now
        true -> case g.v.phase == 19 and k == 34 and g.v.k == 0 - 1 of {
            false -> g.v;
            true -> {
                id: string <- edge_bytes(s1);
                sequence
                    _: boolean <- case length_bytes(id) == 64 of { true -> tell(g, me, 67, g.v.body, id, 0); false -> true }
                produces pure { asm: g.v.asm, phase: g.v.phase, live: g.v.live, down: g.v.down, pend: g.v.pend, ckey: g.v.ckey, cfp: g.v.cfp, pd: g.v.pd, nonce: g.v.nonce, k: 0, body: "" } end
            }
        };
        false -> case g.v.down of {
            true -> { sequence _: atom <- audit(g, "closed_by_peer", stage(g.v.phase)) produces pure finish(g, me, case st.role == 0 of { true -> 61; false -> 0 }, "closed_by_peer") end };
            false -> c_edge_in(g, me, k, s1, n)
        }
    }
}
fn c_edge_in(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, k: int64, s1: string, n: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case st.v.phase of {
        3 -> case k == 34 of { true -> c_hash(st, me, s1); false -> st.v };
        4 -> case k == 31 of { true -> c_prod(st, me, n); false -> st.v };
        5 -> case k == 7 of { true -> c_nonce(st, me, s1); false -> st.v };
        7 -> case k == 32 of { true -> c_signed(st, me, s1); false -> st.v };
        9 -> case k == 31 of { true -> c_pop(st, me, n); false -> st.v };
        11 -> case k == 34 of { true -> ent_hash(st, me, s1, 11); false -> st.v };
        12 -> case k == 31 of { true -> ent_sig(st, me, n, 11); false -> st.v };
        14 -> case k == 34 of { true -> ent_hash(st, me, s1, 14); false -> st.v };
        15 -> case k == 31 of { true -> ent_sig(st, me, n, 14); false -> st.v };
        _: int64 -> st.v
    }
}
fn c_bees(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, k: int64, s1: string, s2: string, n: int64) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case k of {
        1 -> c_frame(st, me, s1, s2);
        2 -> c_reject(st, me, n);
        4 -> c_more(st);
        5 -> c_timer(st, me, n);
        7 -> c_edge(st, me, k, s1, n);
        31 -> c_edge(st, me, k, s1, n);
        32 -> c_edge(st, me, k, s1, n);
        34 -> c_edge(st, me, k, s1, n);
        20 -> c_answer(st, me, k, s1);
        21 -> c_answer(st, me, k, s1);
        // an audit line of the TLS link under this connection (it may not print itself, E2103): event, what
        11 -> { sequence _: atom <- audit(st, s1, s2) produces pure st.v end };
        _: int64 -> st.v
    }
}
fn conn_handle(st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }, me: actor_ref, msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:bees, int64, string, string, int64)) -> { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } {
    case msg of {
        (:link_up, _info: string) -> c_up(st, me);
        (:rx, seg: string) -> c_rx(st, seg);
        (:tx_credit, _n: int64) -> st.v;
        (:tx_failed, _why: atom) -> st.v;
        (:link_down, _w: atom) -> case st.v.phase >= 19 of { true -> vdown(st.v); false -> c_down(st, me) };
        (:bees, k: int64, s1: string, s2: string, n: int64) -> c_bees(st, me, k, s1, s2, n)
    }
}
fn tcon(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom) | (:bees, int64, string, string, int64), st: { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) -> (:no_reply, { c: dangerous_actor_ref, tx: actor_ref, role: int64, cid: int64, req: string, cfg: { node: actor_ref, sig: actor_ref, edge: dangerous_actor_ref, rnd: dangerous_actor_ref, mine: string, mtok: string, kid: string, ppub: string, wl: string, now: int64, skew: int64, count: int64, ms: uint64 }, v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } }) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        v: { asm: actor_ref, phase: int64, live: boolean, down: boolean, pend: int64, ckey: string, cfp: string, pd: string, nonce: string, k: int64, body: string } <- conn_handle(st, me, msg);
        // the link has already ended with its carrier (a carrier ends after :link_down), so the actor only ends itself
        _: atom <- case v.phase == 20 of { true -> stop_self(:normal); false -> :ok }
    produces pure (:no_reply, { c: st.c, tx: st.tx, role: st.role, cid: st.cid, req: st.req, cfg: st.cfg, v: v }) end
}
