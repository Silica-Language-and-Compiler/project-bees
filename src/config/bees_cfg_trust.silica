            }
        }
    }
}

fn lacks(a: { cfg: { limits: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }, net: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }, node: { creation: int64, name: string }, peers: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], pins: List[{ addr: string, fp: string }, mem(normal)], session: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }, time: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }, tls: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }, token: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }) -> string {
    case a.seen == 0 of {
        true -> "(store): no configuration (the store holds no readable record: it is empty, or damaged at its start)";
        false -> case a.seen != a.want of {
            true -> "(store): fewer records than the index states (a truncated or damaged store)";
            false -> case has(a.got, 1) of { false -> "node: missing"; true -> case has(a.got, 2) of { false -> "trust.net: missing"; true -> case has(a.got, 4) of { false -> "trust.limits: missing"; true -> case has(a.got, 8) of { false -> "trust.time: missing"; true -> case has(a.got, 16) of { false -> "trust.token: missing"; true -> case has(a.got, 32) of { false -> "trust.session: missing"; true -> case has(a.got, 64) of { false -> "trust.tls: missing"; true -> "" } } } } } } }
        }
    }
}
fn finish(a: { cfg: { limits: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }, net: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }, node: { creation: int64, name: string }, peers: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], pins: List[{ addr: string, fp: string }, mem(normal)], session: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }, time: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }, tls: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }, token: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }) -> (:ok, { limits: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }, net: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }, node: { creation: int64, name: string }, peers: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], pins: List[{ addr: string, fp: string }, mem(normal)], session: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }, time: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }, tls: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }, token: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string } }) | (:error, { record: int64, schema: int64, text: string }) {
    case length_bytes(a.err.text) > 0 of {
        true -> (:error, a.err);
        false -> case length_bytes(lacks(a)) > 0 of {
            true -> (:error, { record: a.seen, schema: 0, text: lacks(a) });
            false -> (:ok, { limits: a.cfg.limits, net: a.cfg.net, node: a.cfg.node, peers: rev_peer(a.cfg.peers, none_peer()), pins: rev_pin(a.cfg.pins, none_pin()), session: a.cfg.session, time: a.cfg.time, tls: a.cfg.tls, token: a.cfg.token })
        }
    }
}

// ---- the sanitized summary (bees-config-file.md section 4 rule 11): every value except the secrets ----
fn say_n(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces pure o end
}
fn say_s(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print("\"");
        _: atom <- print(s);
        _: atom <- print("\"");
        o: atom <- println("")
    produces pure o end
}
fn say_len(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print("(");
        _: atom <- print_int64(length_bytes(s));
        _: atom <- print(" bytes)");
        o: atom <- println("")
    produces pure o end
}
fn say_secret(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print(case length_bytes(s) > 0 of { true -> "(secret, not shown)"; false -> "(none)" });
        o: atom <- println("")
    produces pure o end
}
fn say_b(label: string, b: boolean) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print(case b of { true -> "true"; false -> "false" });
        o: atom <- println("")
    produces pure o end
}
fn show_limits(v: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("trust.limits.args_len_max = ", v.args_len_max);
        _: atom <- say_n("trust.limits.frame_size_max = ", v.frame_size_max);
        _: atom <- say_n("trust.limits.suspicion_limit = ", v.suspicion_limit);
        _: atom <- say_n("trust.limits.term_depth_max = ", v.term_depth_max);
        o: atom <- print("")
    produces pure o end
}
fn show_net(v: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }) -> atom {
    sequence proc[device_io]
        _: atom <- say_s("trust.net.listen_address = ", v.listen_address);
        _: atom <- say_s("trust.net.listener = ", v.listener);
        _: atom <- say_b("trust.net.plaintext_test_only = ", v.plaintext_test_only);
        _: atom <- say_n("trust.net.port = ", v.port);
        o: atom <- print("")
    produces pure o end
}
fn show_node(v: { creation: int64, name: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("node.creation = ", v.creation);
        _: atom <- say_s("node.name = ", v.name);
        o: atom <- print("")
    produces pure o end
}
fn show_session(v: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("trust.session.idle_ms = ", v.idle_ms);
        _: atom <- say_n("trust.session.max_age_ms = ", v.max_age_ms);
        _: atom <- say_n("trust.session.max_inflight = ", v.max_inflight);
        _: atom <- say_n("trust.session.more.drain_ms = ", v.more.drain_ms);
        _: atom <- say_n("trust.session.more.max_calls = ", v.more.max_calls);
        o: atom <- print("")
    produces pure o end
}
fn show_time(v: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("trust.time.call_timeout_ms = ", v.call_timeout_ms);
        _: atom <- say_n("trust.time.connect_stagger_ms = ", v.connect_stagger_ms);
        _: atom <- say_n("trust.time.connect_timeout_ms = ", v.connect_timeout_ms);
        _: atom <- say_n("trust.time.more.client_handshake_timeout = ", v.more.client_handshake_timeout);
        _: atom <- say_n("trust.time.more.dns_ns_timeout_ms = ", v.more.dns_ns_timeout_ms);
        _: atom <- say_n("trust.time.more.dns_total_timeout_ms = ", v.more.dns_total_timeout_ms);
        _: atom <- say_n("trust.time.more.first_frame_timeout_ms = ", v.more.first_frame_timeout_ms);
        o: atom <- print("")
    produces pure o end
}
fn show_tls(v: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_len("trust.tls.ca_pem = ", v.ca_pem);
        _: atom <- say_len("trust.tls.cert_pem = ", v.cert_pem);
        _: atom <- say_secret("trust.tls.key_pem = ", v.key_pem);
        _: atom <- say_s("trust.tls.self_fp = ", v.self_fp);
        o: atom <- print("")
    produces pure o end
}
fn show_token(v: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("trust.token.token_bytes = ", v.token_bytes);
        _: atom <- say_n("trust.token.token_ttl_sec = ", v.token_ttl_sec);
        _: atom <- say_b("trust.token.whitelist_autoload = ", v.whitelist_autoload);
        _: atom <- say_s("trust.token.whitelist_default_spec = ", v.whitelist_default_spec);
        o: atom <- print("")
    produces pure o end
}
fn show_trust_peer_spec_perms_one(h: { a: int64, f: string, m: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("trust.peer[].spec.perms[].a = ", h.a);
        _: atom <- say_s("trust.peer[].spec.perms[].f = ", h.f);
        _: atom <- say_s("trust.peer[].spec.perms[].m = ", h.m);
        o: atom <- print("")
    produces pure o end
}
fn show_trust_peer_spec_perms(xs: List[{ a: int64, f: string, m: string }, mem(normal)]) -> atom {
    case xs of {
        []: List[{ a: int64, f: string, m: string }, mem(normal)] -> :ok;
        [h: { a: int64, f: string, m: string }, rest: List[{ a: int64, f: string, m: string }, mem(normal)]] -> { _: atom <- show_trust_peer_spec_perms_one(h); show_trust_peer_spec_perms(rest) }
    }
}
fn show_peers_one(h: { cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }) -> atom {
    sequence proc[device_io]
        _: atom <- say_s("trust.peer[].cert = ", h.cert);
        _: atom <- say_b("trust.peer[].classical = ", h.classical);
        _: atom <- say_s("trust.peer[].fp = ", h.fp);
        _: atom <- say_s("trust.peer[].spec.all = ", h.spec.all);
        _: atom <- show_trust_peer_spec_perms(h.spec.perms);
        o: atom <- print("")
    produces pure o end
}
fn show_peers(xs: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)]) -> atom {
    case xs of {
        []: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)] -> :ok;
        [h: { cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, rest: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)]] -> { _: atom <- show_peers_one(h); show_peers(rest) }
    }
}
fn show_pins_one(h: { addr: string, fp: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_s("trust.pin[].addr = ", h.addr);
        _: atom <- say_s("trust.pin[].fp = ", h.fp);
        o: atom <- print("")
    produces pure o end
}
fn show_pins(xs: List[{ addr: string, fp: string }, mem(normal)]) -> atom {
    case xs of {
        []: List[{ addr: string, fp: string }, mem(normal)] -> :ok;
        [h: { addr: string, fp: string }, rest: List[{ addr: string, fp: string }, mem(normal)]] -> { _: atom <- show_pins_one(h); show_pins(rest) }
    }
}
fn show(c: { limits: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }, net: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }, node: { creation: int64, name: string }, peers: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], pins: List[{ addr: string, fp: string }, mem(normal)], session: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }, time: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }, tls: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }, token: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string } }) -> atom {
    sequence proc[device_io]
        _: atom <- show_limits(c.limits);
        _: atom <- show_net(c.net);
        _: atom <- show_node(c.node);
        _: atom <- show_peers(c.peers);
        _: atom <- show_pins(c.pins);
        _: atom <- show_session(c.session);
        _: atom <- show_time(c.time);
        _: atom <- show_tls(c.tls);
        _: atom <- show_token(c.token);
        o: atom <- print("")
    produces pure o end
}
