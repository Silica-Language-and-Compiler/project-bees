fn rev_peer(xs: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], acc: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)]) -> List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)] {
