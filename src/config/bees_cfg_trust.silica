fn take(a: { cfg: { limits: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }, net: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }, node: { creation: int64, name: string }, peers: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], pins: List[{ addr: string, fp: string }, mem(normal)], session: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }, time: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }, tls: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }, token: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }, schema: int64, e: string) -> { cfg: { limits: { args_len_max: int64, frame_size_max: int64, suspicion_limit: int64, term_depth_max: int64 }, net: { listen_address: string, listener: string, plaintext_test_only: boolean, port: int64 }, node: { creation: int64, name: string }, peers: List[{ cert: string, classical: boolean, fp: string, spec: { all: string, perms: List[{ a: int64, f: string, m: string }, mem(normal)] } }, mem(normal)], pins: List[{ addr: string, fp: string }, mem(normal)], session: { idle_ms: int64, max_age_ms: int64, max_inflight: int64, more: { drain_ms: int64, max_calls: int64 } }, time: { call_timeout_ms: int64, connect_stagger_ms: int64, connect_timeout_ms: int64, more: { client_handshake_timeout: int64, dns_ns_timeout_ms: int64, dns_total_timeout_ms: int64, first_frame_timeout_ms: int64 } }, tls: { ca_pem: string, cert_pem: string, key_pem: string, self_fp: string }, token: { token_bytes: int64, token_ttl_sec: int64, whitelist_autoload: boolean, whitelist_default_spec: string } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 } {
    case length_bytes(a.err.text) > 0 of {
        true -> a;
        false -> case a.seen == 0 of {
            true -> take_index(a, schema, dec_index(e));
            false -> case schema of {
                2 -> take_node(a, dec_node(e));
                20 -> take_net(a, dec_net(e));
                21 -> take_limits(a, dec_limits(e));
                22 -> take_time(a, dec_time(e));
                23 -> take_token(a, dec_token(e));
                24 -> take_session(a, dec_session(e));
                25 -> take_tls(a, dec_tls(e));
                26 -> take_peer(a, dec_peer(e));
                27 -> take_pin(a, dec_pin(e));
