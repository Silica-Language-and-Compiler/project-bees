fn take_auth(a: { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }, d: { ok: boolean, v: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string } }) -> { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 } {
    case d.ok of {
        false -> failed(a, 12, "beam.auth: the record does not decode as its kind");
        true -> case length_bytes(why_auth(d.v)) > 0 of {
            true -> failed(a, 12, why_auth(d.v));
            false -> case has(a.got, 8) of {
                true -> failed(a, 12, "beam.auth: given twice");
                false -> { cfg: { auth: d.v, links: a.cfg.links, net: a.cfg.net, node: a.cfg.node, time: a.cfg.time }, err: a.err, got: a.got + 8, seen: a.seen + 1, want: a.want }
            }
        }
    }
}
fn take_link(a: { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }, d: { ok: boolean, v: { address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string } }) -> { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 } {
    case d.ok of {
        false -> failed(a, 13, "beam.link: the record does not decode as its kind");
        true -> case length_bytes(why_link(d.v)) > 0 of {
            true -> failed(a, 13, why_link(d.v));
            false -> { cfg: { auth: a.cfg.auth, links: push_link(d.v, a.cfg.links), net: a.cfg.net, node: a.cfg.node, time: a.cfg.time }, err: a.err, got: a.got, seen: a.seen + 1, want: a.want }
        }
    }
}

fn take(a: { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }, schema: int64, e: string) -> { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 } {
    case length_bytes(a.err.text) > 0 of {
        true -> a;
        false -> case a.seen == 0 of {
            true -> take_index(a, schema, dec_index(e));
            false -> case schema of {
                2 -> take_node(a, dec_node(e));
                10 -> take_net(a, dec_net(e));
                11 -> take_time(a, dec_time(e));
                12 -> take_auth(a, dec_auth(e));
                13 -> take_link(a, dec_link(e));
                _: int64 -> failed(a, schema, "a record kind that is not one of a beam-mode store")
            }
        }
    }
}

fn lacks(a: { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }) -> string {
    case a.seen == 0 of {
        true -> "(store): no configuration (the store holds no readable record: it is empty, or damaged at its start)";
        false -> case a.seen != a.want of {
            true -> "(store): fewer records than the index states (a truncated or damaged store)";
            false -> case has(a.got, 1) of { false -> "node: missing"; true -> case has(a.got, 2) of { false -> "beam.net: missing"; true -> case has(a.got, 4) of { false -> "beam.time: missing"; true -> case has(a.got, 8) of { false -> "beam.auth: missing"; true -> "" } } } }
        }
    }
}
fn finish(a: { cfg: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }, err: { record: int64, schema: int64, text: string }, got: int64, seen: int64, want: int64 }) -> (:ok, { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }) | (:error, { record: int64, schema: int64, text: string }) {
    case length_bytes(a.err.text) > 0 of {
        true -> (:error, a.err);
        false -> case length_bytes(lacks(a)) > 0 of {
            true -> (:error, { record: a.seen, schema: 0, text: lacks(a) });
            false -> (:ok, { auth: a.cfg.auth, links: rev_link(a.cfg.links, none_link()), net: a.cfg.net, node: a.cfg.node, time: a.cfg.time })
        }
    }
}

// ---- the sanitized summary (bees-config-file.md section 4 rule 11): every value except the secrets ----
fn say_n(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces pure o end
}
fn say_s(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print("\"");
        _: atom <- print(s);
        _: atom <- print("\"");
        o: atom <- println("")
    produces pure o end
}
fn say_len(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print("(");
        _: atom <- print_int64(length_bytes(s));
        _: atom <- print(" bytes)");
        o: atom <- println("")
    produces pure o end
}
fn say_secret(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print(case length_bytes(s) > 0 of { true -> "(secret, not shown)"; false -> "(none)" });
        o: atom <- println("")
    produces pure o end
}
fn say_b(label: string, b: boolean) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print(case b of { true -> "true"; false -> "false" });
        o: atom <- println("")
    produces pure o end
}
fn show_auth(v: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_s("beam.auth.auth = ", v.auth);
        _: atom <- say_secret("beam.auth.cookie = ", v.cookie);
        _: atom <- say_n("beam.auth.redial.initial_ms = ", v.redial.initial_ms);
        _: atom <- say_n("beam.auth.redial.max_ms = ", v.redial.max_ms);
        _: atom <- say_b("beam.auth.redial.on = ", v.redial.on);
        _: atom <- say_s("beam.auth.transport = ", v.transport);
        o: atom <- print("")
    produces pure o end
}
fn show_net(v: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_s("beam.net.epmd.mode = ", v.epmd.mode);
        _: atom <- say_n("beam.net.epmd.port = ", v.epmd.port);
        _: atom <- say_s("beam.net.listen_address = ", v.listen_address);
        _: atom <- say_n("beam.net.listen_port = ", v.listen_port);
        _: atom <- say_s("beam.net.listener = ", v.listener);
        o: atom <- print("")
    produces pure o end
}
fn show_node(v: { creation: int64, name: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("node.creation = ", v.creation);
        _: atom <- say_s("node.name = ", v.name);
        o: atom <- print("")
    produces pure o end
}
fn show_time(v: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 }) -> atom {
    sequence proc[device_io]
        _: atom <- say_n("beam.time.frame_max = ", v.frame_max);
        _: atom <- say_n("beam.time.io_ms = ", v.io_ms);
        _: atom <- say_n("beam.time.open_ms = ", v.open_ms);
        _: atom <- say_n("beam.time.tick_ms = ", v.tick_ms);
        o: atom <- print("")
    produces pure o end
}
fn show_links_one(h: { address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }) -> atom {
    sequence proc[device_io]
        _: atom <- say_s("beam.link[].address = ", h.address);
        _: atom <- say_s("beam.link[].host = ", h.host);
        _: atom <- say_b("beam.link[].how.by_epmd = ", h.how.by_epmd);
        _: atom <- say_b("beam.link[].how.dials = ", h.how.dials);
        _: atom <- say_n("beam.link[].how.port = ", h.how.port);
        _: atom <- say_b("beam.link[].how.resolve = ", h.how.resolve);
        _: atom <- say_s("beam.link[].name = ", h.name);
        o: atom <- print("")
    produces pure o end
}
fn show_links(xs: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)]) -> atom {
    case xs of {
        []: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)] -> :ok;
        [h: { address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, rest: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)]] -> { _: atom <- show_links_one(h); show_links(rest) }
    }
}
fn show(c: { auth: { auth: string, cookie: string, redial: { initial_ms: int64, max_ms: int64, on: boolean }, transport: string }, links: List[{ address: string, host: string, how: { by_epmd: boolean, dials: boolean, port: int64, resolve: boolean }, name: string }, mem(normal)], net: { epmd: { mode: string, port: int64 }, listen_address: string, listen_port: int64, listener: string }, node: { creation: int64, name: string }, time: { frame_max: int64, io_ms: int64, open_ms: int64, tick_ms: int64 } }) -> atom {
    sequence proc[device_io]
        _: atom <- show_auth(c.auth);
        _: atom <- show_links(c.links);
        _: atom <- show_net(c.net);
        _: atom <- show_node(c.node);
        _: atom <- show_time(c.time);
        o: atom <- print("")
    produces pure o end
}
