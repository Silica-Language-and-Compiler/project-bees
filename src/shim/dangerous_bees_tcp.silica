// BEES native edge, M2: the foreign declarations and adapters for the 127.0.0.1 TCP entries of
// native/src/silica_bees_tcp.c. This is the one unit that names the foreign symbols; a worker in
// the program's root unit calls these adapters, qualified (`dangerous_bees_tcp@read_word(...)`), so
// the checker tracks what they return as tainted (SD-24), and the worker and its spawn site stay in
// the root unit (SD-17). Each adapter binds the foreign result before returning it: a foreign call
// in tail position faults (Silica's dangerous_ffi_adapter_tail_call; S4/M2 notes). Status codes are
// listed in native/dangerous_exposure_source/bees/silica_bees_native_wrapper.h.
module dangerous_bees_tcp;

export open/3;
export read_word/2;
export last_word/1;
export write_word/3;
export read_part/3;
export write_part/4;
export close/1;

wrapper_meta "dangerous_exposure_source/bees/silica_bees_native_wrapper.meta";

foreign c_wrapper "bees_tcp_open_prepare"
fn open_prepare_raw(slot: int64, timeout_ms: int64) -> int64;

foreign c_wrapper "bees_tcp_open_text"
fn open_text_raw(addr_ptr: uint8, addr_len: uint64) -> int64;

foreign c_wrapper "bees_tcp_read_word"
fn read_word_raw(slot: int64, timeout_ms: int64) -> int64;

foreign c_wrapper "bees_tcp_last_word"
fn last_word_raw(slot: int64) -> int64;

foreign c_wrapper "bees_tcp_write_word"
fn write_word_raw(slot: int64, timeout_ms: int64, word: int64) -> int64;

foreign c_wrapper "bees_tcp_read_part"
fn read_part_raw(slot: int64, timeout_ms: int64, count: int64) -> int64;

foreign c_wrapper "bees_tcp_write_part"
fn write_part_raw(slot: int64, timeout_ms: int64, word: int64, count: int64) -> int64;

foreign c_wrapper "bees_tcp_close"
fn close_raw(slot: int64) -> int64;

fn open(slot: int64, timeout_ms: int64, address: string) -> int64 {
    p: int64 <- open_prepare_raw(slot, timeout_ms);
    r: int64 <- open_text_raw(address);
    r + p
}

fn read_word(slot: int64, timeout_ms: int64) -> int64 {
    r: int64 <- read_word_raw(slot, timeout_ms);
    r + 0
}

fn last_word(slot: int64) -> int64 {
    r: int64 <- last_word_raw(slot);
    r + 0
}

fn write_word(slot: int64, timeout_ms: int64, word: int64) -> int64 {
    r: int64 <- write_word_raw(slot, timeout_ms, word);
    r + 0
}

fn read_part(slot: int64, timeout_ms: int64, count: int64) -> int64 {
    r: int64 <- read_part_raw(slot, timeout_ms, count);
    r + 0
}

fn write_part(slot: int64, timeout_ms: int64, word: int64, count: int64) -> int64 {
    r: int64 <- write_part_raw(slot, timeout_ms, word, count);
    r + 0
}

fn close(slot: int64) -> int64 {
    r: int64 <- close_raw(slot);
    r + 0
}

// open is two foreign calls: the compiler takes a pointer-plus-length pair only as a foreign
// function's whole parameter list, so slot and timeout go in a first call (SD-30; the C side keeps
// them per thread, and both calls run in one dispatch of the one ctl worker).
