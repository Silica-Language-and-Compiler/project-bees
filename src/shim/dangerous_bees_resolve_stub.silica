// BEES N1, TEST STUB worker: the same worker as dangerous_bees_resolve with the stub's fixed answers behind it (native/src/
// silica_bees_resolve.c, bees_resolve_stub_etf). Built in only by the resolver edge's --resolve-stub (tools/bees_edge_gen.py), for
// trials of several answers, a slow lookup and a non-loopback answer that the system resolver cannot give on demand.
module dangerous_bees_resolve_stub;
use dangerous_bees_resolve_stub_native;

export rslv/2;

fn rslv(msg: (string, actor_ref, int64), st: int64) -> (:no_reply, int64) {
    sequence proc[external_danger, concurrency]
        (host: string, reply_to: actor_ref, tag: int64) <- msg;
        answer: string <- dangerous_bees_resolve_stub_native@resolve_stub(host);
        // one cast per message (the one FFI result cast a worker may make), to the requester the message names
        _: boolean <- cast(reply_to, (:bees, tag, answer) impl ActorMessage {});
        // one lookup per worker: it ends after its one answer (the owner spawns a worker per lookup)
        _: atom <- stop_self(:normal)
    produces pure (:no_reply, st + 1) end
}
