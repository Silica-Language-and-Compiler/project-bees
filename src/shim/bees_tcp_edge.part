// ---- BEES carrier edge: pasted into each program's dangerous_ root unit by tools/bees_edge_gen.py. The carrier is the
// language's hosted (:tcp) carrier (transport design 6.2, 6.3: the Silica stdlib's dangerous_tcp_carrier over its socket
// wrappers, dangerous_sockets), a cast-only FFI worker behaviour a program installs with spawn_dangerous. The unit that
// includes this part provides `use carrier; use dangerous_sockets; use dangerous_tcp_carrier;` above its `module` line, and
// the root unit carries the dangerous_ prefix because the carrier is a Fifi wrapper (FFI wrapper specification 3.1).
//
// carrier_new(): one unopened (:tcp) carrier actor. The node (dangerous_bees_net@launch) opens it with (:open, owner, address), where
// address is "host:port" to connect or "listen:port" to listen on 127.0.0.1 (the generated bees_peers@link_address()). Its
// initial state is the stdlib's dangerous_tcp_carrier@initial(), spelled out because a record-returning call written inline
// as an argument has corrupted messages before (SD-31) and the language's own trials write the literal too.
fn carrier_new() -> dangerous_actor_ref {
    sequence proc[concurrency]
        c: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), fd: 0 - 1, rx_credit: 0, up: false, listening: false }, dangerous_tcp_carrier@carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces pure c end
}
