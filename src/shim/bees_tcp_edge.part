// ---- BEES TCP carrier edge (M2): pasted into each program's dangerous_ root unit by
// tools/bees_edge_gen.py (SD-17: a worker and its spawn site must be in one unit). The unit that
// includes it provides `use bees_atoms; use dangerous_bees_tcp;` above its `module` line.
//
// It speaks Silica's planned carrier actor contract (transport design 6.2) for one TCP link on
// 127.0.0.1. Silica's tagged tuples are written here as flat records, because a tag is an atom and
// D30 keeps atom literals in bees_atoms:
//   in  Cmd = { tag, peer, text, n }    (:open, owner, address)  tag open,   peer owner, text address
//                                      (:tx, segment, from)     tag tx,     n segment, peer from
//                                      (:credit, n)             tag credit, n
//                                      (:close)                 tag close
//   out Evt = { tag, n, reason, info } (:link_up, info) (:rx, segment: n) (:tx_credit, n)
//                                      (:tx_failed, reason) (:link_down, reason)
// A segment is ONE 8-byte word (an int64), not a string: a string cannot be built from foreign bytes
// without Recreatable (M0). The address is "listen:127.0.0.1:PORT" or "connect:127.0.0.1:PORT".
//
// Shape. The carrier is a front actor. On (:open) it spawns three dangerous workers whose designated
// receiver is the OWNER (raw results go to the owner, never through the carrier: a handler may not
// forward foreign data, spec 7.6) and a "conn" actor that holds them; every later command is forwarded
// to the link. Workers: ctl (open, close), rd (one word per request: one receive credit), wr (one
// word per request).
//
// SD-31: a function call that returns a record, written inline as the message of a cast, delivers
// garbage (the receiver reads zero fields and a null string). Every message here is bound to a local
// first, then cast.

fn cmd(tag: atom, peer: actor_ref, text: string, n: int64) -> { tag: atom, peer: actor_ref, text: string, n: int64 } {
    { tag: tag, peer: peer, text: text, n: n }
}

fn ev_link_up() -> { tag: atom, n: int64, reason: atom, info: string } {
    { tag: bees_atoms@a_link_up(), n: 0, reason: :ok, info: "127.0.0.1" }
}

fn ev_tx_credit(n: int64) -> { tag: atom, n: int64, reason: atom, info: string } {
    { tag: bees_atoms@a_tx_credit(), n: n, reason: :ok, info: "" }
}

fn ev_down(reason: atom) -> { tag: atom, n: int64, reason: atom, info: string } {
    { tag: bees_atoms@a_link_down(), n: 0, reason: reason, info: "" }
}

// The reason the contract names for a status code of the native edge (header: silica_bees_native_wrapper.h).
fn reason_of(status: int64) -> atom {
    case status == 1 of {
        true -> bees_atoms@a_closed();
        false -> case status == 2 of {
            true -> bees_atoms@a_reset();
            false -> case status == 3 of {
                true -> bees_atoms@a_timeout();
                false -> case status == 4 of {
                    true -> bees_atoms@a_closed();
                    false -> bees_atoms@a_fault()
                }
            }
        }
    }
}

// Result of a receive: status 0 is an :rx carrying the word, any other status ends the link.
fn ev_rx(status: int64, word: int64) -> { tag: atom, n: int64, reason: atom, info: string } {
    case status == 0 of {
        true -> { tag: bees_atoms@a_rx(), n: word, reason: :ok, info: "" };
        false -> ev_down(reason_of(status))
    }
}

fn ev_tx(status: int64) -> { tag: atom, n: int64, reason: atom, info: string } {
    case status == 0 of {
        true -> ev_tx_credit(1);
        false -> { tag: bees_atoms@a_tx_failed(), n: 0, reason: bees_atoms@a_link_down(), info: "" }
    }
}

fn ctl_event(closing: boolean, status: int64) -> { tag: atom, n: int64, reason: atom, info: string } {
    case closing of {
        true -> ev_down(bees_atoms@a_closed());
        false -> case status == 0 of {
            true -> ev_link_up();
            false -> ev_down(reason_of(status))
        }
    }
}

// ctl: the request is the address text, or "close". Reports :link_up and an initial send grant of 8,
// or :link_down; a local close reports :link_down :closed.
fn ctl_worker(
    msg: string,
    st: { owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64 }
) -> (:no_reply, { owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64 }) {
    sequence proc[external_danger, concurrency]
        closing: boolean <- msg == "close";
        r: int64 <- case closing of {
            true -> dangerous_bees_tcp@close(st.slot);
            false -> dangerous_bees_tcp@open(st.slot, st.open_ms, msg)
        };
        e1: { tag: atom, n: int64, reason: atom, info: string } <- ctl_event(closing, r);
        _: boolean <- cast(st.owner, e1 impl ActorMessage {});
        e2: { tag: atom, n: int64, reason: atom, info: string } <- ev_tx_credit(8);
        _: boolean <- case closing of {
            true -> true;
            false -> case r == 0 of {
                true -> cast(st.owner, e2 impl ActorMessage {});
                false -> true
            }
        }
    produces pure (:no_reply, st) end
}

// rd: each request is one receive credit; it reads one word and casts it to the owner as :rx. Status 4
// (the link already ended and was reported) is silent.
fn rd_worker(
    msg: int64,
    st: { owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64 }
) -> (:no_reply, { owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64 }) {
    sequence proc[external_danger, concurrency]
        r: int64 <- dangerous_bees_tcp@read_word(st.slot, st.io_ms);
        w: int64 <- dangerous_bees_tcp@last_word(st.slot);
        e: { tag: atom, n: int64, reason: atom, info: string } <- ev_rx(r, w);
        _: boolean <- case r == 4 of {
            true -> true;
            false -> cast(st.owner, e impl ActorMessage {})
        }
    produces pure (:no_reply, st) end
}

// wr: each request is one word to write; the result is :tx_credit 1 or :tx_failed.
fn wr_worker(
    msg: int64,
    st: { owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64 }
) -> (:no_reply, { owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64 }) {
    sequence proc[external_danger, concurrency]
        r: int64 <- dangerous_bees_tcp@write_word(st.slot, st.io_ms, msg);
        e: { tag: atom, n: int64, reason: atom, info: string } <- ev_tx(r);
        _: boolean <- cast(st.owner, e impl ActorMessage {})
    produces pure (:no_reply, st) end
}

fn grant_one(rd: dangerous_actor_ref, n: int64) -> boolean {
    sequence proc[concurrency]
        _: boolean <- cast(rd, 1 impl ActorMessage {});
        ok: boolean <- grant(rd, n - 1)
    produces pure ok end
}

fn grant(rd: dangerous_actor_ref, n: int64) -> boolean {
    case n <= 0 of {
        true -> true;
        false -> grant_one(rd, n)
    }
}

// The conn actor: forwards each command to the worker that serves it. It never changes state.
fn conn(
    msg: { tag: atom, peer: actor_ref, text: string, n: int64 },
    st: { ctl: dangerous_actor_ref, rd: dangerous_actor_ref, wr: dangerous_actor_ref }
) -> (:no_reply, { ctl: dangerous_actor_ref, rd: dangerous_actor_ref, wr: dangerous_actor_ref }) {
    sequence proc[concurrency]
        _: boolean <- case msg.tag == bees_atoms@a_open() of {
            true -> cast(st.ctl, msg.text impl ActorMessage {});
            false -> true
        };
        _: boolean <- case msg.tag == bees_atoms@a_tx() of {
            true -> cast(st.wr, msg.n impl ActorMessage {});
            false -> true
        };
        _: boolean <- case msg.tag == bees_atoms@a_credit() of {
            true -> grant(st.rd, msg.n);
            false -> true
        };
        _: boolean <- case msg.tag == bees_atoms@a_close() of {
            true -> cast(st.ctl, "close" impl ActorMessage {});
            false -> true
        }
    produces pure (:no_reply, st) end
}

fn make_conn(owner: actor_ref, slot: int64, open_ms: int64, io_ms: int64) -> actor_ref {
    sequence proc[concurrency]
        ctl: dangerous_actor_ref <- spawn_dangerous({ owner: owner, slot: slot, open_ms: open_ms, io_ms: io_ms }, ctl_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        rd: dangerous_actor_ref <- spawn_dangerous({ owner: owner, slot: slot, open_ms: open_ms, io_ms: io_ms }, rd_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        wr: dangerous_actor_ref <- spawn_dangerous({ owner: owner, slot: slot, open_ms: open_ms, io_ms: io_ms }, wr_worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        l: actor_ref <- spawn({ ctl: ctl, rd: rd, wr: wr }, conn, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces pure l end
}

// The carrier actor. Before (:open) it has no conn actor; a command before it is dropped.
fn carrier(
    msg: { tag: atom, peer: actor_ref, text: string, n: int64 },
    st: { slot: int64, open_ms: int64, io_ms: int64, opened: boolean, conn: actor_ref }
) -> (:no_reply, { slot: int64, open_ms: int64, io_ms: int64, opened: boolean, conn: actor_ref }) {
    sequence proc[concurrency]
        is_open: boolean <- msg.tag == bees_atoms@a_open();
        opening: boolean <- is_open and st.opened == false;
        l: actor_ref <- case opening of {
            true -> make_conn(msg.peer, st.slot, st.open_ms, st.io_ms);
            false -> st.conn
        };
        _: boolean <- case st.opened or opening of {
            true -> cast(l, msg impl ActorMessage {});
            false -> true
        }
    produces pure (:no_reply, { slot: st.slot, open_ms: st.open_ms, io_ms: st.io_ms, opened: st.opened or opening, conn: l }) end
}

// carrier_new(slot, open_ms, io_ms): the carrier actor for one link. slot (0 to 7) names the link in
// the native table; open_ms bounds listen/accept and connect; io_ms is the poll timeout of every
// read and write (a read that sees nothing for io_ms ends the link with :timeout).
fn carrier_new(slot: int64, open_ms: int64, io_ms: int64) -> actor_ref {
    sequence proc[concurrency]
        me: actor_ref <- self();
        c: actor_ref <- spawn({ slot: slot, open_ms: open_ms, io_ms: io_ms, opened: false, conn: me }, carrier, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces pure c end
}
