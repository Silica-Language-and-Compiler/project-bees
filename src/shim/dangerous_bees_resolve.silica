// BEES N1: the resolver worker, a cast-only FFI worker behaviour installed with spawn_dangerous by a node's root unit
// (src/shim/bees_resolve_edge.part; the spawn site stays in the root unit, SD-17). It is the ONE host-name resolver of BEES (the
// S14 resolver of spikes/S14-name-resolution.md is folded into it). One request per message, naming the actor to answer:
// (host, reply_to, tag) -> reply_to gets (:bees, tag, etf_binary), where tag is the caller's own number echoed back (so the owner
// can drop an answer it has given up on) and etf_binary is the resolver edge's one ETF binary term "ok <csv> <n6>" or
// "err <reason>" (FFI-derived, decoded by reply_to with the language's decode((:etf), ...) inside a produces-pure block and
// filtered by bees_addr there). getaddrinfo has no timeout of its own: the owner keeps the budget, and a lookup the system is
// slow to fail holds only its own worker's thread.
//
// STATED GOAL (roadmap D42): this unit and its C (native/src/silica_bees_resolve.c) are to be replaced by a Silica implementation
// of name resolution, with no C of BEES's own, keeping the contract above so that the owner does not change. See
// development-plan/spikes/S14-name-resolution.md section 9.
module dangerous_bees_resolve;
use dangerous_bees_resolve_native;

export rslv/2;

fn rslv(msg: (string, actor_ref, int64), st: int64) -> (:no_reply, int64) {
    sequence proc[external_danger, concurrency]
        (host: string, reply_to: actor_ref, tag: int64) <- msg;
        answer: string <- dangerous_bees_resolve_native@resolve_etf(host);
        // one cast per message (the one FFI result cast a worker may make), to the requester the message names
        _: boolean <- cast(reply_to, (:bees, tag, answer) impl ActorMessage {});
        // one lookup per worker: it ends after its one answer (the owner spawns a worker per lookup)
        _: atom <- stop_self(:normal)
    produces pure (:no_reply, st + 1) end
}
