// ---- BEES TRUST link over mutual TLS 1.3 (N4.1): pasted by tools/bees_trust_gen.py into the root unit of a TRUST node whose
// bees.config does not set plaintext_test_only. A connection's link is a TLS worker (dangerous_bees_tls@ttls) that owns the
// language's (:tcp) carrier c and speaks the carrier contract upward, so the node edge (bees_trust_node.part) and TRUST's
// connection actors use it as they use a carrier. The worker's spawn_dangerous site is here, in the root unit, as for the
// carrier (SD-17); the listener (dangerous_bees_tls@ttlsl) starts one carrier and one
// worker per accepted connection itself.
fn trust_link(c: dangerous_actor_ref) -> dangerous_actor_ref {
    sequence proc[concurrency]
        l: dangerous_actor_ref <- spawn_dangerous({ owner: actor_ref_of_word(0), car: c, w: c, h: 0 - 1, role: 0, phase: 0, credit: 0, car_out: false, srv: 0 - 1, told: false, fp_sent: false }, dangerous_bees_tls@ttls, stack_policy(0, :keep_last_message), state_policy(:keep_state_area))
    produces pure l end
}
// the listening link: a plain listener actor (dangerous_bees_tls@ttlsl) that owns the listening carrier c and starts one link
// per accepted connection
fn trust_listen_link(c: dangerous_actor_ref, l: actor_ref, spec: string) -> boolean {
    sequence proc[concurrency]
        ll: actor_ref <- spawn({ owner: actor_ref_of_word(0), car: c }, dangerous_bees_tls@ttlsl, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: boolean <- cast(ll, (:open, l, spec) impl ActorMessage {})
    produces pure ok end
}
// the TLS link adds the dial budget itself when it opens its carrier (dangerous_bees_tls@ttls), the pinned-server lookup needs "host:port"
fn trust_dial_address(addr: string) -> string { addr }
