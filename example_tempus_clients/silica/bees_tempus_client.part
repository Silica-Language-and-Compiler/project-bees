// ---- BEES TEMPUS client library, active part (C2; development-plan/tempus-design.md section 16.4): pasted by
// tools/bees_tempus_gen.py (--part example_tempus_clients/silica/bees_tempus_client.part) into the dangerous_ root unit of an application
// that is a TEMPUS client, after the TEMPUS link edge (src/tempus/bees_tempus_link.part). It is here and not in a unit
// because it dials and listens: the carrier's spawn site stays in the root unit (SD-17) and a root unit may not call a
// function of a dangerous_ unit (E4042). A client is an ordinary TEMPUS peer on the wire: every connection is the node's
// own connection actor (dangerous_bees_tempus_conn@tcon: mutual TLS 1.3, the adverts, the channel binding, the token
// rules, the two proofs, one request and one reply), in both positions. Nothing here reads a file or holds a default:
// every value is an argument (the application passes values). It drives no node by actor messages.
//
// tempus_client_start(app, ci) -> the client actor. ci is
//   { id, pub, seed, seed2, addr, token, listen, spec, wl, kid, ppub, now, skew, count, ms, mst }: the client's TEMPUS
//   identity (peer id, public key, private seed), the seed of a second signer (it signs the proof of a dial whose flags
//   say so: the way to a node's refusal of a wrong proof; "" gives a signer that signs with no key), the address in the
//   client's advert, its token, the carrier's listen text ("" for a client that never listens), the engine's credential
//   text (tempus_spec), the tempus whitelist, the current producer key (kid, ppub), the clock in seconds for the client's
//   own token checks, clock_skew, the most entries a frame may hold, and the bound of a connection as a number and as text.
// What the application may ask of the client actor:
//   tempus_client_dial(cl, addr, req, cid, flags)   one connection to "a.b.c.d:port" with the one request `req` (a frame
//       body of bees_tempus_client; "" closes after admission); flags 1: the proof is signed by the second signer
//   tempus_client_set(cl, what, s, n)               a value for the connections that follow: what 3 the token (s), 4 the
//       peer id (s), 5 the clock (n, seconds), 6 the current kid (s), 7 the public key in the advert (s), 8 the whitelist (s)
// What the application is told, as (:bees, op, s1, s2, cid, m, who):
//   66 the client listens (s1: "port:N")
//   60 the reply of a dialed request (s1: the frame body, its entries verified; s2 and m: the admitted peer's descriptor
//      and 4 * (whitelist index + 1) + its type)                                     61 the dialed connection failed (s1: why)
//   62 the peer answered key_rotated (s1: the kid it named)                          65 admitted and closed (no request)
//   63 an admitted peer's request to the listening client (s1: the frame body, s2: the peer's descriptor as ETF bytes;
//      cid: the accepted connection's number; who: its actor). The application answers every one, when it chooses:
//      tempus_client_answer(who, body) or tempus_client_close(who) (close with no reply)
//   64 an accepted connection has closed
//   67 the connection actor refused an accepted peer (s1: the audit event; s2: the peer's descriptor when m is 1, its id
//      alone when m is 0; ruling NQ-19: a bridge scores it, a client has no use for it)
fn tc_cfg(s: $CS$, flags: int64) -> $CFG$ {
    d: $D$ <- bees_tempus_frame@desc(s.c.id, s.c.pub, s.c.addr, s.c.token);
    { node: s.app, sig: case flags == 1 of { true -> s.sig2; false -> s.sig }, edge: s.edge, rnd: s.rnd, mine: bees_tempus_frame@enc_advert(d), mtok: s.c.token, kid: s.c.kid, ppub: s.c.ppub, wl: s.c.wl, now: s.c.now, skew: s.c.skew, count: s.c.count, ms: s.c.ms, ext: false }
}
fn tc_with(s: $CS$, na: int64, c: $CI$) -> $CS$ { { app: s.app, sig: s.sig, sig2: s.sig2, edge: s.edge, rnd: s.rnd, na: na, c: c } }
fn tc_set(c: $CI$, what: int64, v: string, n: int64) -> $CI$ {
    { id: case what == 4 of { true -> v; false -> c.id }, pub: case what == 7 of { true -> v; false -> c.pub }, seed: c.seed, seed2: c.seed2, addr: c.addr, token: case what == 3 of { true -> v; false -> c.token }, listen: c.listen, spec: c.spec, wl: case what == 8 of { true -> v; false -> c.wl }, kid: case what == 6 of { true -> v; false -> c.kid }, ppub: c.ppub, now: case what == 5 of { true -> n; false -> c.now }, skew: c.skew, count: c.count, ms: c.ms, mst: c.mst }
}
fn tc_tell(s: $CS$, me: actor_ref, op: int64, s1: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(s.app, (:bees, op, s1, "", 0, 0, me) impl ActorMessage {})
    produces pure ok end
}
fn tc_bees(s: $CS$, me: actor_ref, b: $NB$) -> $CS$ {
    case b.op of {
        1 -> { sequence _: boolean <- tempus_dial(tc_cfg(s, b.m), b.s1, b.s2, b.n, s.c.spec, s.c.mst, s.c.ms) produces pure s end };
        2 -> tc_with(s, s.na, tc_set(s.c, b.m, b.s1, b.n));
        _: int64 -> s
    }
}
fn tcli(msg: $NM$, s: $CS$) -> (:no_reply, $CS$) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        s2: $CS$ <- case msg of {
            (:accepted, l: dangerous_actor_ref, _i: string) -> { sequence _: boolean <- tempus_accept(tc_cfg(s, 0), l, s.na + 1) produces pure tc_with(s, s.na + 1, s.c) end };
            (:link_up, info: string) -> { sequence _: boolean <- tc_tell(s, me, 66, info) produces pure s end };
            (:rx, _s: string) -> s;
            (:tx_credit, _n: int64) -> s;
            (:tx_failed, _w: atom) -> s;
            (:link_down, _w2: atom) -> s;
            (:bees, op: int64, s1: string, sb: string, n: int64, m: int64, who: actor_ref) -> tc_bees(s, me, { op: op, s1: s1, s2: sb, n: n, m: m, who: who })
        }
    produces pure (:no_reply, s2) end
}
fn tempus_client_start(app: actor_ref, ci: $CI$) -> actor_ref {
    sequence proc[concurrency]
        e: dangerous_actor_ref <- spawn_dangerous(0, dangerous_bees_tempus_edge@ted, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        r: dangerous_actor_ref <- spawn_dangerous(0, dangerous_bees_trust_edge@trnd, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        sg: actor_ref <- tempus_signer(e, ci.seed);
        sg2: actor_ref <- tempus_signer(e, ci.seed2);
        cl: actor_ref <- spawn({ app: app, sig: sg, sig2: sg2, edge: e, rnd: r, na: 0, c: ci }, tcli, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- case length_bytes(ci.listen) > 0 of { true -> tempus_listen(cl, ci.listen, ci.spec, ci.ms); false -> true }
    produces pure cl end
}
fn tempus_client_dial(cl: actor_ref, addr: string, req: string, cid: int64, flags: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(cl, (:bees, 1, addr, req, cid, flags, cl) impl ActorMessage {})
    produces pure ok end
}
fn tempus_client_set(cl: actor_ref, what: int64, s: string, n: int64) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(cl, (:bees, 2, s, "", n, what, cl) impl ActorMessage {})
    produces pure ok end
}
fn tempus_client_answer(who: actor_ref, body: string) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(who, (:bees, 20, body, "", 0) impl ActorMessage {})
    produces pure ok end
}
fn tempus_client_close(who: actor_ref) -> boolean {
    sequence proc[concurrency]
        ok: boolean <- cast(who, (:bees, 21, "", "", 0) impl ActorMessage {})
    produces pure ok end
}
