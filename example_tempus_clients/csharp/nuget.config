<?xml version="1.0" encoding="utf-8"?>
<!-- The C# extension for TEMPUS uses no NuGet package. This file removes every package source, so that a restore has
     nowhere to send a request: `dotnet build` then works with no network. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
