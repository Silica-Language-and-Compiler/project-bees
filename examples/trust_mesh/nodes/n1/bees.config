%% examples/trust_mesh: node n1 of the five-node TRUST mesh. It is a TRUST server (the whitelist lists the certificates of
%% the other four nodes) and a TRUST client of the other four (the pin file), over mutual TLS 1.3. Its identity is n1.pem,
%% a self-signed TEST ONLY certificate. No cacertfile: a peer is trusted by the SHA-512 of its certificate alone (D43).
%% The five nodes' files differ only in the name, the port and the certificate.
[
  {mode, trust},
  {node, [{name, "n1@127.0.0.1"}]},
  {trust, [
    {port, 24401},
    {listen_address, "127.0.0.1"},                 %% required, there is no default; loopback because all five run on one machine
    {tls_opts, [{certfile, "../../certs/n1.pem"},
                {keyfile, "../../certs/n1-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},    %% who may call this node, and what
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},    %% whom this node may call
    {call_timeout_ms, 5000},
    {connect_timeout_ms, 3000},
    {first_frame_timeout_ms, 2000},
    {client_handshake_timeout, 5000},
    {suspicion_limit, 3},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {args_len_max, 4096},
    {term_depth_max, 32},
    %% sessions: one TLS connection to a peer carries every call to it. idle_ms is longer than the example runs, so the
    %% 20 connections of the mesh all stay open until the nodes are told to exit.
    {session, #{max_inflight => 8, max_calls => 100, max_age_ms => 60000, idle_ms => 30000, drain_ms => 1000}}
  ]}
].
