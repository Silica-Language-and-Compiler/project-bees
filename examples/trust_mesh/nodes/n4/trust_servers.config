%% BEES's pin file: the servers node n4 may call, address => that server's certificate (its SHA-512 is the pin).
%% The order is the order in which this node calls them (roles/mesh.role): the next node, then two on, three on, four on.
#{
  "127.0.0.1:24405" => "n5.pem",
  "127.0.0.1:24401" => "n1.pem",
  "127.0.0.1:24402" => "n2.pem",
  "127.0.0.1:24403" => "n3.pem"
}.
