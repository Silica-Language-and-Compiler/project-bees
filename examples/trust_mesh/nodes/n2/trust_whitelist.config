%% SEMP's whitelist form: certificate file => what that peer may call. Node n2 accepts the other four nodes, and each
%% may call mesh:relay/2 and nothing else.
#{
  "n1.pem" => [{mesh, [{relay, 2}]}],
  "n3.pem" => [{mesh, [{relay, 2}]}],
  "n4.pem" => [{mesh, [{relay, 2}]}],
  "n5.pem" => [{mesh, [{relay, 2}]}]
}.
