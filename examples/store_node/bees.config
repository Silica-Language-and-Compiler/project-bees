%% examples/store_node: the configuration of the example node. It is not compiled in: tools/bees_pack.py packs it into
%% node.sildat (`make pack`), and the program reads that store when it starts. Change a value, pack again, start again:
%% no rebuild. {auth, none} is the loopback-only test setting (no authentication, no encryption).
[ {mode, beam},
  {node, [{name, "a@localhost"}]},
  {beam, [{transport, tcp}, {auth, none}, {frame_size_max, 4096}, {listen_address, "127.0.0.1"},
          {listen_port, 23400}, {epmd, none}]} ].
