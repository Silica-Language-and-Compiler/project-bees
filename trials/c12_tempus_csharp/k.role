// C12 C# client trial: node K, the test node the C# example client meets; its sentinel is the C# client's
// listener.
fn port() -> string { "25400" }
fn sents() -> string { "127.0.0.1:25402" }
// a test program: externally driven, by the test unit (src/tempus_test/bees_tempus_test.silica). The C# client sends
// none of the test frames; the trial tool sends them with the Python example client (walk.py).
fn driven() -> boolean { true }
fn ext_start(app: actor_ref) -> actor_ref { bees_tempus_test@start(tempus_ids@now()) }
fn tick_ms() -> uint64 { 1000 }
// the node's own token: tempus_edge, valid 1000 to 2000 (the node's clock is the trial's value, 1500)
fn own_tok() -> int64 { 1 }
