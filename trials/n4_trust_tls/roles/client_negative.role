// N4.1: N3's negative suite over mutual TLS 1.3 (steps 2 to 16; the identity of node b is now its certificate, so the
// stand-in fingerprint fp_b() is empty and step 1, an unlisted stand-in, becomes the unlisted certificate u.pem of the
// refusals scenario, run with openssl s_client). The N3 text: the negative-path suite (SEMP's "Typical failure modes" that apply without TLS) and trials (b), (c), (d): each refusal
// closes the connection with no error body (a raw peer counts the bytes it got back; a trpc call sees closed and no result),
// node a writes an audit line, and the suspicion of b.cert moves as inter-nodal-modes 3.7 says (node a's suspicion_limit is 8).
// Steps 1 to 7 are raw peers, 8 to 16 trpc calls; step 16 runs after node a's operator reset (9 s after its start).
fn fp_b() -> string { bees_trust_conf@self_fp() }
fn hello() -> string { f4(bees_trust_frame@enc_hello()) }
// #{t => hello, ver => 2}
fn hello_v2() -> string {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [131, 116, 0, 0, 0, 2, 119, 1, 116, 119, 5, 104, 101, 108, 108, 111, 119, 3, 118, 101, 114, 97, 2]
    produces pure f4(bs(xs)) end
}
// a map that claims two pairs and holds one: truncated
fn bad_map() -> string {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [131, 116, 0, 0, 0, 2, 119, 1, 116, 119, 4, 99, 97, 108, 108]
    produces pure f4(bs(xs)) end
}
// a 4-byte length of 100000, above frame_size_max 4096, and a few bytes: refused when the length is read
fn oversize() -> string {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [0, 1, 134, 160, 131, 116, 0, 0]
    produces pure bs(xs) end
}
fn call_first() -> string { f4(bees_trust_frame@enc_request(bees_atoms@a_call(), "r0", bees_atoms@a_demo(), bees_atoms@a_add(), 2, ints2(1, 2))) }
fn label(step: int64) -> string {
    case step of {
        1 -> "(over TLS: the refusals scenario's unlisted certificate)";
        2 -> "raw: token_present with a token the server never issued";
        3 -> "raw: a call frame before the token step";
        4 -> "raw: hello with ver 2";
        5 -> "raw: hello, then a malformed map";
        6 -> "raw: hello, then a frame length above frame_size_max";
        7 -> "raw: the fingerprint, then nothing (first-frame timeout)";
        8 -> "call erlang:apply/3 (forbidden)";
        9 -> "call demo:add([1, 2]) (permitted)";
        10 -> "cast demo:note([7]) (permitted)";
        11 -> "call bees_trust_admin:reset/1 (forbidden: the reset is local only)";
        12 -> "call demo:secret/0 (not in b.cert's spec)";
        13 -> "call demo:crash/1 (the user code fails)";
        14 -> "call demo:slow([300000000]) (call timeout)";
        15 -> "call demo:add([1, 2]) while quarantined";
        16 -> "call demo:add([1, 2]) after the operator reset";
        _: int64 -> "?"
    }
}
fn start(step: int64, me: actor_ref) -> atom {
    case step of {
        1 -> raw_open(1, repeated(7, 64), me, false);
        2 -> raw_open(2, cat(fp_b(), f4(bees_trust_frame@enc_token_present(repeated(120, 48)))), me, false);
        3 -> raw_open(3, cat(fp_b(), call_first()), me, false);
        4 -> raw_open(4, cat(fp_b(), hello_v2()), me, false);
        5 -> raw_open(5, cat(fp_b(), cat(hello(), bad_map())), me, false);
        6 -> raw_open(6, cat(fp_b(), cat(hello(), oversize())), me, false);
        7 -> raw_open(7, fp_b(), me, false);
        8 -> trpc_call(server(), bees_atoms@a_erlang(), bees_atoms@a_apply(), 3, ints3(1, 2, 3), me, 8);
        9 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_add(), 2, ints2(1, 2), me, 9);
        10 -> trpc_cast(server(), bees_atoms@a_demo(), bees_atoms@a_note(), 1, ints1(7), me, 10);
        11 -> trpc_call(server(), bees_atoms@a_bees_trust_admin(), bees_atoms@a_reset(), 1, ints1(0), me, 11);
        12 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_secret(), 0, no_args(), me, 12);
        13 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_crash(), 1, ints1(1), me, 13);
        14 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_slow(), 1, ints1(300000000), me, 14);
        15 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_add(), 2, ints2(1, 2), me, 15);
        16 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_add(), 2, ints2(1, 2), me, 16);
        _: int64 -> say("negative suite done")
    }
}
// step 16 waits for node a's operator reset (9 s after node a starts); step 15 waits 2 s for the abandoned slow worker to end;
// the others follow 150 ms apart, so that each step's
// server lines are written before the next step starts
fn next(step: int64, me: actor_ref) -> atom {
    case step of { 15 -> wake(me, 6500, 16); 14 -> wake(me, 2000, 15); _: int64 -> wake(me, 150, step + 1) }
}
fn driver(r: { req: int64, what: atom, value: string }, step: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        go: boolean <- r.value == "go";
        _: atom <- case go of {
            true -> start(r.req, me);
            false -> {
                sequence
                    _: atom <- say(concat(concat(concat("step ", bees_trust_frame@int_text(r.req)), concat(" ", label(r.req))), concat(": ", outcome(r))));
                    _: atom <- next(r.req, me)
                produces pure :ok end
            }
        }
    produces pure (:no_reply, step + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        b: int64 <- trust_boot();
        _: atom <- start_reporter();
        _: atom <- trust_start();
        d: actor_ref <- spawn(0, driver, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- start(2, d);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
