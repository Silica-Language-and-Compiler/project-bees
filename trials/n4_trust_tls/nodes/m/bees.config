%% N4.1 trial: node m, a TRUST client over mutual TLS 1.3 (standalone: no whitelist, so it accepts no inbound connection). Its
%% identity is n.pem; its pin file pins node a's address to u.pem, which node a does not present (server_not_pinned).
[
  {mode, trust},
  {node, [{name, "m@127.0.0.1"}]},
  {trust, [
    {port, 22502},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../certs/n.pem"},
                {keyfile, "../../certs/n-key.pem"},
                {cacertfile, "../../certs/ca.pem"}]},
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 2000},
    {connect_timeout_ms, 3000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096}
  ]}
].
