%% SEMP's whitelist form: certificate file => permission spec (inter-nodal-modes 3.3). Entry 0 is b.pem (the operator reset
%% of the negative scenario resets entry 0). u.pem, r.pem, x.pem and z.pem are not listed: the refusals scenario presents them.
#{
  "b.pem" => [{demo, [{add, 2}, {echo, 1}, {slow, 1}, {crash, 1}, {note, 1}]}],
  "n.pem" => none,
  "p.pem" => [{demo, [{add, 2}]}],
  "w.pem" => [{demo, [{add, 2}, {echo, 1}]}],       %% self-signed, no CA anywhere: node q (D43)
  "gone.pem" => any                               %% no such certificate: logged at boot and skipped, as SEMP does
}.
