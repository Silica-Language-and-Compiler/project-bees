%% N4.1 trial: node a, the TRUST server, over mutual TLS 1.3 (no plaintext_test_only). Its identity is a.pem (signed by the
%% trial's test CA); the peers it accepts are the whitelist's certificates, recognised by the SHA-512 of their DER (D11).
[
  {mode, trust},
  {node, [{name, "a@127.0.0.1"}]},
  {trust, [
    {port, 47601},
    {listen_address, "127.0.0.1"},                 %% required, no default (R6); loopback for the trial, not required by TLS
    {tls_opts, [{certfile, "../../certs/a.pem"},
                {keyfile, "../../certs/a-key.pem"},
                {cacertfile, "../../certs/ca.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../certs"},
    {call_timeout_ms, 400},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 8},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32}
  ]}
].
