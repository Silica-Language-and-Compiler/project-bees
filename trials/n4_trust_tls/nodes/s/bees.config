%% N4.1 trial: node a, the TRUST server, over mutual TLS 1.3 (no plaintext_test_only). Its identity is a.pem (signed by the
%% trial's test CA, but node a configures no CA, D43); the peers it accepts are the whitelist's certificates, recognised by the SHA-512 of their DER (D11).
[
  {mode, trust},
  {node, [{name, "a@127.0.0.1"}]},
  {trust, [
    {port, 22500},
    {listen_address, "127.0.0.1"},                 %% required, no default (R6); loopback for the trial, not required by TLS
    %% D43: no cacertfile: no chain is verified; a peer is trusted by the SHA-512 pin of its certificate and the whitelist
    {tls_opts, [{certfile, "../../certs/a.pem"},
                {keyfile, "../../certs/a-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    %% D44: p.pem alone may negotiate classical X25519 (as a board would, D41); every other peer must use X25519MLKEM768
    {classical_allowed_certs, ["p.pem"]},
    {whitelist_cert_dir, "../../certs"},
    {call_timeout_ms, 400},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 8},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32}
  ]}
].
