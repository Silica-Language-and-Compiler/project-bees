%% N4.1 trial: node q, a TRUST client over mutual TLS 1.3 (standalone: no whitelist, so it accepts no inbound connection). Its
%% identity is w.pem, a SELF-SIGNED certificate, and it configures no cacertfile (D43): node a trusts it by its pin and the
%% whitelist, and node q trusts node a by the pin of a.pem alone (its pin file), with no chain verified.
[
  {mode, trust},
  {node, [{name, "q@127.0.0.1"}]},
  {trust, [
    {port, 22503},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../certs/w.pem"},
                {keyfile, "../../certs/w-key.pem"}]},
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 2000},
    {connect_timeout_ms, 3000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096}
  ]}
].
