%% N4.1 trial: node b, a TRUST client over mutual TLS 1.3 (standalone: no whitelist, so it accepts no inbound connection). Its
%% identity is b.pem; it pins node a's address to a.pem (the SHA-512 of a.pem's DER must be what node a presents).
[
  {mode, trust},
  {node, [{name, "b@127.0.0.1"}]},
  {trust, [
    {port, 47602},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../certs/b.pem"},
                {keyfile, "../../certs/b-key.pem"},
                {cacertfile, "../../certs/ca.pem"}]},
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 2000},
    {connect_timeout_ms, 3000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096}
  ]}
].
