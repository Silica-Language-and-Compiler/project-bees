        _: int64 <- e_10(h, rg, b, c, a);
        _: int64 <- e_11(h, rg, b, c, a);
        _: int64 <- e_12(h, rg, b, c, a);
        _: int64 <- e_13(h, rg, b, c, a);
        _: int64 <- e_14(h, rg, b, c, a);
        _: int64 <- e_15(h, rg, b, c, a);
        _: int64 <- e_16(h, rg, b, c, a);
        _: int64 <- e_17(h, rg, b, c, a);
        _: int64 <- e_18(h, rg, b, c, a);
        _: int64 <- e_19(h, rg, b, c, a)
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[device_io, mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        a: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        M: lifetime <- fresh_lifetime();
        hr: region(L, normal) <- alloc_region(normal);
        h: { r: region(L, normal) } <- { r: hr };
        _: int64 <- run_all(h, rg, b, c, a);
        println("m1_etf_terms done")
    produces pure 0 end
}
