%% N2T (edge d: dials the hub inside TLS with redial on; certificate d)
[ {mode, beam},
  {node, [{name, "d@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/d.pem"}, {keyfile, "../../certs/d-key.pem"}, {cacertfile, "../../certs/ca.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23203}, {epmd, none}, {redial, true}, {redial_initial_ms, 250}, {redial_max_ms, 4000}]} ].
