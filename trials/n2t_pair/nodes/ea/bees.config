%% N2T (edge a: dials the hub inside TLS; certificate a. Entry dangerous_ea_wrongcookie is the same node with another cookie)
[ {mode, beam},
  {node, [{name, "ea@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/a.pem"}, {keyfile, "../../certs/a-key.pem"}, {cacertfile, "../../certs/ca.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23201}, {epmd, none}, {redial, false}]} ].
