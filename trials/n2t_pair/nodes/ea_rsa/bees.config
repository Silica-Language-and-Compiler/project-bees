%% N2T (edge a with an RSA 2048 certificate: accepted (N2T Q4))
[ {mode, beam},
  {node, [{name, "ea@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/rsa.pem"}, {keyfile, "../../certs/rsa-key.pem"}, {cacertfile, "../../certs/ca.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23201}, {epmd, none}, {redial, false}]} ].
