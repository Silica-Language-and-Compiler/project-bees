%% N2T (edge c: dials the hub inside TLS; certificate b)
[ {mode, beam},
  {node, [{name, "ec@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/b.pem"}, {keyfile, "../../certs/b-key.pem"}, {cacertfile, "../../certs/ca.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23202}, {epmd, none}, {redial, false}]} ].
