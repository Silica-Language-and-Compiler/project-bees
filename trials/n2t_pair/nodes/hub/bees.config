%% N2T (the hub: one TLS listener for every edge; certificate h; it trusts the trial CA and the RSA CA (ca_both.pem))
[ {mode, beam},
  {node, [{name, "hub@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/h.pem"}, {keyfile, "../../certs/h-key.pem"}, {cacertfile, "../../certs/ca_both.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23200}, {epmd, none}]} ].
