%% N2T (a hub whose certificate names otherhost, not localhost: a dialing edge refuses it)
[ {mode, beam},
  {node, [{name, "hub@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/otherhost.pem"}, {keyfile, "../../certs/otherhost-key.pem"}, {cacertfile, "../../certs/ca.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23200}, {epmd, none}]} ].
