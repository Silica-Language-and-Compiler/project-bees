%% N2T (edge a with a certificate of ANOTHER CA: the hub refuses it)
[ {mode, beam},
  {node, [{name, "ea@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../certs/rogue.pem"}, {keyfile, "../../certs/rogue-key.pem"}, {cacertfile, "../../certs/ca.pem"}]}, {tls_verify, verify_peer},
          {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"}, {listen_port, 23201}, {epmd, none}, {redial, false}]} ].
