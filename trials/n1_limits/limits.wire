# N1 limits trial: an in-memory node manifest (no link is opened) whose bees.config sets beam.frame_size_max to 65536, so that
# the generated decode limits (bees_msgs) and the unframe cap (bees_peers@frame_max) are the configured ones
node   b@127.0.0.1
peer   a@127.0.0.1 127.0.0.1 21800 dial
remote str @ a@127.0.0.1 cast { s: string }
local  num cast { n: int64 }
