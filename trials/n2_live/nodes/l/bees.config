%% N2 live trial, node beesl: listens on 127.0.0.1:47441, registers with the private EPMD of the trial (127.0.0.1:4399),
%% net_ticktime 8 s like the stock node
[ {mode, beam},
  {node, [{name, "beesl@localhost"}]},
  {beam, [{transport, tcp}, {frame_size_max, 4096}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 47441}, {epmd, external}, {epmd_port, 4399}, {net_ticktime_s, 8}]} ].
%% {frame_size_max, 4096}: N2's cap, kept (N1 made the default BEAM's 4294967295, R1, and lets the file set it)
