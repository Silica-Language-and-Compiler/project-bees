%% N2 live trial, node beesd: dials stock@localhost, whose port it asks the private EPMD of the trial (127.0.0.1:4399).
%% The peer host is the NAME localhost with port epmd (N2b): resolved first by the resolver edge, then the EPMD at the IPv4 literal is dialed.
[ {mode, beam},
  {node, [{name, "beesd@localhost"}]},
  {beam, [{transport, tcp}, {frame_size_max, 4096}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {epmd, external}, {epmd_port, 4399}, {net_ticktime_s, 8},
          {peers, [{"stock@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]}]}]} ].
%% {frame_size_max, 4096}: N2's cap, kept (N1 made the default BEAM's 4294967295, R1, and lets the file set it)
