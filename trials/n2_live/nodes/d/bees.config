%% N2 live trial, node beesd: dials stock@localhost, whose port it asks the private EPMD of the trial (127.0.0.1:4399)
[ {mode, beam},
  {node, [{name, "beesd@localhost"}]},
  {beam, [{transport, tcp}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {epmd, external}, {epmd_port, 4399}, {net_ticktime_s, 8},
          {peers, [{"stock@localhost", [{host, "127.0.0.1"}, {port, epmd}, {role, dial}]}]}]} ].
