// ---- the service of the live trial's listening node: inbox prints what arrives; to a hello it answers by casting to the
// stock node's registered process outbox, whose proxy hands out its pid (the .beam manifest: pid outbox deliver inbox), so the
// stock node receives {Pid, #{op => reply, n => N + 1}} and can answer through Pid (a SEND that BEES delivers here).
fn inbox(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say(concat(concat("inbox got op=", bees_atoms@spelling(msg.op)), concat(" n=", num_text(msg.n))));
        r: { op: atom, n: int64 } <- { op: bees_atoms@a_reply(), n: msg.n + 1 };
        _: boolean <- case msg.op == bees_atoms@a_hello() of { true -> cast_registered(bees_atoms@a_outbox(), r impl ActorMessage {}); false -> true };
        _: atom <- case msg.op == bees_atoms@a_hello() of { true -> say("inbox: answered with a cast to outbox"); false -> :ok }
    produces pure (:no_reply, st + 1) end
}
fn num_text(n: int64) -> string {
    case n of { 1 -> "1"; 2 -> "2"; 3 -> "3"; 4 -> "4"; 41 -> "41"; 42 -> "42"; _: int64 -> "?" }
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        i: actor_ref <- spawn_registered(0, inbox, bees_atoms@a_inbox(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
