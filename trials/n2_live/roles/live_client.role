// ---- the dialing node of the live trial: outbox prints what the stock node sends; a client casts to the stock node's
// registered process inbox 1.5 s after start (the EPMD lookup and the handshake take well under that).
fn outbox(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say(concat(concat("outbox got op=", bees_atoms@spelling(msg.op)), concat(" n=", case msg.n == 42 of { true -> "42"; false -> "?" })))
    produces pure (:no_reply, st + 1) end
}
fn sender(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: 41 };
        _: boolean <- cast_registered(bees_atoms@a_inbox(), m impl ActorMessage {});
        _: atom <- say("client: cast to inbox sent")
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        o: actor_ref <- spawn_registered(0, outbox, bees_atoms@a_outbox(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        s: actor_ref <- spawn(0, sender, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        t: timer_ref <- send_after(1500, s, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
