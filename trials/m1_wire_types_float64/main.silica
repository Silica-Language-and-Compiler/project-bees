fn run_all(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- t_float64_0(rg, b, c);
        _: int64 <- t_float64_1(rg, b, c);
        _: int64 <- t_float64_2(rg, b, c);
        _: int64 <- t_float64_3(rg, b, c);
        _: int64 <- t_float64_4(rg, b, c);
        _: int64 <- t_float64_5(rg, b, c);
        _: int64 <- t_float64_6(rg, b, c);
        _: int64 <- t_float64_7(rg, b, c);
        _: int64 <- t_float64_8(rg, b, c);
        _: int64 <- t_float64_9(rg, b, c);
        _: int64 <- t_float64_10(rg, b, c);
        _: int64 <- t_float64_11(rg, b, c);
        _: int64 <- t_float64_12(rg, b, c);
        _: int64 <- t_float64_13(rg, b, c);
        println("m1_wire_types_float64 done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        _: int64 <- run_all(rg, b, c)
    produces pure 0 end
}

