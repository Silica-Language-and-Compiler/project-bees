%% N5 trial over mutual TLS 1.3: node r, the soak's session server (make measure): sessions of 1000 calls, 8 in work. Its identity is a.pem of trials/n4_trust_tls/certs
%% (TEST ONLY certificates); the peers it accepts are the whitelist's certificates, by the SHA-512 of their DER (D11, D43).
[
  {mode, trust},
  {node, [{name, "r@127.0.0.1"}]},
  {trust, [
    {port, 23107},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../../n4_trust_tls/certs/a.pem"},
                {keyfile, "../../../n4_trust_tls/certs/a-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../../n4_trust_tls/certs"},
    {call_timeout_ms, 3000},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 3},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32},
    {session, #{max_inflight => 8, max_calls => 1000, max_age_ms => 60000, idle_ms => 5000, drain_ms => 1000}}
  ]}
].
