%% N5 trial over mutual TLS 1.3: node b, a TRUST client that offers sessions. Its identity is b.pem; it pins the servers' addresses to a.pem.
[
  {mode, trust},
  {node, [{name, "b@127.0.0.1"}]},
  {trust, [
    {port, 23101},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../../n4_trust_tls/certs/b.pem"},
                {keyfile, "../../../n4_trust_tls/certs/b-key.pem"}]},
    {whitelist_cert_dir, "../../../n4_trust_tls/certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 1500},
    {connect_timeout_ms, 3000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096},
    {session, #{max_inflight => 4, max_calls => 8, max_age_ms => 60000, idle_ms => 2000, drain_ms => 1000}}
  ]}
].
