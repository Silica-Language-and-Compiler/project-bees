// ---- node a (N3): the TRUST server. The boot check comes first: on a boot error nothing is started (R2).
fn region_dump_limit() -> int64 { 0 }
// the program's failure reporter: one stable line for a request worker that failed (the user code), the report itself to stderr
// for anything else (it is not stable text; a golden that shows one is a finding)
// (an actor that ends with stop_self(:normal) is reported too, with reason :normal: those lines are dropped)
fn normal_end(report: string) -> boolean { contains(report, "reason:          :normal") }
// a request worker that failed (the user code returned (:error, Reason): fail_self, D2) is expected and already audited as
// user_code_error by the connection; its report is dropped here, because its line would race with the audit lines
fn report_line(report: string) -> string { case contains(report, "twork") of { true -> "-"; false -> "" } }
fn reporter(report: string, st: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- case normal_end(report) of {
            true -> :ok;
            false -> case length_bytes(report_line(report)) > 0 of { true -> :ok; false -> println_stderr(report) }
        }
    produces pure (:no_reply, st) end
}
fn start_reporter() -> atom {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: atom <- register_failure_reporter(r)
    produces pure ok end
}
fn serve() -> atom {
    sequence
        _: atom <- start_reporter();
        _: atom <- trust_start();
        _: atom <- operator_start()
    produces pure :ok end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        b: int64 <- trust_boot();
        _: atom <- case b == 0 of { true -> serve(); false -> :ok };
        rc: int64 <- case b == 0 of { true -> wait_for_exit(); false -> 1 }
    produces pure rc end
}
