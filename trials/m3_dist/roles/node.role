// ---- the node's startup (what a compiler's generated startup does): the language's (:tcp) carrier for the one link
// (carrier_new, the edge section), then the node. open_ms is unused since the language's carrier replaced the native edge
// (it connects or fails at once; the listener is bound before the dialer starts); it stays for the roles' shape.
fn node_start(open_ms: int64, io_ms: uint64, tick_ms: uint64) -> actor_ref {
    sequence
        c: dangerous_actor_ref <- carrier_new();
        n: actor_ref <- net_start(c, io_ms, tick_ms)
    produces pure n end
}
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn say_num(s: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(s);
        _: atom <- print_int64(n);
        _: atom <- println("")
    produces pure :ok end
}

// The program's failure reporter: one deterministic line when a proxy was ended by the reaper, nothing for the rest (the
// full report is not stable text: actor ids and the order of reports vary).
fn region_dump_limit() -> int64 { 0 }
fn report_line(report: string) -> string {
    case contains(report, "bees_peers_proxy_") and contains(report, "killed") of {
        true -> "proxy ended (killed)";
        false -> ""
    }
}
fn reporter(report: string, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- case length_bytes(report_line(report)) > 0 of { true -> say(report_line(report)); false -> :ok }
    produces pure (:no_reply, st) end
}
fn start_reporter() -> atom {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: atom <- register_failure_reporter(r)
    produces pure ok end
}
