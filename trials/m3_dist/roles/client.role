// ---- the client: a plain actor that, after delay_ms(), casts to the registered name inbox, which lives on the other node.
// Nothing in it mentions the network: the local proxy registered under inbox carries the message.
fn sender(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: 41 };
        _: boolean <- cast_registered(bees_atoms@a_inbox(), m impl ActorMessage {});
        _: atom <- say("client: cast to inbox sent")
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        n: actor_ref <- node_start(open_ms(), io_ms(), tick_ms());
        s: actor_ref <- spawn(0, sender, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        t: timer_ref <- send_after(delay_ms(), s, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
