%% N1 big frames, node b: the frame cap is BEAM's own, 4294967295 (R1; the default, written out): node b can send node a a frame
%% above node a's cap, and nothing is allocated for the cap itself (the peak memory of `make measure` shows it).
[ {mode, beam},
  {node, [{name, "b@127.0.0.1"}]},
  {beam, [{transport, tcp}, {auth, none}, {listen_address, "127.0.0.1"}, {frame_size_max, 4294967295}, {redial, false}]} ].
