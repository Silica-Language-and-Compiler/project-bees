%% N1 big frames, node a: frames up to 9 MiB (9437184 bytes); a larger one is refused before any byte of it is stored. auth none
%% is a loopback-only TEST setting (M3's node).
[ {mode, beam},
  {node, [{name, "a@127.0.0.1"}]},
  {beam, [{transport, tcp}, {auth, none}, {listen_address, "127.0.0.1"}, {frame_size_max, 9437184}]} ].
