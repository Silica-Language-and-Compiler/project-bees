// ---- N1 node a: a plain actor registered under blobs; every { seq, blob } that arrives is cast back to answers (a proxy for
// node b's actor), so each frame makes a round trip. Nothing here mentions the network.
fn blobs(msg: { seq: int64, blob: string }, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say_num("echo: got seq ", msg.seq);
        _: atom <- say_num("echo: len ", length_bytes(msg.blob));
        _: boolean <- cast_registered(bees_atoms@a_answers(), msg impl ActorMessage {})
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        i: actor_ref <- spawn_registered(0, blobs, bees_atoms@a_blobs(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(open_ms(), io_ms(), tick_ms());
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
