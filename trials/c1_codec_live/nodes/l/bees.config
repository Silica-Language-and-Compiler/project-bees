%% C1 codec trial against stock Erlang, node beesl: listens on 127.0.0.1:24100, registers with the private EPMD of the trial
%% (127.0.0.1:24190), net_ticktime 8 s like the stock node; frames up to 65536 bytes
[ {mode, beam},
  {node, [{name, "beesl@localhost"}]},
  {beam, [{transport, tcp}, {frame_size_max, 65536}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 24100}, {epmd, external}, {epmd_port, 24190}, {net_ticktime_s, 8}]} ].
