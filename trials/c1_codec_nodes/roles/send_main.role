// ---- C1 two nodes, node a's own part: its name in the lines send.role prints, what happens after the last echo (`a: done`,
// the marker the harness waits for), and the start: the first message is sent 1.5 s after the node started (node b listens
// and was started first; the handshake is done by then), every later one when the previous echo arrived.
fn me() -> string { "a" }
fn finish() -> atom { say("a: done") }
fn kick(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say("a: sending");
        _: atom <- go(0)
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        _: actor_ref <- spawn_registered(0, valx, bees_atoms@a_valx(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: actor_ref <- spawn_registered(0, chainx, bees_atoms@a_chainx(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: actor_ref <- spawn_registered(0, imx, bees_atoms@a_imx(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: actor_ref <- spawn_registered(0, intsx, bees_atoms@a_intsx(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: actor_ref <- spawn_registered(0, pktx, bees_atoms@a_pktx(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: actor_ref <- spawn_registered(0, widex, bees_atoms@a_widex(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: actor_ref <- spawn_registered(0, anyx, bees_atoms@a_anyx(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(open_ms(), io_ms(), tick_ms());
        k: actor_ref <- spawn(0, kick, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: timer_ref <- send_after(1500, k, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
