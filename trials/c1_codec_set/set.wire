# C1 codec trial, sets (development-plan/spikes/C1-codec-term-coverage.md 2.4, 2.6): an in-memory node manifest (no link is
# opened; the peer port is only data). Set[T] is List[T, mem(normal)] on the Silica side and, on the wire, the map #{E => []}
# that the sets module builds (sets:from_list/1, version 2: the default since OTP 28). bees.config sets beam.frame_size_max
# to 65536.
node   b@127.0.0.1
peer   a@127.0.0.1 127.0.0.1 24100 dial
local  ints  cast Set[int64]
# a set of tagged tuples, of strings, of a sum
remote pts   @ a@127.0.0.1 cast Set[(:pt, int64, int64)]
remote strs  @ a@127.0.0.1 cast Set[string]
remote enums @ a@127.0.0.1 cast Set[(:i, int64) | :none]
# a set in a tagged tuple, and as the value of a map
remote tags  @ a@127.0.0.1 cast (:tags, int64, Set[string])
remote sets  @ a@127.0.0.1 cast Map[int64, Set[int64]]
