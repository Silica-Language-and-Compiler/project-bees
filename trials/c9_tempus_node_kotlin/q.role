// C9 Kotlin node trial: node Q, a Silica edge (identity 5), NOT a test program: it is not externally driven, its root
// unit names nothing of the test unit, and it reads the machine's clock. Its sentinel is the Kotlin node KP, which is
// not a test node either: Q joins through it by the machine's clock on both sides.
// Its stores tick once an hour, so nothing in its output depends on its own timers.
fn ident() -> int64 { 5 }
fn typ() -> int64 { 1 }
fn port() -> string { "25005" }
fn sents() -> string { "127.0.0.1:25004" }
fn driven() -> boolean { false }
fn ext_start(app: actor_ref) -> actor_ref { app }
fn tick_ms() -> uint64 { 3600000 }
// the node's own token: tempus_edge, valid 1000 to 4000000000, so that it is valid by the machine's clock
fn own_tok() -> int64 { 14 }
