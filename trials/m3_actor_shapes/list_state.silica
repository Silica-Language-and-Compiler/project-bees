// M3 shape 4: a list of words kept in actor state across dispatches (a buf is never part of a spawn's initial state, E4038),
// then written into a fresh buffer when the frame is complete.
use bees_reporter;

fn show(s: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(s);
        _: atom <- print_int64(n);
        _: atom <- println("")
    produces pure :ok end
}
fn sum_list(l: List[int64, mem(normal)], i: int64, n: int64) -> int64 {
    case i >= n of {
        true -> 0;
        false -> {
            sequence proc[mem(normal)]
                h: int64 <- list_at[int64, mem(normal)](l, i);
                s: int64 <- sum_list(l, i + 1, n)
            produces pure h + s end
        }
    }
}
fn acc(msg: int64, st: { n: int64, ws: List[int64, mem(normal)] }) -> (:no_reply, { n: int64, ws: List[int64, mem(normal)] }) {
    sequence proc[mem(normal)]
        l2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](msg, st.ws);
        _: atom <- show("count ", st.n + 1);
        _: atom <- case st.n + 1 == 600 of { true -> show("sum ", sum_list(l2, 0, 600)); false -> :ok }
    produces pure (:no_reply, { n: st.n + 1, ws: l2 }) end
}
fn feed(a: actor_ref, i: int64) -> boolean {
    case i >= 600 of {
        true -> true;
        false -> feed_one(a, i)
    }
}
fn feed_one(a: actor_ref, i: int64) -> boolean {
    sequence proc[concurrency]
        _: boolean <- cast(a, i impl ActorMessage {});
        ok: boolean <- feed(a, i + 1)
    produces pure ok end
}
fn main() -> int64 {
    sequence proc[concurrency, mem(normal), device_io]
        _: atom <- bees_reporter@start();
        e: List[int64, mem(normal)] <- empty[int64, mem(normal)]();
        a: actor_ref <- spawn({ n: 0, ws: e }, acc, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- feed(a, 0);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
