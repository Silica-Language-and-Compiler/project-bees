// M3 shape 2: link() so that the end of one actor ends the other; the failure report of the linked one;
// cast_registered to a name nobody holds; spawn_registered.
use bees_atoms;

fn pxy(msg: int64, st: { t: actor_ref }) -> (:no_reply, { t: actor_ref }) {
    sequence proc[concurrency]
        _: atom <- case msg == 7 of { true -> link(st.t); false -> :ok }
    produces pure (:no_reply, st) end
}

fn txa(msg: int64, st: { p: actor_ref }) -> (:no_reply, { p: actor_ref }) {
    sequence proc[concurrency]
        _: atom <- case msg == 0 of { true -> link(st.p); false -> :ok };
        _: atom <- case msg == 1 of { true -> fail_self(bees_atoms@a_link_down()); false -> :ok }
    produces pure (:no_reply, st) end
}

fn show(n: boolean) -> atom {
    sequence proc[device_io]
        _: atom <- print_boolean(n);
        _: atom <- println("")
    produces pure :ok end
}

fn late(msg: int64, st: { p: actor_ref }) -> (:no_reply, { p: actor_ref }) {
    sequence proc[concurrency]
        _: atom <- show_str("late: casting to the proxy");
        _: boolean <- cast(st.p, 5 impl ActorMessage {});
        _: atom <- show_str("late: the proxy was alive")
    produces pure (:no_reply, st) end
}
fn show_str(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        me: actor_ref <- self();
        t: actor_ref <- spawn({ p: me }, txa, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        p: actor_ref <- spawn_registered({ t: t }, pxy, bees_atoms@a_pxy(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(p, 7 impl ActorMessage {});
        _: atom <- println("start");
        _: boolean <- cast(t, 1 impl ActorMessage {});
        l: actor_ref <- spawn({ p: p }, late, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        tm: timer_ref <- send_after(500, l, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}

fn rep(report: string, st: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println("REPORT: the failing actor's reason names link_down:");
        _: atom <- print_boolean(contains(report, "link_down"));
        _: atom <- println("")
    produces pure (:no_reply, st) end
}
fn start_reporter() -> atom {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, rep, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: atom <- register_failure_reporter(r)
    produces pure ok end
}
fn region_dump_limit() -> int64 { 0 }
