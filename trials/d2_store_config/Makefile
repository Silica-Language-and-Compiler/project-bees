# D2 (spikes/N0d-store-config.md): the reader units of src/config (generated by tools/bees_pack_gen.py from the packer's record
# table) read a configuration store that tools/bees_pack.py wrote, through Silica's hosted (:store) carrier (D46), and answer
# (:ok, cfg) or (:error, reason). Two roots, one per mode, written from root.silica.in when the Makefile is read:
#
#   dangerous_d2_beam    carried_on config: (:store) (:backing, "node_beam.sildat", 65536, :stop)
#   dangerous_d2_trust   carried_on config: (:store) (:backing, "node_trust.sildat", 65536, :stop)
#
# cases.py packs a BEAM-mode and a TRUST-mode bees.config (with a cookie, a whitelist and certificates) and runs the roots on
# them, then on stores that must be refused: absent, of another size, damaged, for the other mode, truncated, with a group
# missing or given twice, with an unknown record kind, with a value out of bounds, with a record of the wrong shape. A secret
# (the cookie) is in the store and in the value the application gets; no output line shows it.
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
_ := $(shell cd "$(LEAF_DIR)" && python3 "$(BEES_ROOT)/tools/bees_pack_gen.py" root root.silica.in beam dangerous_d2_beam.silica && \
	python3 "$(BEES_ROOT)/tools/bees_pack_gen.py" root root.silica.in trust dangerous_d2_trust.silica)
include $(BEES_ROOT)/tools/bees_pack_trial.mk

clean: clean-generated
.PHONY: clean-generated
clean-generated:
	@cd "$(LEAF_DIR)" && rm -f dangerous_d2_beam.silica dangerous_d2_trust.silica
