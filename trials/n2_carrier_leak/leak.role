fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn region_dump_limit() -> int64 { 0 }
fn reporter(report: string, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say("")
    produces pure (:no_reply, st) end
}
fn sink(msg: (:link_up, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom), st: int64) -> (:no_reply, int64) {
    (:no_reply, st)
}
fn once(sk: actor_ref) -> boolean {
    sequence proc[concurrency]
        c: dangerous_actor_ref <- carrier_new();
        ok: boolean <- cast(c, (:open, sk, "127.0.0.1:1:500") impl ActorMessage {})
    produces pure ok end
}
fn spawner(msg: int64, sk: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        _: boolean <- once(sk);
        _: atom <- case (msg + 1) % 500 == 0 of { true -> say("batch"); false -> :ok };
        t: timer_ref <- send_after(10, me, msg + 1 impl ActorMessage {})
    produces pure (:no_reply, sk) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        rp: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- register_failure_reporter(rp);
        sk: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        s: actor_ref <- spawn(sk, spawner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- say("start");
        _: boolean <- cast(s, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
