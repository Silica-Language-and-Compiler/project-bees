// ---- edge a: after 1.5 s casts req_a (21) to the hub (the proxy of req_a is registered here) and prints the answer that arrives on ans_a
fn num_text(n: int64) -> string {
    case n of {
        21 -> "21"; 42 -> "42";
        _: int64 -> "?"
    }
}
fn ans_a(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say(concat("edge a: got answer ", num_text(msg.n)))
    produces pure (:no_reply, st + 1) end
}
fn sender(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: 21 };
        _: boolean <- cast_registered(bees_atoms@a_req_a(), m impl ActorMessage {});
        _: atom <- say("edge a: request sent")
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn_registered(0, ans_a, bees_atoms@a_ans_a(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        s: actor_ref <- spawn(0, sender, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        t: timer_ref <- send_after(1500, s, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
