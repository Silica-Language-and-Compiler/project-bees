%% N2b hub (BEES to BEES, no EPMD): one listener on 22100 for both edges; the cookie of trials/n2_multilink (mode 600, written by the Makefile)
[ {mode, beam},
  {node, [{name, "hub@localhost"}]},
  {beam, [{transport, tcp}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 22100}, {epmd, none}]} ].
