# M1 rejection trial: messages whose frames are fed hostile bytes. deep17 nests 17 levels, one above the limit
# (bees_config warns; every frame of it is rejected as too_deep).
message small { a: uint16, s: string, l: List[uint8], at: atom, ok: boolean }
message lst List[uint8]
message str string
message tag atom
message flt float64
message flt32 float32
message chr char
message deep16 { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: uint8 } } } } } } } } } } } } } } } }
message deep17 { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: uint8 } } } } } } } } } } } } } } } } }
message lstr List[string]
message bol boolean
