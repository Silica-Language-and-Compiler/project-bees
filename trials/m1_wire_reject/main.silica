// M1b: hostile and malformed frames on ETF. Every case builds a frame by hand (or mutates a valid one) and feeds it to the
// generated validator or decoder (found by the target NAME, as a REG_SEND would); each must come back as
// a rejection reason (the language's atoms), never a fault, and the program goes on.
// A line is `<case> -> <reason>` (:ok means the frame was accepted). The oracle-checked decode and reject entries are in the
// m1_wire_types* leaves; these are the limit cases that need a hand-built frame.
use bees_atoms;
use bees_wire;
use bees_wire_msgs;

fn line(label: string, code: int64) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" -> ");
        _: atom <- print_atom(bees_wire@reason_atom(code));
        println("")
    produces pure 0 end
}
fn rep(s: string, n: int64) -> string {
    case n <= 0 of {
        true -> "";
        false -> case n == 1 of { true -> s; false -> concat(rep(s, n / 2), rep(s, n - n / 2)) }
    }
}
fn pre(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 { bees_wire@put_hdr(rg, b) }
fn p(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, x: int64) -> int64 { bees_wire@put_i(rg, b, pos, x) }
fn fill(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, n: int64, v: int64) -> int64 {
    case n <= 0 of { true -> pos; false -> fill(rg, b, p(rg, b, pos, v), n - 1, v) }
}
// n small-integer elements (97 7)
fn elems(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, n: int64) -> int64 {
    case n <= 0 of { true -> pos; false -> elems(rg, b, p(rg, b, p(rg, b, pos, 97), 7), n - 1) }
}
// a LIST_EXT header with count n
fn lhead(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, n: int64) -> int64 { bees_wire@put_u32(rg, b, p(rg, b, pos, 108), n) }
fn bhead(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, n: int64) -> int64 { bees_wire@put_u32(rg, b, p(rg, b, pos, 109), n) }
fn code_of_enc(n: int64) -> int64 { case n < 0 of { true -> 0 - n; false -> 0 } }
// validate through the generated dispatcher, by target name
fn v_bol(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_bol()) }
fn v_chr(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_chr()) }
fn v_deep16(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_deep16()) }
fn v_deep17(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_deep17()) }
fn v_flt(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_flt()) }
fn v_flt32(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_flt32()) }
fn v_known(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_known()) }
fn v_lst(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_lst()) }
fn v_lstr(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_lstr()) }
fn v_small(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_small()) }
fn v_str(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_str()) }
fn v_tag(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate_named(rg, b, n, bees_atoms@a_tag()) }
fn vl(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { v_lst(rg, b, n) }
fn vs(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { v_str(rg, b, n) }
fn vt(rg: region(L, normal), b: buf(L, normal, uint8, 4096), n: int64) -> int64 { v_tag(rg, b, n) }

// --- truncation at every length of a valid frame
fn small_value() -> { a: uint16, s: string, l: List[uint8, mem(normal)], at: atom, ok: boolean } {
    sequence proc[mem(normal)]
        e: List[uint8, mem(normal)] <- empty[uint8, mem(normal)]();
        l1: List[uint8, mem(normal)] <- prepend[uint8, mem(normal)](9, prepend[uint8, mem(normal)](8, e));
        r: { a: uint16, s: string, l: List[uint8, mem(normal)], at: atom, ok: boolean } <- { a: 513, s: "hello", l: l1, at: bees_atoms@a_known(), ok: true }
    produces pure r end
}
fn count_trunc(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64, n: int64, hits: int64, other: int64) -> int64 {
    case i >= n of {
        true -> hits * 1000 + other;
        false -> case v_small(rg, b, i) == 2 of {
            true -> count_trunc(rg, b, i + 1, n, hits + 1, other);
            false -> count_trunc(rg, b, i + 1, n, hits, other + 1)
        }
    }
}
fn count_trunc_dec(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64, n: int64, hits: int64, other: int64) -> int64 {
    case i >= n of {
        true -> hits * 1000 + other;
        false -> case bees_wire_msgs@dec_small(rg, b, i).code == 2 of {
            true -> count_trunc_dec(rg, b, i + 1, n, hits + 1, other);
            false -> count_trunc_dec(rg, b, i + 1, n, hits, other + 1)
        }
    }
}
fn count_trunc_lstr(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64, n: int64, hits: int64, other: int64) -> int64 {
    case i >= n of {
        true -> hits * 1000 + other;
        false -> case v_lstr(rg, b, i) == 2 of {
            true -> count_trunc_lstr(rg, b, i + 1, n, hits + 1, other);
            false -> count_trunc_lstr(rg, b, i + 1, n, hits, other + 1)
        }
    }
}
fn truncation(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n: int64 <- bees_wire_msgs@enc_small(rg, b, small_value());
        print_string("valid small frame: n=");
        _: atom <- print_int64(n);
        print_string(" validate -> ");
        _: atom <- print_atom(bees_wire@reason_atom(v_small(rg, b, n)));
        println("");
        t: int64 <- count_trunc(rg, b, 0, n, 0, 0);
        print_string("truncated at every length 0..n-1 via validate_named: truncated/other = ");
        _: atom <- print_int64(t / 1000);
        print_string("/");
        _: atom <- print_int64(t % 1000);
        println("");
        t2: int64 <- count_trunc_dec(rg, b, 0, n, 0, 0);
        print_string("truncated at every length 0..n-1 via dec_small: truncated/other = ");
        _: atom <- print_int64(t2 / 1000);
        print_string("/");
        _: atom <- print_int64(t2 % 1000);
        println("");
        n3: int64 <- bees_wire_msgs@enc_lstr(rg, b, str_list2(3, 5));
        print_string("a list of three binaries (frame of ");
        _: atom <- print_int64(n3);
        println(" bytes), as a message, truncated at every length:");
        t4: int64 <- count_trunc_lstr(rg, b, 0, n3, 0, 0);
        print_string("  message lstr, truncated/other = ");
        _: atom <- print_int64(t4 / 1000);
        print_string("/");
        _: atom <- print_int64(t4 % 1000);
        println("")
    produces pure 0 end
}

// --- oversized
fn str_list2(n: int64, last: int64) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[string, mem(normal)] <- empty[string, mem(normal)]();
        tailv: List[string, mem(normal)] <- prepend[string, mem(normal)](rep("k", last), e);
        out: List[string, mem(normal)] <- more_strs(n - 1, tailv)
    produces pure out end
}
fn more_strs(k: int64, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[string, mem(normal)] <- case k <= 0 of {
            true -> acc;
            false -> more_strs(k - 1, prepend[string, mem(normal)](rep("k", 1024), acc))
        }
    produces pure out end
}
fn oversized(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- line("frame longer than 4096 bytes held (len 4097)", vl(rg, b, 4097));
        _: int64 <- line("an empty frame", vl(rg, b, 0));
        e2: int64 <- bees_wire_msgs@enc_lstr(rg, b, str_list2(4, 997));
        print_string("encode a frame of exactly 4096 bytes: n=");
        _: atom <- print_int64(e2);
        _: int64 <- line(" validate", v_lstr(rg, b, e2));
        e3: int64 <- bees_wire_msgs@enc_lstr(rg, b, str_list2(4, 998));
        _: int64 <- line("encode a frame of 4097 bytes", code_of_enc(e3))
    produces pure 0 end
}

// --- depth
fn deep16_value() -> { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: uint8 } } } } } } } } } } } } } } } } { { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: 7 } } } } } } } } } } } } } } } } }
fn deep17_value() -> { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: uint8 } } } } } } } } } } } } } } } } } { { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: 7 } } } } } } } } } } } } } } } } } }
// 17 maps inside each other, each holding the key d: 131, then (116 0 0 0 1 119 1 100) 17 times, then 97 7
fn maps(rg: region(L, normal), b: buf(L, normal, uint8, 4096), pos: int64, k: int64) -> int64 {
    case k <= 0 of {
        true -> p(rg, b, p(rg, b, pos, 97), 7);
        false -> maps(rg, b, p(rg, b, p(rg, b, p(rg, b, bees_wire@put_u32(rg, b, p(rg, b, pos, 116), 1), 119), 1), 100), k - 1)
    }
}
fn depth(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n: int64 <- bees_wire_msgs@enc_deep16(rg, b, deep16_value());
        print_string("16 levels: n=");
        _: atom <- print_int64(n);
        _: int64 <- line(" validate", v_deep16(rg, b, n));
        e: int64 <- bees_wire_msgs@enc_deep17(rg, b, deep17_value());
        _: int64 <- line("encode 17 levels", code_of_enc(e));
        m16: int64 <- maps(rg, b, pre(rg, b), 16);
        _: int64 <- line("decode 16 levels (handcrafted frame)", v_deep16(rg, b, m16));
        m17: int64 <- maps(rg, b, pre(rg, b), 17);
        _: int64 <- line("decode 17 levels (handcrafted frame)", v_deep17(rg, b, m17))
    produces pure 0 end
}

// --- counts and lengths
fn counts(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n1: int64 <- p(rg, b, elems(rg, b, lhead(rg, b, pre(rg, b), 256), 256), 106);
        print_string("list of 256: n=");
        _: atom <- print_int64(n1);
        _: int64 <- line(" validate", vl(rg, b, n1));
        n2: int64 <- p(rg, b, elems(rg, b, lhead(rg, b, pre(rg, b), 257), 257), 106);
        _: int64 <- line("list of 257", vl(rg, b, n2));
        n3: int64 <- elems(rg, b, lhead(rg, b, pre(rg, b), 4294967295), 3);
        _: int64 <- line("list count 4294967295, 3 elements follow", vl(rg, b, n3));
        n4: int64 <- elems(rg, b, lhead(rg, b, pre(rg, b), 200), 3);
        _: int64 <- line("list count 200, 3 elements follow", vl(rg, b, n4));
        n4b: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 107), 1), 1), 0), 0);
        _: int64 <- line("STRING_EXT of 257 bytes (count only)", vl(rg, b, n4b));
        n5: int64 <- fill(rg, b, bhead(rg, b, pre(rg, b), 1024), 1024, 97);
        print_string("string of 1024: n=");
        _: atom <- print_int64(n5);
        _: int64 <- line(" validate", vs(rg, b, n5));
        n6: int64 <- fill(rg, b, bhead(rg, b, pre(rg, b), 1025), 1025, 97);
        _: int64 <- line("string of 1025", vs(rg, b, n6));
        n7: int64 <- fill(rg, b, bhead(rg, b, pre(rg, b), 4294967295), 3, 97);
        _: int64 <- line("string count 4294967295, 3 bytes follow", vs(rg, b, n7));
        n8: int64 <- fill(rg, b, bhead(rg, b, pre(rg, b), 1000), 3, 97);
        _: int64 <- line("string count 1000, 3 bytes follow", vs(rg, b, n8));
        n9: int64 <- fill(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 255), 3, 122);
        _: int64 <- line("atom count 255, 3 bytes follow", vt(rg, b, n9));
        n10: int64 <- fill(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 255), 255, 122);
        _: int64 <- line("atom of 255 bytes that the program does not hold", vt(rg, b, n10));
        n11: int64 <- fill(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 118), 1), 0), 256, 122);
        _: int64 <- line("ATOM_UTF8_EXT of 256 bytes", vt(rg, b, n11));
        e: int64 <- bees_wire_msgs@enc_tag(rg, b, bees_atoms@a_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy());
        _: int64 <- line("encode an atom whose spelling is 256 bytes", code_of_enc(e))
    produces pure 0 end
}

// --- text, atoms, booleans, floats, headers, trailing bytes
fn content(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        a1: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 4), 110), 111), 112), 101);
        _: int64 <- line("atom nope (not held), as a message", vt(rg, b, a1));
        a2: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 5), 107), 110), 111), 119), 110);
        _: int64 <- line("atom known", vt(rg, b, a2));
        _: int64 <- line("atom known, then one more byte", vt(rg, b, a2 + 1));
        a3: int64 <- p(rg, b, p(rg, b, pre(rg, b), 119), 0);
        _: int64 <- line("atom with an empty spelling", vt(rg, b, a3));
        a4: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 3), 110), 200), 101);
        _: int64 <- line("atom spelling with byte 200", vt(rg, b, a4));
        t1: int64 <- p(rg, b, p(rg, b, p(rg, b, bhead(rg, b, pre(rg, b), 3), 97), 128), 99);
        _: int64 <- line("string with byte 128", vs(rg, b, t1));
        t2: int64 <- p(rg, b, p(rg, b, bhead(rg, b, pre(rg, b), 2), 195), 169);
        _: int64 <- line("string 0xC3 0xA9 (UTF-8 e-acute)", vs(rg, b, t2));
        t3: int64 <- p(rg, b, p(rg, b, bhead(rg, b, pre(rg, b), 2), 97), 0);
        _: int64 <- line("string with a NUL byte", vs(rg, b, t3));
        t4: int64 <- p(rg, b, p(rg, b, bhead(rg, b, pre(rg, b), 2), 97), 127);
        _: int64 <- line("string with byte 127", vs(rg, b, t4));
        t5: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, bhead(rg, b, pre(rg, b), 4), 240), 159), 152), 128);
        _: int64 <- line("string holding a 4-byte UTF-8 character", vs(rg, b, t5));
        c1: int64 <- p(rg, b, p(rg, b, bees_wire@put_u32(rg, b, p(rg, b, pre(rg, b), 98), 233), 0), 0);
        _: int64 <- line("char code point 233 (and two more bytes)", v_chr(rg, b, c1 - 2));
        c3: int64 <- p(rg, b, p(rg, b, pre(rg, b), 97), 65);
        _: int64 <- line("char A", v_chr(rg, b, c3));
        o1: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 4), 116), 114), 117);
        _: int64 <- line("boolean atom tru", v_bol(rg, b, o1));
        o2: int64 <- p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, p(rg, b, pre(rg, b), 119), 4), 116), 114), 117), 101);
        _: int64 <- line("boolean atom true", v_bol(rg, b, o2));
        o3: int64 <- p(rg, b, p(rg, b, pre(rg, b), 97), 1);
        _: int64 <- line("boolean given the integer 1", v_bol(rg, b, o3));
        h1: int64 <- p(rg, b, p(rg, b, pre(rg, b), 97), 1);
        _: int64 <- bees_wire@put_i(rg, b, 0, 130);
        _: int64 <- line("version byte 130", vl(rg, b, h1));
        _: int64 <- bees_wire@put_i(rg, b, 0, 131);
        _: int64 <- line("a message name nobody registered", v_known(rg, b, h1));
        g1: int64 <- fill(rg, b, p(rg, b, pre(rg, b), 70), 8, 0);
        _: int64 <- bees_wire@put_i(rg, b, 2, 127);
        _: int64 <- bees_wire@put_i(rg, b, 3, 240);
        _: int64 <- line("float64 +infinity", v_flt(rg, b, g1));
        _: int64 <- bees_wire@put_i(rg, b, 3, 248);
        _: int64 <- line("float64 NaN", v_flt(rg, b, g1));
        _: int64 <- bees_wire@put_i(rg, b, 2, 255);
        _: int64 <- bees_wire@put_i(rg, b, 3, 240);
        _: int64 <- line("float32 -infinity", v_flt32(rg, b, g1));
        _: int64 <- bees_wire@put_i(rg, b, 2, 0);
        _: int64 <- bees_wire@put_i(rg, b, 3, 0);
        _: int64 <- line("float32 zero", v_flt32(rg, b, g1));
        _: int64 <- line("float64 zero and one byte more", v_flt(rg, b, g1 + 1));
        _: int64 <- line("float64 zero", v_flt(rg, b, g1))
    produces pure 0 end
}

fn big() -> float64 { 1.0e308 }
fn hugef() -> float64 { big() * big() }
fn nanf() -> float64 { hugef() - hugef() }
fn floats(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        i: float64 <- hugef();
        _: int64 <- line("encode float64 +infinity", code_of_enc(bees_wire_msgs@enc_flt(rg, b, i)));
        n: float64 <- nanf();
        _: int64 <- line("encode float64 NaN", code_of_enc(bees_wire_msgs@enc_flt(rg, b, n)))
    produces pure 0 end
}

// --- dispatch by name
fn names(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        print_string("index_of small/lst/bol/known: ");
        _: atom <- print_int64(bees_wire_msgs@index_of(bees_atoms@a_small()));
        print_string(" ");
        _: atom <- print_int64(bees_wire_msgs@index_of(bees_atoms@a_lst()));
        print_string(" ");
        _: atom <- print_int64(bees_wire_msgs@index_of(bees_atoms@a_bol()));
        print_string(" ");
        _: atom <- print_int64(bees_wire_msgs@index_of(bees_atoms@a_known()));
        println("");
        print_string("msg_count: ");
        _: atom <- print_int64(bees_wire_msgs@msg_count());
        println("")
    produces pure 0 end
}

fn run_all(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- truncation(rg, b);
        _: int64 <- oversized(rg, b);
        _: int64 <- depth(rg, b);
        _: int64 <- counts(rg, b);
        _: int64 <- content(rg, b);
        _: int64 <- floats(rg, b);
        _: int64 <- names(rg, b);
        n: int64 <- bees_wire_msgs@enc_small(rg, b, small_value());
        print_string("after every rejection a valid frame still decodes: ");
        _: atom <- print_atom(bees_wire@reason_atom(v_small(rg, b, n)));
        println("");
        println("reject done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        _: int64 <- run_all(rg, b)
    produces pure 0 end
}
