// M1: hostile and malformed frames. Every case builds a frame by hand (or mutates a valid one) and feeds it to the
// generated validator/decoder; each must come back as a rejection reason, never a fault, and the program goes on.
// Reasons: truncated too_large too_deep too_long bad_text unknown_atom unknown_kind bad_float bad_boolean bad_version
// bad_frame_kind trailing.  A line is `<case> -> <reason>` (:ok means the frame was accepted).
use bees_atoms;
use bees_wire;
use bees_wire_msgs;

fn line(label: string, code: int64) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" -> ");
        _: atom <- print_atom(bees_wire@reason_atom(code));
        println("")
    produces pure 0 end
}
fn rep(s: string, n: int64) -> string {
    case n <= 0 of {
        true -> "";
        false -> case n == 1 of { true -> s; false -> concat(rep(s, n / 2), rep(s, n - n / 2)) }
    }
}
// a frame prefix: length placeholder, version 1, frame kind, message kind id (two bytes); returns the next position
fn pre(b: buf(L, normal, uint8, 4096), fk: int64, id: int64) -> int64 {
    bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_u32(b, 0, 0), 1), fk), id / 256)
}
fn pre2(b: buf(L, normal, uint8, 4096), fk: int64, id: int64) -> int64 { bees_wire@put_i(b, pre(b, fk, id), id % 256) }
fn fill(b: buf(L, normal, uint8, 4096), pos: int64, n: int64, v: int64) -> int64 {
    case n <= 0 of { true -> pos; false -> fill(b, bees_wire@put_i(b, pos, v), n - 1, v) }
}
fn fin(b: buf(L, normal, uint8, 4096), pos: int64) -> int64 { bees_wire@finish(b, pos) }
fn code_of_enc(n: int64) -> int64 { case n < 0 of { true -> 0 - n; false -> 0 } }
// validate through the generated dispatcher
fn v(b: buf(L, normal, uint8, 4096), n: int64) -> int64 { bees_wire_msgs@validate(b, n) }

// --- truncation at every length of a valid frame
fn small_value() -> { a: uint16, s: string, l: List[uint8, mem(normal)], at: atom, ok: boolean } {
    sequence proc[mem(normal)]
        e: List[uint8, mem(normal)] <- empty[uint8, mem(normal)]();
        l1: List[uint8, mem(normal)] <- prepend[uint8, mem(normal)](9, prepend[uint8, mem(normal)](8, e));
        r: { a: uint16, s: string, l: List[uint8, mem(normal)], at: atom, ok: boolean } <- { a: 513, s: "hello", l: l1, at: bees_atoms@a_known(), ok: true }
    produces pure r end
}
fn count_trunc(b: buf(L, normal, uint8, 4096), i: int64, n: int64, hits: int64, other: int64) -> int64 {
    case i >= n of {
        true -> hits * 1000 + other;
        false -> case v(b, i) == 1 of {
            true -> count_trunc(b, i + 1, n, hits + 1, other);
            false -> count_trunc(b, i + 1, n, hits, other + 1)
        }
    }
}
fn count_trunc_dec(b: buf(L, normal, uint8, 4096), i: int64, n: int64, hits: int64, other: int64) -> int64 {
    case i >= n of {
        true -> hits * 1000 + other;
        false -> case bees_wire_msgs@dec_small(b, i).code == 1 of {
            true -> count_trunc_dec(b, i + 1, n, hits + 1, other);
            false -> count_trunc_dec(b, i + 1, n, hits, other + 1)
        }
    }
}
fn count_trunc_hello(b: buf(L, normal, uint8, 4096), i: int64, n: int64, hits: int64, other: int64) -> int64 {
    case i >= n of {
        true -> hits * 1000 + other;
        false -> case bees_wire@dec_hello(b, i).code == 1 of {
            true -> count_trunc_hello(b, i + 1, n, hits + 1, other);
            false -> count_trunc_hello(b, i + 1, n, hits, other + 1)
        }
    }
}
fn truncation(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n: int64 <- bees_wire_msgs@enc_small(b, small_value());
        print_string("valid small frame: n=");
        _: atom <- print_int64(n);
        print_string(" validate -> ");
        _: atom <- print_atom(bees_wire@reason_atom(v(b, n)));
        println("");
        t: int64 <- count_trunc(b, 0, n, 0, 0);
        print_string("truncated at every length 0..n-1 via validate: truncated/other = ");
        _: atom <- print_int64(t / 1000);
        print_string("/");
        _: atom <- print_int64(t % 1000);
        println("");
        t2: int64 <- count_trunc_dec(b, 0, n, 0, 0);
        print_string("truncated at every length 0..n-1 via dec_small: truncated/other = ");
        _: atom <- print_int64(t2 / 1000);
        print_string("/");
        _: atom <- print_int64(t2 % 1000);
        println("");
        h: int64 <- bees_wire@enc_hello(b, bees_atoms@a_node_a(), 0 - 1234567890123);
        print_string("valid hello frame: n=");
        _: atom <- print_int64(h);
        println("");
        t3: int64 <- count_trunc_hello(b, 0, h, 0, 0);
        print_string("hello truncated at every length 0..n-1: truncated/other = ");
        _: atom <- print_int64(t3 / 1000);
        print_string("/");
        _: atom <- print_int64(t3 % 1000);
        println("")
    produces pure 0 end
}

// --- oversized
fn str_list(n: int64, len: int64) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[string, mem(normal)] <- empty[string, mem(normal)]();
        rest: List[string, mem(normal)] <- case n <= 1 of { true -> e; false -> str_list(n - 1, len) };
        out: List[string, mem(normal)] <- prepend[string, mem(normal)](rep("k", len), rest)
    produces pure out end
}
// n strings: the first n-1 are 1024 bytes, the last `last` bytes
fn str_list2(n: int64, last: int64) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[string, mem(normal)] <- empty[string, mem(normal)]();
        tailv: List[string, mem(normal)] <- prepend[string, mem(normal)](rep("k", last), e);
        out: List[string, mem(normal)] <- more_strs(n - 1, tailv)
    produces pure out end
}
fn more_strs(k: int64, acc: List[string, mem(normal)]) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        out: List[string, mem(normal)] <- case k <= 0 of {
            true -> acc;
            false -> more_strs(k - 1, prepend[string, mem(normal)](rep("k", 1024), acc))
        }
    produces pure out end
}
fn oversized(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- line("frame longer than 4096 bytes held (len 4097)", v(b, 4097));
        p: int64 <- fill(b, pre2(b, 1, 1), 40, 7);
        _: int64 <- fin(b, p);
        _: int64 <- bees_wire@put_u32(b, 0, 70000);
        _: int64 <- line("declared length 70000 in a 100-byte frame", v(b, 100));
        _: int64 <- bees_wire@put_u32(b, 0, 4093);
        _: int64 <- line("declared length 4093 (one over the limit) in a 100-byte frame", v(b, 100));
        e1: int64 <- bees_wire_msgs@enc_lstr(b, str_list(5, 1024));
        _: int64 <- line("encode 5 strings of 1024 bytes (about 5 KiB)", code_of_enc(e1));
        e2: int64 <- bees_wire_msgs@enc_lstr(b, str_list2(4, 996));
        print_string("encode a frame of exactly 4096 bytes: n=");
        _: atom <- print_int64(e2);
        _: int64 <- line(" validate", v(b, e2));
        e3: int64 <- bees_wire_msgs@enc_lstr(b, str_list2(4, 997));
        _: int64 <- line("encode a frame of 4097 bytes", code_of_enc(e3))
    produces pure 0 end
}

// --- depth
fn deep16_value() -> { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: uint8 } } } } } } } } } } } } } } } } { { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: 7 } } } } } } } } } } } } } } } } }
fn deep17_value() -> { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: uint8 } } } } } } } } } } } } } } } } } { { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: { d: 7 } } } } } } } } } } } } } } } } } }
fn depth(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n: int64 <- bees_wire_msgs@enc_deep16(b, deep16_value());
        print_string("16 levels: n=");
        _: atom <- print_int64(n);
        _: int64 <- line(" validate", v(b, n));
        e: int64 <- bees_wire_msgs@enc_deep17(b, deep17_value());
        _: int64 <- line("encode 17 levels", code_of_enc(e));
        p: int64 <- bees_wire@put_i(b, pre2(b, 1, 8), 7);
        m: int64 <- fin(b, p);
        _: int64 <- line("decode 17 levels (handcrafted frame)", v(b, m))
    produces pure 0 end
}

// --- counts and lengths
fn counts(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        p1: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 1), 256), 256, 7);
        n1: int64 <- fin(b, p1);
        print_string("list of 256: n=");
        _: atom <- print_int64(n1);
        _: int64 <- line(" validate", v(b, n1));
        p2: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 1), 257), 257, 7);
        n2: int64 <- fin(b, p2);
        _: int64 <- line("list of 257", v(b, n2));
        p3: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 1), 4294967295), 3, 7);
        n3: int64 <- fin(b, p3);
        _: int64 <- line("list count 4294967295, 3 bytes follow", v(b, n3));
        p4: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 1), 200), 3, 7);
        n4: int64 <- fin(b, p4);
        _: int64 <- line("list count 200, 3 bytes follow", v(b, n4));
        p5: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 2), 1024), 1024, 97);
        n5: int64 <- fin(b, p5);
        print_string("string of 1024: n=");
        _: atom <- print_int64(n5);
        _: int64 <- line(" validate", v(b, n5));
        p6: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 2), 1025), 1025, 97);
        n6: int64 <- fin(b, p6);
        _: int64 <- line("string of 1025", v(b, n6));
        p7: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 2), 4294967295), 3, 97);
        n7: int64 <- fin(b, p7);
        _: int64 <- line("string count 4294967295, 3 bytes follow", v(b, n7));
        p8: int64 <- fill(b, bees_wire@put_u32(b, pre2(b, 1, 2), 1000), 3, 97);
        n8: int64 <- fin(b, p8);
        _: int64 <- line("string count 1000, 3 bytes follow", v(b, n8));
        p9: int64 <- fill(b, bees_wire@put_i(b, pre2(b, 1, 3), 255), 3, 122);
        n9: int64 <- fin(b, p9);
        _: int64 <- line("atom count 255, 3 bytes follow", v(b, n9));
        p10: int64 <- fill(b, bees_wire@put_i(b, pre2(b, 1, 3), 255), 255, 122);
        n10: int64 <- fin(b, p10);
        _: int64 <- line("atom of 255 bytes that the program does not hold", v(b, n10));
        e: int64 <- bees_wire_msgs@enc_tag(b, bees_atoms@a_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy());
        _: int64 <- line("encode an atom whose spelling is 256 bytes", code_of_enc(e))
    produces pure 0 end
}

// --- atoms, kinds, text, booleans, headers, floats, trailing bytes
fn spelled(b: buf(L, normal, uint8, 4096), id: int64, c0: int64, c1: int64, c2: int64, c3: int64) -> int64 {
    fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, pre2(b, 1, id), 4), c0), c1), c2), c3))
}
fn content(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n1: int64 <- spelled(b, 3, 110, 111, 112, 101);
        _: int64 <- line("atom nope (not held)", v(b, n1));
        n2: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, pre2(b, 1, 3), 5), 107), 110), 111), 119), 110), 0));
        _: int64 <- line("atom known, then one more byte", v(b, n2));
        n3: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, pre2(b, 1, 3), 5), 107), 110), 111), 119), 110));
        _: int64 <- line("atom known", v(b, n3));
        n4: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 3), 0));
        _: int64 <- line("atom with an empty spelling", v(b, n4));
        n5: int64 <- spelled(b, 3, 110, 111, 200, 101);
        _: int64 <- line("atom spelling with byte 200", v(b, n5));
        n6: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 11), 0));
        _: int64 <- line("unknown kind id 11", v(b, n6));
        n7: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 65535), 0));
        _: int64 <- line("unknown kind id 65535", v(b, n7));
        n8: int64 <- fin(b, pre(b, 1, 0));
        _: int64 <- line("frame ends inside the kind id", v(b, n8));
        n9: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_u32(b, pre2(b, 1, 2), 3), 97));
        _: int64 <- line("string count 3, one byte follows", v(b, n9));
        t1: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_u32(b, pre2(b, 1, 2), 3), 97), 128), 99));
        _: int64 <- line("string with byte 128", v(b, t1));
        t2: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_u32(b, pre2(b, 1, 2), 2), 195), 169));
        _: int64 <- line("string 0xC3 0xA9 (UTF-8 e-acute)", v(b, t2));
        t3: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_u32(b, pre2(b, 1, 2), 2), 97), 0));
        _: int64 <- line("string with a NUL byte", v(b, t3));
        t4: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_u32(b, pre2(b, 1, 2), 2), 97), 127));
        _: int64 <- line("string with byte 127", v(b, t4));
        c1: int64 <- fin(b, bees_wire@put_u32(b, pre2(b, 1, 6), 233));
        _: int64 <- line("char code point 233", v(b, c1));
        c2: int64 <- fin(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, bees_wire@put_i(b, pre2(b, 1, 6), 0), 1), 246), 0));
        _: int64 <- line("char code point 0x1F600", v(b, c2));
        c3: int64 <- fin(b, bees_wire@put_u32(b, pre2(b, 1, 6), 65));
        _: int64 <- line("char A", v(b, c3));
        o1: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 10), 2));
        _: int64 <- line("boolean byte 2", v(b, o1));
        o2: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 10), 1));
        _: int64 <- line("boolean byte 1", v(b, o2));
        h1: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 10), 1));
        _: int64 <- bees_wire@put_i(b, 4, 2);
        _: int64 <- line("version byte 2", v(b, h1));
        h2: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 2, 10), 1));
        _: int64 <- line("frame kind 2", v(b, h2));
        h3: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 0, 10), 1));
        _: int64 <- line("frame kind 0 (hello) where a send is expected", v(b, h3));
        d1: int64 <- bees_wire@enc_hello(b, bees_atoms@a_node_a(), 5);
        _: int64 <- line("hello frame where a send is expected (dec_bol)", bees_wire_msgs@dec_bol(b, d1).code);
        d2: int64 <- fin(b, bees_wire@put_i(b, pre2(b, 1, 10), 1));
        hd: { code: int64, node: atom, digest: int64 } <- bees_wire@dec_hello(b, d2);
        _: int64 <- line("send frame where a hello is expected", hd.code);
        g1: int64 <- fin(b, fill(b, pre2(b, 1, 4), 8, 0));
        _: int64 <- bees_wire@put_i(b, 8, 127);
        _: int64 <- bees_wire@put_i(b, 9, 240);
        _: int64 <- line("float64 +infinity", v(b, g1));
        _: int64 <- bees_wire@put_i(b, 9, 248);
        _: int64 <- line("float64 NaN", v(b, g1));
        g2: int64 <- fin(b, fill(b, pre2(b, 1, 5), 4, 0));
        _: int64 <- bees_wire@put_i(b, 8, 255);
        _: int64 <- bees_wire@put_i(b, 9, 128);
        _: int64 <- line("float32 -infinity", v(b, g2));
        _: int64 <- bees_wire@put_i(b, 9, 192);
        _: int64 <- line("float32 NaN", v(b, g2));
        x1: int64 <- fin(b, fill(b, pre2(b, 1, 5), 5, 0));
        _: int64 <- line("float32 and one byte more", v(b, x1));
        x2: int64 <- fin(b, fill(b, pre2(b, 1, 5), 4, 0));
        _: int64 <- bees_wire@put_i(b, x2, 0);
        _: int64 <- line("one byte past the declared length", v(b, x2 + 1));
        x3: int64 <- fin(b, fill(b, pre2(b, 1, 5), 4, 0));
        _: int64 <- line("float32 zero", v(b, x3))
    produces pure 0 end
}

fn big() -> float64 { 1.0e308 }
fn hugef() -> float64 { big() * big() }
fn nanf() -> float64 { hugef() - hugef() }
fn floats(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        i: float64 <- hugef();
        _: int64 <- line("encode float64 +infinity", code_of_enc(bees_wire_msgs@enc_flt(b, i)));
        n: float64 <- nanf();
        _: int64 <- line("encode float64 NaN", code_of_enc(bees_wire_msgs@enc_flt(b, n)))
    produces pure 0 end
}

fn run_all(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- truncation(b);
        _: int64 <- oversized(b);
        _: int64 <- depth(b);
        _: int64 <- counts(b);
        _: int64 <- content(b);
        _: int64 <- floats(b);
        n: int64 <- bees_wire_msgs@enc_small(b, small_value());
        print_string("after every rejection a valid frame still decodes: ");
        _: atom <- print_atom(bees_wire@reason_atom(v(b, n)));
        println("");
        println("reject done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(r, 4096);
        _: int64 <- run_all(b)
    produces pure 0 end
}
