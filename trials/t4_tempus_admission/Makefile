# T4: TEMPUS admission in one process (development-plan/tempus-design.md section 4): the token rules, the two key
# operations (SHA-512 identity, the producer's Ed25519 signature) and proof of possession, through the TEMPUS native edge
# (native/tempus over the programmer-installed OpenSSL). No carrier, no TLS, no clock: `now` is a fixed TEST-ONLY value.
# The fixtures (lib/tempus_fixtures.silica) are generated by tools/bees_tempus_fixtures.py from fixed seeds and kept in the
# tree; `build` fails when the file is not what the tool writes. The leaf needs the edge's archive (make -C native tempus),
# which needs the OpenSSL the TLS engine needs; without it the leaf fails with native/Makefile's refusal, it never skips.
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
include $(BEES_ROOT)/tools/trial.mk

.PHONY: tempus-edge fixtures
build: tempus-edge fixtures
tempus-edge:
	@out=$$($(MAKE) --no-print-directory -C "$(BEES_ROOT)/native" tempus 2>&1); rc=$$?; \
	[ -z "$$out" ] || printf '%s\n' "$$out" | grep -v '^ar \|^cc \|^mkdir ' ; \
	if [ "$$rc" != 0 ]; then echo "FAIL: [t4_tempus_admission] needs the TEMPUS native edge (make -C native tempus)"; exit 1; fi
fixtures:
	@python3 "$(BEES_ROOT)/tools/bees_tempus_fixtures.py" check > /dev/null || { echo "FAIL: [t4_tempus_admission] lib/tempus_fixtures.silica is not what tools/bees_tempus_fixtures.py writes"; exit 1; }
