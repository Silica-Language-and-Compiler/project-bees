// protocol (criteria 5 and 6): what a session does with frames that break the rules. Raw peers with b.cert's identity.
//   1  two requests with the same req_id while the first is in work: the second is dropped and counted, nothing else
//      happens; a third request is served; the session then ends by idle_ms. Bytes back: token_issue, ok, two results, goaway.
//   2  a call that is busy 300 ms, then a malformed map in the middle of the session: protocol_error, goaway protocol, closed
//      at once (the call's result is dropped). Bytes back: token_issue, ok, goaway.
//   3  a frame length above frame_size_max in the middle of a session: refused when the length is read, goaway protocol
//   4  token_present (with the offer) carrying a token the server never issued: token_reject, goaway deny before any ok
//   5  a call by trpc (a session); 6 the metrics
fn bad_map() -> string {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [131, 116, 0, 0, 0, 2, 119, 1, 116, 119, 4, 99, 97, 108, 108]
    produces pure f4(bs(xs)) end
}
fn oversize() -> string {
    sequence proc[mem(normal)]
        xs: List[int64, mem(normal)] <- [0, 1, 134, 160, 131, 116, 0, 0]
    produces pure bs(xs) end
}
fn fp_b() -> string { bees_trust_conf@self_fp() }
fn label(step: int64) -> string {
    case step of {
        1 -> "raw: a session, the same req_id twice while the first is in work, then another request";
        2 -> "raw: a session, a call in work, then a malformed map";
        3 -> "raw: a session, then a frame length above frame_size_max";
        4 -> "raw: token_present with the offer and a token the server never issued";
        5 -> "call demo:add([1, 2]) (a session by trpc)";
        6 -> "cast demo:stats([])";
        _: int64 -> "?"
    }
}
fn start(step: int64, me: actor_ref) -> atom {
    case step of {
        2 -> sraw_open(2, cat3(fp_b(), offer_hello(), cat(call_frame("p1", bees_atoms@a_slow(), 1, ints1(300)), bad_map())), me, false);
        3 -> sraw_open(3, cat3(fp_b(), offer_hello(), oversize()), me, false);
        4 -> sraw_open(4, cat(fp_b(), offer_token(repeated(120, 48))), me, false);
        1 -> sraw_open(1, cat3(fp_b(), offer_hello(), cat3(call_frame("dup", bees_atoms@a_slow(), 1, ints1(300)), call_frame("dup", bees_atoms@a_add(), 2, ints2(1, 2)), call_frame("ok2", bees_atoms@a_add(), 2, ints2(40, 2)))), me, false);
        5 -> trpc_call(server(), bees_atoms@a_demo(), bees_atoms@a_add(), 2, ints2(1, 2), me, 5);
        6 -> stats_cast(me, 6);
        _: int64 -> say("protocol done")
    }
}
fn next(step: int64, me: actor_ref) -> atom {
    case step of { 2 -> wake(me, 500, 3); 6 -> wake(me, 500, 7); _: int64 -> wake(me, 200, step + 1) }
}
fn driver(r: { req: int64, what: atom, value: string }, n: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        _: atom <- case r.value == "go" of {
            true -> start(r.req, me);
            false -> { sequence _: atom <- step_line(r) produces pure next(r.req, me) end }
        }
    produces pure (:no_reply, n + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        b: int64 <- trust_boot();
        _: atom <- start_reporter();
        _: atom <- trust_start();
        d: actor_ref <- spawn(0, driver, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- start(1, d);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
