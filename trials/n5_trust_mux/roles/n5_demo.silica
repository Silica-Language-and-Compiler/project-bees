// N5 trial: the demo service of the server nodes, the functions their demo.trust manifest offers to TRUST peers. Each takes
// the request's args as the list the manifest declares and returns (:ok, value) or (:error, reason) (the user code failing;
// the worker then fails, D2). The two functions that speak to a session node's own actors are in n5_ops. None of them prints: a worker's line would race with the connection actor's lines.
module n5_demo;
use bees_atoms;

export add/1;
export echo/1;
export slow/1;
export crash/1;
export note/1;
export secret/1;

fn sum(xs: List[int64, mem(normal)], acc: int64) -> int64 {
    case xs of {
        []: List[int64, mem(normal)] -> acc;
        [h: int64, t: List[int64, mem(normal)]] -> sum(t, acc + h)
    }
}
fn first_int(xs: List[int64, mem(normal)]) -> int64 {
    case xs of { []: List[int64, mem(normal)] -> 0; [h: int64, _t: List[int64, mem(normal)]] -> h }
}
fn first_str(xs: List[string, mem(normal)]) -> string {
    case xs of { []: List[string, mem(normal)] -> ""; [h: string, _t: List[string, mem(normal)]] -> h }
}
fn add(xs: List[int64, mem(normal)]) -> (:ok, int64) | (:error, atom) { (:ok, sum(xs, 0)) }
fn echo(xs: List[string, mem(normal)]) -> (:ok, string) | (:error, atom) { (:ok, first_str(xs)) }
// in work for the given number of milliseconds (by the clock, so the same on every machine), then the number. The wait is
// not one long computation: it asks a helper actor of its own again and again until the time has passed. A call that awaits
// its reply is a point where Silica's scheduler runs the other actors of the same carrier thread (specification 15.1.2), so
// the server goes on reading and answering while this request is in work, on a machine of any number of cores (SD-47, Q15).
fn now() -> int64 {
    sequence proc[concurrency]
        t: int64 <- monotonic_time()
    produces pure t end
}
fn yielder(msg: int64, state: int64) -> (:reply, int64, int64) {
    sequence proc[concurrency]
        _: atom <- case msg == 0 of { true -> stop_self(:normal); false -> :normal }
    produces pure (:reply, msg, state) end
}
fn wait_until(a: actor_ref, deadline: int64) -> int64 {
    sequence proc[concurrency]
        late: boolean <- now() >= deadline;
        v: int64 <- case late of { true -> call(a, 0 impl ActorMessage {}); false -> call(a, 1 impl ActorMessage {}) };
        r: int64 <- case late of { true -> v; false -> wait_until(a, deadline) }
    produces pure r end
}
fn slow(xs: List[int64, mem(normal)]) -> (:ok, int64) | (:error, atom) {
    sequence proc[concurrency]
        ms: int64 <- first_int(xs);
        a: actor_ref <- spawn(0, yielder, stack_policy(1048576, :keep_last_message), state_policy(:keep_state_area));
        _: int64 <- wait_until(a, now() + ms * 1000000)
    produces pure (:ok, ms) end
}
fn crash(xs: List[int64, mem(normal)]) -> (:ok, int64) | (:error, atom) { (:error, bees_atoms@a_badarith()) }
fn note(xs: List[int64, mem(normal)]) -> (:ok, int64) | (:error, atom) { (:ok, first_int(xs)) }
fn secret(xs: List[int64, mem(normal)]) -> (:ok, int64) | (:error, atom) { (:ok, 42) }
