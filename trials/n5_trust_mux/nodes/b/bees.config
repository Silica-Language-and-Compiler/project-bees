%% N5 trial: node e, a TRUST server WITHOUT trust.session: one request per connection (B1, N3's actors). TEST ONLY: plaintext on 127.0.0.1, stand-in fingerprints (R5).
[
  {mode, trust},
  {node, [{name, "e@127.0.0.1"}]},
  {trust, [
    {port, 23003},
    {listen_address, "127.0.0.1"},
    {plaintext_test_only, true},
    {tls_opts, [{certfile, "../../certs/a.cert"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../certs"},
    {call_timeout_ms, 3000},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 3},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32}
  ]}
].
