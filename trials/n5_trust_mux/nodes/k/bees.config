%% N5 trial compat: N3's node a with the session actors and limits 1 and 1 (the multiplexing design's R-6). TEST ONLY: plaintext on 127.0.0.1, stand-in fingerprints (R5).
[
  {mode, trust},
  {node, [{name, "a@127.0.0.1"}]},
  {trust, [
    {port, 23002},
    {listen_address, "127.0.0.1"},                 %% required, no default (R6)
    {plaintext_test_only, true},                   %% TRUST's TLS is N4
    {tls_opts, [{certfile, "../../certs/a.cert"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../certs"},
    {call_timeout_ms, 400},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 8},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32},
    {session, #{max_inflight => 1, max_calls => 1}}
  ]}
].
