%% N5 trial: node b, a TRUST client that offers sessions (standalone: no whitelist; it pins node a).
[
  {mode, trust},
  {node, [{name, "b@127.0.0.1"}]},
  {trust, [
    {port, 23001},
    {listen_address, "127.0.0.1"},
    {plaintext_test_only, true},
    {tls_opts, [{certfile, "../../certs/b.cert"}]},   %% the stand-in identity this node presents (R5)
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 1500},
    {connect_timeout_ms, 3000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096},
    %% the client's side of the session map: max_inflight is how many of its calls may wait on one session
    {session, #{max_inflight => 4, max_calls => 8, max_age_ms => 60000, idle_ms => 2000, drain_ms => 1000}}
  ]}
].
