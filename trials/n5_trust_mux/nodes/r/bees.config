%% N5 trial: node r, the soak's session server (make measure): sessions of 1000 calls, 8 in work. TEST ONLY: plaintext on 127.0.0.1, stand-in fingerprints (R5).
[
  {mode, trust},
  {node, [{name, "r@127.0.0.1"}]},
  {trust, [
    {port, 23007},
    {listen_address, "127.0.0.1"},
    {plaintext_test_only, true},
    {tls_opts, [{certfile, "../../certs/a.cert"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../certs"},
    {call_timeout_ms, 3000},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 3},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32},
    %% the session window, every key written (the trial does not depend on a default)
    {session, #{max_inflight => 8, max_calls => 1000, max_age_ms => 60000, idle_ms => 5000, drain_ms => 1000}}
  ]}
].
