// M1: the worked example of contract/wire-v1.md. Prints the schema digest and the frames listed there; the
// document's bytes are fixed in tools/test_bees_wire_gen.py, which compares them with this trial's golden.
use bees_atoms;
use bees_wire;
use bees_wire_msgs;

fn dump(b: buf(L, normal, uint8, 4096), i: int64, n: int64) -> int64 {
    case i >= n of {
        true -> 0;
        false -> {
            sequence proc[device_io]
                _: atom <- print_int64(bees_wire@rb_i(b, i));
                print_string(" ");
                r: int64 <- dump(b, i + 1, n)
            produces pure r end
        }
    }
}
fn show(label: string, b: buf(L, normal, uint8, 4096), n: int64) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(": ");
        r: int64 <- dump(b, 0, n);
        println("")
    produces pure r end
}
fn bl() -> List[boolean, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[boolean, mem(normal)] <- empty[boolean, mem(normal)]();
        l: List[boolean, mem(normal)] <- prepend[boolean, mem(normal)](true, prepend[boolean, mem(normal)](false, e))
    produces pure l end
}
fn bv() -> { n: int16, s: string } { { n: -2, s: "hi" } }
fn go(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: atom <- print_int64(bees_wire_msgs@schema_digest());
        println("");
        n1: int64 <- bees_wire_msgs@enc_a(b, 255);
        _: int64 <- show("a", b, n1);
        n2: int64 <- bees_wire_msgs@enc_b(b, bv());
        _: int64 <- show("b", b, n2);
        n3: int64 <- bees_wire_msgs@enc_c(b, bl());
        _: int64 <- show("c", b, n3);
        n4: int64 <- bees_wire@enc_hello(b, bees_atoms@a_n1(), bees_wire_msgs@schema_digest());
        _: int64 <- show("hello", b, n4)
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(r, 4096);
        _: int64 <- go(b)
    produces pure 0 end
}
