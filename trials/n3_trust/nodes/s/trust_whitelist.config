%% SEMP's whitelist form: certificate file => permission spec (inter-nodal-modes 3.3)
#{
  "b.cert" => [{demo, [{add, 2}, {echo, 1}, {slow, 1}, {crash, 1}, {note, 1}]}],
  "n.cert" => none,
  "z.cert" => any                                 %% no such certificate: logged at boot and skipped, as SEMP does
}.
