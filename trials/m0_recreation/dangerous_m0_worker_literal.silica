// M0 (control): the worker reads a word through the adapter, delivers the raw word to the sink by the FFI
// result cast, and puts only an untainted literal in produces pure. Compiles and runs. Expected: true
module dangerous_m0_worker_literal;

use bees_reporter;

use dangerous_m0_fixture;

fn lookup(v: int64) -> int64 { case v of { 42 -> 42; 0 -> 0; 1 -> 1; _: int64 -> -1 } }

fn sink(msg: int64, state: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        ok: boolean <- msg == 42;
        _: atom <- print_boolean(ok);
        _: atom <- println("")
    produces pure (:no_reply, state) end
}

fn worker(msg: int64, state: { rt: actor_ref, v: int64 }) -> (:no_reply, { rt: actor_ref, v: int64 }) {
    sequence proc[external_danger, concurrency]
        w: int64 <- dangerous_m0_fixture@fixture_word(msg);
        x: int64 <- 0;
        _: boolean <- cast(state.rt, w impl ActorMessage {})
    produces pure (:no_reply, { rt: state.rt, v: x }) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message));
        w: dangerous_actor_ref <- spawn_dangerous({ rt: s, v: 0 }, worker, stack_policy(0, :keep_last_message));
        _: boolean <- cast(w, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
