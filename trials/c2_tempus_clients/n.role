// C2 clients trial: node N, the test node the Python client drives; its sentinel is the Python client's listener.
fn port() -> string { "23900" }
fn sents() -> string { "127.0.0.1:23903" }
// a test program: externally driven, by the test unit (src/tempus_test/bees_tempus_test.silica)
fn driven() -> boolean { true }
fn ext_start(app: actor_ref) -> actor_ref { bees_tempus_test@start(tempus_ids@now()) }
fn tick_ms() -> uint64 { 1000 }
