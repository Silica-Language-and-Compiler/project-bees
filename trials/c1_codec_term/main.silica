// C1: dynamic terms. bees_term_wire (any ETF term to and from a flat token list) and bees_etf_scan (positions), in one
// process, with no network.
//
// Part 1, fixtures: the bytes stock Erlang wrote (OTP 28, term_to_binary/1; tools/bees_term_fixtures.erl prints them, and
// tools/test_bees_term_etf.py compares the hex below with erl again). Each line: label, the tokens bees_term_wire@decode
// made (at most 40, then +N), and "same" when bees_term_wire@encode of those tokens gives the fixture's bytes back.
// A " SCAN" mark would follow when bees_etf_scan@skip did not end at the frame's end (never expected).
//   token spelling: i<n> integer, I+<hex> I-<hex> big integer (magnitude, little-endian), f<hex> float (IEEE bits),
//   a:<hex> atom name, b:<hex> binary, B<bits>:<hex> bit string, t<n> tuple, l<n> list (n elements and a tail), n nil,
//   s:<hex> byte list, m<n> map, p: r: o: u: a carried pid, reference, port, fun; hex over 24 bytes is cut, ~<length>.
// The fixed_ fixtures (pid, reference, port, local fun) were captured once: their bytes differ in every Erlang run.
// Part 2: forms Erlang reads but does not write (old tags, padded integers): the tokens, and the canonical bytes.
// Part 3: terms built with the constructors; their bytes equal the fixture's.
// Part 4: the scanner's questions.  Part 5: refusals (decode: the rejection atom; encode: an empty result).
// Part 6: large terms (60,002 tokens) and the limits.
use bees_etf_scan;
use bees_term_wire;

// ---- hex ----
fn at(s: string, i: int64) -> int64 {
    sequence proc[transport]
        b: int64 <- byte_at(s, i)
    produces pure b end
}
fn cut(s: string, start: int64, stop: int64) -> string {
    sequence proc[mem(normal), transport]
        out: string <- byte_slice(s, start, stop)
    produces pure out end
}
fn hv(c: int64) -> int64 { case c >= 97 of { true -> c - 87; false -> c - 48 } }
fn unhex_acc(s: string, i: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case i < 0 of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                b: int64 <- hv(at(s, i)) * 16 + hv(at(s, i + 1));
                l: List[int64, mem(normal)] <- prepend[int64, mem(normal)](b, acc)
            produces pure unhex_acc(s, i - 2, l) end
        }
    }
}
fn no_ints() -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[int64, mem(normal)] <- []
    produces pure e end
}
fn no_toks() -> List[(int64, int64, float64, string), mem(normal)] {
    sequence proc[mem(normal)]
        e: List[(int64, int64, float64, string), mem(normal)] <- []
    produces pure e end
}
fn packed(xs: List[int64, mem(normal)]) -> string {
    sequence proc[mem(normal), transport]
        out: string <- bytes_of(xs)
    produces pure out end
}
fn unhex(s: string) -> string { packed(unhex_acc(s, length_bytes(s) - 2, no_ints())) }
fn hd(v: int64) -> int64 { case v < 10 of { true -> 48 + v; false -> 87 + v } }
fn hex_acc(s: string, i: int64, acc: List[int64, mem(normal)]) -> List[int64, mem(normal)] {
    case i < 0 of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                l1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](hd(at(s, i) % 16), acc);
                l2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](hd(at(s, i) / 16), l1)
            produces pure hex_acc(s, i - 1, l2) end
        }
    }
}
fn hex(s: string) -> string { packed(hex_acc(s, length_bytes(s) - 1, no_ints())) }

// ---- printing ----
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn num(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label);
        _: atom <- print_string(" ");
        _: atom <- print_int64(n);
        _: atom <- println("")
    produces pure :ok end
}
fn text(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label);
        _: atom <- print_string(" ");
        _: atom <- println(s)
    produces pure :ok end
}
fn why(label: string, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label);
        _: atom <- print_string(" ");
        _: atom <- print_atom(a);
        _: atom <- println("")
    produces pure :ok end
}
fn put_num(prefix: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(prefix);
        _: atom <- print_int64(n)
    produces pure :ok end
}
fn put_clip(prefix: string, s: string) -> atom {
    n: int64 <- length_bytes(s);
    case n <= 24 of {
        true -> {
            sequence proc[device_io]
                _: atom <- print_string(prefix);
                _: atom <- print_string(hex(s))
            produces pure :ok end
        };
        false -> {
            sequence proc[device_io]
                _: atom <- print_string(prefix);
                _: atom <- print_string(hex(cut(s, 0, 24)));
                _: atom <- print_string("~");
                _: atom <- print_int64(n)
            produces pure :ok end
        }
    }
}
fn put_bits(t: (int64, int64, float64, string)) -> atom {
    sequence
        _: atom <- put_num("B", bees_term_wire@n_of(t));
        _: atom <- put_clip(":", bees_term_wire@s_of(t))
    produces pure :ok end
}
fn sign_mark(n: int64) -> string { case n == 1 of { true -> "I-"; false -> "I+" } }
fn show_tok(t: (int64, int64, float64, string)) -> atom {
    case bees_term_wire@kind_of(t) of {
        1 -> put_num("i", bees_term_wire@n_of(t));
        2 -> put_clip(sign_mark(bees_term_wire@n_of(t)), bees_term_wire@s_of(t));
        3 -> put_clip("f", bees_etf_scan@body_of(bees_etf_scan@float_term(bees_term_wire@f_of(t))));
        4 -> put_clip("a:", bees_term_wire@s_of(t));
        5 -> put_clip("b:", bees_term_wire@s_of(t));
        6 -> put_bits(t);
        7 -> put_num("t", bees_term_wire@n_of(t));
        8 -> put_num("l", bees_term_wire@n_of(t));
        9 -> put_clip("n", "");
        10 -> put_clip("s:", bees_term_wire@s_of(t));
        11 -> put_num("m", bees_term_wire@n_of(t));
        12 -> put_clip("p:", bees_term_wire@s_of(t));
        13 -> put_clip("r:", bees_term_wire@s_of(t));
        14 -> put_clip("o:", bees_term_wire@s_of(t));
        15 -> put_clip("u:", bees_term_wire@s_of(t));
        _: int64 -> put_num("?", bees_term_wire@kind_of(t))
    }
}
fn count(toks: List[(int64, int64, float64, string), mem(normal)], n: int64) -> int64 {
    case toks of {
        []: List[(int64, int64, float64, string), mem(normal)] -> n;
        [_h: (int64, int64, float64, string), t: List[(int64, int64, float64, string), mem(normal)]] -> count(t, n + 1)
    }
}
fn show_toks(toks: List[(int64, int64, float64, string), mem(normal)], left: int64) -> atom {
    case toks of {
        []: List[(int64, int64, float64, string), mem(normal)] -> :ok;
        [h: (int64, int64, float64, string), t: List[(int64, int64, float64, string), mem(normal)]] -> case left == 0 of {
            true -> put_num(" +", count(toks, 0));
            false -> {
                sequence proc[device_io]
                    _: atom <- print_string(" ");
                    _: atom <- show_tok(h)
                produces pure show_toks(t, left - 1) end
            }
        }
    }
}
fn verdict(a: string, b: string) -> string { case a == b of { true -> "same"; false -> "differs" } }
fn scan_mark(frame: string) -> string {
    case bees_etf_scan@skip(frame, 1) == length_bytes(frame) of { true -> ""; false -> " SCAN" }
}

// ---- part 1: a fixture, decoded, shown, encoded again ----
fn shown(frame: string, toks: List[(int64, int64, float64, string), mem(normal)]) -> atom {
    sequence proc[device_io]
        _: atom <- show_toks(toks, 40);
        again: string <- bees_term_wire@encode(toks);
        _: atom <- print_string(" | ");
        _: atom <- print_string(verdict(again, frame));
        _: atom <- println(scan_mark(frame))
    produces pure :ok end
}
fn refused(reason: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(" rejected ");
        _: atom <- print_atom(reason);
        _: atom <- println("")
    produces pure :ok end
}
fn fx_done(frame: string, r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, toks: List[(int64, int64, float64, string), mem(normal)]) -> shown(frame, toks);
        (:rejected, reason: atom) -> refused(reason)
    }
}
fn fxb(label: string, frame: string) -> atom {
    sequence proc[device_io]
        r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- bees_term_wire@decode(frame);
        _: atom <- print_string(label);
        _: atom <- print_string(":")
    produces pure fx_done(frame, r) end
}
fn fx(label: string, hx: string) -> atom { fxb(label, unhex(hx)) }

// ---- part 2: a form Erlang does not write: the tokens, then the canonical bytes ----
fn canon_done(r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, toks: List[(int64, int64, float64, string), mem(normal)]) -> {
            sequence proc[device_io]
                _: atom <- show_toks(toks, 40);
                again: string <- bees_term_wire@encode(toks);
                _: atom <- print_string(" -> ");
                _: atom <- println(hex(again))
            produces pure :ok end
        };
        (:rejected, reason: atom) -> refused(reason)
    }
}
fn canon(label: string, hx: string) -> atom {
    sequence proc[device_io]
        r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- bees_term_wire@decode(unhex(hx));
        _: atom <- print_string(label);
        _: atom <- print_string(":")
    produces pure canon_done(r) end
}

// ---- part 3: built from constructors ----
fn built(label: string, toks: List[(int64, int64, float64, string), mem(normal)], hx: string) -> atom {
    sequence
        out: string <- bees_term_wire@encode(toks);
        _: atom <- text(label, verdict(out, unhex(hx)))
    produces pure :ok end
}
// encode refuses: the length of what it returned (0)
fn enc_no(label: string, toks: List[(int64, int64, float64, string), mem(normal)]) -> atom {
    sequence
        out: string <- bees_term_wire@encode(toks);
        _: atom <- num(label, length_bytes(out))
    produces pure :ok end
}

// ---- frames made here ----
fn fill(acc: List[int64, mem(normal)], b: int64, n: int64) -> List[int64, mem(normal)] {
    case n <= 0 of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                l: List[int64, mem(normal)] <- prepend[int64, mem(normal)](b, acc)
            produces pure fill(l, b, n - 1) end
        }
    }
}
fn push2(acc: List[int64, mem(normal)], a: int64, b: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        l1: List[int64, mem(normal)] <- prepend[int64, mem(normal)](b, acc);
        l2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](a, l1)
    produces pure l2 end
}
// tag and a 4-byte count in front of acc
fn head4(acc: List[int64, mem(normal)], tag: int64, n: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        l1: List[int64, mem(normal)] <- push2(acc, (n / 256) % 256, n % 256);
        l2: List[int64, mem(normal)] <- push2(l1, (n / 16777216) % 256, (n / 65536) % 256);
        l3: List[int64, mem(normal)] <- prepend[int64, mem(normal)](tag, l2)
    produces pure l3 end
}
fn framed(acc: List[int64, mem(normal)]) -> string {
    sequence proc[mem(normal)]
        l: List[int64, mem(normal)] <- prepend[int64, mem(normal)](131, acc)
    produces pure packed(l) end
}
fn one(b: int64) -> List[int64, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[int64, mem(normal)] <- [b]
    produces pure e end
}
// n one-element tuples inside one another around nil: {{...{[]}...}}
fn nest_acc(acc: List[int64, mem(normal)], n: int64) -> List[int64, mem(normal)] {
    case n <= 0 of { true -> acc; false -> nest_acc(push2(acc, 104, 1), n - 1) }
}
fn nested(n: int64) -> string { framed(nest_acc(one(106), n)) }
// a list of n elements, each the bytes `a b` (n times), closed by nil
fn pairs_acc(acc: List[int64, mem(normal)], a: int64, b: int64, n: int64) -> List[int64, mem(normal)] {
    case n <= 0 of { true -> acc; false -> pairs_acc(push2(acc, a, b), a, b, n - 1) }
}
// [{0}, {1}, ..., {255}, {0}, ...]: n one-element tuples of a small integer
fn tuples_acc(acc: List[int64, mem(normal)], i: int64) -> List[int64, mem(normal)] {
    case i < 0 of { true -> acc; false -> tuples_acc(push2(push2(acc, 97, i % 256), 104, 1), i - 1) }
}
fn tuple_list(n: int64) -> string { framed(head4(tuples_acc(one(106), n - 1), 108, n)) }
// [1000, 1001, ...]: n integers as INTEGER_EXT
fn ints_acc(acc: List[int64, mem(normal)], i: int64) -> List[int64, mem(normal)] {
    case i < 0 of { true -> acc; false -> ints_acc(head4(acc, 98, 1000 + i), i - 1) }
}
fn int_list(n: int64) -> string { framed(head4(ints_acc(one(106), n - 1), 108, n)) }
// [0, 1, ..., 255, 0, ...] spelled as LIST_EXT of SMALL_INTEGER_EXT (Erlang writes STRING_EXT)
fn small_acc(acc: List[int64, mem(normal)], i: int64) -> List[int64, mem(normal)] {
    case i < 0 of { true -> acc; false -> small_acc(push2(acc, 97, i % 256), i - 1) }
}
fn small_list(n: int64) -> string { framed(head4(small_acc(one(106), n - 1), 108, n)) }
// a list of n nils
fn nil_list(n: int64) -> string { framed(head4(fill(one(106), 106, n), 108, n)) }
// a list of `rows` tuples of 255 nils each: the token limit is passed part of the way in
fn rows_acc(acc: List[int64, mem(normal)], rows: int64) -> List[int64, mem(normal)] {
    case rows <= 0 of { true -> acc; false -> rows_acc(push2(fill(acc, 106, 255), 104, 255), rows - 1) }
}
fn row_list(rows: int64) -> string { framed(head4(rows_acc(one(106), rows), 108, rows)) }
// #{1000 => [], 1001 => [], ...}: n pairs with INTEGER_EXT keys
fn map_acc(acc: List[int64, mem(normal)], i: int64) -> List[int64, mem(normal)] {
    case i < 0 of {
        true -> acc;
        false -> {
            sequence proc[mem(normal)]
                l: List[int64, mem(normal)] <- prepend[int64, mem(normal)](106, acc)
            produces pure map_acc(head4(l, 98, 1000 + i), i - 1) end
        }
    }
}
fn int_map(n: int64) -> string { framed(head4(map_acc(no_ints(), n - 1), 116, n)) }
// an atom of n letters x under ATOM_UTF8_EXT
fn long_atom(n: int64) -> string {
    sequence proc[mem(normal)]
        l1: List[int64, mem(normal)] <- push2(fill(no_ints(), 120, n), n / 256, n % 256);
        l2: List[int64, mem(normal)] <- prepend[int64, mem(normal)](118, l1)
    produces pure framed(l2) end
}
fn letters(n: int64) -> string { packed(fill(no_ints(), 120, n)) }

// what decode says: the reason, or the number of tokens
fn verdict_of(label: string, r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, toks: List[(int64, int64, float64, string), mem(normal)]) -> num(concat(label, ": accepted, tokens"), count(toks, 0));
        (:rejected, reason: atom) -> why(concat(label, ": rejected"), reason)
    }
}
fn ask(label: string, frame: string) -> atom {
    sequence
        r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- bees_term_wire@decode(frame)
    produces pure verdict_of(label, r) end
}
fn ask_within(label: string, frame: string, d: int64, t: int64) -> atom {
    sequence
        r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- bees_term_wire@decode_within(frame, d, t)
    produces pure verdict_of(label, r) end
}
// a large term: tokens, the bytes back, and the scanner's end
fn large_done(label: string, frame: string, r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, toks: List[(int64, int64, float64, string), mem(normal)]) -> {
            sequence
                again: string <- bees_term_wire@encode(toks);
                _: atom <- num(concat(label, ": tokens"), count(toks, 0));
                _: atom <- num(concat(label, ": bytes in"), length_bytes(frame));
                _: atom <- num(concat(label, ": bytes out"), length_bytes(again));
                _: atom <- text(concat(label, ": bytes"), verdict(again, frame));
                _: atom <- num(concat(label, ": scanner ends at"), bees_etf_scan@skip(frame, 1))
            produces pure :ok end
        };
        (:rejected, reason: atom) -> why(concat(label, ": rejected"), reason)
    }
}
fn large(label: string, frame: string) -> atom {
    sequence
        r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- bees_term_wire@decode(frame)
    produces pure large_done(label, frame, r) end
}

// ---- every prefix of a frame, and every byte of it changed ----
fn is_ok(r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, _t: List[(int64, int64, float64, string), mem(normal)]) -> 1;
        (:rejected, _a: atom) -> 0
    }
}
fn is_truncated(r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, _t: List[(int64, int64, float64, string), mem(normal)]) -> 0;
        (:rejected, a: atom) -> case a == :truncated of { true -> 1; false -> 0 }
    }
}
fn dec(frame: string) -> (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) { bees_term_wire@decode(frame) }
// k from len - 1 down to 0: decode of the first k bytes; acc = accepted * 1000000 + truncated * 1000 + scanner refusals
fn prefixes(frame: string, k: int64, acc: int64) -> int64 {
    case k < 0 of {
        true -> acc;
        false -> {
            sequence
                part: string <- cut(frame, 0, k);
                r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- dec(part);
                sc: int64 <- case bees_etf_scan@skip(part, 1) < 0 of { true -> 1; false -> 0 }
            produces pure prefixes(frame, k - 1, acc + is_ok(r) * 1000000 + is_truncated(r) * 1000 + sc) end
        }
    }
}
fn changed(frame: string, i: int64, add: int64) -> string {
    sequence proc[mem(normal), transport]
        a: string <- byte_slice(frame, 0, i);
        m: string <- packed(one((at(frame, i) + add) % 256));
        b: string <- byte_slice(frame, i + 1, length_bytes(frame));
        parts: List[string, mem(normal)] <- [a, m, b];
        out: string <- join_bytes(parts)
    produces pure out end
}
// every byte i changed by `add`: the number of changed frames decode accepted (the rest were refused; none faulted)
fn changes(frame: string, i: int64, add: int64, acc: int64) -> int64 {
    case i < 0 of {
        true -> acc;
        false -> {
            sequence
                r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- dec(changed(frame, i, add))
            produces pure changes(frame, i - 1, add, acc + is_ok(r)) end
        }
    }
}
fn sweep(label: string, hx: string) -> atom {
    sequence
        frame: string <- unhex(hx);
        p: int64 <- prefixes(frame, length_bytes(frame) - 1, 0);
        _: atom <- num(concat(label, ": prefixes tried"), length_bytes(frame));
        _: atom <- num(concat(label, ": prefixes accepted"), p / 1000000);
        _: atom <- num(concat(label, ": prefixes rejected truncated"), (p / 1000) % 1000);
        _: atom <- num(concat(label, ": prefixes the scanner refused"), p % 1000);
        _: atom <- num(concat(label, ": bytes changed by 1, accepted"), changes(frame, length_bytes(frame) - 1, 1, 0));
        _: atom <- num(concat(label, ": bytes changed by 128, accepted"), changes(frame, length_bytes(frame) - 1, 128, 0))
    produces pure :ok end
}

fn fl_2_5() -> float64 { v: float64 <- 2.5; v }
fn fl_1_5() -> float64 { v: float64 <- 1.5; v }
fn fl_1_0() -> float64 { v: float64 <- 1.0; v }
fn fl_neg0() -> float64 { z: float64 <- 0.0; m: float64 <- 0.0 - 1.0; z * m }
fn one_tok(t: (int64, int64, float64, string)) -> List[(int64, int64, float64, string), mem(normal)] {
    sequence proc[mem(normal)]
        e: List[(int64, int64, float64, string), mem(normal)] <- [t]
    produces pure e end
}
// n one-element tuple tokens in front of toks
fn tuples_in(n: int64, toks: List[(int64, int64, float64, string), mem(normal)]) -> List[(int64, int64, float64, string), mem(normal)] {
    case n <= 0 of {
        true -> toks;
        false -> {
            sequence proc[mem(normal)]
                l: List[(int64, int64, float64, string), mem(normal)] <- prepend[(int64, int64, float64, string), mem(normal)](bees_term_wire@t_tuple(1), toks)
            produces pure tuples_in(n - 1, l) end
        }
    }
}
fn toks_of(frame: string) -> List[(int64, int64, float64, string), mem(normal)] {
    sequence
        r: (:ok, List[(int64, int64, float64, string), mem(normal)]) | (:rejected, atom) <- bees_term_wire@decode(frame)
    produces pure case r of { (:ok, toks: List[(int64, int64, float64, string), mem(normal)]) -> toks; (:rejected, _a: atom) -> no_toks() } end
}
fn part1a() -> atom {
    sequence 
        _: atom <- fx("int_0", "836100");
        _: atom <- fx("int_255", "8361ff");
        _: atom <- fx("int_256", "836200000100");
        _: atom <- fx("int_neg1", "8362ffffffff");
        _: atom <- fx("int_i32max", "83627fffffff");
        _: atom <- fx("int_i32min", "836280000000");
        _: atom <- fx("int_i32max1", "836e040000000080");
        _: atom <- fx("int_i32min1", "836e040101000080");
        _: atom <- fx("int_i64max", "836e0800ffffffffffffff7f");
        _: atom <- fx("int_i64min", "836e08010000000000000080");
        _: atom <- fx("int_i64max1", "836e08000000000000000080");
        _: atom <- fx("int_i64min1", "836e08010100000000000080");
        _: atom <- fx("int_2p64", "836e0900000000000000000001");
        _: atom <- fx("big_2048", "");
        _: atom <- fx("big_2048_neg", "");
        _: atom <- fx("float_1_5", "83463ff8000000000000");
        _: atom <- fx("float_neg0", "83468000000000000000");
        _: atom <- fx("float_0", "83460000000000000000");
