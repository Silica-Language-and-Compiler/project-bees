fn part3a() -> atom {
    sequence proc[mem(normal)]
        b0: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_tuple(3), bees_term_wire@t_atom("a"), bees_term_wire@t_int(1), bees_term_wire@t_bin("x")];
        _: atom <- built("built tuple_3:", b0, "83680377016161016d0000000178");
        b1: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_tuple(0)];
        _: atom <- built("built tuple_0:", b1, "836800");
        b2: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bytes("abc")];
        _: atom <- built("built string from a byte list token:", b2, "836b0003616263");
        b3: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(3), bees_term_wire@t_int(97), bees_term_wire@t_int(98), bees_term_wire@t_int(99), bees_term_wire@t_nil()];
        _: atom <- built("built string from a list of small integers:", b3, "836b0003616263");
        b4: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(1), bees_term_wire@t_int(1), bees_term_wire@t_int(2)];
        _: atom <- built("built improper:", b4, "836c0000000161016102");
        b5: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(2), bees_term_wire@t_atom("a"), bees_term_wire@t_atom("b"), bees_term_wire@t_atom("c")];
        _: atom <- built("built improper2:", b5, "836c00000002770161770162770163");
        b6: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(7), bees_term_wire@t_int(1), bees_term_wire@t_atom("a"), bees_term_wire@t_bin("b"), bees_term_wire@t_tuple(1), bees_term_wire@t_atom("c"), bees_term_wire@t_float(fl_2_5()), bees_term_wire@t_nil(), bees_term_wire@t_bytes("s"), bees_term_wire@t_nil()];
        _: atom <- built("built list_mixed:", b6, "836c0000000761017701616d000000016268017701634640040000000000006a6b0001736a");
        b7: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(4), bees_term_wire@t_int(256), bees_term_wire@t_int(1000), bees_term_wire@t_int(65536), bees_term_wire@t_int(0 - 1), bees_term_wire@t_nil()];
        _: atom <- built("built list_big_ints:", b7, "836c00000004620000010062000003e8620001000062ffffffff6a");
        b8: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(2), bees_term_wire@t_int(104), bees_term_wire@t_int(256), bees_term_wire@t_nil()];
        _: atom <- built("built list_char_256:", b8, "836c00000002616862000001006a");
        b9: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(3), bees_term_wire@t_int(1), bees_term_wire@t_atom("a"), bees_term_wire@t_int(2), bees_term_wire@t_atom("b"), bees_term_wire@t_int(3), bees_term_wire@t_atom("c")];
        _: atom <- built("built map_ints:", b9, "837400000003610177016161027701626103770163");
        b10: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(2), bees_term_wire@t_int(1), bees_term_wire@t_atom("a"), bees_term_wire@t_float(fl_1_0()), bees_term_wire@t_atom("b")];
        _: atom <- built("built map_1_and_1_0:", b10, "8374000000026101770161463ff0000000000000770162");
        b11: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(1), bees_term_wire@t_map(2), bees_term_wire@t_int(1), bees_term_wire@t_nil(), bees_term_wire@t_int(2), bees_term_wire@t_nil(), bees_term_wire@t_nil()];
        _: atom <- built("built a map whose key is a map:", b11, "837400000001740000000261016a61026a6a");
        b12: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(2), bees_term_wire@t_atom("k"), bees_term_wire@t_map(1), bees_term_wire@t_int(1), bees_term_wire@t_list(1), bees_term_wire@t_map(0), bees_term_wire@t_nil(), bees_term_wire@t_bin("b"), bees_term_wire@t_tuple(1), bees_term_wire@t_map(0)];
        _: atom <- built("built map_nested:", b12, "83740000000277016b740000000161016c0000000174000000006a6d000000016268017400000000");
        b13: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(3), bees_term_wire@t_int(1), bees_term_wire@t_nil(), bees_term_wire@t_int(2), bees_term_wire@t_nil(), bees_term_wire@t_int(3), bees_term_wire@t_nil()];
        _: atom <- built("built set:", b13, "83740000000361016a61026a61036a");
        b14: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(0, unhex("000000000000000001"))];
        _: atom <- built("built int_2p64:", b14, "836e0900000000000000000001");
        b15: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(1, unhex("0100000000000080"))];
        _: atom <- built("built int_i64min1:", b15, "836e08010100000000000080")
    produces pure :ok end
}

fn part3b() -> atom {
    sequence proc[mem(normal)]
        b16: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(0, unhex("ff"))];
        _: atom <- built("built int_255 from a big token that fits:", b16, "8361ff");
        b17: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(1, unhex("0000000000000080"))];
        _: atom <- built("built int_i64min from a big token that fits:", b17, "836e08010000000000000080");
        b18: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_int(0 - 9223372036854775807 - 1)];
        _: atom <- built("built int_i64min:", b18, "836e08010000000000000080");
        b19: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_int(0 - 2147483649)];
        _: atom <- built("built int_i32min1:", b19, "836e040101000080");
        b20: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_float(fl_1_5())];
        _: atom <- built("built float_1_5:", b20, "83463ff8000000000000");
        b21: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_float(fl_neg0())];
        _: atom <- built("built float_neg0:", b21, "83468000000000000000");
        b22: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_atom(unhex("68c3a96c6c6fe28692"))];
        _: atom <- built("built atom_utf8:", b22, "83770968c3a96c6c6fe28692");
        b23: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_atom(letters(255))];
        _: atom <- built("built atom_255:", b23, "");
        b24: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_atom("")];
        _: atom <- built("built atom_empty:", b24, "837700");
        b25: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bin("")];
        _: atom <- built("built bin_empty:", b25, "836d00000000");
        b26: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bits(unhex("a0"), 3)];
        _: atom <- built("built bits_3:", b26, "834d0000000103a0");
        b27: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bits(unhex("bf"), 3)];
        _: atom <- built("built bits_3 with unused bits set:", b27, "834d0000000103a0");
        b28: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bits("abc", 8)];
        _: atom <- built("built bin_abc from a bit string of 8 bits:", b28, "836d00000003616263");
        b29: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_fun(unhex("7177056c6973747377036d61706102"))];
        _: atom <- built("built export_fun:", b29, "837177056c6973747377036d61706102");
        b30: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_pid(unhex("58770d6e6f6e6f6465406e6f686f73740000000a0000000000000000"))];
        _: atom <- built("built fixed_pid:", b30, "8358770d6e6f6e6f6465406e6f686f73740000000a0000000000000000");
        b31: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_ref(unhex("5a0003770d6e6f6e6f6465406e6f686f7374000000000003e24b59c40001ea4cbcd5"))];
        _: atom <- built("built fixed_ref:", b31, "835a0003770d6e6f6e6f6465406e6f686f7374000000000003e24b59c40001ea4cbcd5");
        b32: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_port(unhex("78770d6e6f6e6f6465406e6f686f7374000000000000000000000000"))];
        _: atom <- built("built fixed_port:", b32, "8378770d6e6f6e6f6465406e6f686f7374000000000000000000000000")
    produces pure :ok end
}

fn part3() -> atom {
    sequence
        _: atom <- part3a();
        _: atom <- part3b()
    produces pure :ok end
}

fn part4a() -> atom {
    sequence proc[device_io]
        m: string <- unhex("");
        _: atom <- num("mixed: length", length_bytes(m));
        _: atom <- num("mixed: skip from 1", bees_etf_scan@skip(m, 1));
        _: atom <- num("mixed: tag_at 1", bees_etf_scan@tag_at(m, 1));
        _: atom <- num("mixed: tuple_arity 1", bees_etf_scan@tuple_arity(m, 1));
        e1: int64 <- bees_etf_scan@tuple_first(m, 1);
        _: atom <- num("mixed: tuple_first 1", e1);
        _: atom <- text("mixed: atom_text of element 1", bees_etf_scan@atom_text(m, e1));
        _: atom <- num("mixed: atom_check of element 1", bees_etf_scan@atom_check(m, e1));
        _: atom <- print_boolean(bees_etf_scan@atom_is(m, e1, "call"));
        _: atom <- println(" atom_is call");
        _: atom <- print_boolean(bees_etf_scan@atom_is(m, e1, "cast"));
        _: atom <- println(" atom_is cast");
        e2: int64 <- bees_etf_scan@skip(m, e1);
        _: atom <- num("mixed: element 2 at", e2);
        _: atom <- num("mixed: map_count of element 2", bees_etf_scan@map_count(m, e2));
        k1: int64 <- bees_etf_scan@map_first(m, e2);
        _: atom <- num("mixed: map_first of element 2", k1);
        _: atom <- text("mixed: first key", bees_etf_scan@atom_text(m, k1));
        v1: int64 <- bees_etf_scan@skip(m, k1);
        _: atom <- num("mixed: first value: tag", bees_etf_scan@tag_at(m, v1));
        _: atom <- num("mixed: first value: list_count", bees_etf_scan@list_count(m, v1));
        x1: int64 <- bees_etf_scan@list_first(m, v1);
        _: atom <- num("mixed: first value: list_first", x1);
        x2: int64 <- bees_etf_scan@skip(m, x1);
        sl: string <- bees_etf_scan@slice_term(m, x1, x2);
        _: atom <- text("mixed: slice_term of the first element", hex(sl));
        _: atom <- text("mixed: body_of that slice", hex(bees_etf_scan@body_of(sl)));
        _: atom <- num("mixed: leaf_int of that slice", bees_etf_scan@leaf_int(sl).v);
        _: atom <- num("mixed: atom_check of element 2 (a map)", bees_etf_scan@atom_check(m, e2));
        _: atom <- num("mixed: length of atom_text of element 2", length_bytes(bees_etf_scan@atom_text(m, e2)));
        _: atom <- num("mixed: map_count of element 1 (an atom)", bees_etf_scan@map_count(m, e1));
        _: atom <- num("mixed: tuple_arity of element 1", bees_etf_scan@tuple_arity(m, e1));
        _: atom <- num("mixed: list_count of element 1", bees_etf_scan@list_count(m, e1));
        _: atom <- num("mixed: tag_at 100000", bees_etf_scan@tag_at(m, 100000));
        _: atom <- num("mixed: tag_at -1", bees_etf_scan@tag_at(m, 0 - 1));
        _: atom <- num("mixed: skip from 100000", bees_etf_scan@skip(m, 100000));
        _: atom <- num("mixed: slice_term outside, length", length_bytes(bees_etf_scan@slice_term(m, 5, 100000)))
    produces pure :ok end
}

fn part4b() -> atom {
    sequence 
        _: atom <- num("string: list_count", bees_etf_scan@list_count(unhex("836b0003616263"), 1));
        _: atom <- num("string: list_first", bees_etf_scan@list_first(unhex("836b0003616263"), 1));
        _: atom <- num("nil: list_count", bees_etf_scan@list_count(unhex("836a"), 1));
        _: atom <- num("nil: list_first", bees_etf_scan@list_first(unhex("836a"), 1));
        _: atom <- num("tuple_300: tuple_arity", bees_etf_scan@tuple_arity(unhex(""), 1));
        _: atom <- num("tuple_300: tuple_first", bees_etf_scan@tuple_first(unhex(""), 1));
        _: atom <- num("map_0: map_count", bees_etf_scan@map_count(unhex("837400000000"), 1));
        _: atom <- num("map count over the bytes left", bees_etf_scan@map_count(unhex("8374000000ff6a"), 1));
        _: atom <- num("tuple arity over the bytes left", bees_etf_scan@tuple_arity(unhex("8368056a"), 1));
        _: atom <- num("list count over the bytes left", bees_etf_scan@list_count(unhex("836c000000056a"), 1));
        _: atom <- num("string count over the bytes left", bees_etf_scan@list_count(unhex("836b000561"), 1));
        _: atom <- text("atom_ext latin1: atom_text", hex(bees_etf_scan@atom_text(unhex("8364000268e9"), 1)));
        _: atom <- text("small_atom_ext latin1: atom_text", hex(bees_etf_scan@atom_text(unhex("83730268e9"), 1)));
        _: atom <- num("atom of 256 letters: atom_check", bees_etf_scan@atom_check(long_atom(256), 1));
        _: atom <- num("atom of 255 letters: atom_check", bees_etf_scan@atom_check(long_atom(255), 1));
        _: atom <- num("atom not utf8: atom_check", bees_etf_scan@atom_check(unhex("837702c328"), 1));
        _: atom <- num("atom cut: atom_check", bees_etf_scan@atom_check(unhex("8377056f6b"), 1));
        _: atom <- num("atom cache reference: atom_check", bees_etf_scan@atom_check(unhex("835200"), 1));
        _: atom <- num("atom cut: atom_end", bees_etf_scan@atom_end(unhex("8377056f6b"), 1));
        _: atom <- num("atom ok: atom_end", bees_etf_scan@atom_end(unhex("8377026f6b"), 1));
        _: atom <- num("utf8_chars h e-acute l l o arrow", bees_etf_scan@utf8_chars(unhex("68c3a96c6c6fe28692")));
        _: atom <- num("utf8_chars U+10FFFF", bees_etf_scan@utf8_chars(unhex("f48fbfbf")));
        _: atom <- num("utf8_chars above U+10FFFF", bees_etf_scan@utf8_chars(unhex("f4908080")));
        _: atom <- num("utf8_chars surrogate", bees_etf_scan@utf8_chars(unhex("eda080")));
        _: atom <- num("utf8_chars overlong", bees_etf_scan@utf8_chars(unhex("c080")));
        _: atom <- num("utf8_chars cut", bees_etf_scan@utf8_chars(unhex("e282")));
        _: atom <- num("utf8_chars lone continuation", bees_etf_scan@utf8_chars(unhex("80")));
        _: atom <- text("latin1_to_utf8 00 7f 80 ff", hex(bees_etf_scan@latin1_to_utf8(unhex("007f80ff"))));
        _: atom <- num("bytes_compare ab abc", bees_etf_scan@bytes_compare("ab", "abc"));
        _: atom <- num("bytes_compare abc ab", bees_etf_scan@bytes_compare("abc", "ab"));
        _: atom <- num("bytes_compare abc abc", bees_etf_scan@bytes_compare("abc", "abc"));
        _: atom <- num("bytes_compare empty empty", bees_etf_scan@bytes_compare("", ""));
        _: atom <- num("bytes_compare ff 00", bees_etf_scan@bytes_compare(unhex("ff"), unhex("00")));
        _: atom <- num("bytes_compare 7f 80", bees_etf_scan@bytes_compare(unhex("7f"), unhex("80")));
        _: atom <- num("bytes_compare abd abc", bees_etf_scan@bytes_compare("abd", "abc"));
        _: atom <- num("skip unknown tag", bees_etf_scan@skip(unhex("83ff"), 1));
        _: atom <- num("skip FLOAT_EXT", bees_etf_scan@skip(unhex("8363"), 1));
        _: atom <- num("skip compressed", bees_etf_scan@skip(unhex("8350"), 1));
        _: atom <- num("skip cut tuple", bees_etf_scan@skip(unhex("8368026101"), 1));
        _: atom <- num("skip 64 deep (130 bytes)", bees_etf_scan@skip(nested(64), 1));
        _: atom <- num("skip 65 deep", bees_etf_scan@skip(nested(65), 1));
        _: atom <- num("skip_within 2: 2 deep", bees_etf_scan@skip_within(nested(2), 1, 2));
        _: atom <- num("skip_within 2: 3 deep", bees_etf_scan@skip_within(nested(3), 1, 2));
        _: atom <- num("skip list claiming 4294967295 elements", bees_etf_scan@skip(unhex("836cffffffff61016a"), 1));
        _: atom <- num("skip new fun with a size under 4", bees_etf_scan@skip(unhex("837000000003"), 1))
    produces pure :ok end
}

fn part4c() -> atom {
    sequence 
        _: atom <- why("code_reason -1", bees_etf_scan@code_reason(0 - 1));
        _: atom <- why("code_reason -2", bees_etf_scan@code_reason(0 - 2));
        _: atom <- why("code_reason -3", bees_etf_scan@code_reason(0 - 3));
        _: atom <- why("code_reason -4", bees_etf_scan@code_reason(0 - 4));
        _: atom <- why("code_reason -5", bees_etf_scan@code_reason(0 - 5));
        _: atom <- why("code_reason -6", bees_etf_scan@code_reason(0 - 6));
        _: atom <- why("code_reason -7", bees_etf_scan@code_reason(0 - 7));
        _: atom <- why("code_reason -8", bees_etf_scan@code_reason(0 - 8));
        _: atom <- why("code_reason -9", bees_etf_scan@code_reason(0 - 9));
        _: atom <- why("code_reason -10", bees_etf_scan@code_reason(0 - 10));
        _: atom <- why("code_reason -11", bees_etf_scan@code_reason(0 - 11));
        _: atom <- why("code_reason -12", bees_etf_scan@code_reason(0 - 12));
        _: atom <- why("code_reason -13", bees_etf_scan@code_reason(0 - 13));
        _: atom <- why("code_reason -14", bees_etf_scan@code_reason(0 - 14));
        _: atom <- why("code_reason -15", bees_etf_scan@code_reason(0 - 15));
        _: atom <- why("code_reason -16", bees_etf_scan@code_reason(0 - 16));
        _: atom <- why("code_reason 0", bees_etf_scan@code_reason(0));
        _: atom <- why("code_reason -99", bees_etf_scan@code_reason(0 - 99))
    produces pure :ok end
}

fn part4() -> atom {
    sequence
        _: atom <- part4a();
        _: atom <- part4b();
        _: atom <- part4c()
    produces pure :ok end
}

fn part5a() -> atom {
    sequence 
        _: atom <- fx("empty frame", "");
        _: atom <- fx("no 131", "6100");
        _: atom <- fx("version 132", "8461");
        _: atom <- fx("131 alone", "83");
        _: atom <- fx("compressed term", "8350000000026a6a");
        _: atom <- fx("distribution header", "834400");
        _: atom <- fx("unknown tag 255", "83ff");
        _: atom <- fx("unknown tag 0", "8300");
        _: atom <- fx("trailing bytes", "836a00");
        _: atom <- fx("list claiming 4294967295 elements", "836cffffffff61016a");
        _: atom <- fx("tuple claiming 4294967295 elements", "8369ffffffff6a6a6a");
        _: atom <- fx("map claiming 4294967295 pairs", "8374ffffffff6a6a6a");
        _: atom <- fx("binary claiming 4294967295 bytes", "836dffffffff000000");
        _: atom <- fx("big integer claiming 4294967295 bytes", "836fffffffff00010203");
        _: atom <- fx("string claiming 65535 bytes", "836bffff6161");
        _: atom <- fx("list of 0 elements and a tail", "836c000000006a");
        _: atom <- fx("duplicate key", "83740000000261017701616101770162");
        _: atom <- fx("duplicate key, 1 as 97 and as 98", "83740000000261016a62000000016a");
        _: atom <- fx("duplicate key, ab as 107 and as 108", "8374000000026b000261626a6c00000002616161626a6a");
        _: atom <- fx("duplicate key, old and new atom tag", "83740000000277016b6a6400016b6a");
        _: atom <- fx("duplicate key in a map inside a tuple in a list", "836c000000016801740000000261016a61016a6a");
        _: atom <- fx("duplicate key, two maps with the same pairs in another order", "837400000002740000000261016a61026a6a740000000261026a61016a6a");
        _: atom <- fx("two keys that are maps with different pairs", "837400000002740000000261016a61026a6a740000000261016a61036a6a");
        _: atom <- fx("duplicate key, maps in another order inside a tuple and a list", "83740000000268016c00000001740000000261016a61026a6a6a68016c00000001740000000261026a61016a6a6a")
    produces pure :ok end
}

fn part5b() -> atom {
    sequence 
        _: atom <- fx("duplicate key, maps in another order inside a map key", "8374000000027400000001740000000261016a61026a6a6a7400000001740000000261026a61016a6a6a");
        _: atom <- fx("duplicate key, same map values in another order", "8374000000027400000002610177016161027701626a7400000002610277016261017701616a");
        _: atom <- fx("two keys, same map keys with other values", "8374000000027400000002610177016161027701626a7400000002610277016161017701626a");
        _: atom <- fx("atom not utf8", "837702c328");
        _: atom <- fx("atom surrogate", "837703eda080");
        _: atom <- fx("FLOAT_EXT", "836330303030303030303030303030303030303030303030303030303030303030");
        _: atom <- fx("atom cache reference", "835200");
        _: atom <- fx("pid whose node is a cache reference", "83585200000000010000000000000000");
        _: atom <- fx("bit string, 0 bits", "834d000000010080");
        _: atom <- fx("bit string, 9 bits", "834d000000010980");
        _: atom <- fx("bit string, no byte", "834d0000000003");
        _: atom <- fx("big integer, sign byte 2", "836e010205");
        _: atom <- fx("new fun, size under 4", "837000000003");
        _: atom <- fx("export, arity not a small integer", "83717701617701626200000001");
        _: atom <- fx("old FUN_EXT", "8375");
        _: atom <- fx("LOCAL_EXT", "8379");
        _: atom <- fx("pid cut by one byte", "8358770d6e6f6e6f6465406e6f686f73740000000a00000000000000");
        _: atom <- fx("tuple cut", "836803610162");
        _: atom <- fx("float cut", "834640");
        _: atom <- fx("atom cut", "8377056f6b");
        _: atom <- fxb("atom of 256 letters", long_atom(256));
        _: atom <- fxb("65 deep", nested(65));
        _: atom <- fxb("64 deep", nested(64));
        _: atom <- sweep("mixed", "");
        _: atom <- sweep("fixed_all", "")
    produces pure :ok end
}

fn part5c() -> atom {
    sequence proc[mem(normal)]
        e0: List[(int64, int64, float64, string), mem(normal)] <- no_toks();
        _: atom <- enc_no("encode refuses no token: length", e0);
        e1: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_tuple(2), bees_term_wire@t_int(1)];
        _: atom <- enc_no("encode refuses tuple of 2 with 1 element: length", e1);
        e2: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_int(1), bees_term_wire@t_int(2)];
        _: atom <- enc_no("encode refuses two terms: length", e2);
        e3: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(1), bees_term_wire@t_int(1)];
        _: atom <- enc_no("encode refuses list without its tail: length", e3);
        e4: List[(int64, int64, float64, string), mem(normal)] <- [(99, 0, 0.0, "")];
        _: atom <- enc_no("encode refuses unknown kind 99: length", e4);
        e5: List[(int64, int64, float64, string), mem(normal)] <- [(0, 0, 0.0, "")];
        _: atom <- enc_no("encode refuses unknown kind 0: length", e5);
        e6: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bits("a", 0)];
        _: atom <- enc_no("encode refuses bit string, 0 bits: length", e6);
        e7: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bits("a", 9)];
        _: atom <- enc_no("encode refuses bit string, 9 bits: length", e7);
        e8: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bits("", 3)];
        _: atom <- enc_no("encode refuses bit string, no byte: length", e8);
        e9: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_atom(letters(256))];
        _: atom <- enc_no("encode refuses atom of 256 letters: length", e9);
        e10: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_atom(unhex("c328"))];
        _: atom <- enc_no("encode refuses atom not utf8: length", e10);
        e11: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(2), bees_term_wire@t_int(1), bees_term_wire@t_atom("a"), bees_term_wire@t_int(1), bees_term_wire@t_atom("b")];
        _: atom <- enc_no("encode refuses duplicate key: length", e11);
        e12: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(2), bees_term_wire@t_bytes("ab"), bees_term_wire@t_nil(), bees_term_wire@t_list(2), bees_term_wire@t_int(97), bees_term_wire@t_int(98), bees_term_wire@t_nil(), bees_term_wire@t_nil()];
        _: atom <- enc_no("encode refuses duplicate key, byte list and list of small integers: length", e12);
        e13: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(2), bees_term_wire@t_map(2), bees_term_wire@t_int(1), bees_term_wire@t_nil(), bees_term_wire@t_int(2), bees_term_wire@t_nil(), bees_term_wire@t_nil(), bees_term_wire@t_map(2), bees_term_wire@t_int(2), bees_term_wire@t_nil(), bees_term_wire@t_int(1), bees_term_wire@t_nil(), bees_term_wire@t_nil()];
        _: atom <- enc_no("encode refuses duplicate key, two maps with the same pairs in another order: length", e13);
        e14: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_tuple(1), bees_term_wire@t_map(2), bees_term_wire@t_atom("k"), bees_term_wire@t_nil(), bees_term_wire@t_atom("k"), bees_term_wire@t_nil()];
        _: atom <- enc_no("encode refuses duplicate key in an inner map: length", e14);
        e15: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(1025)];
        _: atom <- enc_no("encode refuses map of 1025 pairs: length", e15);
        e16: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_map(0 - 1)];
        _: atom <- enc_no("encode refuses map of -1 pairs: length", e16);
        e17: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(2, "x")];
        _: atom <- enc_no("encode refuses big integer, sign 2: length", e17);
        e18: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(0, unhex("0100"))];
        _: atom <- enc_no("encode refuses big integer, leading zero byte: length", e18);
        e19: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_big(0, "")];
        _: atom <- enc_no("encode refuses big integer, no byte: length", e19);
        e20: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_pid("abc")];
        _: atom <- enc_no("encode refuses pid that is not a pid: length", e20);
        e21: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_pid(unhex("5a0003770d6e6f6e6f6465406e6f686f7374000000000003e24b59c40001ea4cbcd5"))];
        _: atom <- enc_no("encode refuses pid holding a reference: length", e21);
        e22: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_pid(unhex("58770d6e6f6e6f6465406e6f686f73740000000a000000000000000000"))];
        _: atom <- enc_no("encode refuses pid with a byte too many: length", e22);
        e23: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_fun("")];
        _: atom <- enc_no("encode refuses fun, empty: length", e23);
        e24: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_list(0), bees_term_wire@t_nil()];
        _: atom <- enc_no("encode refuses list of 0: length", e24);
        e25: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_tuple(0 - 1)];
        _: atom <- enc_no("encode refuses tuple of -1: length", e25);
        _: atom <- enc_no("encode 65 deep: length", tuples_in(65, one_tok(bees_term_wire@t_nil())));
        _: atom <- enc_no("encode 64 deep: length", tuples_in(64, one_tok(bees_term_wire@t_nil())))
    produces pure :ok end
}

fn part6() -> atom {
    sequence proc[mem(normal)]
        _: atom <- large("list of 30000 one-tuples", tuple_list(30000));
        _: atom <- large("list of 60000 integers", int_list(60000));
        _: atom <- large("60000 small integers spelled as a list (out: STRING_EXT)", small_list(60000));
        _: atom <- large("map of 1024 pairs", int_map(1024));
        _: atom <- ask("map of 1025 pairs", int_map(1025));
        _: atom <- ask("list of 65534 nils (65536 tokens)", nil_list(65534));
        _: atom <- ask("list of 65535 nils (65537 tokens)", nil_list(65535));
        _: atom <- ask("300 tuples of 255 nils (76802 tokens)", row_list(300));
        _: atom <- ask_within("tuple_3 within 4 tokens", unhex("83680377016161016d0000000178"), 64, 4);
        _: atom <- ask_within("tuple_3 within 3 tokens", unhex("83680377016161016d0000000178"), 64, 3);
        _: atom <- ask_within("2 deep within depth 2", nested(2), 2, 100);
        _: atom <- ask_within("3 deep within depth 2", nested(3), 2, 100);
        _: atom <- ask_within("64 deep within depth 1000 (lowered to 64)", nested(64), 1000, 1000000);
        _: atom <- ask_within("65 deep within depth 1000 (lowered to 64)", nested(65), 1000, 1000000);
        by1: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bytes(letters(65535))];
        _: atom <- enc_no("encode byte list of 65535 (STRING_EXT): length", by1);
        by2: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_bytes(letters(65536))];
        _: atom <- enc_no("encode byte list of 65536 (LIST_EXT): length", by2);
        mx: List[(int64, int64, float64, string), mem(normal)] <- toks_of(unhex(""));
        _: atom <- num("mixed: tokens", count(mx, 0));
        _: atom <- num("mixed: term_size", bees_term_wire@term_size(mx));
        _: atom <- num("mixed: term_end 0", bees_term_wire@term_end(mx, 0));
        _: atom <- num("mixed: term_end 1 (an atom)", bees_term_wire@term_end(mx, 1));
        _: atom <- num("mixed: term_end 2 (the map)", bees_term_wire@term_end(mx, 2));
        _: atom <- num("mixed: term_end 3 (its first key)", bees_term_wire@term_end(mx, 3));
        _: atom <- num("mixed: term_end 4 (its first value)", bees_term_wire@term_end(mx, 4));
        _: atom <- num("mixed: term_end 9999", bees_term_wire@term_end(mx, 9999));
        _: atom <- num("mixed: tokens of rest_after", count(bees_term_wire@rest_after(mx), 0));
        cutl: List[(int64, int64, float64, string), mem(normal)] <- [bees_term_wire@t_tuple(2), bees_term_wire@t_int(1)];
        _: atom <- num("tuple of 2 with 1 element: term_size", bees_term_wire@term_size(cutl))
    produces pure :ok end
}

fn main() -> int64 {
    sequence
        _: atom <- say("-- 1 fixtures from erl");
        _: atom <- part1a();
        _: atom <- part1b();
        _: atom <- part1c();
        _: atom <- say("-- 2 forms erl reads and does not write");
        _: atom <- part2();
        _: atom <- say("-- 3 built from constructors");
        _: atom <- part3();
        _: atom <- say("-- 4 scanner");
        _: atom <- part4();
        _: atom <- say("-- 5 refusals");
        _: atom <- part5a();
        _: atom <- part5b();
        _: atom <- part5c();
        _: atom <- say("-- 6 large terms and limits");
        _: atom <- part6()
    produces pure 0 end
}
