// D1: a backing the packer wrote, read through the hosted (:store) carrier and decoded.
use bees_reporter;
use carrier;
use wireframe;
use wire_etf;
use storelog;
use dangerous_store;
use dangerous_store_backing_carrier;
module dangerous_d1_read;

carried_on journal: (:store) (:backing, "d1.sildat", 16384, :stop);

fn say_n(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_int64(n);
        o: atom <- println("")
    produces pure o end
}
fn say_atom(label: string, a: atom) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        _: atom <- print_atom(a);
        o: atom <- println("")
    produces pure o end
}
fn say_text(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print(label);
        o: atom <- println(s)
    produces pure o end
}
fn say_log(oldest: int64, nx: int64, capacity: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print("log oldest=");
        _: atom <- print_int64(oldest);
        _: atom <- print(" next=");
        _: atom <- print_int64(nx);
        _: atom <- print(" capacity=");
        _: atom <- print_int64(capacity);
        o: atom <- println("")
    produces pure o end
}

fn ask(car: dangerous_actor_ref, what: atom) -> boolean {
    sequence proc[concurrency]
        r: boolean <- case what == :credit of {
            true -> cast(car, (:credit, 1) impl ActorMessage {});
            false -> cast(car, :close impl ActorMessage {})
        }
    produces pure r end
}
fn ask_read(car: dangerous_actor_ref, from: int64) -> boolean {
    sequence proc[concurrency]
        r: boolean <- cast(car, (:read, from) impl ActorMessage {})
    produces pure r end
}
fn show_small(r: (:ok, { name: string, n: int64 }) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, v: { name: string, n: int64 }) -> { _: atom <- say_text("  name=", v.name); say_n("  n=", v.n) };
        (:rejected, why: atom) -> say_atom("  decode rejected ", why)
    }
}
fn show_big(r: (:ok, string) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, v: string) -> say_n("  string bytes=", length_bytes(v));
        (:rejected, why: atom) -> say_atom("  decode rejected ", why)
    }
}
fn show_items(xs: List[{ a: int64, s: string }, mem(normal)]) -> atom {
    case xs of {
        []: List[{ a: int64, s: string }, mem(normal)] -> :ok;
        [h: { a: int64, s: string }, t: List[{ a: int64, s: string }, mem(normal)]] -> { _: atom <- say_n("  item a=", h.a); _: atom <- say_text("  item s=", h.s); show_items(t) }
    }
}
fn show_mixed(r: (:ok, { flag: boolean, items: List[{ a: int64, s: string }, mem(normal)], neg: int64, wide: int64 }) | (:rejected, atom)) -> atom {
    case r of {
        (:ok, v: { flag: boolean, items: List[{ a: int64, s: string }, mem(normal)], neg: int64, wide: int64 }) -> {
            _: atom <- say_text("  flag=", case v.flag of { true -> "true"; false -> "false" });
            _: atom <- show_items(v.items);
            _: atom <- say_n("  neg=", v.neg);
            say_n("  wide=", v.wide)
        };
        (:rejected, why: atom) -> say_atom("  decode rejected ", why)
    }
}
fn dec_mixed(f: string) -> atom {
    sequence proc[mem(normal), transport]
        r: (:ok, { flag: boolean, items: List[{ a: int64, s: string }, mem(normal)], neg: int64, wide: int64 }) | (:rejected, atom) <- decode((:etf), f, { max_bytes: 4294967295, max_depth: 4, max_length: 4294967295 })
    produces pure show_mixed(r) end
}
fn dec_small(f: string) -> atom {
    sequence proc[mem(normal), transport]
        r: (:ok, { name: string, n: int64 }) | (:rejected, atom) <- decode((:etf), f, { max_bytes: 4294967295, max_depth: 2, max_length: 4294967295 })
    produces pure show_small(r) end
}
fn dec_big(f: string) -> atom {
    sequence proc[mem(normal), transport]
        r: (:ok, string) | (:rejected, atom) <- decode((:etf), f, { max_bytes: 4294967295, max_depth: 1, max_length: 4294967295 })
    produces pure show_big(r) end
}
fn show_frame(f: string) -> atom {
    u: (:ok, atom, int64, string) | (:rejected, atom) <- wireframe@unrecord(f);
    case u of {
        (:ok, fmt: atom, schema: int64, e: string) -> {
            _: atom <- say_atom("frame format ", fmt);
            _: atom <- say_n("  schema ", schema);
            _: atom <- say_n("  bytes ", length_bytes(e));
            case schema of { 1 -> dec_small(e); 2 -> dec_big(e); _: int64 -> dec_mixed(e) }
        };
        (:rejected, why: atom) -> say_atom("unrecord rejected ", why)
    }
}
fn on_rx(s: string, state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string } }) {
    _: atom <- say_n("rx bytes=", length_bytes(s));
    _: boolean <- ask(state.car, :credit);
    u: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(state.rx, s, 65536);
    case u of {
        (:more, st: { mode: atom, expected: int64, pending: string }) -> (:no_reply, { car: state.car, rx: st });
        (:frame, f: string, st: { mode: atom, expected: int64, pending: string }) -> { _: atom <- show_frame(f); (:no_reply, { car: state.car, rx: st }) };
        (:rejected, why: atom) -> { _: atom <- say_atom("unframe rejected ", why); (:no_reply, { car: state.car, rx: wireframe@fresh(:storage) }) }
    }
}
fn finished() -> boolean {
    sequence proc[device_io]
        _: atom <- println("done")
    produces pure true end
}
fn on_down(why: atom, car: dangerous_actor_ref) -> boolean {
    _: atom <- say_atom("link_down ", why);
    case why == :closed of { true -> finished(); false -> ask(car, :close) }
}
fn owner(msg: (:link_up, string) | (:log, int64, int64, int64) | (:tx_credit, int64) | (:synced, int64) | (:rx, string) | (:rx_end, int64) | (:tx_failed, atom) | (:read_failed, atom) | (:link_down, atom), state: { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string } }) -> (:no_reply, { car: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string } }) {
    case msg of {
        (:link_up, info: string) -> { _: atom <- say_text("link_up ", info); (:no_reply, state) };
        (:log, a: int64, b: int64, c: int64) -> { _: atom <- say_log(a, b, c); _: boolean <- ask_read(state.car, a); _: boolean <- ask(state.car, :credit); (:no_reply, state) };
        (:tx_credit, n: int64) -> { _: atom <- say_n("tx_credit ", n); (:no_reply, state) };
        (:synced, n: int64) -> (:no_reply, state);
        (:rx, s: string) -> on_rx(s, state);
        (:rx_end, n: int64) -> { _: atom <- say_n("rx_end ", n); _: boolean <- ask(state.car, :close); (:no_reply, state) };
        (:tx_failed, why: atom) -> { _: atom <- say_atom("tx_failed ", why); (:no_reply, state) };
        (:read_failed, why: atom) -> { _: atom <- say_atom("read_failed ", why); _: boolean <- ask(state.car, :close); (:no_reply, state) };
        (:link_down, why: atom) -> { _: boolean <- on_down(why, state.car); (:no_reply, state) }
    }
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        car: dangerous_actor_ref <- spawn_dangerous_carrier(journal, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        own: actor_ref <- spawn({ car: car, rx: wireframe@fresh(:storage) }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(car, (:open, own, "") impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
