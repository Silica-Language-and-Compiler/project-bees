                sequence
                    _: int64 <- show(rg, "float32 NEG0", b, n);
                    d: { code: int64, v: float32 } <- bees_wire_msgs@dec_t_float32(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_float32(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
