fn run_all(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- t_float32_0(rg, b, c);
        _: int64 <- t_float32_1(rg, b, c);
        _: int64 <- t_float32_2(rg, b, c);
        _: int64 <- t_float32_3(rg, b, c);
        _: int64 <- t_float32_4(rg, b, c);
        _: int64 <- t_float32_5(rg, b, c);
        _: int64 <- t_float32_6(rg, b, c);
        _: int64 <- t_float32_7(rg, b, c);
        _: int64 <- t_float32_8(rg, b, c);
        _: int64 <- t_float32_9(rg, b, c);
        _: int64 <- t_float32_10(rg, b, c);
        _: int64 <- t_float32_11(rg, b, c);
        _: int64 <- t_bool_0(rg, b, c);
        _: int64 <- t_bool_1(rg, b, c);
        _: int64 <- t_char_0(rg, b, c);
        _: int64 <- t_char_1(rg, b, c);
        _: int64 <- t_char_2(rg, b, c);
        _: int64 <- t_char_3(rg, b, c);
        _: int64 <- t_char_4(rg, b, c);
        _: int64 <- t_char_5(rg, b, c);
        _: int64 <- t_char_6(rg, b, c);
        println("m1_wire_types_float32 done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        _: int64 <- run_all(rg, b, c)
    produces pure 0 end
}

