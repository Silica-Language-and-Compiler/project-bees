%% C16 trial: node T, the TRUST node behind the two bridges, over mutual TLS 1.3 on loopback. Its identity is a.pem of the
%% N4.1 trial's TEST-ONLY certificates (no CA configured, D43); its whitelist names the two bridges' TRUST certificates.
%% suspicion_limit 2: the trial quarantines bridge B1 at this node on purpose (design 17.7) with three denied requests.
[
  {mode, trust},
  {node, [{name, "t@127.0.0.1"}]},
  {trust, [
    {port, 25800},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../../n4_trust_tls/certs/a.pem"},
                {keyfile, "../../../n4_trust_tls/certs/a-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../../n4_trust_tls/certs"},
    {call_timeout_ms, 1000},
    {first_frame_timeout_ms, 1000},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 2},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32}
  ]}
].
