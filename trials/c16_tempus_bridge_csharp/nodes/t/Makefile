# C16 node T: a plain TRUST node (the N4.1 server's program: t_server.role, operator_none.role) with its own bees.config.
# Generated by the rule of .gen.mk (make starts again and sees the new units).
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROLES := $(LEAF_DIR)/../../roles
T := $(BEES_ROOT)/tools
# The TRUST configuration bakes the certificates' absolute paths into lib/bees_trust_conf.silica, so the units are made
# again whenever the tree is at another place (another machine): .gen.root holds the tree's path, rewritten only when it
# differs.
_ := $(shell cd "$(LEAF_DIR)" && [ "$$(cat .gen.root 2>/dev/null)" = "$(BEES_ROOT)" ] || echo "$(BEES_ROOT)" > .gen.root)
-include $(LEAF_DIR)/.gen.mk
$(LEAF_DIR)/.gen.mk: $(LEAF_DIR)/.gen.root bees.config trust_whitelist.config demo.trust $(ROLES)/t_server.role $(ROLES)/operator_none.role $(T)/bees_trust_gen.py $(BEES_ROOT)/src/shim/bees_trust_node.part
	@cd "$(LEAF_DIR)" && chmod 600 ../../../n4_trust_tls/certs/*-key.pem && python3 "$(T)/bees_config_trust.py" conf -o lib bees.config && \
	python3 "$(T)/bees_trust_gen.py" mfa -o lib --config bees.config demo.trust && \
	python3 "$(T)/bees_trust_gen.py" edge dangerous_t dangerous_t.silica "$(ROLES)/t_server.role" "$(ROLES)/operator_none.role" && \
	echo "# written by the rule of this file in the Makefile: the generated units are current" > .gen.mk
include $(BEES_ROOT)/tools/trial.mk
PAIRED := $(ENTRIES)
clean: clean-generated
.PHONY: clean-generated
clean-generated:
	@cd "$(LEAF_DIR)" && rm -f dangerous_t.silica .gen.mk lib/bees_trust_conf.silica lib/bees_trust_conf.atoms lib/bees_trust_mfa.silica
