// ---- node a: listens on 127.0.0.1:47311 and sends frame A.
fn label() -> string { "a" }
fn address() -> string { "listen:127.0.0.1:47311" }

// Frame A: a count, a small integer, the bytes "hello!!!" as one word, and -1 (all bits set).
fn frame_word(i: int64) -> int64 {
    case i == 0 of {
        true -> 3;
        false -> case i == 1 of {
            true -> 42;
            false -> case i == 2 of {
                true -> 7522537965568991521;
                false -> -1
            }
        }
    }
}
