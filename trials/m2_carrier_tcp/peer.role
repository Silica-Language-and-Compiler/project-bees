// ---- the peer program (M2 trial): an owner of one carrier. It grants 4 receive credits, sends its
// frame (4 words, one per :tx) once the carrier grants send credit, prints every word that arrives,
// and closes after it has received 4 words and every write has completed. The words it prints are
// the foreign data itself, consumed in this handler (printing is the only use: it is not forwarded).
// The events' tags are read here, which strict taint (spec 7.4) would forbid; it works because the
// handler that receives an FFI result cast is not checked (SD-25). See the M2 note.

fn b2i(b: boolean) -> int64 {
    case b of { true -> 1; false -> 0 }
}

fn show_word(w: int64) -> atom {
    sequence proc[device_io]
        print_string(label());
        print_string(" rx ");
        print_int64(w);
        println("")
    produces pure :ok end
}

fn show_end(reason: atom, up: boolean, got: int64, txc: int64) -> atom {
    sequence proc[device_io]
        print_string(label());
        print_string(" link_down ");
        println(bees_atoms@spelling(reason));
        print_string(label());
        print_string(" link_up seen ");
        print_boolean(up);
        println("");
        print_string(label());
        print_string(" words received ");
        print_int64(got);
        print_string(", tx credits ");
        print_int64(txc);
        println("");
        println("done")
    produces pure :ok end
}

fn send_frame(c: actor_ref, me: actor_ref) -> boolean {
    sequence proc[concurrency]
        m0: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_tx(), me, "", frame_word(0), 8);
        _: boolean <- cast(c, m0 impl ActorMessage {});
        m1: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_tx(), me, "", frame_word(1), 8);
        _: boolean <- cast(c, m1 impl ActorMessage {});
        m2: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_tx(), me, "", frame_word(2), 8);
        _: boolean <- cast(c, m2 impl ActorMessage {});
        m3: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_tx(), me, "", frame_word(3), 8);
        _: boolean <- cast(c, m3 impl ActorMessage {})
    produces pure true end
}

fn owner(
    msg: { tag: atom, n: int64, reason: atom, info: string },
    st: { c: actor_ref, got: int64, txc: int64, up: boolean, sent: boolean }
) -> (:no_reply, { c: actor_ref, got: int64, txc: int64, up: boolean, sent: boolean }) {
    sequence proc[concurrency]
        me: actor_ref <- self();
        is_credit: boolean <- msg.tag == bees_atoms@a_tx_credit();
        is_rx: boolean <- msg.tag == bees_atoms@a_rx();
        is_up: boolean <- msg.tag == bees_atoms@a_link_up();
        is_down: boolean <- msg.tag == bees_atoms@a_link_down();
        send_now: boolean <- is_credit and st.sent == false;
        _: boolean <- case send_now of { true -> send_frame(st.c, me); false -> true };
        got: int64 <- st.got + b2i(is_rx);
        txc: int64 <- st.txc + b2i(is_credit);
        _: atom <- case is_rx of { true -> show_word(msg.n); false -> :ok };
        finish: boolean <- got == 4 and txc == 5 and (is_rx or is_credit);
        mc: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_close(), me, "", 0, 8);
        _: boolean <- case finish of {
            true -> cast(st.c, mc impl ActorMessage {});
            false -> true
        };
        _: atom <- case is_down of { true -> show_end(msg.reason, st.up, got, txc); false -> :ok }
    produces pure (:no_reply, { c: st.c, got: got, txc: txc, up: st.up or is_up, sent: st.sent or send_now }) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        c: actor_ref <- carrier_new(0, 10000, 4000);
        o: actor_ref <- spawn({ c: c, got: 0, txc: 0, up: false, sent: false }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        mo: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_open(), o, address(), 0, 8);
        _: boolean <- cast(c, mo impl ActorMessage {});
        mk: { tag: atom, peer: actor_ref, text: string, n: int64, k: int64 } <- cmd(bees_atoms@a_credit(), o, "", 4, 8);
        _: boolean <- cast(c, mk impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
