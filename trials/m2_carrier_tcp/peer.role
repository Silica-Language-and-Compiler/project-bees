// ---- the peer program: the owner of one (:tcp) carrier, the language's (transport design 6.2, 6.3). It grants receive
// credits, sends one frame (a string, length-prefixed by wireframe) once the link is up, prints the frame that arrives, and
// closes after it has received the peer's frame and its own write completed. The listening side waits for the listener's
// (:accepted, conn, info) and adopts the connection with (:open, me, ""), as the design's listener contract says.

fn b2i(b: boolean) -> int64 {
    case b of { true -> 1; false -> 0 }
}

fn first_segment(xs: List[string, mem(normal)]) -> string {
    case xs of {
        []: List[string, mem(normal)] -> "";
        [h: string, _t: List[string, mem(normal)]] -> h
    }
}
fn framed(s: string) -> string {
    sequence
        segs: List[string, mem(normal)] <- wireframe@frame(s, carrier@mtu((:tcp)), carrier@boundaries((:tcp)));
        seg: string <- first_segment(segs)
    produces pure seg end
}

fn show_frame(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label());
        _: atom <- print_string(" rx ");
        _: atom <- println(s)
    produces pure :ok end
}

fn show_end(reason: atom, up: boolean, got: int64, txc: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label());
        _: atom <- print_string(" link_down ");
        _: atom <- println(bees_atoms@spelling(reason));
        _: atom <- print_string(label());
        _: atom <- print_string(" link_up seen ");
        _: atom <- print_boolean(up);
        _: atom <- println("");
        _: atom <- print_string(label());
        _: atom <- print_string(" frames received ");
        _: atom <- print_int64(got);
        _: atom <- print_string(", tx credit grants ");
        _: atom <- print_int64(txc);
        _: atom <- println("");
        _: atom <- println("done")
    produces pure :ok end
}

fn send_frame(c: dangerous_actor_ref) -> boolean {
    sequence proc[concurrency]
        seg: string <- framed(frame_text());
        ok: boolean <- cast(c, (:tx, seg, self()) impl ActorMessage {})
    produces pure ok end
}

// close once, when the peer's frame is in and the write's credit came back (the initial grant is the first credit event)
fn maybe_close(c: dangerous_actor_ref, got: int64, txc: int64, closed: boolean) -> boolean {
    case got >= 1 and txc >= 2 and closed == false of {
        true -> {
            sequence proc[concurrency]
                ok: boolean <- cast(c, :close impl ActorMessage {})
            produces pure ok end
        };
        false -> false
    }
}

fn owner(
    msg: (:link_up, string) | (:accepted, dangerous_actor_ref, string) | (:rx, string) | (:tx_credit, int64) | (:tx_failed, atom) | (:link_down, atom),
    st: { c: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, got: int64, txc: int64, up: boolean, closed: boolean }
) -> (:no_reply, { c: dangerous_actor_ref, rx: { mode: atom, expected: int64, pending: string }, got: int64, txc: int64, up: boolean, closed: boolean }) {
    case msg of {
        (:link_up, info: string) -> case starts_with(info, "port:") of {
            true -> (:no_reply, { c: st.c, rx: st.rx, got: st.got, txc: st.txc, up: st.up, closed: st.closed });
            false -> {
                sequence proc[concurrency]
                    _: boolean <- cast(st.c, (:credit, 4) impl ActorMessage {});
                    _: boolean <- send_frame(st.c)
                produces pure (:no_reply, { c: st.c, rx: st.rx, got: st.got, txc: st.txc, up: true, closed: st.closed }) end
            }
        };
        (:accepted, conn: dangerous_actor_ref, _info: string) -> {
            sequence proc[concurrency]
                _: boolean <- cast(conn, (:open, self(), "") impl ActorMessage {})
            produces pure (:no_reply, { c: conn, rx: st.rx, got: st.got, txc: st.txc, up: st.up, closed: st.closed }) end
        };
        (:tx_credit, _n: int64) -> {
            sequence
                closing: boolean <- maybe_close(st.c, st.got, st.txc + 1, st.closed)
            produces pure (:no_reply, { c: st.c, rx: st.rx, got: st.got, txc: st.txc + 1, up: st.up, closed: st.closed or closing }) end
        };
        (:rx, seg: string) -> {
            sequence proc[concurrency]
                un: (:more, { mode: atom, expected: int64, pending: string }) | (:frame, string, { mode: atom, expected: int64, pending: string }) | (:rejected, atom) <- wireframe@unframe(st.rx, seg, 4096);
                got: int64 <- case un of {
                    (:more, _r1: { mode: atom, expected: int64, pending: string }) -> st.got;
                    (:frame, f: string, _r2: { mode: atom, expected: int64, pending: string }) -> {
                        sequence
                            _: atom <- show_frame(f)
                        produces pure st.got + 1 end
                    };
                    (:rejected, why: atom) -> {
                        sequence proc[device_io]
                            _: atom <- print_atom(why)
                        produces pure st.got end
                    }
                };
                rx2: { mode: atom, expected: int64, pending: string } <- case un of {
                    (:more, r3: { mode: atom, expected: int64, pending: string }) -> r3;
                    (:frame, _f2: string, r4: { mode: atom, expected: int64, pending: string }) -> r4;
                    (:rejected, _why2: atom) -> st.rx
                };
                _: boolean <- cast(st.c, (:credit, 1) impl ActorMessage {});
                closing: boolean <- maybe_close(st.c, got, st.txc, st.closed)
            produces pure (:no_reply, { c: st.c, rx: rx2, got: got, txc: st.txc, up: st.up, closed: st.closed or closing }) end
        };
        (:tx_failed, why3: atom) -> {
            sequence proc[device_io]
                _: atom <- print_atom(why3)
            produces pure (:no_reply, { c: st.c, rx: st.rx, got: st.got, txc: st.txc, up: st.up, closed: st.closed }) end
        };
        (:link_down, why4: atom) -> {
            sequence
                _: atom <- show_end(why4, st.up, st.got, st.txc)
            produces pure (:no_reply, { c: st.c, rx: st.rx, got: st.got, txc: st.txc, up: st.up, closed: true }) end
        }
    }
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        c: dangerous_actor_ref <- carrier_new();
        o: actor_ref <- spawn({ c: c, rx: wireframe@fresh(carrier@boundaries((:tcp))), got: 0, txc: 0, up: false, closed: false }, owner, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(c, (:open, o, address()) impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
