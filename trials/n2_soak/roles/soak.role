// ---- the soak program (N2c): a registered service `req` that nobody calls and the node; a peer that is connected or dialed over and over by
// tools/soak.py. Its resident set over the cycles is the measurement (`make measure`).
fn req(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    (:no_reply, st + 1)
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        r: actor_ref <- spawn_registered(0, req, bees_atoms@a_req(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
