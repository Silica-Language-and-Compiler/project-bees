// M1: round trips of int8 and int16 through the generated codec, with the frame bytes printed. The trial is one of six leaves
// (m1_wire_types, _signed_a, _signed_b, _float64, _float32, _text) because one compiler process runs out of memory type-checking
// the whole set at once (silica-999936, SD-29). Each line is `<type> <value> n=<frame bytes> bytes=<first 24 bytes, decimal> sum=<sum> <verdict>`.
// The verdict is `rt` (decoded, and re-encoding the decoded value gives the same bytes) or the rejection.
// tools/test_bees_wire_gen.py checks these bytes against Python's struct.pack, independently of the codec.
use bees_atoms;
use bees_wire;
use bees_wire_msgs;

fn rep(s: string, n: int64) -> string {
    case n <= 0 of {
        true -> "";
        false -> case n == 1 of {
            true -> s;
            false -> concat(rep(s, n / 2), rep(s, n - n / 2))
        }
    }
}
fn sumbytes(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64, n: int64, acc: int64) -> int64 {
    case i >= n of { true -> acc; false -> sumbytes(rg, b, i + 1, n, acc + bees_wire@rb_i(rg, b, i)) }
}
fn show_bytes(rg: region(L, normal), b: buf(L, normal, uint8, 4096), i: int64, n: int64) -> int64 {
    case i >= n of {
        true -> 0;
        false -> {
            sequence proc[device_io]
                print_string(" ");
                _: atom <- print_int64(bees_wire@rb_i(rg, b, i));
                r: int64 <- show_bytes(rg, b, i + 1, n)
            produces pure r end
        }
    }
}
fn min2(a: int64, b: int64) -> int64 { case a < b of { true -> a; false -> b } }
fn same_bytes(rg: region(L, normal), a: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096), i: int64, n: int64) -> boolean {
    case i >= n of {
        true -> true;
        false -> case bees_wire@rb_i(rg, a, i) == bees_wire@rb_i(rg, c, i) of { true -> same_bytes(rg, a, c, i + 1, n); false -> false }
    }
}
// header of one line: label, frame length, the first bytes, the byte sum
fn show(rg: region(L, normal), label: string, b: buf(L, normal, uint8, 4096), n: int64) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" n=");
        _: atom <- print_int64(n);
        print_string(" bytes=");
        _: int64 <- show_bytes(rg, b, 0, min2(n, 24));
        print_string(" sum=");
        _: atom <- print_int64(sumbytes(rg, b, 0, n, 0));
        print_string(" ")
    produces pure 0 end
}
fn verdict(code: int64, same: boolean) -> int64 {
    sequence proc[device_io]
        _: atom <- print_atom(bees_wire@reason_atom(code));
        println(case same of { true -> " rt"; false -> " DIFFERENT" })
    produces pure 0 end
}
fn rejected(n: int64) -> int64 {
    sequence proc[device_io]
        println("encode rejected");
        _: atom <- print_int64(n);
        println("")
    produces pure 0 end
}

fn val_int8_0() -> int8 { -128 }
fn t_int8_0(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_int8(rg, b, val_int8_0());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show(rg, "int8 -128", b, n);
                    d: { code: int64, v: int8 } <- bees_wire_msgs@dec_t_int8(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_int8(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
