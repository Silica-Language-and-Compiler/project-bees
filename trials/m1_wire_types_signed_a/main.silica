fn run_all(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- t_int8_0(rg, b, c);
        _: int64 <- t_int8_1(rg, b, c);
        _: int64 <- t_int8_2(rg, b, c);
        _: int64 <- t_int8_3(rg, b, c);
        _: int64 <- t_int8_4(rg, b, c);
        _: int64 <- t_int8_5(rg, b, c);
        _: int64 <- t_int8_6(rg, b, c);
        _: int64 <- t_int16_0(rg, b, c);
        _: int64 <- t_int16_1(rg, b, c);
        _: int64 <- t_int16_2(rg, b, c);
        _: int64 <- t_int16_3(rg, b, c);
        _: int64 <- t_int16_4(rg, b, c);
        _: int64 <- t_int16_5(rg, b, c);
        _: int64 <- t_int16_6(rg, b, c);
        _: int64 <- t_int16_7(rg, b, c);
        println("m1_wire_types_signed_a done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        _: int64 <- run_all(rg, b, c)
    produces pure 0 end
}

