# C1 codec trial, maps (development-plan/spikes/C1-codec-term-coverage.md 2.3, 2.6): an in-memory node manifest (no link is
# opened; the peer port is only data). Map[K, V] is List[(K, V), mem(normal)] on the Silica side and MAP_EXT on the wire.
# bees.config sets beam.frame_size_max to 65536.
node   b@127.0.0.1
peer   a@127.0.0.1 127.0.0.1 24000 dial
# integer keys; local, so that bees_peers has its deliverer
local  im    cast Map[int64, string]
# string keys, a record as the value
remote sm    @ a@127.0.0.1 cast Map[string, { id: int64, up: boolean }]
# a map in a record field, and in a tagged tuple
remote holder @ a@127.0.0.1 cast { id: int64, m: Map[int64, atom], note: string }
remote cfg   @ a@127.0.0.1 cast (:cfg, Map[atom, int64], string)
# values that are lists, sums, maps
remote lists @ a@127.0.0.1 cast Map[int64, List[int64]]
remote sums  @ a@127.0.0.1 cast Map[int64, (:i, int64) | (:s, string) | :none]
remote nest  @ a@127.0.0.1 cast Map[int64, Map[int64, int64]]
# a list of maps, and a tuple as the key
remote many  @ a@127.0.0.1 cast List[Map[int64, int64]]
remote grid  @ a@127.0.0.1 cast Map[(int64, int64), string]
