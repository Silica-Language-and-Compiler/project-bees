// S1 / SD-10 follow-up: a Supervisor child whose state holds a region and a term in it, called
// twice. Plain spawn of the same behaviour passes (trials/s06_terms_and_regions). Expected: 51 72
use bees_reporter;

impl S1RegSup for Supervisor;

fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, (atom, int64, ref?(L, normal, rec))) { c }

fn beh(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) -> (:reply, int64, { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) {
    sequence proc[mem(normal)]
        cell: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- case state.root of {
            :none -> alloc_rec(state.r, (:int, msg, :none));
            prev: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> alloc_rec(state.r, (:int, msg, prev))
        };
        node: (atom, int64, ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) <- read_ref(cell);
        (_: atom, v: int64, nxt: ref?(L, normal, (atom, int64, ref?(L, normal, rec)))) <- node;
        depth: int64 <- case nxt of { :none -> 1; _: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> 2 }
    produces pure (:reply, v * 10 + depth, { r: state.r, root: some_term(cell) }) end
}

fn init(initial_state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }, behavior: fn(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) -> (:reply, int64, { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }, behavior: fn(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }) -> (:reply, int64, { r: region(L, normal), root: ref?(L, normal, (atom, int64, ref?(L, normal, rec))) }), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: :s1_reg_worker, agent_type: :worker, initial_state: initial_state, behavior: beh, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces pure (flags, children) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        _: atom <- bees_reporter@start();
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        sup: supervisor_ref <- spawn_registered_supervisor(S1RegSup, { r: r, root: :none }, :s1_reg_sup, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :s1_reg_worker } impl SupervisorMessage {});
        v1: int64 <- call(got.child, 5 impl ActorMessage {});
        v2: int64 <- call(got.child, 7 impl ActorMessage {});
        _: atom <- print_int64(v1);
        print_string(" ");
        _: atom <- print_int64(v2);
        println("")
    produces pure 0 end
}
