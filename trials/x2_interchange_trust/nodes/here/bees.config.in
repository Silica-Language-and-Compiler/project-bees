%% x2 node here: the TRUST node of THIS machine (the one the driver runs on), over mutual TLS 1.3. Identity b.pem. It is a server
%% (whitelist: node there's certificate a.pem) on 127.0.0.1:22901 only: the remote machine cannot dial this one, so node there's
%% connections arrive through an ssh -R forward of the driver's ssh session. It is a client of node there (pin file).
%% @HERE_LISTEN@ is 127.0.0.1 then; with the driver's --here-address it is 0.0.0.0 and node there dials this machine directly.
[
  {mode, trust},
  {node, [{name, "here@x2"}]},
  {trust, [
    {port, 22901},
    {listen_address, "@HERE_LISTEN@"},
    %% D43: no cacertfile: no chain is verified; a peer is trusted by the SHA-512 pin of its certificate and the whitelist
    {tls_opts, [{certfile, "../../certs/b.pem"},
                {keyfile, "../../certs/b-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},
    %% timeouts with room for a real network and an ssh forward (they are printed in the boot summary, never measured)
    {call_timeout_ms, 5000},
    {connect_timeout_ms, 5000},
    {first_frame_timeout_ms, 3000},
    {client_handshake_timeout, 5000},
    {suspicion_limit, 8},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32}
  ]}
].
