%% x2 node there: the TRUST node of the REMOTE machine, over mutual TLS 1.3. Identity a.pem. It is a server (whitelist: node
%% here's certificate b.pem) on every IPv4 interface ("0.0.0.0": the carrier binds 127.0.0.1 or every interface), port 22900, so
%% node here dials it directly over the network. It is a client of node here at 127.0.0.1:22901, the remote end of an ssh -R
%% forward to node here's listener: this node believes it calls 127.0.0.1.
[
  {mode, trust},
  {node, [{name, "there@x2"}]},
  {trust, [
    {port, 22900},
    {listen_address, "0.0.0.0"},
    %% D43: no cacertfile: no chain is verified; a peer is trusted by the SHA-512 pin of its certificate and the whitelist
    {tls_opts, [{certfile, "../../certs/a.pem"},
                {keyfile, "../../certs/a-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../certs"},
    {server_pins_file, "trust_servers.config"},
    %% timeouts with room for a real network and an ssh forward (they are printed in the boot summary, never measured)
    {call_timeout_ms, 5000},
    {connect_timeout_ms, 5000},
    {first_frame_timeout_ms, 3000},
    {client_handshake_timeout, 5000},
    {suspicion_limit, 8},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {term_depth_max, 32}
  ]}
].
