%% F1 (fuzzer) node bd: dials stock@localhost, whose port it asks the fuzz driver's EPMD (127.0.0.1:23502); the driver's listener
%% is on 127.0.0.1:23501. Redial on with short delays, so every attempt is one fuzz case.
[ {mode, beam},
  {node, [{name, "bd@localhost"}]},
  {beam, [{transport, tcp}, {frame_size_max, 4096}, {auth, cookie}, {cookie_file, "../cookie"}, {listen_address, "127.0.0.1"},
          {epmd, external}, {epmd_port, 23502}, {net_ticktime_s, 8}, {open_timeout_ms, 2000},
          {peers, [{"stock@localhost", [{host, "127.0.0.1"}, {port, epmd}, {role, dial}]}]},
          {redial, true}, {redial_initial_ms, 100}, {redial_max_ms, 200}]} ].
