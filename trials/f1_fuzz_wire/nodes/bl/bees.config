%% F1 (fuzzer) node bl: listens on 127.0.0.1:23500 and registers with the fuzz driver's EPMD (127.0.0.1:23502), which answers
%% well or hostile as the case says. frame_size_max 4096: frames above it must be refused from their length (D47).
[ {mode, beam},
  {node, [{name, "bl@localhost"}]},
  {beam, [{transport, tcp}, {frame_size_max, 4096}, {auth, cookie}, {cookie_file, "../cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 23500}, {epmd, external}, {epmd_port, 23502}, {net_ticktime_s, 8}]} ].
