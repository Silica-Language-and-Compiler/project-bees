%% SEMP's whitelist form: certificate file => permission spec. p.pem is the identity the fuzz driver presents; n.pem may do
%% nothing; u.pem is not listed (the driver presents it to check that an unlisted certificate executes nothing).
#{
  "p.pem" => [{demo, [{add, 2}, {echo, 1}, {crash, 1}, {note, 1}]}],
  "n.pem" => none
}.
