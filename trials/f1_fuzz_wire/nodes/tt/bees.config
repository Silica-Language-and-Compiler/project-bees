%% F1 (fuzzer) node tt: a TRUST server under test over mutual TLS 1.3. The TEST-ONLY certificates are trials/n4_trust_tls's
%% (keys that belong to nobody). p.pem is the identity the fuzz driver presents; it may negotiate classical X25519 (D44), so the
%% driver's Python ssl client works whatever groups its OpenSSL offers. suspicion_limit: as node ts.
[
  {mode, trust},
  {node, [{name, "tt@127.0.0.1"}]},
  {trust, [
    {port, 23511},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../../n4_trust_tls/certs/a.pem"},
                {keyfile, "../../../n4_trust_tls/certs/a-key.pem"}]},
    {whitelist_file, "trust_whitelist.config"},
    {classical_allowed_certs, ["p.pem", "n.pem"]},
    {whitelist_cert_dir, "../../../n4_trust_tls/certs"},
    {call_timeout_ms, 400},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 1000},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {args_len_max, 1024},
    {term_depth_max, 32}
  ]}
].
