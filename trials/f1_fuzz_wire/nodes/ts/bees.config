%% F1 (fuzzer) node ts: a TRUST server under test. TEST ONLY: plaintext on 127.0.0.1, stand-in fingerprints (R5); the stand-in
%% certificates are trials/n3_trust's. suspicion_limit is the largest allowed, so that a run of refused frames does not end in
%% quarantine (the driver's probe after each case lowers the count again, and the node is restarted every slice).
[
  {mode, trust},
  {node, [{name, "ts@127.0.0.1"}]},
  {trust, [
    {port, 23510},
    {listen_address, "127.0.0.1"},
    {plaintext_test_only, true},
    {tls_opts, [{certfile, "../../../n3_trust/certs/a.cert"}]},
    {whitelist_file, "trust_whitelist.config"},
    {whitelist_cert_dir, "../../../n3_trust/certs"},
    {call_timeout_ms, 400},
    {first_frame_timeout_ms, 500},
    {client_handshake_timeout, 2000},
    {suspicion_limit, 1000},
    {token_bytes, 48},
    {token_ttl_sec, 300},
    {frame_size_max, 4096},
    {args_len_max, 1024},
    {term_depth_max, 32}
  ]}
].
