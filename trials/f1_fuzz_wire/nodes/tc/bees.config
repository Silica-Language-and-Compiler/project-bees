%% F1 (fuzzer) node tc: a TRUST client under test (standalone: no whitelist, so it accepts no inbound connection). TEST ONLY:
%% plaintext on 127.0.0.1, stand-in fingerprints (R5). It pins the fuzz driver's TRUST listener, 127.0.0.1:23503.
[
  {mode, trust},
  {node, [{name, "tc@127.0.0.1"}]},
  {trust, [
    {port, 23512},
    {listen_address, "127.0.0.1"},
    {plaintext_test_only, true},
    {tls_opts, [{certfile, "../../../n3_trust/certs/b.cert"}]},
    {whitelist_cert_dir, "../../../n3_trust/certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 400},
    {connect_timeout_ms, 1000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096}
  ]}
].
