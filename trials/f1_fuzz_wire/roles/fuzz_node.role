// ---- F1 (fuzzer) BEAM-mode node startup, shared by nodes bl and bd: the same startup as trials/n2_dist/roles/node.role, with a
// failure reporter that hides nothing but normal ends: every other actor failure report is printed whole behind one marker line,
// because the fuzz driver (tools/bees_fuzz.py) reads this program's output and treats an unexpected report as a finding.
fn node_start(io_ms: uint64, tick_ms: uint64) -> actor_ref {
    sequence
        c: dangerous_actor_ref <- carrier_new();
        n: actor_ref <- beam_start(c, io_ms, tick_ms, cookie())
    produces pure n end
}
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn fz_digits(n: int64, acc: string) -> string {
    case n < 10 of {
        true -> concat(substring("0123456789", n, n + 1), acc);
        false -> fz_digits(n / 10, concat(substring("0123456789", n % 10, n % 10 + 1), acc))
    }
}
// decimal text of an int64, one string (so a delivery is one println and the driver can compare the value with what it sent)
fn fz_int_text(n: int64) -> string {
    case n < 0 - 9223372036854775807 of {
        true -> "-9223372036854775808";
        false -> case n < 0 of { true -> concat("-", fz_digits(0 - n, "")); false -> fz_digits(n, "") }
    }
}
fn region_dump_limit() -> int64 { 0 }
fn fz_normal_end(report: string) -> boolean { contains(report, "reason:          :normal") }
// a proxy ended by the reaper when its link went down is this layer's design (one stable line, as in n2_dist)
fn fz_proxy_killed(report: string) -> boolean { contains(report, "beam_peers_proxy_") and contains(report, "killed") }
fn reporter(report: string, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- case fz_normal_end(report) of {
            true -> :ok;
            false -> case fz_proxy_killed(report) of {
                true -> say("proxy ended (killed)");
                false -> say(concat("[fuzz actor failure report]", report))
            }
        }
    produces pure (:no_reply, st) end
}
fn start_reporter() -> atom {
    sequence proc[concurrency]
        r: actor_ref <- spawn(0, reporter, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: atom <- register_failure_reporter(r)
    produces pure ok end
}
