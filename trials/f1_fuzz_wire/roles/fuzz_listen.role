// ---- F1 node bl, the listening BEAM-mode node under test: inbox prints every delivery on one line with the value in decimal
// (the fuzz driver's oracle: a delivery it cannot account for is a wrong acceptance). To op hello it answers with a cast to the
// peer's registered outbox, whose proxy hands out its pid (node.beam), so a hostile peer can also reach the SEND-to-pid path.
fn inbox(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say(concat(concat("inbox got op=", bees_atoms@spelling(msg.op)), concat(" n=", fz_int_text(msg.n))));
        r: { op: atom, n: int64 } <- { op: bees_atoms@a_reply(), n: msg.n };
        _: boolean <- case msg.op == bees_atoms@a_hello() of { true -> cast_registered(bees_atoms@a_outbox(), r impl ActorMessage {}); false -> true }
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        i: actor_ref <- spawn_registered(0, inbox, bees_atoms@a_inbox(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
