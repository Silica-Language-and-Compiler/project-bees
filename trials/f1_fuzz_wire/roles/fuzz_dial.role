// ---- F1 node bd, the dialing BEAM-mode node under test: it asks EPMD for its peer's port and dials it, again after every lost
// link (redial on), so each attempt meets the fuzz driver's EPMD and listener. outbox prints every delivery on one line.
fn outbox(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say(concat(concat("outbox got op=", bees_atoms@spelling(msg.op)), concat(" n=", fz_int_text(msg.n))))
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        o: actor_ref <- spawn_registered(0, outbox, bees_atoms@a_outbox(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
