# M1 round-trip trial: every supported type, one message each (kind ids in this order).
message t_uint8 uint8
message t_uint16 uint16
message t_uint32 uint32
message t_uint64 uint64
message t_int8 int8
message t_int16 int16
message t_int32 int32
message t_int64 int64
message t_float64 float64
message t_float32 float32
message t_boolean boolean
message t_char char
message t_atom atom
message t_string string
message t_tuple (int8, uint16, string, boolean)
message t_record { a: int64, b: float64, c: boolean, d: atom }
message t_list_i32 List[int32]
message t_list_str List[string]
message t_list_f64 List[float64]
message t_nested { id: uint32, tags: List[string], pos: (float64, float64), items: List[{ k: atom, v: int16, ok: boolean }], ch: char, big: uint64, f: float32, s: string, grid: List[List[uint8]] }
message t_list_tuple List[(int64, string)]
