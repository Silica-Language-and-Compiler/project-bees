                    d: { code: int64, v: { a: int64, b: float64, c: boolean, d: atom } } <- bees_wire_msgs@dec_t_record(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_record(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
