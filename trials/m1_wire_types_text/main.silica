fn t_list_str(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_list_str(rg, b, lst_str(5));
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show(rg, "List[string] 5", b, n);
                    d: { code: int64, v: List[string, mem(normal)] } <- bees_wire_msgs@dec_t_list_str(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_list_str(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
fn t_list_f64(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_list_f64(rg, b, lst_f64());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show(rg, "List[float64] 3", b, n);
                    d: { code: int64, v: List[float64, mem(normal)] } <- bees_wire_msgs@dec_t_list_f64(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_list_f64(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
fn t_list_tuple(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_list_tuple(rg, b, lst_tuple());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show(rg, "List[(int64,string)] 2", b, n);
                    d: { code: int64, v: List[(int64, string), mem(normal)] } <- bees_wire_msgs@dec_t_list_tuple(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_list_tuple(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
fn t_nested(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_nested(rg, b, val_nested());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show(rg, "nested (every type)", b, n);
                    d: { code: int64, v: { id: uint32, tags: List[string, mem(normal)], pos: (float64, float64), items: List[{ k: atom, v: int16, ok: boolean }, mem(normal)], ch: char, big: uint64, f: float32, s: string, grid: List[List[uint8, mem(normal)], mem(normal)] } } <- bees_wire_msgs@dec_t_nested(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_nested(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}

// hello (frame kind 0): the node name as an atom spelling, then the 8-byte schema digest
fn hello_test(rg: region(L, normal), b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n: int64 <- bees_wire@enc_hello(rg, b, bees_atoms@a_alpha(), bees_wire_msgs@schema_digest());
        _: int64 <- show(rg, "hello alpha", b, n);
        d: { code: int64, node: atom, digest: int64 } <- bees_wire@dec_hello(rg, b, n);
        print_string("digest=");
        _: atom <- print_int64(d.digest);
        print_string(" same_digest=");
        _: atom <- print_boolean(d.digest == bees_wire_msgs@schema_digest());
        print_string(" same_node=");
        _: atom <- print_boolean(d.node == bees_atoms@a_alpha());
        print_string(" code=");
        _: atom <- print_atom(bees_wire@reason_atom(d.code));
        println("")
    produces pure 0 end
}

fn run_all(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- t_atom_0(rg, b, c);
        _: int64 <- t_atom_1(rg, b, c);
        _: int64 <- t_atom_2(rg, b, c);
        _: int64 <- t_atom_3(rg, b, c);
        _: int64 <- t_string_0(rg, b, c);
        _: int64 <- t_string_1(rg, b, c);
        _: int64 <- t_string_2(rg, b, c);
        _: int64 <- t_string_3(rg, b, c);
        _: int64 <- t_string_4(rg, b, c);
        _: int64 <- t_string_5(rg, b, c);
        _: int64 <- t_string_6(rg, b, c);
        _: int64 <- t_tuple(rg, b, c);
        _: int64 <- t_record(rg, b, c);
        _: int64 <- t_list_i32_0(rg, b, c);
        _: int64 <- t_list_i32_1(rg, b, c);
        _: int64 <- t_list_i32_255(rg, b, c);
        _: int64 <- t_list_i32_256(rg, b, c);
        _: int64 <- t_list_i32_257(rg, b, c);
        _: int64 <- t_list_str(rg, b, c);
        _: int64 <- t_list_f64(rg, b, c);
        _: int64 <- t_list_tuple(rg, b, c);
        _: int64 <- t_nested(rg, b, c);
        _: int64 <- hello_test(rg, b);
        n: int64 <- bees_wire_msgs@enc_t_atom(rg, b, bees_atoms@a_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy());
        print_string("atom y*256 encode: ");
        _: atom <- print_atom(bees_wire@reason_atom(0 - n));
        println("");
        println("types done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        _: int64 <- run_all(rg, b, c)
    produces pure 0 end
}

