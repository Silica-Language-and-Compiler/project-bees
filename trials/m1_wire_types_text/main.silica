fn lst_i32(n: int32) -> List[int32, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[int32, mem(normal)] <- empty[int32, mem(normal)]();
        rest: List[int32, mem(normal)] <- case n <= 0 of { true -> e; false -> lst_i32(n - 1) };
        out: List[int32, mem(normal)] <- case n <= 0 of { true -> e; false -> prepend[int32, mem(normal)](n * 1000003, rest) }
    produces pure out end
}
fn lst_str(n: int64) -> List[string, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[string, mem(normal)] <- empty[string, mem(normal)]();
        rest: List[string, mem(normal)] <- case n <= 0 of { true -> e; false -> lst_str(n - 1) };
        out: List[string, mem(normal)] <- case n <= 0 of { true -> e; false -> prepend[string, mem(normal)](rep("s", n), rest) }
    produces pure out end
}
fn val_f64_a() -> float64 { 1.5 }
fn val_f64_b() -> float64 { 0.0 }
fn val_f64_c() -> float64 { 1.0e-320 }
fn lst_f64() -> List[float64, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[float64, mem(normal)] <- empty[float64, mem(normal)]();
        c: float64 <- val_f64_c();
        z: float64 <- val_f64_b();
        a: float64 <- val_f64_a();
        l1: List[float64, mem(normal)] <- prepend[float64, mem(normal)](c, e);
        l2: List[float64, mem(normal)] <- prepend[float64, mem(normal)](z, l1);
        l3: List[float64, mem(normal)] <- prepend[float64, mem(normal)](a, l2)
    produces pure l3 end
}
fn lst_tuple() -> List[(int64, string), mem(normal)] {
    sequence proc[mem(normal)]
        e: List[(int64, string), mem(normal)] <- empty[(int64, string), mem(normal)]();
        p1: (int64, string) <- (7, "seven");
        p2: (int64, string) <- (-8, "");
        l1: List[(int64, string), mem(normal)] <- prepend[(int64, string), mem(normal)](p2, e);
        l2: List[(int64, string), mem(normal)] <- prepend[(int64, string), mem(normal)](p1, l1)
    produces pure l2 end
}
fn val_tuple() -> (int8, uint16, string, boolean) { (-5, 65535, "tuple", true) }
fn val_record() -> { a: int64, b: float64, c: boolean, d: atom } { { a: -9, b: 2.5, c: true, d: bees_atoms@a_beta_gamma() } }
fn pos_pair() -> (float64, float64) { (0.5, -0.25) }
fn items() -> List[{ k: atom, v: int16, ok: boolean }, mem(normal)] {
    sequence proc[mem(normal)]
        e: List[{ k: atom, v: int16, ok: boolean }, mem(normal)] <- empty[{ k: atom, v: int16, ok: boolean }, mem(normal)]();
        i1: { k: atom, v: int16, ok: boolean } <- { k: bees_atoms@a_alpha(), v: -300, ok: true };
        i2: { k: atom, v: int16, ok: boolean } <- { k: bees_atoms@a_z(), v: 300, ok: false };
        l1: List[{ k: atom, v: int16, ok: boolean }, mem(normal)] <- prepend[{ k: atom, v: int16, ok: boolean }, mem(normal)](i2, e);
        l2: List[{ k: atom, v: int16, ok: boolean }, mem(normal)] <- prepend[{ k: atom, v: int16, ok: boolean }, mem(normal)](i1, l1)
    produces pure l2 end
}
fn grid() -> List[List[uint8, mem(normal)], mem(normal)] {
    sequence proc[mem(normal)]
        e: List[uint8, mem(normal)] <- empty[uint8, mem(normal)]();
        r1: List[uint8, mem(normal)] <- prepend[uint8, mem(normal)](200, prepend[uint8, mem(normal)](1, e));
        eg: List[List[uint8, mem(normal)], mem(normal)] <- empty[List[uint8, mem(normal)], mem(normal)]();
        g1: List[List[uint8, mem(normal)], mem(normal)] <- prepend[List[uint8, mem(normal)], mem(normal)](e, eg);
        g2: List[List[uint8, mem(normal)], mem(normal)] <- prepend[List[uint8, mem(normal)], mem(normal)](r1, g1)
    produces pure g2 end
}
fn f32_nested() -> float32 { 0.15625 }
fn val_nested() -> { id: uint32, tags: List[string, mem(normal)], pos: (float64, float64), items: List[{ k: atom, v: int16, ok: boolean }, mem(normal)], ch: char, big: uint64, f: float32, s: string, grid: List[List[uint8, mem(normal)], mem(normal)] } {
    sequence
        v: { id: uint32, tags: List[string, mem(normal)], pos: (float64, float64), items: List[{ k: atom, v: int16, ok: boolean }, mem(normal)], ch: char, big: uint64, f: float32, s: string, grid: List[List[uint8, mem(normal)], mem(normal)] } <- { id: 4000000000, tags: lst_str(3), pos: pos_pair(), items: items(), ch: 'Z', big: 18446744073709551615, f: f32_nested(), s: "nested value", grid: grid() }
    produces pure v end
}

fn t_tuple(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_tuple(rg, b, val_tuple());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show(rg, "tuple (-5,65535,tuple,true)", b, n);
                    d: { code: int64, v: (int8, uint16, string, boolean) } <- bees_wire_msgs@dec_t_tuple(rg, b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_tuple(rg, c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(rg, b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
