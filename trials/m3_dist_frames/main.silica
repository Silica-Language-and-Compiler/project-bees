// M3 (ported to the language's transport): the byte layouts of the distribution layer, with no network: the handshake
// messages, a REG_SEND frame built by the generated proxy path (bees_msgs@enc_counter, the language's encode; bees_dist@reg_send_body
// and frame4) and parsed back (bees_dist@reg_send_target, then the language's decode through bees_msgs). Each frame is printed as
// hex; tools/test_bees_dist.py compares them with the bytes `erl` writes (term_to_binary).
use bees_atoms;
use bees_msgs;
use bees_dist;
use bees_ingress;
use bees_peers;

fn hexd(v: int64) -> string { substring("0123456789abcdef", v, v + 1) }
fn show(label: string, s: string) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label);
        _: atom <- print_string(" ");
        _: atom <- println(s)
    produces pure :ok end
}
fn num(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label);
        _: atom <- print_string(" ");
        _: atom <- print_int64(n);
        _: atom <- println("")
    produces pure :ok end
}
// byte_at is a transport operation (E3013): in a sequence that declares transport
fn at(s: string, i: int64) -> int64 {
    sequence proc[transport]
        b: int64 <- byte_at(s, i)
    produces pure b end
}
fn hex_of(s: string, i: int64, n: int64) -> string {
    case i >= n of {
        true -> "";
        false -> concat(concat(hexd(at(s, i) / 16), hexd(at(s, i) % 16)), hex_of(s, i + 1, n))
    }
}
fn dump(label: string, s: string) -> atom { show(label, hex_of(s, 0, length_bytes(s))) }
// the body of a framed message: after its 2- or 4-byte length prefix
fn body_of(s: string, from: int64) -> string {
    sequence proc[mem(normal), transport]
        out: string <- byte_slice(s, from, length_bytes(s))
    produces pure out end
}
fn b2i(b: boolean) -> int64 { case b of { true -> 1; false -> 0 } }
fn decoded_n(r: (:ok, { op: atom, n: int64 }) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: { op: atom, n: int64 }) -> v.n;
        (:rejected, _w: atom) -> 0 - 1
    }
}
fn decoded_op(r: (:ok, { op: atom, n: int64 }) | (:rejected, atom)) -> string {
    case r of {
        (:ok, v: { op: atom, n: int64 }) -> bees_atoms@spelling(v.op);
        (:rejected, w: atom) -> bees_atoms@spelling(w)
    }
}

fn main() -> int64 {
    sequence
        f1: string <- bees_dist@put_n_init(bees_peers@node_name(), bees_peers@node_creation());
        _: atom <- dump("n_init", f1);
        s1: string <- body_of(f1, 2);
        r1: { code: int64, v: string } <- bees_dist@n_init_name(s1);
        _: atom <- num("n_init parse code", r1.code);
        _: atom <- show("n_init parse name", r1.v);
        _: atom <- num("n_init peer_index", bees_peers@peer_index(r1.v));
        f2: string <- bees_dist@put_s_ok();
        _: atom <- dump("s_ok", f2);
        _: atom <- num("s_ok accepted", b2i(bees_dist@is_s_ok(body_of(f2, 2))));
        f3: string <- bees_dist@put_n_acc("a@127.0.0.1", 7);
        _: atom <- dump("n_acc", f3);
        s3: string <- body_of(f3, 2);
        r3: { code: int64, v: string } <- bees_dist@n_acc_name(s3);
        _: atom <- num("n_acc parse code", r3.code);
        _: atom <- show("n_acc parse name", r3.v);
        _: atom <- num("n_acc as an init message, code", bees_dist@n_init_name(s3).code);
        _: atom <- num("n_init as an acc message, code", bees_dist@n_acc_name(s1).code);
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: 5 };
        payload: string <- bees_msgs@enc_counter(m);
        _: atom <- dump("payload", payload);
        body: string <- bees_dist@reg_send_body(payload, 3, bees_peers@node_name(), bees_peers@node_creation(), bees_atoms@spelling(bees_atoms@a_counter()));
        f4: string <- bees_dist@frame4(body);
        _: atom <- dump("reg_send", f4);
        t4: { code: int64, name: atom, pstart: int64 } <- bees_dist@reg_send_target(body, "b@127.0.0.1");
        _: atom <- num("reg_send parse code", t4.code);
        _: atom <- show("reg_send parse name", bees_atoms@spelling(t4.name));
        _: atom <- num("reg_send parse pstart", t4.pstart);
        _: atom <- num("reg_send from another node, code", bees_dist@reg_send_target(body, "x@127.0.0.1").code);
        _: atom <- num("reg_send local_index of counter (a remote name)", bees_peers@local_index(t4.name));
        p4: string <- bees_dist@payload_of(body, t4.pstart);
        _: atom <- num("payload validates", bees_ingress@reason_code(bees_msgs@validate_named(p4, t4.name)));
        d4: (:ok, { op: atom, n: int64 }) | (:rejected, atom) <- bees_msgs@dec_counter(p4);
        _: atom <- num("payload decoded n", decoded_n(d4));
        _: atom <- show("payload decoded op", decoded_op(d4))
    produces pure 0 end
}
