use bees_reporter;
// SD-19 re-check (silica-999939): migrate_actor with an arithmetic EXPRESSION as the core argument
// (it faulted inside silica_rt_migrate_actor on silica-999977). Expected: ok, then 4.
fn idle(msg: int64, state: int64) -> (:reply, int64, int64) { (:reply, state + msg, state + msg) }

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        a: actor_ref <- spawn(1, idle, stack_policy(0, :keep_last_message), state_policy(:keep_state_area), 1);
        i: int64 <- 1;
        r: atom <- migrate_actor(a, 1 + i % 2);
        _: atom <- println("ok");
        v: int64 <- call(a, 3 impl ActorMessage {});
        _: atom <- print_int64(v);
        println("")
    produces pure 0 end
}
