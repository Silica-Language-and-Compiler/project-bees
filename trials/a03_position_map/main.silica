// A3: what the supervisor position map can be, checked against Silica's run-time numbering.
// A pid is a 64-bit identity: position (high 32 bits, the position of the supervisor that spawned it)
// and child number (low 32 bits). Silica numbers positions at RUN time (spec 15.1.4 status), so
// no table of positions can be generated at build time. This program reads the numbers a tree of
// supervisors actually gets: do the workers of one supervisor share a position, do two supervisors
// differ, and what happens to a restarted worker's identity. See the compiler guide, A4.
// Expected (verified 2026-11-04): workers of one supervisor share a position, the two supervisors differ, the position is NOT the supervisor own identity position (children of the root have position 1, leaf0 workers 2, leaf1 workers 3); a restarted worker keeps the position and gets the next child number (2), and its old ref does not equal the new one.
use Supervisor;
use bees_atoms;
use bees_ids;
use bees_exit;

impl PosRootSup for Supervisor;

fn worker(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + 100 / msg)
}

fn leaf0_init(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: bees_ids@id_of(bees_ids@leaf_t(0), 0), agent_type: :worker, initial_state: 0, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: bees_ids@id_of(bees_ids@leaf_t(0), 1), agent_type: :worker, initial_state: 0, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces pure (flags, children) end
}

fn leaf1_init(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: bees_ids@id_of(bees_ids@leaf_t(1), 0), agent_type: :worker, initial_state: 0, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: bees_ids@id_of(bees_ids@leaf_t(1), 1), agent_type: :worker, initial_state: 0, behavior: worker, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces pure (flags, children) end
}

fn init(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(initial_state: int64) -> ({ strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 }, List[{ id: atom, agent_type: :worker | :supervisor, initial_state: int64, behavior: fn(msg: int64, state: int64) -> (:no_reply, int64), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)]), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous, state_policy: state_policy }, mem(normal)] <- [
            { id: bees_ids@id_of(bees_ids@pool_t_top(), 0), agent_type: :supervisor, initial_state: 0, behavior: leaf0_init, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) },
            { id: bees_ids@id_of(bees_ids@pool_t_top(), 1), agent_type: :supervisor, initial_state: 0, behavior: leaf1_init, restart: :permanent, shutdown: 0, flavor: :plain, state_policy: state_policy(:keep_state_area) }
        ]
    produces pure (flags, children) end
}

fn child_of(sup: actor_ref, id: atom) -> actor_ref {
    sequence
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[ { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal) ], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: id } impl SupervisorMessage {})
    produces pure got.child end
}

fn top_of(root: supervisor_ref, j: int64) -> actor_ref {
    sequence
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[ { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal) ], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(root, { op: :get_child, id: bees_ids@id_of(bees_ids@pool_t_top(), j) } impl SupervisorMessage {})
    produces pure got.child end
}

fn pos(r: actor_ref) -> uint64 {
    sequence proc[concurrency]
        i: uint64 <- actor_id(r)
    produces pure i shr 32 end
}
fn num(r: actor_ref) -> uint64 {
    sequence proc[concurrency]
        i: uint64 <- actor_id(r)
    produces pure i band 4294967295 end
}

fn same(a: uint64, b: uint64) -> boolean { a == b }

fn spin(n: int64) -> int64 { case n == 0 of { true -> 0; false -> spin(n - 1) } }

fn say(label: string, b: boolean) -> int64 {
    sequence proc[device_io]
        print_string(label);
        _: atom <- print_boolean(b)
    produces pure 0 end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_exit@start();
        root: supervisor_ref <- spawn_registered_supervisor(PosRootSup, 0, bees_atoms@a_pos_root(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        l0: actor_ref <- top_of(root, 0);
        l1: actor_ref <- top_of(root, 1);
        a0: actor_ref <- child_of(l0, bees_ids@id_of(bees_ids@leaf_t(0), 0));
        a1: actor_ref <- child_of(l0, bees_ids@id_of(bees_ids@leaf_t(0), 1));
        b0: actor_ref <- child_of(l1, bees_ids@id_of(bees_ids@leaf_t(1), 0));
        b1: actor_ref <- child_of(l1, bees_ids@id_of(bees_ids@leaf_t(1), 1));
        _: int64 <- say("workers of leaf0 share a position: ", same(pos(a0), pos(a1)));
        _: int64 <- say(" / leaf1: ", same(pos(b0), pos(b1)));
        _: int64 <- say(" / leaves differ: ", pos(a0) != pos(b0));
        println("");
        _: int64 <- say("a leaf's own position is its children's: ", same(pos(l0), pos(a0)));
        _: int64 <- say(" / the root's children (the leaves) share the root's: ", same(pos(l0), pos(l1)));
        println("");
        print_string("positions root-children=");
        _: atom <- print_uint64(pos(l0));
        print_string(" leaf0-workers=");
        _: atom <- print_uint64(pos(a0));
        print_string(" leaf1-workers=");
        _: atom <- print_uint64(pos(b0));
        print_string(" child numbers leaf0=");
        _: atom <- print_uint64(num(a0));
        print_string(",");
        _: atom <- print_uint64(num(a1));
        println("");
        // crash leaf0's worker 0 (100 / 0): the permanent worker is restarted
        _: boolean <- cast(a0, 0 impl ActorMessage {});
        _: int64 <- spin(3000000);
        a0b: actor_ref <- child_of(l0, bees_ids@id_of(bees_ids@leaf_t(0), 0));
        _: int64 <- say("restarted worker: same position: ", same(pos(a0), pos(a0b)));
        _: int64 <- say(" / new child number: ", num(a0b) != num(a0));
        _: int64 <- say(" / old ref equals new: ", a0 == a0b);
        println("");
        print_string("restarted child number=");
        _: atom <- print_uint64(num(a0b));
        println("");
        _: boolean <- bees_exit@finish();
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
