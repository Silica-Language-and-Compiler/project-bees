%% N2T live trial (BEAM mode inside TLS; the test certificates of trials/n2t_pair/certs), node beesl: listens on 127.0.0.1:23300, registers with the private EPMD of the trial (127.0.0.1:23390),
%% net_ticktime 8 s like the stock node
[ {mode, beam},
  {node, [{name, "beesl@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../../n2t_pair/certs/l.pem"}, {keyfile, "../../../n2t_pair/certs/l-key.pem"}, {cacertfile, "../../../n2t_pair/certs/ca.pem"}]}, {tls_verify, verify_peer},
          {frame_size_max, 4096}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 23300}, {epmd, external}, {epmd_port, 23390}, {net_ticktime_s, 8}]} ].
%% {frame_size_max, 4096}: N2's cap, kept (N1 made the default BEAM's 4294967295, R1, and lets the file set it)
