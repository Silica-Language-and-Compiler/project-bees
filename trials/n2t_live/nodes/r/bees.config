%% N2T live trial (BEAM mode inside TLS; the test certificates of trials/n2t_pair/certs), node beesr: like beesd (dials stock@localhost through the private EPMD of the trial, 127.0.0.1:23390), with redial ON. F1-1 (spikes/F1-fuzzer.md): the scenario bees_redials_epmd starts it BEFORE the stock node, so its first EPMD lookup fails (the peer is not registered); the next attempt, 6 s later, finds the stock node (the driver checks that the stock node was registered before that attempt).
%% The peer host is the NAME localhost with port epmd (N2b): resolved first by the resolver edge, then the EPMD at the IPv4 literal is dialed.
[ {mode, beam},
  {node, [{name, "beesr@localhost"}]},
  {beam, [{transport, tls}, {tls_opts, [{certfile, "../../../n2t_pair/certs/d.pem"}, {keyfile, "../../../n2t_pair/certs/d-key.pem"}, {cacertfile, "../../../n2t_pair/certs/ca.pem"}]}, {tls_verify, verify_peer},
          {frame_size_max, 4096}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {epmd, external}, {epmd_port, 23390}, {net_ticktime_s, 8},
          {peers, [{"stock@localhost", [{host, "localhost"}, {port, epmd}, {role, dial}]}]}, {redial, true}, {redial_initial_ms, 6000}, {redial_max_ms, 6000}]} ].
%% {frame_size_max, 4096}: N2's cap, kept (N1 made the default BEAM's 4294967295, R1, and lets the file set it)
