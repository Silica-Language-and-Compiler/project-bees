# C17 bridge b2: a TRUST node and a TEMPUS node in one program (design 17.2). Generated by the rule of .gen.mk (an included
# makefile, so make starts again and sees the new units: make 3.81 lists a directory once): the TRUST side's configuration
# (tools/bees_config_trust.py), the MFA table of the functions edges may name (tools/bees_trust_gen.py mfa, edge.trust),
# the per-type permission specs (tools/bees_tempus_gen.py spec, edge.spec), the node unit and the TEST-ONLY TEMPUS
# identities, the TRUST root unit (tools/bees_trust_gen.py edge, into trust_root.part) and from it the bridge's root unit
# (tools/bees_tempus_gen.py bridge: the TEMPUS link edge, the node part, the bridge part and the roles follow the TRUST text).
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROLES := $(LEAF_DIR)/../../roles
T := $(BEES_ROOT)/tools
SRC_T := $(BEES_ROOT)/src/tempus
USES := --use tempus_ids --use bees_tempus_store --use bees_tempus_store_actor --use bees_tempus_node --use dangerous_bees_tempus_draws --use bees_tempus_bridge --use bees_tempus_test
# The TRUST configuration bakes the certificates' absolute paths into lib/bees_trust_conf.silica, so the units are made
# again whenever the tree is at another place (another machine): .gen.root holds the tree's path, rewritten only when it
# differs.
_ := $(shell cd "$(LEAF_DIR)" && [ "$$(cat .gen.root 2>/dev/null)" = "$(BEES_ROOT)" ] || echo "$(BEES_ROOT)" > .gen.root)
-include $(LEAF_DIR)/.gen.mk
$(LEAF_DIR)/.gen.mk: $(LEAF_DIR)/.gen.root bees.config trust_servers.config edge.trust edge.spec $(ROLES)/b2.role $(ROLES)/bridge.role $(T)/bees_tempus_gen.py $(T)/bees_trust_gen.py $(SRC_T)/bees_tempus_node.silica.in $(SRC_T)/bees_tempus_node.part $(SRC_T)/bees_tempus_bridge.part $(SRC_T)/bees_tempus_link.part $(BEES_ROOT)/src/shim/bees_trust_node.part
	@cd "$(LEAF_DIR)" && chmod 600 ../../../n4_trust_tls/certs/*-key.pem && python3 "$(T)/bees_config_trust.py" conf -o lib bees.config && \
	python3 "$(T)/bees_trust_gen.py" mfa -o lib --config bees.config edge.trust && \
	python3 "$(T)/bees_tempus_gen.py" spec edge.spec lib/bees_tempus_spec.silica && \
	python3 "$(T)/bees_tempus_gen.py" unit "$(SRC_T)/bees_tempus_node.silica.in" lib/bees_tempus_node.silica && \
	python3 "$(T)/bees_tempus_ids.py" write lib/tempus_ids.silica ../../../t5_tempus_tls/certs/ && \
	python3 "$(T)/bees_trust_gen.py" edge dangerous_b2 trust_root.part /dev/null && \
	python3 "$(T)/bees_tempus_gen.py" bridge dangerous_b2 dangerous_b2.silica trust_root.part $(USES) --part bees_tempus_node.part --part bees_tempus_bridge.part "$(ROLES)/b2.role" "$(ROLES)/bridge.role" && \
	echo "# written by the rule of this file in the Makefile: the generated units are current" > .gen.mk
include $(BEES_ROOT)/tools/trial.mk
PAIRED := $(ENTRIES)
clean: clean-generated
.PHONY: clean-generated
clean-generated:
	@cd "$(LEAF_DIR)" && rm -f dangerous_b2.silica trust_root.part .gen.mk lib/bees_trust_conf.silica lib/bees_trust_conf.atoms lib/bees_trust_mfa.silica lib/bees_tempus_spec.silica lib/bees_tempus_node.silica lib/tempus_ids.silica
