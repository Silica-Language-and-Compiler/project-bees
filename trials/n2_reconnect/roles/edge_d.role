// ---- edge d (redial): casts req_d (21) after 0.7 s and again (34) after 8 s, printing each answer on ans_d. The hub (h1) is ended after the
// first answer and a new one (h2) is started later on the same port: d's link is lost, d dials again with a growing delay (its audit
// lines say so) until h2 accepts, and the second request is answered over the new link. The marker is the second answer.
fn num_text(n: int64) -> string {
    case n of {
        21 -> "21"; 34 -> "34"; 42 -> "42"; 68 -> "68";
        _: int64 -> "?"
    }
}
fn ans_d(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say(concat("edge d: got answer ", num_text(msg.n)))
    produces pure (:no_reply, st + 1) end
}
fn sender(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: 21 + st * 13 };
        _: boolean <- cast_registered(bees_atoms@a_req_d(), m impl ActorMessage {});
        _: atom <- say("edge d: request sent")
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        a: actor_ref <- spawn_registered(0, ans_d, bees_atoms@a_ans_d(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        s: actor_ref <- spawn(0, sender, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        t: timer_ref <- send_after(700, s, 0 impl ActorMessage {});
        t2: timer_ref <- send_after(8000, s, 0 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
