# C7 Python node trial, node w (dangerous_w): shaped like a production program: no --use of the test unit, and lib/ lists neither src/tempus_test/bees_tempus_test.silica nor its atoms.
# Generated by the rule of .gen.mk (an included makefile, so make starts again and sees the new units).
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROLES := $(LEAF_DIR)/../../roles
T := $(BEES_ROOT)/tools
SRC_T := $(BEES_ROOT)/src/tempus
USES := --use tempus_ids --use bees_tempus_store --use bees_tempus_store_actor --use bees_tempus_node --use dangerous_bees_tempus_draws
-include $(LEAF_DIR)/.gen.mk
$(LEAF_DIR)/.gen.mk: $(ROLES)/w.role $(ROLES)/node.role $(T)/bees_tempus_gen.py $(T)/bees_tempus_ids.py $(SRC_T)/bees_tempus_node.silica.in $(SRC_T)/bees_tempus_node.part $(SRC_T)/bees_tempus_link.part $(BEES_ROOT)/src/shim/bees_tcp_edge.part
	@cd "$(LEAF_DIR)" && python3 "$(T)/bees_tempus_ids.py" write lib/tempus_ids.silica ../../../t5_tempus_tls/certs/ && \
	python3 "$(T)/bees_tempus_gen.py" unit "$(SRC_T)/bees_tempus_node.silica.in" lib/bees_tempus_node.silica && \
	python3 "$(T)/bees_tempus_gen.py" edge dangerous_w dangerous_w.silica $(USES) --part bees_tempus_node.part "$(ROLES)/w.role" "$(ROLES)/node.role" && \
	echo "# written by the rule of this file in the Makefile: the generated units are current" > .gen.mk
include $(BEES_ROOT)/tools/trial.mk
PAIRED := $(ENTRIES)
clean: clean-generated
.PHONY: clean-generated
clean-generated:
	@cd "$(LEAF_DIR)" && rm -f dangerous_w.silica .gen.mk lib/tempus_ids.silica lib/bees_tempus_node.silica
