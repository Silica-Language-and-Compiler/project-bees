// C7 Python node trial, the application of every Silica node: a thin program that passes the TEST-ONLY values of
// lib/tempus_ids.silica to tempus_node_start (src/tempus/bees_tempus_node.part) and prints what the node tells its
// application: 80 (its own token is not valid any more), 81 (a peer answered key_rotated), 86 (the clock could not be
// read) and 87 (the node stopped after a step back above its limit).
// The entry's own role file gives me() (the identity's number), typ() (1 edge, 3 sentinel), tok() (the variant of the
// node's own token), port(), sents(), tick_ms(), and what makes the program a test program or not: driven() and
// ext_start(app).
// The tempus whitelist of every node holds three certificates: entry 0 `sentinel` (the Silica sentinel Q), entry 1
// `bridge` (the Python sentinel S, which holds a tempus_sentinel token under that certificate) and entry 2 `x4` (the
// Python sentinel R, the node that is not a test node).
// Stores: capacity 4, shuffle length 3 (edge) and 2 (bridge, sentinel). inflight_max 2. shuffle_timeout_ms 2000.
// clock_back follow, clock_fail pause. The same values as the Python nodes of this trial (walk.py).
fn say(s: string) -> atom {
    sequence proc[device_io]
        _: atom <- println(s)
    produces pure :ok end
}
fn hx(s: string) -> string { tempus_ids@unhex(s) }
fn app_line(op: int64, s1: string) -> atom {
    case op of {
        80 -> say(concat("application: told that the node's own token is not valid any more: ", s1));
        81 -> say(concat("application: told that a peer answered key_rotated, its current kid is ", s1));
        86 -> say(concat("application: told (86) that ", s1));
        87 -> say(concat("application: told (87) that ", s1));
        _: int64 -> :ok
    }
}
fn app(msg: $NM$, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- case msg of {
            (:accepted, _l: dangerous_actor_ref, _i: string) -> :ok;
            (:link_up, _info: string) -> :ok;
            (:rx, _s: string) -> :ok;
            (:tx_credit, _n: int64) -> :ok;
            (:tx_failed, _w: atom) -> :ok;
            (:link_down, _w2: atom) -> :ok;
            (:bees, op: int64, s1: string, _s2: string, _n2: int64, _m: int64, _who: actor_ref) -> app_line(op, s1)
        }
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        a: actor_ref <- spawn(0, app, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        idn: $NI$ <- { id: hx(tempus_ids@id_hex(me())), pub: hx(tempus_ids@pub_hex(me())), seed: hx(tempus_ids@seed_hex(me())), addr: concat("127.0.0.1:", port()), token: hx(tempus_ids@tok_hex(me(), tok())), typ: typ() };
        wl: string <- concat(concat(tempus_ids@fp_hex(2), tempus_ids@fp_hex(3)), tempus_ids@fp_hex(7));
        net: $NN$ <- { listen: concat("listen:", port()), spec: tempus_spec(tempus_ids@certfile(me()), tempus_ids@keyfile(me())), sents: sents(), wl: wl, kid: tempus_ids@kid(), ppub: hx(tempus_ids@producer_pub_hex()), ms: 2000, mst: "2000", max: 2, skew: tempus_ids@skew(), j0: 200, j1: 800, back: 1, blim: 0, fail: 2, every: 1000 };
        sz: $NZ$ <- { k1: 4, c1: 3, t1: tick_ms(), k2: 4, c2: 2, t2: tick_ms(), k3: 4, c3: 2, t3: tick_ms() };
        x: actor_ref <- ext_start(a);
        drv: $NT$ <- { driven: driven(), ext: x, draws: case driven() of { true -> "0,1,2,3"; false -> "" } };
        n: actor_ref <- tempus_node_start(a, idn, net, sz, drv);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
