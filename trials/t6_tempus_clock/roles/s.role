// T6 clock trial: node S, a test program (externally driven, by the test unit of src/tempus_test). clock_back stop with
// clock_back_limit_s 60, clock_fail pause. Its sentinel is the Python client's listener, which is not there at first.
fn port() -> string { "24501" }
fn sents() -> string { "127.0.0.1:24503" }
fn tok() -> int64 { 1 }
fn back() -> int64 { 3 }
fn blim() -> int64 { 60 }
fn fail() -> int64 { 2 }
fn driven() -> boolean { true }
fn ext_start(app: actor_ref) -> actor_ref { bees_tempus_test@start(tempus_ids@now()) }
