// M1: round trips of every supported type through the generated codec, with the frame bytes printed.
// Each line is `<type> <value> n=<frame bytes> bytes=<first 24 bytes, decimal> sum=<sum of all bytes> <verdict>`.
// The verdict is `rt` (decoded, and re-encoding the decoded value gives the same bytes) or the rejection.
// tools/test_bees_wire_gen.py checks these bytes against Python's struct.pack, independently of the codec.
use bees_atoms;
use bees_wire;
use bees_wire_msgs;

fn rep(s: string, n: int64) -> string {
    case n <= 0 of {
        true -> "";
        false -> case n == 1 of {
            true -> s;
            false -> concat(rep(s, n / 2), rep(s, n - n / 2))
        }
    }
}
fn sumbytes(b: buf(L, normal, uint8, 4096), i: int64, n: int64, acc: int64) -> int64 {
    case i >= n of { true -> acc; false -> sumbytes(b, i + 1, n, acc + bees_wire@rb_i(b, i)) }
}
fn show_bytes(b: buf(L, normal, uint8, 4096), i: int64, n: int64) -> int64 {
    case i >= n of {
        true -> 0;
        false -> {
            sequence proc[device_io]
                print_string(" ");
                _: atom <- print_int64(bees_wire@rb_i(b, i));
                r: int64 <- show_bytes(b, i + 1, n)
            produces pure r end
        }
    }
}
fn min2(a: int64, b: int64) -> int64 { case a < b of { true -> a; false -> b } }
fn same_bytes(a: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096), i: int64, n: int64) -> boolean {
    case i >= n of {
        true -> true;
        false -> case bees_wire@rb_i(a, i) == bees_wire@rb_i(c, i) of { true -> same_bytes(a, c, i + 1, n); false -> false }
    }
}
// header of one line: label, frame length, the first bytes, the byte sum
fn show(label: string, b: buf(L, normal, uint8, 4096), n: int64) -> int64 {
    sequence proc[device_io]
        print_string(label);
        print_string(" n=");
        _: atom <- print_int64(n);
        print_string(" bytes=");
        _: int64 <- show_bytes(b, 0, min2(n, 24));
        print_string(" sum=");
        _: atom <- print_int64(sumbytes(b, 0, n, 0));
        print_string(" ")
    produces pure 0 end
}
fn verdict(code: int64, same: boolean) -> int64 {
    sequence proc[device_io]
        _: atom <- print_atom(bees_wire@reason_atom(code));
        println(case same of { true -> " rt"; false -> " DIFFERENT" })
    produces pure 0 end
}
fn rejected(n: int64) -> int64 {
    sequence proc[device_io]
        println("encode rejected");
        _: atom <- print_int64(n);
        println("")
    produces pure 0 end
}

fn val_uint8_0() -> uint8 { 0 }
fn t_uint8_0(b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_uint8(b, val_uint8_0());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show("uint8 0", b, n);
                    d: { code: int64, v: uint8 } <- bees_wire_msgs@dec_t_uint8(b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_uint8(c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
fn val_uint8_1() -> uint8 { 255 }
fn t_uint8_1(b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
