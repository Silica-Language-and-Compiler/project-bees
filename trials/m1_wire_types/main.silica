fn t_nested(b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_nested(b, val_nested());
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show("nested (every type)", b, n);
                    d: { code: int64, v: { id: uint32, tags: List[string, mem(normal)], pos: (float64, float64), items: List[{ k: atom, v: int16, ok: boolean }, mem(normal)], ch: char, big: uint64, f: float32, s: string, grid: List[List[uint8, mem(normal)], mem(normal)] } } <- bees_wire_msgs@dec_t_nested(b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_nested(c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}

// hello (frame kind 0): the node name as an atom spelling, then the 8-byte schema digest
fn hello_test(b: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        n: int64 <- bees_wire@enc_hello(b, bees_atoms@a_alpha(), bees_wire_msgs@schema_digest());
        _: int64 <- show("hello alpha", b, n);
        d: { code: int64, node: atom, digest: int64 } <- bees_wire@dec_hello(b, n);
        print_string("digest=");
        _: atom <- print_int64(d.digest);
        print_string(" same_digest=");
        _: atom <- print_boolean(d.digest == bees_wire_msgs@schema_digest());
        print_string(" same_node=");
        _: atom <- print_boolean(d.node == bees_atoms@a_alpha());
        print_string(" code=");
        _: atom <- print_atom(bees_wire@reason_atom(d.code));
        println("")
    produces pure 0 end
}

