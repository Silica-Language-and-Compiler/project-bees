fn run_all(rg: region(L, normal), b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence proc[device_io]
        _: int64 <- t_uint8_0(rg, b, c);
        _: int64 <- t_uint8_1(rg, b, c);
        _: int64 <- t_uint8_2(rg, b, c);
        _: int64 <- t_uint8_3(rg, b, c);
        _: int64 <- t_uint16_0(rg, b, c);
        _: int64 <- t_uint16_1(rg, b, c);
        _: int64 <- t_uint16_2(rg, b, c);
        _: int64 <- t_uint16_3(rg, b, c);
        _: int64 <- t_uint16_4(rg, b, c);
        _: int64 <- t_uint32_0(rg, b, c);
        _: int64 <- t_uint32_1(rg, b, c);
        _: int64 <- t_uint32_2(rg, b, c);
        _: int64 <- t_uint32_3(rg, b, c);
        _: int64 <- t_uint32_4(rg, b, c);
        _: int64 <- t_uint64_0(rg, b, c);
        _: int64 <- t_uint64_1(rg, b, c);
        _: int64 <- t_uint64_2(rg, b, c);
        _: int64 <- t_uint64_3(rg, b, c);
        _: int64 <- t_uint64_4(rg, b, c);
        println("m1_wire_types done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        rg: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(rg, 4096);
        _: int64 <- run_all(rg, b, c)
    produces pure 0 end
}

