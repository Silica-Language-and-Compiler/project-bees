        println("types done")
    produces pure 0 end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 4096) <- alloc_buf(r, 4096);
        c: buf(L, normal, uint8, 4096) <- alloc_buf(r, 4096);
        _: int64 <- run_all(b, c)
    produces pure 0 end
}

