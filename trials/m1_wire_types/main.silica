    sequence
        n: int64 <- bees_wire_msgs@enc_t_list_str(b, lst_str(5));
        r: int64 <- case n < 0 of {
            true -> rejected(n);
            false -> {
                sequence
                    _: int64 <- show("List[string] 5", b, n);
                    d: { code: int64, v: List[string, mem(normal)] } <- bees_wire_msgs@dec_t_list_str(b, n);
                    m2: int64 <- bees_wire_msgs@enc_t_list_str(c, d.v);
                    same: boolean <- case d.code == 0 of { true -> m2 == n and same_bytes(b, c, 0, n); false -> false };
                    _: int64 <- verdict(d.code, same)
                produces pure 0 end
            }
        }
    produces pure r end
}
fn t_list_f64(b: buf(L, normal, uint8, 4096), c: buf(L, normal, uint8, 4096)) -> int64 {
    sequence
        n: int64 <- bees_wire_msgs@enc_t_list_f64(b, lst_f64());
