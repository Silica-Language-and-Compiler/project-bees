%% C3 trial: the TRUST side of bridge B1 (its TEMPUS side is given its values by bridge.role). A TRUST client only: no
%% whitelist, so no TRUST listener; it calls node T, pinned to a.pem. Its TRUST certificate is b.pem of the N4.1 trial's
%% TEST-ONLY certificates (no CA configured, D43); its TEMPUS certificate is another key altogether (design 17.2).
[
  {mode, trust},
  {node, [{name, "b1@127.0.0.1"}]},
  {trust, [
    {port, 24206},
    {listen_address, "127.0.0.1"},
    {tls_opts, [{certfile, "../../../n4_trust_tls/certs/b.pem"},
                {keyfile, "../../../n4_trust_tls/certs/b-key.pem"}]},
    {whitelist_cert_dir, "../../../n4_trust_tls/certs"},
    {server_pins_file, "trust_servers.config"},
    {call_timeout_ms, 2000},
    {connect_timeout_ms, 2000},
    {client_handshake_timeout, 2000},
    {frame_size_max, 4096}
  ]}
].
