use bees_reporter;
// S3 re-run (silica-999939): spawn idle cast-only actors with the DEFAULT stack reservation (stack_policy(0, ...) = the
// machine's memory plus swap, of address space, per actor) until the spawn aborts ("stack reservation failed", exit 71): the
// ceiling is virtual address space, not the thread cap (4,093 on silica-999977). Where it aborts follows the machine: near
// 4,000 actors on a 16 GB Mac with swap in use, near 8,000 on the same Mac with none. 100,000 are asked for, so that the
// address space runs out on any machine whose memory plus swap is above about 1.3 GB, and the entry prints the same on all
// of them (8,000 was enough or not by the machine: the 2026-11-21 runs). Lowering the reserve removes the ceiling: see
// ceiling_100k_1mb.
fn idle(msg: int64, state: int64) -> (:no_reply, int64) {
    (:no_reply, state + msg)
}

fn spawn_n(n: int64, acc: int64) -> int64 {
    sequence proc[concurrency]
        a: actor_ref <- spawn(0, idle, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        ok: boolean <- cast(a, 1 impl ActorMessage {});
        got: int64 <- case ok of { true -> 1; false -> 0 };
        rest: int64 <- case n <= 1 of { true -> acc + got; false -> spawn_n(n - 1, acc + got) }
    produces pure rest end
}

fn main() -> int64 {
    sequence proc[device_io]
        _: atom <- bees_reporter@start();
        n: int64 <- spawn_n(100000, 0);
        _: atom <- print_int64(n);
        println("")
    produces pure 0 end
}
