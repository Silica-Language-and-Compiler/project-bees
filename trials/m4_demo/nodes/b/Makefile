# M4 node b (the client): one manifest (node.wire, generated by roles/gen_types.py), one generated bees_peers, and the entries below.
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROLES := $(BEES_ROOT)/trials/m4_demo/roles
EDGE_GEN := $(BEES_ROOT)/tools/bees_edge_gen.py
USES := --use bees_dist --use dangerous_bees_net --use bees_peers --use m4_payload
BASE := $(ROLES)/node.role $(ROLES)/client.role
_ := $(shell python3 "$(ROLES)/gen_types.py" && cd "$(LEAF_DIR)" && \
	"$(EDGE_GEN)" dangerous_b_demo dangerous_b_demo.silica $(USES) $(BASE) $(ROLES)/timing_kill.role $(ROLES)/plan_demo.role $(ROLES)/extras_none.role && \
	"$(EDGE_GEN)" dangerous_b_kill dangerous_b_kill.silica $(USES) $(BASE) $(ROLES)/timing_kill.role $(ROLES)/plan_demo.role $(ROLES)/extras_ticker.role && \
	"$(EDGE_GEN)" dangerous_b_hostile dangerous_b_hostile.silica $(USES) $(BASE) $(ROLES)/timing_kill.role $(ROLES)/plan_demo.role $(ROLES)/extras_hostile.role $(ROLES)/final_keep.role && \
	"$(EDGE_GEN)" dangerous_b_hostile_close dangerous_b_hostile_close.silica $(USES) $(BASE) $(ROLES)/timing_kill.role $(ROLES)/plan_demo.role $(ROLES)/extras_hostile.role $(ROLES)/final_close.role && \
	"$(EDGE_GEN)" dangerous_b_rate dangerous_b_rate.silica $(USES) $(BASE) $(ROLES)/timing_rate.role $(ROLES)/plan_rate.role $(ROLES)/extras_none.role)
include $(BEES_ROOT)/tools/trial.mk

clean: clean-generated
.PHONY: clean-generated
clean-generated:
	@cd "$(LEAF_DIR)" && rm -f dangerous_*.silica lib/bees_peers.silica lib/m4_payload.silica
