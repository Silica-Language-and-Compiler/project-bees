%% N0.2: this M3-style node now runs from a bees.config (the one reader, tools/bees_conf.py, a build-time stand-in). mode beam
%% with auth none, a loopback-only TEST setting (R4): M3's node (dangerous_bees_net) speaks no cookie and no EPMD. The timing
%% stays in the programs' roles: the trials use sub-4-second test timings (1.5 s, 3 s, no ticks), below beam.net_ticktime_s's
%% bound of 4 s and different per program of one node, so they are not bees.config values (bees-config-file.md section 2).
[ {mode, beam},
  {node, [{name, "b@127.0.0.1"}]},
  {beam, [{transport, tcp}, {auth, none}, {listen_address, "127.0.0.1"},
          {frame_size_max, 4096}, {redial, false}]} ].   %% N2c: the demo's scenarios end a link on purpose; a dialer stays down (trials/m3_multilink tests redial). M3's cap, kept so the hostile-frame goldens hold (the default is BEAM's, R1)
