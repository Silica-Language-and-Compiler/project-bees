# M4 node a (the service): one manifest (node.wire, generated by roles/gen_types.py), one generated bees_peers, and the entries below.
# Each entry's root unit is generated at parse time from the carrier edge and roles (SD-17: a worker and its spawn site share a unit).
BEES_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../../..)
LEAF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ROLES := $(BEES_ROOT)/trials/m4_demo/roles
EDGE_GEN := $(BEES_ROOT)/tools/bees_edge_gen.py
USES := --use bees_wire --use bees_wire_msgs --use bees_dist --use bees_net --use bees_peers --use m4_payload
BASE := $(ROLES)/node.role $(ROLES)/service.role
_ := $(shell python3 "$(ROLES)/gen_types.py" && cd "$(LEAF_DIR)" && \
	"$(EDGE_GEN)" dangerous_a_demo dangerous_a_demo.silica $(USES) $(BASE) $(ROLES)/timing_kill.role $(ROLES)/plan_demo.role && \
	"$(EDGE_GEN)" dangerous_a_rate dangerous_a_rate.silica $(USES) $(BASE) $(ROLES)/timing_rate.role $(ROLES)/plan_rate.role)
include $(BEES_ROOT)/tools/trial.mk

clean: clean-generated
.PHONY: clean-generated
clean-generated:
	@cd "$(LEAF_DIR)" && rm -f dangerous_*.silica lib/bees_peers.silica lib/m4_payload.silica
