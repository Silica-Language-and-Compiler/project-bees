%% N1 node b: dials node a (listening on 127.0.0.1 only) over the non-loopback address: refused (@IP@ is this machine's non-loopback IPv4 address, written by the leaf's Makefile)
[ {mode, beam},
  {node, [{name, "b@localhost"}]},
  {beam, [{transport, tcp}, {auth, cookie}, {cookie_file, "../../../n2_dist/cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 21610}, {epmd, none}, {frame_size_max, 4096},
          {peers, [{"a@localhost", [{host, "@IP@"}, {port, 21600}, {role, dial}]}]}, {redial, false}]} ].
