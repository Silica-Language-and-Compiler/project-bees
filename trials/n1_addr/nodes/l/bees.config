%% N1 node l: M3's node (auth none, a loopback-only TEST setting) that dials the name localhost; the resolver's test stub answers it
%% with 10.0.0.8 and 127.0.0.1, so the loopback-only rule refuses the dial (a name passes only by what it resolves to)
[ {mode, beam},
  {node, [{name, "l@localhost"}]},
  {beam, [{transport, tcp}, {auth, none}, {listen_address, "127.0.0.1"}, {redial, false}]} ].
