%% N1 node a: listens on 127.0.0.1 only (the carrier's listen:PORT); cookie authentication
[ {mode, beam},
  {node, [{name, "a@localhost"}]},
  {beam, [{transport, tcp}, {auth, cookie}, {cookie_file, "../../../n2_dist/cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 21600}, {epmd, none}, {frame_size_max, 4096}]} ].
