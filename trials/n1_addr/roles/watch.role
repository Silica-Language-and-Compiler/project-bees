// ---- N1: a dialing node that sends nothing: it starts the node (whose link fails to come up) and prints the 4 s marker
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        n: actor_ref <- node_start(io_ms(), tick_ms());
        _: atom <- start_late();
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
