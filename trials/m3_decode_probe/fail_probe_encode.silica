// Step 1 of M3: is the language's derived encode callable in the linked compiler binary?
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        v: { x: int16, y: int16 } <- { x: 1, y: -2 };
        frame: string <- encode((:etf), v);
        out: atom <- println(frame)
    produces
        pure 0
    end
}
