// Step 1 of M3: is the derived decode (the receive step) callable in the linked compiler binary?
fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        frame: string <- "abc";
        r: (:ok, { x: int16, y: int16 }) | (:rejected, atom) <- decode((:etf), frame);
        out: atom <- println("x")
    produces
        pure 0
    end
}
