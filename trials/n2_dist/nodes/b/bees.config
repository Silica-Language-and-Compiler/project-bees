%% N2 node b (BEES to BEES, no EPMD): the cookie of trials/n2_dist (written mode 600 by the leaf's Makefile)
[ {mode, beam},
  {node, [{name, "b@localhost"}]},
  {beam, [{transport, tcp}, {auth, cookie}, {cookie_file, "../../cookie"}, {listen_address, "127.0.0.1"},
          {listen_port, 47432}, {epmd, none}]} ].
