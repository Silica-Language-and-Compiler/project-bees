%% C1 codec trial (dynamic-term messages): a frame cap of 65536 bytes (beam.frame_size_max), read by the one reader (tools/bees_conf.py)
[ {mode, beam},
  {node, [{name, "b@127.0.0.1"}]},
  {beam, [{transport, tcp}, {auth, none}, {listen_address, "127.0.0.1"}, {frame_size_max, 65536}, {redial, false}]} ].
