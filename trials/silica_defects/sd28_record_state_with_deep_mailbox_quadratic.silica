use bees_reporter;
// SD-28 (open on silica-999936; first seen 2026-11-05): an actor whose state is an AGGREGATE (here a two-field record) takes
// time QUADRATIC in the number of its pending messages. main casts N messages at once: 1,500 take 12 s of wall time,
// 3,000 take 44 s. The same actor with an int64 state handles 20,000 casts in under a second, and the same record state
// handled by synchronous `call` (queue depth one) is fast (4,000 calls in 0.3 s), so the cost is the mailbox depth
// together with a non-scalar state. The BEES exit hub (record state, a flood of exit reports) shows it:
// 500 reports 2 s, 1,000 6 s, 2,000 22 s. The output is correct (800 below); only the time is wrong. On silica-999939
// the order-across-migrations trial ran 100,000 casts to a record-state actor.
// Expected: 800 / done
fn checker(msg: int64, state: { expect: int64, broken: boolean }) -> (:no_reply, { expect: int64, broken: boolean }) {
    sequence proc[device_io]
        next: { expect: int64, broken: boolean } <- case msg == 0 - 1 of {
            true -> state;
            false -> { expect: state.expect + 1, broken: state.broken or msg != state.expect }
        };
        _: atom <- case msg == 0 - 1 of { true -> print_int64(next.expect); false -> :ok };
        _: atom <- case msg == 0 - 1 of { true -> println(""); false -> :ok };
        _: atom <- case msg == 0 - 1 of { true -> println("done"); false -> :ok }
    produces pure (:no_reply, next) end
}

fn send_n(a: actor_ref, i: int64, n: int64) -> atom {
    sequence proc[concurrency]
        _: boolean <- cast(a, i impl ActorMessage {});
        r: atom <- case i + 1 == n of { true -> :ok; false -> send_n(a, i + 1, n) }
    produces pure r end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        a: actor_ref <- spawn({ expect: 0, broken: false }, checker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- send_n(a, 0, 800);
        _: boolean <- cast(a, 0 - 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
