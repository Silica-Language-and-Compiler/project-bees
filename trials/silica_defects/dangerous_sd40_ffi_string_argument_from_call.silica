use bees_reporter;
// SD-40 (silica-999919): a string argument of a foreign function, written as a call expression, reaches C with the wrong
// pointer and length (length 1 here); the same string bound to a name first reaches C intact. The foreign function is BEES's
// bees_fixture_string_len (native/src/silica_bees_native.c), which answers the byte length of the string as C received it
// (this reproducer first used the S14 resolver's entry, retired into the N1 resolver on 2026-11-17; the N1 resolver and its test
// stub bind the host first, which is the workaround). "localhost" is 9 bytes.
// The golden records today's wrong output: the first line should be "inline 9" like the second.
module dangerous_sd40_ffi_string_argument_from_call;

wrapper_meta "dangerous_exposure_source/bees/silica_bees_native_wrapper.meta";

foreign c_wrapper "bees_fixture_string_len"
fn len_raw(host_ptr: uint8, host_len: uint64) -> int64;

fn name() -> string { "localhost" }

fn pure_int(r: (:ok, int64) | (:rejected, atom)) -> int64 {
    case r of {
        (:ok, v: int64) -> v;
        (:rejected, _why: atom) -> 0 - 1
    }
}

fn sink(msg: string, n: int64) -> (:no_reply, int64) {
    sequence proc[device_io]
        _: atom <- println(msg)
    produces pure (:no_reply, n + 1) end
}

fn line(label: string, n: int64) -> string {
    concat(label, concat(" ", digit(n)))
}
fn digit(d: int64) -> string {
    case d of { 0 -> "0"; 1 -> "1"; 9 -> "9"; _: int64 -> "?" }
}

fn worker(msg: int64, reply_to: actor_ref) -> (:no_reply, actor_ref) {
    sequence proc[external_danger, concurrency, transport]
        a: int64 <- len_raw(name());
        h: string <- name();
        b: int64 <- len_raw(h);
        a_raw: int64 <- a;
        b_raw: int64 <- b;
        an: int64 <- pure_int(recreate(a_raw));
        bn: int64 <- pure_int(recreate(b_raw));
        _: boolean <- cast(reply_to, concat(concat(line("inline", an), "\n"), line("bound", bn)) impl ActorMessage {})
    produces pure (:no_reply, reply_to) end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- bees_reporter@start();
        s: actor_ref <- spawn(0, sink, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        w: dangerous_actor_ref <- spawn_dangerous(s, worker, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: boolean <- cast(w, 1 impl ActorMessage {});
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
