// SD-54 (expected: "argument 1", "bound 1", the cells reachable from the cell): a name of the sequence bound to :none with an
// optional-reference type, written inside the tuple literal given to alloc_rec, is not an empty slot: the cell's slot then
// holds a reference to a further cell. Passing :none as an ARGUMENT of a function that does the alloc_rec works.
fn cell(r: region(L, normal), top: ref?(L, normal, (int64, ref?(L, normal, rec))), v: int64) -> ref?(L, normal, (int64, ref?(L, normal, rec))) {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (v, top))
    produces pure c end
}
fn cells(top: ref?(L, normal, (int64, ref?(L, normal, rec))), n: int64) -> int64 {
    case top of {
        :none -> n;
        c: ref(L, normal, (int64, ref?(L, normal, rec))) -> {
            sequence proc[mem(normal)]
                node: (int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: int64, nx: ref?(L, normal, (int64, ref?(L, normal, rec)))) <- node
            produces pure case n > 5 of { true -> n; false -> cells(nx, n + 1) } end
        }
    }
}
fn show(label: string, n: int64) -> atom {
    sequence proc[device_io]
        _: atom <- print_string(label);
        _: atom <- print_int64(n);
        _: atom <- println("")
    produces pure :ok end
}
fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        a: ref?(L, normal, (int64, ref?(L, normal, rec))) <- cell(r, :none, 2);
        _: atom <- show("argument ", cells(a, 0));
        none: ref?(L, normal, (int64, ref?(L, normal, rec))) <- :none;
        b: ref(L, normal, (int64, ref?(L, normal, rec))) <- alloc_rec(r, (2, none));
        b2: ref?(L, normal, (int64, ref?(L, normal, rec))) <- b;
        _: atom <- show("bound ", cells(b2, 0))
    produces pure 0 end
}
