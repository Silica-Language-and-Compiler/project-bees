// ---- node a of the mesh: answers the requests of b and c (rq_<from><to>, each answer goes to an_<from><to>, the registered name of the
// ASKER, so it leaves over the link of the peer the name belongs to), and sends one request to each of them per timer (arm, in the timing role).
// The request value encodes the pair and the round (100 * round + 10 * from + to; a=1 b=2 c=3); the answer is 10 * request + responder.
fn rq_ba(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say_num("a: request from b n=", msg.n);
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_dbl(), n: msg.n * 10 + 1 };
        _: boolean <- cast_registered(bees_atoms@a_an_ba(), m impl ActorMessage {});
        _: atom <- say("a: answer to b sent")
    produces pure (:no_reply, st + 1) end
}
fn rq_ca(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say_num("a: request from c n=", msg.n);
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_dbl(), n: msg.n * 10 + 1 };
        _: boolean <- cast_registered(bees_atoms@a_an_ca(), m impl ActorMessage {});
        _: atom <- say("a: answer to c sent")
    produces pure (:no_reply, st + 1) end
}
fn an_ab(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say_num("a: answer from b n=", msg.n)
    produces pure (:no_reply, st + 1) end
}
fn send_b(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say_num("a: request to b n=", st * 100 + 12);
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: st * 100 + 12 };
        _: boolean <- cast_registered(bees_atoms@a_rq_ab(), m impl ActorMessage {})
    produces pure (:no_reply, st + 1) end
}
fn an_ac(msg: { op: atom, n: int64 }, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say_num("a: answer from c n=", msg.n)
    produces pure (:no_reply, st + 1) end
}
fn send_c(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence proc[concurrency]
        _: atom <- say_num("a: request to c n=", st * 100 + 13);
        m: { op: atom, n: int64 } <- { op: bees_atoms@a_inc(), n: st * 100 + 13 };
        _: boolean <- cast_registered(bees_atoms@a_rq_ac(), m impl ActorMessage {})
    produces pure (:no_reply, st + 1) end
}
fn done(msg: int64, st: int64) -> (:no_reply, int64) {
    sequence
        _: atom <- say("a: done")
    produces pure (:no_reply, st + 1) end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        _: atom <- start_reporter();
        rb: actor_ref <- spawn_registered(0, rq_ba, bees_atoms@a_rq_ba(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        nb: actor_ref <- spawn_registered(0, an_ab, bees_atoms@a_an_ab(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        rc: actor_ref <- spawn_registered(0, rq_ca, bees_atoms@a_rq_ca(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        nc: actor_ref <- spawn_registered(0, an_ac, bees_atoms@a_an_ac(), stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        n: actor_ref <- node_start(io_ms(), tick_ms());
        sb: actor_ref <- spawn(0, send_b, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        sc: actor_ref <- spawn(0, send_c, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        d: actor_ref <- spawn(0, done, stack_policy(0, :keep_last_message), state_policy(:keep_state_area));
        _: atom <- arm(sb, sc, d);
        _: int64 <- wait_for_exit()
    produces pure 0 end
}
